{
  "name": "divjs",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test:pipeline": "node tests/test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:vendor": "esbuild playground/vendor-src/codemirror.js --bundle --format=esm --minify --legal-comments=eof --banner:js=\"/* CodeMirror 6 (MIT, https://codemirror.net) bundled by esbuild - generated by npm run build:vendor, do not edit. Licences: see THIRD_PARTY_NOTICES.md */\" --outfile=playground/vendor/codemirror.js",
    "test:browser": "node tests/browser.mjs",
    "pack": "node tools/pack.mjs",
    "build:physics": "esbuild node_modules/planck/dist/planck.mjs --bundle --format=esm --minify --legal-comments=inline --outfile=vendor/planck.js",
    "capture": "node tools/capture.mjs",
    "itch": "node tools/itch.mjs",
    "build": "esbuild index.js --bundle --format=esm --legal-comments=inline --outfile=dist/divjs.js && esbuild index.js --bundle --format=esm --minify --legal-comments=eof --outfile=dist/divjs.min.js"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "planck": "^1.5.0",
    "playwright": "^1.56.1"
  },
  "version": "1.0.0",
  "description": "The DIV Games Studio language in the browser: compiler, virtual machine and runtime",
  "main": "./dist/divjs.js",
  "exports": {
    ".": "./dist/divjs.js",
    "./src": "./index.js"
  },
  "files": [
    "dist/",
    "index.js",
    "divjs.js",
    "compiler/",
    "parser/",
    "vm/",
    "graph/",
    "vendor/",
    "tools/packer.js",
    "tools/pack.mjs",
    "docs/natives.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
