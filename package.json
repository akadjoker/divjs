{
  "name": "divjs",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test:pipeline": "node tests/test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:browser": "node tests/browser.mjs",
    "pack": "node tools/pack.mjs",
    "build:physics": "esbuild node_modules/planck/dist/planck.mjs --bundle --format=esm --minify --legal-comments=inline --outfile=vendor/planck.js",
    "build": "esbuild index.js --bundle --format=esm --legal-comments=inline --outfile=dist/divjs.js && esbuild index.js --bundle --format=esm --minify --legal-comments=eof --outfile=dist/divjs.min.js"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "planck": "^1.5.0",
    "playwright": "^1.56.1"
  },
  "version": "1.0.0",
  "description": "The DIV Games Studio language in the browser: compiler, virtual machine and runtime",
  "main": "./dist/divjs.js",
  "exports": {
    ".": "./dist/divjs.js",
    "./src": "./index.js"
  },
  "files": [
    "dist/",
    "index.js",
    "divjs.js",
    "compiler/",
    "parser/",
    "vm/",
    "graph/",
    "utils/",
    "vendor/",
    "tools/packer.js",
    "tools/pack.mjs",
    "docs/natives.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ]
}
