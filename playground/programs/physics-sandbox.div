PROGRAM physics_sandbox;

// A physics playground: everything here is moved by the engine's rigid-body
// physics (the phys_* functions, on Planck.js). A process calls phys_box or
// phys_circle once and from then on the world moves it - its x, y and angle
// are written back every frame. Click to drop crates and balls, stack a
// pyramid, and knock it down with the spinning paddle or the wrecking ball.

GLOBAL
  g_crate[2];       // three crate sizes
  g_ball = 0;
  g_bob = 0;
  g_plank = 0;
  g_paddle = 0;
  g_bg = 0;
  bodies = 0;
  fps_now = 0;

// ---------------------------------------------------------------------
// Graphics, all drawn in code
// ---------------------------------------------------------------------

FUNCTION crate_graphic(size);
PRIVATE g;
BEGIN
  g = new_graphic(size, size);
  gfx_fill(g, 150, 98, 48);
  gfx_rect_outline(g, 0, 0, size, size, 90, 56, 24);
  gfx_rect_outline(g, 2, 2, size - 4, size - 4, 186, 130, 70);
  gfx_line(g, 3, 3, size - 4, size - 4, 110, 70, 32);
  gfx_line(g, size - 4, 3, 3, size - 4, 110, 70, 32);
  RETURN g;
END

FUNCTION make_graphics();
PRIVATE i;
BEGIN
  g_crate[0] = crate_graphic(16);
  g_crate[1] = crate_graphic(24);
  g_crate[2] = crate_graphic(32);

  g_ball = new_graphic(20, 20);
  gfx_fill_rgba(g_ball, 0, 0, 0, 0);
  gfx_circle(g_ball, 10, 10, 9, 60, 170, 255);
  gfx_circle(g_ball, 7, 7, 3, 190, 230, 255);      // a highlight shows it roll

  g_bob = new_graphic(40, 40);
  gfx_fill_rgba(g_bob, 0, 0, 0, 0);
  gfx_circle(g_bob, 20, 20, 19, 70, 70, 80);
  gfx_circle(g_bob, 14, 14, 5, 140, 140, 150);

  g_plank = new_graphic(160, 10);
  gfx_fill(g_plank, 120, 190, 110);
  gfx_rect_outline(g_plank, 0, 0, 160, 10, 60, 110, 60);

  // Drawn facing right, as DIV graphics should be: angle turns it.
  g_paddle = new_graphic(140, 12);
  gfx_fill(g_paddle, 220, 70, 70);
  gfx_rect_outline(g_paddle, 0, 0, 140, 12, 120, 30, 30);

  g_bg = new_graphic(640, 480);
  gfx_fill(g_bg, 24, 30, 44);
  FOR i = 0 TO 23
    gfx_line(g_bg, i * 28, 0, i * 28, 479, 30, 38, 54);
  END
  gfx_rect(g_bg, 0, 450, 640, 30, 60, 66, 80);
  put_screen(0, g_bg);
  RETURN 0;
END

// ---------------------------------------------------------------------
// Bodies
// ---------------------------------------------------------------------

// The floor and the side walls: one static body made of edges.
PROCESS walls();
BEGIN
  x = 0; y = 0;
  phys_edge(0, 450, 640, 450);
  phys_edge(0, 0, 0, 450);
  phys_edge(640, 0, 640, 450);
  LOOP FRAME; END
END

PROCESS crate(x, y, kind);
BEGIN
  graph = g_crate[kind];
  phys_box(16 + kind * 8, 16 + kind * 8, phys_dynamic);
  phys_material(1, 0.6, 0.05);
  LOOP
    IF (y > 600) BREAK; END          // pushed out through the top and fell
    FRAME;
  END
END

PROCESS ball(x, y);
BEGIN
  graph = g_ball;
  phys_circle(9, phys_dynamic);
  phys_material(0.6, 0.3, 0.6);       // light and bouncy
  LOOP
    IF (y > 600) BREAK; END
    FRAME;
  END
END

// A paddle turning at a steady speed: a kinematic body only moves as told.
PROCESS paddle(x, y);
BEGIN
  graph = g_paddle;
  phys_box(140, 12, phys_kinematic);
  phys_spin(60000);                   // 60 degrees a second, counter-clockwise
  LOOP FRAME; END
END

// A heavy ball on a rope from a fixed anchor. phys_rope keeps the distance
// between the two bodies' centres fixed - one stiff joint, which stays
// stable where a long chain of pinned links would stretch under the weight.
// The chain is only drawn, as dots from the anchor to the ball.
PROCESS anchor(x, y);
BEGIN
  phys_circle(3, phys_static);
  LOOP FRAME; END
END

PROCESS wrecking_ball(x, y, hook);
PRIVATE i, n, d;
BEGIN
  graph = g_bob;
  phys_circle(19, phys_dynamic);
  phys_material(8, 0.3, 0.1);
  phys_rope(hook);
  phys_velocity(-520, 0);             // a first swing, into the pyramid
  LOOP
    IF (key_pressed(_w)) phys_velocity(-520, 0); END   // W swings it again
    d = fget_distance(hook.x, hook.y, x, y);
    n = d / 10;
    set_color('#a0a4b4');
    FOR i = 0 TO n - 1
      draw_rect(hook.x + (x - hook.x) * i / (n + 0.001) - 1, hook.y + (y - hook.y) * i / (n + 0.001) - 1, 3, 3);
    END
    FRAME;
  END
END

// A see-saw: a plank pinned to the world at its middle, free to turn.
PROCESS seesaw(x, y);
BEGIN
  graph = g_plank;
  phys_box(160, 10, phys_dynamic);
  phys_material(1, 0.8, 0);
  phys_pin(0, x, y);
  LOOP FRAME; END
END

FUNCTION pyramid(cx, rows);
PRIVATE r, c;
BEGIN
  FOR r = 0 TO rows - 1
    FOR c = 0 TO rows - r - 1
      crate(cx - (rows - r - 1) * 12 + c * 24, 438 - r * 24, 1);
    END
  END
  RETURN 0;
END

// Everything that falls, back to the start.
FUNCTION reset_world();
BEGIN
  signal(TYPE crate, s_kill);
  signal(TYPE ball, s_kill);
  FRAME;
  pyramid(430, 6);
  RETURN 0;
END

// ---------------------------------------------------------------------
// Main
// ---------------------------------------------------------------------
BEGIN
  set_mode(640, 480);
  set_fps(60, 0);
  make_graphics();
  phys_gravity(0, 700);

  walls();
  paddle(170, 330);
  wrecking_ball(590, 400, anchor(590, 60));   // hangs just above the floor
  seesaw(90, 400);
  pyramid(430, 6);

  write(0, 8, 8, 0, "LEFT CLICK crate  RIGHT CLICK ball  P pyramid  R reset  W swing  D shapes");
  write(0, 8, 20, 0, "BODIES");
  write_int(0, 56, 20, 0, OFFSET bodies);
  write(0, 90, 20, 0, "FPS");
  write_int(0, 116, 20, 0, OFFSET fps_now);

  LOOP
    IF (mouse.left AND mouse.y < 440) crate(mouse.x, mouse.y, rand(0, 2)); FRAME(600); END
    IF (mouse.right AND mouse.y < 440) ball(mouse.x, mouse.y); FRAME(600); END
    IF (key_pressed(_p)) pyramid(rand(260, 380), 5); END
    IF (key_pressed(_r)) reset_world(); END
    IF (key_pressed(_d)) set_debug(); END
    bodies = phys_bodies();
    fps_now = get_fps();
    FRAME;
  END
END
