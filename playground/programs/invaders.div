PROGRAM invaders;

// ---------------------------------------------------------------------
// PROCEDURAL INVADERS - Space Invaders where every wave brings three
// brand new alien species. Each species is a random 5x8 grid of bits
// mirrored into a left/right symmetric 10x8 sprite (like the arcade
// originals), scaled up 3x with gfx_rect blocks and given a random
// colour. A second frame shifts the "legs" (bottom rows) outwards, so
// the formation walks as it marches.
// The shields are bitmaps too: one graphic per shield, redrawn from a
// grid of 4x4 cells whenever a shot, bomb or alien eats a hole in it.
// Sound: every effect and tune is made by the engine (sfx, sfx_tone,
// song_*), no files: the classic four-note march that speeds up as the
// formation thins out, the saucer's siren, shots, hits, explosions, a
// chiptune on the title and a quieter one under the battle, jingles for
// a cleared wave and game over. M switches the music on and off.
// ---------------------------------------------------------------------

GLOBAL bits[39];          // one species' half-grid: 8 rows x 5 columns
GLOBAL gA[2];             // walk frame A of the three species
GLOBAL gB[2];             // walk frame B
GLOBAL gX[2];             // explosion graphic in the species' colour
GLOBAL cr[2]; cg[2]; cb[2];
GLOBAL slot[49];          // process id of the alien in each formation slot
GLOBAL shc[351];          // shield cells: 4 shields x 8 rows x 11 columns
GLOBAL gsh[3];            // one graphic per shield

GLOBAL g_bg = 0; g_cannon = 0; g_shot = 0; g_bomb1 = 0; g_bomb2 = 0;
GLOBAL g_ufo = 0; g_boom = 0; g_spark = 0;

GLOBAL state = 0;         // 0 title, 1 playing, 2 wave cleared, 3 game over
GLOBAL score = 0; hiscore = 0; lives = 3; wave = 0;
GLOBAL left = 0;          // aliens still alive
GLOBAL fx = 0; fy = 0;    // formation origin (centre of slot 0)
GLOBAL dir = 1;           // marching direction
GLOBAL anim = 0;          // walk frame shown (0 / 1)
GLOBAL step_t = 0;        // frames to the next march step
GLOBAL speed_base = 34;   // step delay with a full formation
GLOBAL bomb_t = 60; max_bombs = 2; bomb_spd = 3;
GLOBAL nbombs = 0; nshots = 0;
GLOBAL ufo_t = 900; ufo_on = 0;
GLOBAL player_hit = 0; inv = 0; pause_t = 0;

// Sound: ids made once at the start, a private random generator for the
// pitch variations (the game's own rand() sequence stays untouched) and
// the music the game wants now (snd_update starts it when it changes)
GLOBAL sn_shot = 0; sn_kill[2]; sn_crunch = 0; sn_march[3]; sn_mi = 0;
GLOBAL sn_ufo[1]; sn_ufo_boom = 0; sn_chip = 0; sn_clash = 0;
GLOBAL sn_die = 0; sn_die2 = 0; sn_ding = 0; sn_start = 0; sn_spawn = 0;
GLOBAL sn_r = 4711; sn_tick = 0; sn_chip_t = -99; sn_kill_t = -99;
GLOBAL sn_music = 1; sn_want = 0; sn_cur = -1; sn_loop = 1;
GLOBAL song_title = 0; song_battle = 0; song_over = 0;

GLOBAL SY = 364;          // top of the shields
GLOBAL GROUND = 458;      // the ground line
GLOBAL cannon_x = 280;    // where the cannon is (for aimed bombs)

// --- Graphics ---------------------------------------------------------

// Fixed graphics: star field, cannon, shots, bombs, player explosion.
FUNCTION make_static();
PRIVATE i;
BEGIN
  g_bg = new_graphic(560, 480);
  gfx_fill(g_bg, 0, 0, 8);
  FOR i = 0 TO 119
    gfx_pixel(g_bg, rand(0, 559), rand(0, 479), rand(40, 140), rand(40, 140), rand(90, 200));
  END
  g_cannon = new_graphic(26, 16);
  gfx_rect(g_cannon, 0, 8, 26, 8, 60, 230, 90);
  gfx_rect(g_cannon, 2, 6, 22, 2, 60, 230, 90);
  gfx_rect(g_cannon, 10, 2, 6, 4, 60, 230, 90);
  gfx_rect(g_cannon, 12, 0, 2, 2, 160, 255, 170);
  g_shot = new_graphic(2, 10);
  gfx_fill(g_shot, 255, 255, 255);
  // Two zig-zag frames for the alien bombs
  g_bomb1 = new_graphic(6, 12);
  g_bomb2 = new_graphic(6, 12);
  FOR i = 0 TO 5
    gfx_rect(g_bomb1, (i % 2) * 3, i * 2, 3, 2, 255, 230, 120);
    gfx_rect(g_bomb2, 3 - (i % 2) * 3, i * 2, 3, 2, 255, 230, 120);
  END
  g_boom = new_graphic(32, 20);
  FOR i = 0 TO 23
    gfx_rect(g_boom, rand(0, 29), rand(4, 18), 2, 2, 80 + rand(0, 170), 255, 100);
  END
  g_spark = new_graphic(8, 6);
  gfx_rect(g_spark, 0, 2, 8, 2, 255, 120, 80);
  gfx_rect(g_spark, 2, 0, 4, 6, 255, 120, 80);
  FOR i = 0 TO 3
    gsh[i] = new_graphic(44, 32);
  END
  RETURN 0;
END

// Draws the current half-grid bits[] into graphic g, mirrored,
// every bit a 3x3 block. legs = 1 shifts rows 5-7 one column outwards.
FUNCTION draw_species(g, legs, r, gr, b);
PRIVATE row; c; src;
BEGIN
  FOR row = 0 TO 7
    FOR c = 0 TO 4
      src = c;
      IF (legs AND row >= 5)
        src = c + 1;
      END
      IF (src <= 4 AND bits[row * 5 + src])
        gfx_rect(g, c * 3, row * 3, 3, 3, r, gr, b);
        gfx_rect(g, (9 - c) * 3, row * 3, 3, 3, r, gr, b);
      END
    END
  END
  RETURN 0;
END

// Invents alien species t: random bits, colour, two walk frames and
// a matching explosion.
FUNCTION make_species(t);
PRIVATE i; n; dens;
BEGIN
  dens = rand(35, 60);
  REPEAT
    n = 0;
    FOR i = 0 TO 39
      bits[i] = rand(0, 99) < dens;
      IF (i % 5 >= 3 AND rand(0, 99) < 30) bits[i] = 1; END  // denser centre
    END
    bits[14] = 1; bits[19] = 1; bits[13] = 1;             // a spine
    IF (rand(0, 99) < 70) bits[rand(2, 3) * 5 + 3] = 0; END  // eye holes
    FOR i = 0 TO 39 n = n + bits[i]; END
  UNTIL (n >= 16 AND n <= 32)
  // Bright random colour: one channel pushed to full, a different
  // channel for each species so a wave never has three of one colour
  cr[t] = rand(40, 230); cg[t] = rand(40, 230); cb[t] = rand(40, 230);
  n = (t + wave) % 3;
  IF (n == 0) cr[t] = 255; END
  IF (n == 1) cg[t] = 255; END
  IF (n == 2) cb[t] = 255; END
  IF (gA[t]) free_graphic(gA[t]); free_graphic(gB[t]); free_graphic(gX[t]); END
  gA[t] = new_graphic(30, 24);
  gB[t] = new_graphic(30, 24);
  draw_species(gA[t], 0, cr[t], cg[t], cb[t]);
  draw_species(gB[t], 1, cr[t], cg[t], cb[t]);
  // Explosion: symmetric scattered blocks in the same colour
  gX[t] = new_graphic(30, 24);
  FOR i = 0 TO 9
    n = rand(0, 4);
    dens = rand(0, 7);
    gfx_rect(gX[t], n * 3, dens * 3, 2, 2, cr[t], cg[t], cb[t]);
    gfx_rect(gX[t], (9 - n) * 3, dens * 3, 2, 2, cr[t], cg[t], cb[t]);
  END
  RETURN 0;
END

// A new mystery ship: saucer body plus random coloured lights.
FUNCTION make_ufo();
PRIVATE r; gr; b; i;
BEGIN
  IF (g_ufo) free_graphic(g_ufo); END
  g_ufo = new_graphic(36, 16);
  r = rand(150, 255); gr = rand(40, 120); b = rand(100, 255);
  gfx_rect(g_ufo, 12, 0, 12, 4, r, gr, b);
  gfx_rect(g_ufo, 6, 4, 24, 4, r, gr, b);
  gfx_rect(g_ufo, 0, 8, 36, 4, r, gr, b);
  gfx_rect(g_ufo, 6, 12, 6, 4, r, gr, b);
  gfx_rect(g_ufo, 24, 12, 6, 4, r, gr, b);
  FOR i = 0 TO 3
    gfx_rect(g_ufo, 3 + i * 9, 9, 3, 2, rand(150, 255), 255, rand(0, 255));
  END
  RETURN 0;
END

// --- Sound ---------------------------------------------------------------

// A random number for sound variations only (a small LCG of our own).
FUNCTION srnd(a, b);
BEGIN
  sn_r = (sn_r * 1103 + 4271) % 65521;
  RETURN a + sn_r % (b - a + 1);
END

FUNCTION make_sounds();
BEGIN
  sn_shot = sfx_tone(wave_square, 1500, 260, 120, 34);
  sn_kill[0] = sfx(sfx_hit, 3);                // one crunch per row type
  sn_kill[1] = sfx(sfx_hit, 8);
  sn_kill[2] = sfx(sfx_hit, 14);
  sn_crunch = sfx_tone(wave_noise, 5000, 900, 160, 30);
  // The march: four falling bass notes, one per step
  sn_march[0] = sfx_tone(wave_square, 98, 92, 110, 62);
  sn_march[1] = sfx_tone(wave_square, 87, 82, 110, 62);
  sn_march[2] = sfx_tone(wave_square, 78, 73, 110, 62);
  sn_march[3] = sfx_tone(wave_square, 73, 69, 110, 62);
  sn_ufo[0] = sfx_tone(wave_square, 620, 1150, 170, 20);   // the saucer's siren
  sn_ufo[1] = sfx_tone(wave_square, 1150, 620, 170, 20);
  sn_ufo_boom = sfx(sfx_explosion, 21);
  sn_chip = sfx_tone(wave_noise, 1800, 300, 70, 34);
  sn_clash = sfx(sfx_blip, 4);
  sn_die = sfx(sfx_explosion, 7);
  sn_die2 = sfx_tone(wave_saw, 700, 55, 900, 30);
  sn_ding = sfx_tone(wave_triangle, 880, 880, 170, 45);
  sn_start = sfx(sfx_coin, 3);
  sn_spawn = sfx(sfx_powerup, 2);
  RETURN 0;
END

FUNCTION make_songs();
BEGIN
  // Title: an eerie minor theme over a pulsing bass
  song_title = song_new(112);
  song_track(song_title, inst_square,
    "A4 - - - C5 - - - E5 - - - D5 - C5 - | B4 - - - G4 - - - A4 - - - - - . . |" +
    "A4 - - - C5 - - - E5 - - - G5 - F5 - | E5 - - - D5 - B4 - C5 - B4 - A4 - . . ", 34);
  song_track(song_title, inst_bass,
    "A3 . . A3 . . A3 . F3 . . F3 . . F3 . | G3 . . G3 . . G3 . E3 . . E3 . E3 . ", 55);
  song_track(song_title, inst_pad,
    "A4 - - - - - - - - - - - - - - - | F4 - - - - - - - - - - - - - - - |" +
    "G4 - - - - - - - - - - - - - - - | E4 - - - - - - - - - - - - - - - ", 22);
  song_track(song_title, inst_drums, "k . . . h . . . s . . . h . h . ", 34);
  // Battle: soft arpeggios and hi-hats, the march is the heartbeat
  song_battle = song_new(120);
  song_track(song_battle, inst_pluck,
    "A3 C4 E4 A4 E4 C4 A3 C4 E4 A4 E4 C4 A3 C4 E4 C4 | F3 A3 C4 F4 C4 A3 F3 A3 C4 F4 C4 A3 F3 A3 C4 A3 |" +
    "G3 B3 D4 G4 D4 B3 G3 B3 D4 G4 D4 B3 G3 B3 D4 B3 | E3 G#3 B3 E4 B3 G#3 E3 G#3 B3 E4 B3 G#3 E3 G#3 B3 G#3 ", 20);
  song_track(song_battle, inst_pad,
    "A4 - - - - - - - - - - - - - - - | F4 - - - - - - - - - - - - - - - |" +
    "G4 - - - - - - - - - - - - - - - | E4 - - - - - - - - - - - - - - - ", 14);
  song_track(song_battle, inst_drums, "h . . h . . h . h . . h . . h h ", 16);
  // Game over: a falling phrase, played once
  song_over = song_new(96);
  song_track(song_over, inst_square,
    "E5 - D5 - C5 - B4 - A4 - - - G#4 - - - A4 - - - - - - - . . . . ", 40);
  song_track(song_over, inst_bass,
    "A3 - - - - - - - F3 - - - E3 - - - A2 - - - - - - - . . . . ", 60);
  song_track(song_over, inst_drums, "k . . . . . . . k . . . s . . . k . . . . . . . ", 40);
  music_volume(40);
  RETURN 0;
END

// Called once a frame by the main loops: M toggles the music, and the
// song the game wants is started when it changes (a jingle, loop 0,
// plays even with the music off).
FUNCTION snd_update();
BEGIN
  sn_tick = sn_tick + 1;
  IF (key_pressed(_m)) sn_music = 1 - sn_music; sn_cur = -1; END
  IF (sn_want != sn_cur)
    IF (sn_want AND (sn_music OR sn_loop == 0)) song_play(sn_want, sn_loop); ELSE song_stop(); END
    sn_cur = sn_want;
  END
  RETURN 0;
END

FUNCTION want_song(sng, lp);
BEGIN
  sn_want = sng; sn_loop = lp;
  RETURN 0;
END

// Pan for a screen x: -70 at the left edge, 70 at the right.
FUNCTION sn_pan(px);
BEGIN
  RETURN clamp((px - 280) / 4, -70, 70);
END

// A little tune of up to four notes of sound snd (pitches in percent,
// 0 = none), gap frames apart.
PROCESS sn_arp(snd, vol, gap, a, b, c, d);
PRIVATE k; p;
BEGIN
  FOR k = 0 TO 3
    p = a;
    IF (k == 1) p = b; END
    IF (k == 2) p = c; END
    IF (k == 3) p = d; END
    IF (p > 0) play_sound(snd, vol, p, 0); END
    FRAME(gap * 100);
  END
END

// --- Shields ------------------------------------------------------------

// Redraws shield k from its cells.
FUNCTION draw_shield(k);
PRIVATE i;
BEGIN
  gfx_fill_rgba(gsh[k], 0, 0, 0, 0);
  FOR i = 0 TO 87
    IF (shc[k * 88 + i])
      gfx_rect(gsh[k], (i % 11) * 4, (i / 11) * 4, 4, 4, 70, 220, 90);
    END
  END
  RETURN 0;
END

// Rebuilds the classic bunker shape in all four shields.
FUNCTION reset_shields();
PRIVATE k; r; c; v;
BEGIN
  FOR k = 0 TO 3
    FOR r = 0 TO 7
      FOR c = 0 TO 10
        v = 1;
        IF (r == 0 AND (c <= 1 OR c >= 9)) v = 0; END
        IF (r == 1 AND (c == 0 OR c == 10)) v = 0; END
        IF (r >= 6 AND c >= 3 AND c <= 7) v = 0; END
        IF (r == 5 AND c >= 4 AND c <= 6) v = 0; END
        shc[k * 88 + r * 11 + c] = v;
      END
    END
    draw_shield(k);
  END
  RETURN 0;
END

// Clears shield cell (k, r, c) if it is inside the grid.
FUNCTION chip(k, r, c);
BEGIN
  IF (r >= 0 AND r <= 7 AND c >= 0 AND c <= 10)
    shc[k * 88 + r * 11 + c] = 0;
  END
  RETURN 0;
END

// A shot or bomb tip at (px, py): if it touches a live cell, blow a
// ragged hole around it and return 1.
FUNCTION shield_point(px, py);
PRIVATE k; r; c; i;
BEGIN
  IF (py < SY OR py >= SY + 32) RETURN 0; END
  IF (px < 90) RETURN 0; END
  k = (px - 90) / 112;               // shields start at x = 90, 202, 314, 426
  IF (k > 3) RETURN 0; END
  c = (px - 90 - k * 112) / 4;
  IF (c > 10) RETURN 0; END
  r = (py - SY) / 4;
  IF (shc[k * 88 + r * 11 + c] == 0) RETURN 0; END
  chip(k, r, c);
  FOR i = 0 TO 3
    chip(k, r + rand(-1, 1), c + rand(-1, 1));
  END
  draw_shield(k);
  RETURN 1;
END

// An alien marching through the shields eats every cell under it.
FUNCTION shield_eat(ax, ay);
PRIVATE k; r; c; hit;
BEGIN
  FOR k = 0 TO 3
    IF (ax + 15 > 90 + k * 112 AND ax - 15 < 134 + k * 112)
      hit = 0;
      FOR r = 0 TO 7
        IF (SY + r * 4 + 4 > ay - 12 AND SY + r * 4 < ay + 12)
          FOR c = 0 TO 10
            IF (90 + k * 112 + c * 4 + 4 > ax - 15 AND 90 + k * 112 + c * 4 < ax + 15)
              IF (shc[k * 88 + r * 11 + c]) shc[k * 88 + r * 11 + c] = 0; hit = 1; END
            END
          END
        END
      END
      IF (hit) draw_shield(k); END
    END
  END
  RETURN 0;
END

// A shot or bomb eating into a shield (or the ground): quiet, at most one
// every few frames.
FUNCTION chip_sound(px);
BEGIN
  IF (sn_tick - sn_chip_t < 4) RETURN 0; END
  sn_chip_t = sn_tick;
  play_sound(sn_chip, 40, srnd(80, 120), sn_pan(px));
  RETURN 1;
END

// --- Processes ------------------------------------------------------------

PROCESS shield(k);
BEGIN
  x = 112 + k * 112; y = SY + 16; graph = gsh[k];
  LOOP FRAME; END
END

// Short-lived fading graphic (explosions).
PROCESS burst(bx, by, g, life);
PRIVATE t;
BEGIN
  x = bx; y = by; graph = g; t = life;
  WHILE (t > 0)
    alpha = t * 100 / life;
    t = t - 1;
    FRAME;
  END
END

// Floating score text (mystery ship).
PROCESS popup(bx, by, v);
PRIVATE t = 70;
BEGIN
  WHILE (t > 0)
    set_color('#f6f');
    text(bx - 9, by - 4, v);
    t = t - 1;
    FRAME;
  END
END

// One alien of the formation. It never moves by itself: its place is
// the formation origin plus its slot, its frame the global walk frame.
PROCESS alien(i, t);
BEGIN
  LOOP
    x = fx + (i % 10) * 40;
    y = fy + (i / 10) * 30;
    IF (anim) graph = gB[t]; ELSE graph = gA[t]; END
    IF (y + 12 > SY AND y - 12 < SY + 32) shield_eat(x, y); END
    FRAME;
  END
END

// Removes the alien with process id a, scoring by its row.
FUNCTION kill_alien(a);
PRIVATE i; t; show_title = 1;
BEGIN
  FOR i = 0 TO 49
    IF (slot[i] == a)
      slot[i] = 0;
      left = left - 1;
      t = 2;
      IF (i < 30) t = 1; END
      IF (i < 10) t = 0; END
      score = score + (3 - t) * 10;
      burst(fx + (i % 10) * 40, fy + (i / 10) * 30, gX[t], 18);
      IF (sn_tick - sn_kill_t >= 2)                 // two in one frame sound as one
        sn_kill_t = sn_tick;
        play_sound(sn_kill[t], 70, 90 + t * 12 + srnd(-6, 6), sn_pan(fx + (i % 10) * 40));
        play_sound(sn_crunch, 30, srnd(85, 115), sn_pan(fx + (i % 10) * 40));
      END
      signal(a, s_kill);
      RETURN 1;
    END
  END
  RETURN 0;
END

PROCESS shot(bx, by);
PRIVATE a;
BEGIN
  x = bx; y = by; graph = g_shot;
  nshots = nshots + 1;
  LOOP
    y = y - 8;
    IF (y < 26) burst(x, 30, g_spark, 10); BREAK; END
    IF (shield_point(x, y - 5)) chip_sound(x); BREAK; END
    a = collision(TYPE alien);
    IF (a) kill_alien(a); BREAK; END
    a = collision(TYPE ufo);
    IF (a)
      ufo_on = 0;
      a = 50 * rand(1, 6);
      score = score + a;
      burst(x, y, g_boom, 24);
      popup(x, y, a);
      play_sound(sn_ufo_boom, 90, 90, sn_pan(x));
      sn_arp(sn_ding, 40, 5, 150, 189, 225, 300);
      signal(TYPE ufo, s_kill);
      BREAK;
    END
    a = collision(TYPE bomb);
    IF (a) a.y = 999; burst(x, y, g_spark, 10); play_sound(sn_clash, 45, srnd(90, 115), sn_pan(x)); BREAK; END  // shot meets bomb
    FRAME;
  END
  nshots = nshots - 1;
END

PROCESS bomb(bx, by);
PRIVATE t;
BEGIN
  x = bx; y = by; graph = g_bomb1;
  nbombs = nbombs + 1;
  LOOP
    y = y + bomb_spd;
    t = t + 1;
    IF (t % 12 < 6) graph = g_bomb1; ELSE graph = g_bomb2; END
    IF (y > 900) BREAK; END                     // removed by a shot
    IF (y > GROUND - 6) burst(x, GROUND - 3, g_spark, 12); chip_sound(x); BREAK; END
    IF (shield_point(x, y + 6)) chip_sound(x); BREAK; END
    IF (inv == 0 AND player_hit == 0 AND collision(TYPE cannon))
      player_hit = 1;
      BREAK;
    END
    FRAME;
  END
  nbombs = nbombs - 1;
END

PROCESS cannon();
PRIVATE cool;
BEGIN
  x = 280; y = 440; graph = g_cannon;
  LOOP
    IF (player_hit) BREAK; END
    IF (key(_left) OR key(_a))  x = x - 3; END
    IF (key(_right) OR key(_d)) x = x + 3; END
    x = clamp(x, 16, 544);
    cannon_x = x;
    cool = cool - 1;
    IF (key(_space) AND cool <= 0 AND nshots < 2)
      shot(x, y - 12);
      play_sound(sn_shot, 55, srnd(92, 110), sn_pan(x));
      cool = 14;
    END
    // blink while invulnerable after a respawn
    IF (inv > 0 AND (inv / 6) % 2) alpha = 30; ELSE alpha = 100; END
    FRAME;
  END
  burst(x, y - 2, g_boom, 60);
  play_sound(sn_die, 100, 75, sn_pan(x));
  play_sound(sn_die2, 60, 100, sn_pan(x));
END

PROCESS ufo(d);
PRIVATE t;
BEGIN
  graph = g_ufo; y = 44;
  IF (d > 0) x = -20; ELSE x = 580; END
  ufo_on = 1;
  LOOP
    x = x + d * 2;
    IF (t % 9 == 0) play_sound(sn_ufo[(t / 9) % 2], 45, 100, sn_pan(x)); END  // the siren loop
    t = t + 1;
    IF (x < -30 OR x > 590) BREAK; END
    FRAME;
  END
  ufo_on = 0;
END

// Title screen display of one species with its points.
PROCESS showcase(t, bx, by);
BEGIN
  x = bx; y = by;
  LOOP
    IF (t == 3) graph = g_ufo;
    ELSE
      IF (anim) graph = gB[t]; ELSE graph = gA[t]; END
    END
    FRAME;
  END
END

// --- Game flow -------------------------------------------------------------

// Clears the field and sets up the next wave with new species.
FUNCTION start_wave();
PRIVATE i; t; show_title = 1;
BEGIN
  signal(TYPE alien, s_kill);
  signal(TYPE bomb, s_kill);
  signal(TYPE shot, s_kill);
  signal(TYPE ufo, s_kill);
  nbombs = 0; nshots = 0; ufo_on = 0;
  wave = wave + 1;
  FOR t = 0 TO 2 make_species(t); END
  make_ufo();
  reset_shields();
  fx = 100;
  fy = 86 + clamp(wave - 1, 0, 6) * 10;
  dir = 1; anim = 0; step_t = 30;
  speed_base = clamp(32 - (wave - 1) * 4, 8, 32);
  max_bombs = clamp(1 + wave, 2, 6);
  bomb_spd = clamp(2 + wave / 2, 3, 6);
  ufo_t = rand(600, 1200);
  FOR i = 0 TO 49
    t = 2;
    IF (i < 30) t = 1; END
    IF (i < 10) t = 0; END
    slot[i] = alien(i, t);
  END
  left = 50;
  RETURN 0;
END

// One march step: sideways, or down and reverse at the screen edge.
FUNCTION march();
PRIVATE i; lc = 9; rc = 0; low = 0; c; hs = 6;
BEGIN
  FOR i = 0 TO 49
    IF (slot[i])
      c = i % 10;
      IF (c < lc) lc = c; END
      IF (c > rc) rc = c; END
      IF (i / 10 > low) low = i / 10; END
    END
  END
  IF (left <= 4) hs = 9; END
  IF ((dir > 0 AND fx + rc * 40 + 15 + hs > 552) OR (dir < 0 AND fx + lc * 40 - 15 - hs < 8))
    dir = -dir;
    fy = fy + 12;
  ELSE
    fx = fx + dir * hs;
  END
  anim = 1 - anim;
  step_t = 1 + left * speed_base / 50;
  // Landing: the formation reached the cannon's row
  IF (fy + low * 30 + 12 >= 430) RETURN 1; END
  RETURN 0;
END

// Picks a shooter: usually a random column, sometimes the one above
// the cannon; the lowest alien in that column drops the bomb.
FUNCTION drop_bomb();
PRIVATE c; r; n;
BEGIN
  IF (rand(0, 2) == 0)
    c = clamp((cannon_x - fx + 20) / 40, 0, 9);
  ELSE
    c = rand(0, 9);
  END
  FOR n = 0 TO 9
    r = 4;
    WHILE (r >= 0)
      IF (slot[r * 10 + c])
        bomb(fx + c * 40 + rand(-10, 10), fy + r * 30 + 14);  // from anywhere under it
        RETURN 1;
      END
      r = r - 1;
    END
    c = (c + 1) % 10;
  END
  RETURN 0;
END

PRIVATE i; t; show_title = 1;
BEGIN
  set_mode(560, 480);
  set_fps(60, 0);
  make_static();
  make_sounds();
  make_songs();
  put_screen(0, g_bg);
  hiscore = 0;
  LOOP
    // ---- Title (first game only): show off freshly generated species ----
    let_me_alone();
    IF (show_title)
      FOR i = 0 TO 2 make_species(i); showcase(i, 244, 190 + i * 40); END
      make_ufo();
      showcase(3, 244, 310);
      state = 0;
      t = 0;
      want_song(song_title, 1);
      REPEAT
        t = t + 1;
        IF (t % 40 == 0) anim = 1 - anim; END
        set_color('#fff');
        text(223, 90, "PROCEDURAL INVADERS");
        set_color('#8af');
        text(181, 120, "every wave: new aliens, generated");
        set_color('#ccc');
        text(272, 186, "= 30 POINTS");
        text(272, 226, "= 20 POINTS");
        text(272, 266, "= 10 POINTS");
        text(272, 306, "= ? MYSTERY");
        set_color('#ff8');
        text(175, 360, "LEFT/RIGHT or A/D move   SPACE fire");
        IF ((t / 30) % 3) text(220, 390, "PRESS SPACE TO START"); END
        set_color('#aaa');
        text(8, 6, "HI " + hiscore);
        set_color('#888');
        IF (sn_music) text(222, 420, "M  music on/off (on)"); ELSE text(222, 420, "M  music on/off (off)"); END
        snd_update();
        FRAME;
      UNTIL (key_pressed(_space) OR key_pressed(_enter))
      play_sound(sn_start, 70, 100, 0);
      let_me_alone();
      show_title = 0;        // later games restart straight from GAME OVER
    END

    // ---- New game ----
    score = 0; lives = 3; wave = 0;
    player_hit = 0; inv = 0;
    FOR i = 0 TO 3 shield(i); END
    start_wave();
    cannon();
    state = 1;
    pause_t = 0;
    want_song(song_battle, 1);
    WHILE (state != 3)
      IF (inv > 0) inv = inv - 1; END
      IF (state == 1 AND player_hit == 0)
        step_t = step_t - 1;
        IF (step_t <= 0)
          IF (march()) lives = 0; player_hit = 1; END
          // the march: louder as the formation comes down
          play_sound(sn_march[sn_mi], 60 + clamp((fy - 86) / 6, 0, 30), 100, 0);
          sn_mi = (sn_mi + 1) % 4;
        END
        bomb_t = bomb_t - 1;
        IF (bomb_t <= 0)
          IF (nbombs < max_bombs) drop_bomb(); END
          bomb_t = clamp(rand(20, 70) - wave * 4, 8, 70);
        END
        ufo_t = ufo_t - 1;
        IF (ufo_t <= 0)
          IF (ufo_on == 0 AND left >= 8) ufo(rand(0, 1) * 2 - 1); END
          ufo_t = rand(900, 1500);
        END
        IF (left <= 0)
          state = 2; pause_t = 120;
          sn_arp(sn_ding, 50, 7, 100, 126, 150, 200);   // wave cleared
        END
      END
      // Cannon destroyed: pause, then respawn or game over
      IF (player_hit AND state == 1)
        IF (pause_t == 0)
          pause_t = 100;
          IF (lives > 0) lives = lives - 1; END
        END
        pause_t = pause_t - 1;
        IF (pause_t <= 0)
          pause_t = 0;
          IF (lives <= 0)
            state = 3;
            want_song(song_over, 0);
          ELSE
            signal(TYPE bomb, s_kill); nbombs = 0;
            player_hit = 0; inv = 90;
            cannon();
            play_sound(sn_spawn, 45, 100, 0);
          END
        END
      END
      // Wave cleared: short break, then a new generation of aliens
      IF (state == 2)
        set_color('#8f8');
        text(238, 290, "WAVE " + wave + " CLEARED");
        pause_t = pause_t - 1;
        IF (pause_t <= 0) pause_t = 0; start_wave(); state = 1; sn_mi = 0; END
      END
      IF (score > hiscore) hiscore = score; END
      // HUD
      set_color('#fff');
      text(8, 6, "SCORE " + score);
      text(236, 6, "HI " + hiscore);
      text(480, 6, "WAVE " + wave);
      draw_rect(0, GROUND, 560, 2, '#3c5');
      FOR i = 1 TO lives - 1
        draw_rect(10 + (i - 1) * 34, 466, 26, 8, '#3e5');
      END
      set_color('#3e5');
      text(90, 466, "LIVES " + lives);
      snd_update();
      FRAME;
    END

    // ---- Game over: wait for a key to restart ----
    t = 0;
    REPEAT
      t = t + 1;
      draw_rect(170, 270, 220, 64, '#101830');
      set_color('#f66');
      text(253, 282, "GAME OVER");
      draw_rect(0, GROUND, 560, 2, '#3c5');
      set_color('#fff');
      text(8, 6, "SCORE " + score);
      text(236, 6, "HI " + hiscore);
      text(480, 6, "WAVE " + wave);
      IF (t > 60 AND (t / 30) % 2)
        set_color('#ff8');
        text(214, 312, "PRESS SPACE TO RESTART");
      END
      snd_update();
      FRAME;
    UNTIL (t > 60 AND (key_pressed(_space) OR key_pressed(_enter)))
  END
END
