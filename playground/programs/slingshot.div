PROGRAM slingshot;

// SLINGSHOT - an Angry Birds style physics game. Every body is simulated
// by the engine's rigid-body physics (phys_*): a process calls phys_box or
// phys_circle once and from then on the world moves it.
//
// Every level is generated from its number (rand_seed): a terrain of
// hills and stone platforms made of static edges, and on it towers,
// forts and pyramids built from wood (light, weak), stone (heavy,
// strong) and ice (brittle) with pigs on and inside them. After building,
// the world runs for a moment with damage and birds disabled; if any
// block moved more than a couple of pixels the layout is thrown away and
// built again from the next seed, so levels always start standing still.
//
// Blocks and pigs read phys_impact() - how hard they were hit in the last
// step - and lose health above a per-material threshold: cracks show,
// then they break into debris. Birds: RED plain, BLUE splits into three
// on click, YELLOW speeds up on click, BLACK is heavy and dives on click.
// The world is wider than the screen: a scroll window follows the bird
// and a sky plane behind it moves slower (parallax).
//
// Sound is made by the engine (sfx, sfx_tone, song_*: no files): the
// band creaks as it stretches, a whoosh and a call for every launch,
// each bird's power, wood, stone and ice knocks as loud as the impact
// (phys_impact) and their own sound when they break, grunting and
// popping pigs, stars and a fanfare for a clear level; a tune for the
// menus and a calmer one while playing. It starts with the first click.

GLOBAL
  SW = 800; SH = 480;          // screen
  WW = 1400;                   // world width (the scroll graphic)
  SLX = 170; SLY = 310;        // the slingshot's pouch at rest
  PULL = 95;                   // longest pull, px
  KPULL = 10.0;                // launch speed per pixel of pull
  GRAV = 600;                  // gravity, px/s^2
  DT = 0.0166666667;           // one physics step (1/60 s); '/ 60.0' would be integer division

  // ---- terrain: a polyline of points, flat "sites" to build on
  np = 0; tx[39]; ty[39];
  ns = 0; site_a[3]; site_b[3]; site_y[3];
  nplat = 0; plat_a[3]; plat_b[3]; plat_y[3];

  // ---- block shapes (drawn lying down; pillars are rotated 90000)
  shp_w[4]; shp_h[4];
  bird_r[3];

  // ---- game state
  state = 0;            // 0 title, 1 level select, 2 building, 3 playing, 4 won, 5 lost
  level = 1; unlocked = 1; best[99];
  score = 0; stars_got = 0; star2 = 0; star3 = 0;
  armed = 0;            // 1 = impacts do damage (off while a level settles)
  frame_no = 0; last_motion = 0;
  pigs_alive = 0; n_blocks = 0; blocks_broken = 0; pigs_popped = 0;
  nbirds = 0; bird_kind[4]; load_idx = 0;
  phase = 0;            // 0 bird loading/aiming, 1 bird flying, 2 waiting for calm
  fly_x = 0; wait_t = 0; btn_hit = 0; n_debris = 0; hint = 1;
  cam_x = 0.0; cam_t = 0; cam_ix = 0; pan = 0;

  // ---- measurements read by the tests
  check_now = 0; settle_max = 0.0; settle_ang = 0; settle_v = 0; attempts = 0;
  max_imp = 0; hits = 0; bodies = 0; fps_now = 0; shots = 0; abilities = 0;
  pv_n = 0; pv_x[29]; pv_y[29];     // trajectory preview at release (every 4th step)
  fl_n = 0; fl_x[299]; fl_y[299];   // the flight that followed, one point per frame

  // ---- graphics
  g_world = 0; g_sky = 0; g_blk[44]; g_pig[3]; g_bird[3]; g_sling = 0;
  g_chip[2]; g_puff = 0; g_star = 0; g_star0 = 0; g_panel = 0;
  g_title = 0; g_clear = 0; g_fail = 0; g_select = 0; g_btn[4]; g_lv[11];

  // ---- sound (made by the engine) and music
  s_click = 0; s_hop = 0; s_creak = 0; s_whoosh = 0; s_call[3]; s_split = 0;
  s_zoom = 0; s_dive = 0; s_thud = 0; s_knock[2]; s_break[2]; s_crumble = 0;
  s_oink = 0; s_pop = 0; s_squeal = 0; s_star = 0; s_clear = 0; s_fail = 0;
  s_laugh = 0; s_bonus = 0;
  song_menu = 0; song_level = 0; song_win = 0; song_now = 0;
  snd_rnd = 5; snd_f = 0; snd_n = 0;   // hit sounds this frame (at most 3)

// =====================================================================
// Graphics, all drawn in code
// =====================================================================

// One block: wood grain along the length, stone speckles, translucent
// ice with glints; stage 1 and 2 add cracks.
FUNCTION block_graphic(w, h, mat, stage);
PRIVATE g, i, k, px, py, qx, qy, c;
BEGIN
  g = new_graphic(w, h);
  SWITCH (mat)
    CASE 0
      gfx_fill(g, 176, 122, 62);
      FOR i = 1 TO h / 3
        c = rand(0, 20);
        px = 0; py = i * 3 + rand(-1, 1);
        WHILE (px < w)
          qx = px + rand(6, 14); qy = py + rand(-1, 1);
          gfx_line(g, px, py, qx, qy, 140 - c, 94 - c, 44);
          px = qx; py = qy;
        END
      END
      IF (w > 40) gfx_circle(g, rand(10, w - 10), h / 2, 2, 120, 76, 36); END
      gfx_rect_outline(g, 0, 0, w, h, 96, 60, 28);
    CASE 1
      gfx_fill(g, 146, 148, 156);
      FOR i = 0 TO w * h / 40
        c = rand(-30, 30);
        gfx_pixel(g, rand(1, w - 2), rand(1, h - 2), 146 + c, 148 + c, 156 + c);
      END
      gfx_line(g, 1, 1, w - 2, 1, 196, 198, 206);
      gfx_line(g, 1, 1, 1, h - 2, 186, 188, 196);
      gfx_rect_outline(g, 0, 0, w, h, 84, 86, 94);
    CASE 2
      gfx_fill_rgba(g, 170, 225, 250, 78);
      FOR i = 0 TO w / 18
        px = rand(0, w - 8);
        gfx_line(g, px, h - 2, px + 6, 1, 240, 252, 255);
      END
      gfx_rect_outline(g, 0, 0, w, h, 110, 180, 225);
  END
  // cracks: zigzags from the middle towards the edges, more when hurt
  FOR k = 1 TO stage * 2
    px = w / 2 + rand(-w / 4, w / 4); py = h / 2;
    FOR i = 0 TO 3
      qx = px + rand(-8, 8); qy = py + rand(-h / 3, h / 3);
      IF (mat == 2) gfx_line(g, px, py, qx, qy, 255, 255, 255);
      ELSE gfx_line(g, px, py, qx, qy, 50, 34, 20); END
      px = qx; py = qy;
    END
  END
  RETURN g;
END

// A round bird facing right: body, belly, eyes, angry brows, beak, tail.
FUNCTION bird_graphic(r, cr, cg, cb, kind);
PRIVATE g, c, i;
BEGIN
  c = r + 5;
  g = new_graphic(c * 2, c * 2);
  gfx_line(g, 0, c - 4, c, c, 30, 30, 30);          // tail feathers
  gfx_line(g, 1, c + 2, c, c, 30, 30, 30);
  IF (kind == 3)                                      // a fuse and a spark
    gfx_line(g, c, c - r, c + 2, 1, 120, 100, 80);
    gfx_circle(g, c + 2, 2, 2, 255, 190, 40);
  END
  IF (kind == 2)                                      // a crest
    gfx_line(g, c - 2, c - r, c - 6, 0, 200, 150, 20);
    gfx_line(g, c, c - r, c - 1, 0, 200, 150, 20);
  END
  gfx_circle(g, c, c, r, cr / 2, cg / 2, cb / 2);
  gfx_circle(g, c, c, r - 1, cr, cg, cb);
  gfx_circle(g, c - 1, c + r * 0.45, r * 0.5, 240, 220, 190);
  gfx_circle(g, c + r * 0.15, c - r * 0.2, r * 0.27, 255, 255, 255);
  gfx_circle(g, c + r * 0.62, c - r * 0.2, r * 0.25, 255, 255, 255);
  gfx_circle(g, c + r * 0.25, c - r * 0.18, r * 0.11 + 0.5, 0, 0, 0);
  gfx_circle(g, c + r * 0.7, c - r * 0.18, r * 0.11 + 0.5, 0, 0, 0);
  gfx_line(g, c - r * 0.15, c - r * 0.6, c + r * 0.85, c - r * 0.38, 20, 20, 20);
  gfx_line(g, c - r * 0.15, c - r * 0.52, c + r * 0.85, c - r * 0.3, 20, 20, 20);
  FOR i = 0 TO 6                                      // beak: a filled triangle
    gfx_line(g, c + r + 3, c + r * 0.15, c + r * 0.55, c + i * r * 0.06, 250, 170, 30);
  END
  RETURN g;
END

// A green pig: ears, snout with nostrils, eyes (a black eye when hurt).
FUNCTION pig_graphic(r, hurt);
PRIVATE g, c;
BEGIN
  c = r + 2;
  g = new_graphic(c * 2, c * 2);
  gfx_circle(g, c - r * 0.55, c - r * 0.8, r * 0.28, 60, 130, 40);
  gfx_circle(g, c + r * 0.55, c - r * 0.8, r * 0.28, 60, 130, 40);
  gfx_circle(g, c, c, r, 50, 120, 30);
  gfx_circle(g, c, c, r - 1, 120, 205, 70);
  gfx_circle(g, c - r * 0.35, c - r * 0.35, r * 0.25, 150, 225, 100);
  gfx_circle(g, c, c + r * 0.2, r * 0.36, 90, 170, 60);
  gfx_circle(g, c, c + r * 0.2, r * 0.32, 160, 230, 110);
  gfx_circle(g, c - r * 0.13, c + r * 0.2, r * 0.08 + 0.5, 40, 90, 30);
  gfx_circle(g, c + r * 0.13, c + r * 0.2, r * 0.08 + 0.5, 40, 90, 30);
  IF (hurt) gfx_circle(g, c - r * 0.45, c - r * 0.3, r * 0.34, 70, 50, 90); END
  gfx_circle(g, c - r * 0.45, c - r * 0.3, r * 0.22, 255, 255, 255);
  gfx_circle(g, c + r * 0.45, c - r * 0.3, r * 0.22, 255, 255, 255);
  gfx_circle(g, c - r * 0.42, c - r * 0.28, r * 0.09 + 0.5, 0, 0, 0);
  gfx_circle(g, c + r * 0.48, c - r * 0.28, r * 0.09 + 0.5, 0, 0, 0);
  IF (hurt) gfx_line(g, c - r * 0.2, c + r * 0.62, c + r * 0.3, c + r * 0.55, 40, 80, 30); END
  RETURN g;
END

// A five-pointed star, filled by lines from the centre to its outline.
FUNCTION star_graphic(sz, cr, cg, cb);
PRIVATE g, c, i, j, a, r1, r2, px, py, qx, qy;
BEGIN
  g = new_graphic(sz, sz);
  c = sz / 2; r1 = c - 1; r2 = c * 0.42;
  FOR i = 0 TO 9
    a = 90000 + i * 36000;
    IF (i % 2 == 0) px = c + get_distx(a, r1); py = c + get_disty(a, r1);
      qx = c + get_distx(a + 36000, r2); qy = c + get_disty(a + 36000, r2);
    ELSE px = c + get_distx(a, r2); py = c + get_disty(a, r2);
      qx = c + get_distx(a + 36000, r1); qy = c + get_disty(a + 36000, r1);
    END
    FOR j = 0 TO 10
      gfx_line(g, c, c, px + (qx - px) * j * 0.1, py + (qy - py) * j * 0.1, cr, cg, cb);
    END
    gfx_line(g, px, py, qx, qy, cr * 0.6, cg * 0.6, cb * 0.6);
  END
  RETURN g;
END

// Number of decimal digits (to centre numbers drawn as text).
FUNCTION digits(v);
PRIVATE n;
BEGIN
  n = 1;
  WHILE (v >= 10) v = v / 10; n++; END
  RETURN n;
END

FUNCTION big_text(w, h, s, cr, cg, cb, sz);
PRIVATE g;
BEGIN
  g = new_graphic(w, h);
  gfx_text(g, 3, 3, s, 0, 0, 0, sz);                  // shadow
  gfx_text(g, 0, 0, s, cr, cg, cb, sz);
  RETURN g;
END

FUNCTION button_graphic(w, s, n);
PRIVATE g;
BEGIN
  g = new_graphic(w, 34);
  gfx_fill(g, 60, 150, 60);
  gfx_rect(g, 0, 20, w, 14, 40, 120, 40);
  gfx_rect_outline(g, 0, 0, w, 34, 20, 60, 20);
  gfx_text(g, (w - n * 11) / 2, 8, s, 255, 255, 255, 18);
  RETURN g;
END

// The sky plane behind the world: a gradient, far hills and clouds. It
// is tiled, so the hills repeat seamlessly every 800 pixels.
FUNCTION make_sky();
PRIVATE i, h;
BEGIN
  g_sky = new_graphic(800, 480);
  FOR i = 0 TO 479                      // 1-pixel rects: lines would blend
    gfx_rect(g_sky, 0, i, 800, 1, 110 + i / 6, 170 + i / 8, 235);
  END
  FRAME;
  FOR i = 0 TO 799
    h = 150 + sin(i * 450) * 30 + sin(i * 1350 + 40000) * 14;
    gfx_rect(g_sky, i, 480 - h, 1, h, 150, 200, 190);
    h = 90 + sin(i * 900 + 10000) * 20;
    gfx_rect(g_sky, i, 480 - h, 1, h, 120, 180, 150);
  END
  FOR i = 0 TO 5
    h = 60 + (i * 53) % 110;
    gfx_circle(g_sky, 70 + i * 130, h, 22, 250, 252, 255);
    gfx_circle(g_sky, 95 + i * 130, h - 10, 26, 250, 252, 255);
    gfx_circle(g_sky, 122 + i * 130, h, 20, 250, 252, 255);
  END
  RETURN 0;
END

FUNCTION make_graphics();
PRIVATE s, m, k;
BEGIN
  shp_w[0] = 56; shp_w[1] = 84; shp_w[2] = 112; shp_w[3] = 140; shp_w[4] = 28;
  shp_h[0] = 14; shp_h[1] = 14; shp_h[2] = 14; shp_h[3] = 14; shp_h[4] = 28;
  bird_r[0] = 11; bird_r[1] = 8; bird_r[2] = 11; bird_r[3] = 15;
  FOR s = 0 TO 4
    FOR m = 0 TO 2
      FOR k = 0 TO 2
        g_blk[(s * 3 + m) * 3 + k] = block_graphic(shp_w[s], shp_h[s], m, k);
      END
    END
    FRAME;                              // spread the drawing over frames
  END
  g_bird[0] = bird_graphic(11, 215, 40, 40, 0);
  g_bird[1] = bird_graphic(8, 80, 150, 235, 1);
  g_bird[2] = bird_graphic(11, 250, 215, 50, 2);
  g_bird[3] = bird_graphic(15, 50, 50, 58, 3);
  g_pig[0] = pig_graphic(12, 0); g_pig[1] = pig_graphic(12, 1);
  g_pig[2] = pig_graphic(16, 0); g_pig[3] = pig_graphic(16, 1);

  // the slingshot: a trunk and two arms
  g_sling = new_graphic(44, 110);
  gfx_rect(g_sling, 17, 50, 10, 60, 120, 76, 36);
  FOR k = -4 TO 4
    gfx_line(g_sling, 22 + k, 58, 8 + k, 4, 130, 84, 40);
    gfx_line(g_sling, 22 + k, 58, 36 + k, 4, 130, 84, 40);
  END
  gfx_rect(g_sling, 17, 50, 3, 60, 90, 56, 26);

  // debris chips, one per material, and a smoke puff
  g_chip[0] = new_graphic(7, 4); gfx_fill(g_chip[0], 150, 100, 50);
  g_chip[1] = new_graphic(6, 6); gfx_fill(g_chip[1], 130, 132, 140);
  g_chip[2] = new_graphic(6, 5); gfx_fill(g_chip[2], 200, 240, 255);
  g_puff = new_graphic(24, 24);
  FOR k = 0 TO 5
    gfx_circle(g_puff, 12, 12, 11 - k * 2, 220 + k * 7, 225 + k * 6, 230 + k * 5);
  END
  FRAME;
  g_star = star_graphic(56, 255, 210, 40);
  g_star0 = star_graphic(56, 70, 70, 90);
  g_panel = new_graphic(400, 260);
  gfx_fill_rgba(g_panel, 20, 26, 44, 86);
  gfx_rect_outline(g_panel, 0, 0, 400, 260, 250, 210, 80);
  gfx_rect_outline(g_panel, 3, 3, 394, 254, 120, 100, 50);
  g_title = big_text(400, 70, "SLINGSHOT", 255, 90, 60, 64);
  g_clear = big_text(340, 50, "LEVEL CLEAR!", 255, 220, 60, 44);
  g_fail = big_text(340, 50, "LEVEL FAILED", 255, 110, 90, 44);
  g_select = big_text(300, 36, "SELECT A LEVEL", 255, 224, 110, 30);
  g_btn[0] = button_graphic(110, "RETRY", 5);
  g_btn[1] = button_graphic(110, "NEXT", 4);
  g_btn[2] = button_graphic(110, "LEVELS", 6);
  g_btn[3] = button_graphic(150, "PLAY", 4);
  g_btn[4] = button_graphic(110, "BACK", 4);
  FOR k = 0 TO 11 g_lv[k] = new_graphic(64, 64); END
  make_sky();
  g_world = new_graphic(WW, SH);
  RETURN 0;
END

// Level-select tiles: the number, and the best stars earned.
FUNCTION draw_level_tiles();
PRIVATE k, g, s;
BEGIN
  FOR k = 0 TO 11
    g = g_lv[k];
    IF (k + 1 <= unlocked)
      gfx_fill(g, 70, 130, 200); gfx_rect(g, 0, 44, 64, 20, 50, 100, 170);
      gfx_text(g, 32 - digits(k + 1) * 8, 8, "" + (k + 1), 255, 255, 255, 26);
    ELSE
      gfx_fill(g, 70, 74, 90);
      gfx_text(g, 32 - digits(k + 1) * 8, 8, "" + (k + 1), 130, 134, 150, 26);
    END
    gfx_rect_outline(g, 0, 0, 64, 64, 20, 30, 60);
    FOR s = 0 TO 2
      IF (best[k + 1] > s) gfx_circle(g, 16 + s * 16, 52, 6, 255, 210, 40);
      ELSE gfx_circle(g, 16 + s * 16, 52, 6, 40, 50, 80); END
    END
  END
  RETURN 0;
END

// =====================================================================
// Level generation (all rand() calls happen under rand_seed(level))
// =====================================================================

FUNCTION add_pt(px, py);
BEGIN
  tx[np] = px; ty[np] = py; np++;
  RETURN 0;
END

// The ground: flat at the slingshot, a rolling hill, then one to three
// flat sites for structures - on hills, or on stone platforms with
// vertical sides.
FUNCTION gen_terrain();
PRIVATE i, xs, per, w, a, sy;
BEGIN
  np = 0; nplat = 0;
  add_pt(0, 410); add_pt(250, 410);
  add_pt(330 + rand(0, 60), 400 - rand(0, 50));
  add_pt(480 + rand(0, 40), 425 - rand(0, 15));
  ns = 1;
  IF (level >= 3) ns = 2; END
  IF (level >= 6 AND rand(0, 1)) ns = 3; END
  xs = 610 + rand(0, 50);
  per = (1370 - xs) / ns;
  FOR i = 0 TO ns - 1
    w = clamp(per - 40, 130, 280);
    a = xs + i * per + rand(10, per - w - 10);
    IF (rand(0, 99) < 45)
      sy = 410 - rand(40, 110);                // a stone platform
      add_pt(a, 425); add_pt(a, sy); add_pt(a + w, sy); add_pt(a + w, 425);
      plat_a[nplat] = a; plat_b[nplat] = a + w; plat_y[nplat] = sy; nplat++;
    ELSE
      sy = 408 - rand(0, 50);                  // the flat top of a hill
      add_pt(a, sy); add_pt(a + w, sy);
    END
    site_a[i] = a; site_b[i] = a + w; site_y[i] = sy;
  END
  add_pt(WW, 415);
  RETURN 0;
END

// Material for the next piece: wood first, then ice and stone appear.
FUNCTION pick_mat();
PRIVATE r, pi, ps;
BEGIN
  r = rand(0, 99);
  pi = clamp(level * 7, 0, 30);
  ps = clamp((level - 2) * 9, 0, 40);
  IF (r < pi) RETURN 2; END
  IF (r < pi + ps) RETURN 1; END
  RETURN 0;
END

// Floors of two pillars and a plank roof, narrowing upwards; pigs inside
// the floors and on the roof.
FUNCTION build_house(cx, gy, w, floors);
PRIVATE f, L, lw, ph, pl, m, yb, np0;
BEGIN
  L = 1;
  IF (w >= 122) L = 2; END
  IF (w >= 150) L = 3; END
  yb = gy; np0 = pigs_alive;
  FOR f = 0 TO floors - 1
    lw = shp_w[L];
    ph = 0; IF (rand(0, 2) == 0) ph = 1; END
    pl = shp_w[ph];
    m = pick_mat();
    block(cx - lw / 2 + 7, yb - pl / 2, ph, m, 90000);
    block(cx + lw / 2 - 7, yb - pl / 2, ph, m, 90000);
    block(cx, yb - pl - 7, L, pick_mat(), 0);
    IF (f == 0 OR rand(0, 1)) pig(cx, yb, rand(0, 3) == 0 AND lw >= 112); END
    yb -= pl + 14;
    IF (L > 1 AND rand(0, 1)) L--; END
  END
  IF (rand(0, 2) > 0 OR pigs_alive == np0) pig(cx, yb, 0);
  ELSE block(cx - 15, yb - 14, 4, pick_mat(), 0); block(cx + 15, yb - 14, 4, pick_mat(), 0); END
  RETURN 0;
END

// Two columns of cubes with a plank on top; a small hut on the plank at
// later levels.
FUNCTION build_fort(cx, gy, w);
PRIVATE L, lw, k, j, m, yb;
BEGIN
  L = 2; IF (w >= 150) L = 3; END
  lw = shp_w[L];
  k = rand(2, 3); m = pick_mat();
  FOR j = 0 TO k - 1
    block(cx - lw / 2 + 14, gy - 14 - j * 28, 4, m, 0);
    block(cx + lw / 2 - 14, gy - 14 - j * 28, 4, m, 0);
  END
  pig(cx, gy, lw >= 140);
  yb = gy - k * 28;
  block(cx, yb - 7, L, pick_mat(), 0);
  yb -= 14;
  IF (level >= 4 AND rand(0, 1))
    m = pick_mat();
    block(cx - 35, yb - 28, 0, m, 90000); block(cx + 35, yb - 28, 0, m, 90000);
    block(cx, yb - 63, 1, pick_mat(), 0);
    pig(cx, yb, 0);
    yb -= 70;
  END
  pig(cx, yb, 0);
  RETURN 0;
END

// A pyramid of cubes, each row by material, a pig on the top.
FUNCTION build_pyramid(cx, gy, w);
PRIVATE n, rr, c, m;
BEGIN
  n = clamp(w / 30, 2, 5);
  FOR rr = 0 TO n - 1
    m = pick_mat();
    FOR c = 0 TO n - rr - 1
      block(cx - (n - rr - 1) * 14 + c * 28, gy - 14 - rr * 28, 4, m, 0);
    END
  END
  pig(cx, gy - n * 28, 0);
  IF (w >= 190) pig(cx - n * 14 - 16, gy, 0); END
  RETURN 0;
END

FUNCTION gen_structures();
PRIVATE i, cx, w, k;
BEGIN
  FOR i = 0 TO ns - 1
    cx = (site_a[i] + site_b[i]) / 2;
    w = site_b[i] - site_a[i] - 12;
    k = rand(0, 99);
    IF (k < 50) build_house(cx, site_y[i], w, clamp(1 + rand(0, level / 2), 1, 3));
    ELSE IF (k < 78) build_fort(cx, site_y[i], w);
    ELSE build_pyramid(cx, site_y[i], w); END END
  END
  RETURN 0;
END

// Birds for the level: always a red one first, and at least two kinds.
FUNCTION gen_birds();
PRIVATE i, other;
BEGIN
  nbirds = clamp(3 + level / 3, 3, 5);
  bird_kind[0] = 0; other = 0;
  FOR i = 1 TO nbirds - 1
    bird_kind[i] = rand(0, 3);
    IF (bird_kind[i] > 0) other = 1; END
  END
  IF (NOT other) bird_kind[1] = 1 + level % 3; END
  RETURN 0;
END

// =====================================================================
// Sound and music (all made by the engine: sfx, sfx_tone, song_*)
// =====================================================================

// Pseudo-random numbers for sound variety only: rand() stays the game's
FUNCTION snd_rand(a, b);
BEGIN
  snd_rnd = (snd_rnd * 75 + 74) % 65537;
  RETURN a + snd_rnd % (b - a + 1);
END

// World x -> stereo pan, from where the camera is
FUNCTION snd_pan(px);
BEGIN
  RETURN clamp((px - cam_ix - SW / 2) / 4, -80, 80);
END

// Physics contacts repeat: at most 3 impact sounds in one frame
FUNCTION snd_slot();
BEGIN
  IF (snd_f != frame_no) snd_f = frame_no; snd_n = 0; END
  IF (snd_n >= 3) RETURN 0; END
  snd_n++;
  RETURN 1;
END

FUNCTION make_sounds();
BEGIN
  s_click = sfx(sfx_blip, 2);
  s_hop = sfx_tone(wave_square, 600, 900, 70, 30);
  s_creak = sfx_tone(wave_saw, 150, 190, 90, 30);           // the band stretching
  s_whoosh = sfx_tone(wave_noise, 2400, 500, 350, 45);
  s_call[0] = sfx_tone(wave_square, 700, 1300, 220, 32);    // "weeee!"
  s_call[1] = sfx_tone(wave_saw, 1100, 1500, 160, 26);      // a chirp
  s_call[2] = sfx_tone(wave_square, 1400, 600, 260, 30);    // a squawk
  s_call[3] = sfx_tone(wave_triangle, 300, 160, 300, 60);   // the black bird: "hmpf"
  s_split = sfx(sfx_laser, 4);
  s_zoom = sfx_tone(wave_saw, 400, 1800, 260, 36);
  s_dive = sfx_tone(wave_sine, 1800, 300, 500, 46);         // falling whistle
  s_thud = sfx_tone(wave_triangle, 150, 60, 140, 70);       // a bird landing
  s_knock[0] = sfx_tone(wave_triangle, 320, 180, 90, 60);   // wood
  s_knock[1] = sfx_tone(wave_noise, 500, 150, 120, 60);     // stone
  s_knock[2] = sfx_tone(wave_sine, 2400, 2200, 120, 40);    // ice
  s_break[0] = sfx(sfx_hit, 3);                             // wood splinters
  s_break[1] = sfx(sfx_explosion, 9);                       // stone crumbles
  s_break[2] = sfx_tone(wave_noise, 7000, 3000, 380, 40);   // glass shatter
  s_crumble = sfx_tone(wave_sine, 3000, 1800, 300, 30);     // ... and its tinkle
  s_oink = sfx_tone(wave_square, 260, 180, 140, 36);
  s_pop = sfx(sfx_explosion, 14);
  s_squeal = sfx_tone(wave_square, 500, 1200, 180, 28);
  s_laugh = sfx_tone(wave_square, 330, 280, 110, 30);
  s_star = sfx(sfx_coin, 6);
  s_clear = sfx(sfx_powerup, 5);
  s_fail = sfx_tone(wave_triangle, 440, 150, 900, 50);
  s_bonus = sfx(sfx_coin, 12);

  // Menus: a jaunty tune in F
  song_menu = song_new(124);
  song_track(song_menu, inst_pluck,
    "F5 . A5 . C6 . A5 . F5 . . . C5 . . . | G5 . Bb5 . D6 . Bb5 . G5 . . . . . . . |" +
    "A5 . C6 . A5 . F5 . G5 . E5 . C5 . . . | F5 . . . A4 . C5 . F5 - - - . . . . ", 40);
  song_track(song_menu, inst_bass,
    "F2 . . . C3 . . . F2 . . . C3 . . . | G2 . . . D3 . . . G2 . . . D3 . . . |" +
    "C3 . . . G2 . . . C3 . . . E3 . . . | F2 . . . C3 . . . F2 . . . . . . . ", 60);
  song_track(song_menu, inst_drums, "k . h . s . h h | k . h . s . h . ", 38);

  // Playing: a sneaky, quieter walk in D minor
  song_level = song_new(100);
  song_track(song_level, inst_pluck,
    "D5 . . F5 . . A5 . G5 . F5 . E5 . . . | D5 . . F5 . . A5 . C6 - - . A5 . . . |" +
    "Bb4 . . D5 . . F5 . E5 . D5 . C#5 . . . | D5 . A4 . F4 . A4 . D5 - - - . . . . ", 30);
  song_track(song_level, inst_bass,
    "D3 . . . A2 . . . D3 . . . A2 . . . | D3 . . . A2 . . . F2 . . . A2 . . . |" +
    "Bb2 . . . F2 . . . A2 . . . E2 . . . | D3 . . . A2 . . . D3 . . . . . . . ", 55);
  song_track(song_level, inst_drums, "k . . h s . . h | k . k h s . . h ", 28);

  // Level clear: a short fanfare, not looped
  song_win = song_new(140);
  song_track(song_win, inst_square,
    "C5 . E5 . G5 . C6 - - . G5 . C6 - - - | . . . . . . . . . . . . . . . . ", 40);
  song_track(song_win, inst_bass, "C3 . . . G2 . . . C3 . . . . . . . ", 60);
  music_volume(40);
  RETURN 0;
END

// Plays song s (looped unless once) unless it is already on
FUNCTION music(s, once);
BEGIN
  IF (song_now != s)
    song_now = s;
    IF (once) song_play(s, 0); ELSE song_play(s); END
  END
  RETURN 0;
END

// A knock on a block of material mat, as loud as the impact
FUNCTION knock(px, mat, imp);
BEGIN
  IF (NOT snd_slot()) RETURN 0; END
  play_sound(s_knock[mat], clamp(imp * 0.18, 18, 90), snd_rand(85, 120), snd_pan(px));
  RETURN 0;
END

// =====================================================================
// The world
// =====================================================================

// The ground as static edges, painted into the scroll graphic a few
// hundred columns a frame: dirt and grass, stone bricks for platforms.
PROCESS terrain();
PRIVATE i, px, seg, top, c, yy, xj, row;
BEGIN
  x = 0; y = 0;
  FOR i = 0 TO np - 2
    phys_edge(tx[i], ty[i], tx[i + 1], ty[i + 1]);
  END
  phys_edge(0, -2000, 0, 480);                        // world walls
  phys_edge(WW, -2000, WW, 480);
  phys_material(1, 0.8, 0.05);
  gfx_fill_rgba(g_world, 0, 0, 0, 0);
  seg = 0;
  FOR px = 0 TO WW - 1
    WHILE (seg < np - 2 AND px >= tx[seg + 1]) seg++; END
    top = ty[seg] + (ty[seg + 1] - ty[seg]) * (px - tx[seg]) / (tx[seg + 1] - tx[seg] + 0.001);
    c = (px * 37) % 13;
    gfx_rect(g_world, px, top, 1, SH - top, 120 + c, 84 + c, 50);
    gfx_rect(g_world, px, top + 14 + (px * 7) % 5, 1, SH, 100 + c, 68 + c, 40);
    gfx_rect(g_world, px, top - 1 - (px * 13) % 3, 1, 6, 70 + c * 2, 170 + c, 60);
    IF (px % 200 == 199) FRAME; END
  END
  FOR i = 0 TO nplat - 1                              // stone platforms
    gfx_rect(g_world, plat_a[i], plat_y[i], plat_b[i] - plat_a[i], SH - plat_y[i], 128, 128, 138);
    row = 0;
    FOR yy = plat_y[i] TO SH STEP 16
      gfx_line(g_world, plat_a[i], yy, plat_b[i], yy, 90, 90, 100);
      FOR xj = plat_a[i] + (row % 2) * 16 TO plat_b[i] STEP 32
        gfx_line(g_world, xj, yy, xj, yy + 16, 90, 90, 100);
      END
      row++;
    END
    gfx_rect(g_world, plat_a[i], plat_y[i], plat_b[i] - plat_a[i], 3, 170, 170, 180);
  END
  LOOP FRAME; END
END

PROCESS block(x, y, shp, mat, angle);
PRIVATE hp, hp0, thr, thr0, imp, stg, sx, sy, sa, d, i, age, snd_t;
BEGIN
  ctype = c_scroll; z = 0;
  graph = g_blk[(shp * 3 + mat) * 3];
  phys_box(shp_w[shp], shp_h[shp]);
  SWITCH (mat)
    CASE 0 phys_material(0.6, 0.7, 0.05); hp = 200; thr = 110;
    CASE 1 phys_material(2.2, 0.9, 0.02); hp = 480; thr = 150;
    CASE 2 phys_material(0.9, 0.45, 0.05); hp = 90; thr = 70;
  END
  hp0 = hp; thr0 = thr; n_blocks++;
  sx = x; sy = y; sa = angle;
  LOOP
    imp = phys_impact();
    IF (armed)
      IF (imp > max_imp) max_imp = imp; END
      // a knock for a new, real hit (not the steady push of a resting load)
      IF (snd_t > 0) snd_t--; END
      IF (imp > thr * 0.7 AND imp > 60 AND snd_t == 0) knock(x, mat, imp); snd_t = 10; END
      IF (imp > thr)
        hp -= imp - thr; hits++;
        IF (hp <= 0) BREAK; END
        stg = 0;
        IF (hp < hp0 * 0.66) stg = 1; END
        IF (hp < hp0 * 0.33) stg = 2; END
        graph = g_blk[(shp * 3 + mat) * 3 + stg];
      END
    ELSE
      // While settling: learn the steady push of the load resting on this
      // block, so only real hits count as damage.
      age++;
      IF (age > 45 AND imp * 1.5 + thr0 > thr) thr = imp * 1.5 + thr0; END
    END
    IF (check_now)                     // how far did it drift while settling?
      d = abs(x - sx) + abs(y - sy);
      IF (d > settle_max) settle_max = d; END
      IF (abs(angle - sa) > settle_ang) settle_ang = abs(angle - sa); END
      IF (abs(phys_vx()) + abs(phys_vy()) > settle_v) settle_v = abs(phys_vx()) + abs(phys_vy()); END
    END
    IF (abs(phys_vx()) + abs(phys_vy()) > 15) last_motion = frame_no; END
    IF (y > 560) BREAK; END
    FRAME;
  END
  // broken: debris flies apart, points
  n_blocks--; blocks_broken++;
  IF (armed AND snd_slot())
    play_sound(s_break[mat], 70, snd_rand(85, 115), snd_pan(x));
    IF (mat == 2) play_sound(s_crumble, 45, snd_rand(90, 130), snd_pan(x)); END
  END
  FOR i = 0 TO 6
    IF (n_debris < 140) debris(x + rand(-shp_w[shp] / 3, shp_w[shp] / 3), y, phys_vx() * 0.3 + rand(-160, 160), phys_vy() * 0.3 - rand(40, 260), g_chip[mat]); END
  END
  i = 500; IF (mat == 1) i = 800; END IF (mat == 2) i = 300; END
  score += i;
  popup(x, y - 10, i, '#ffffff');
END

PROCESS pig(x, y, big);
PRIVATE r, hp, hp0, imp, sx, sy, i, rolls, thr, age, snd_t;
BEGIN
  ctype = c_scroll; z = -1;
  r = 12 + big * 4;
  y -= r;                              // given the floor it stands on
  graph = g_pig[big * 2];
  phys_circle(r);
  phys_material(0.7, 0.8, 0.1);
  // A resting circle creeps: it cannot roll until it is disturbed.
  phys_fixed_rotation(1); rolls = 0;
  hp = 90 + big * 70; hp0 = hp;
  pigs_alive++;
  sx = x; sy = y;
  thr = 80;
  LOOP
    imp = phys_impact();
    IF (armed)
      IF (NOT rolls AND (imp > thr - 30 OR abs(phys_vx()) > 40)) rolls = 1; phys_fixed_rotation(0); END
      IF (snd_t > 0) snd_t--; END
      IF (imp > thr)
        hp -= imp - thr; hits++;
        IF (hp <= 0) BREAK; END
        IF (hp < hp0 * 0.6) graph = g_pig[big * 2 + 1]; END
        IF (snd_t == 0 AND snd_slot()) play_sound(s_oink, 60, 100 - big * 20 + snd_rand(-8, 8), snd_pan(x)); snd_t = 20; END
      END
    ELSE
      age++;
      IF (age > 45 AND imp * 1.5 + 80 > thr) thr = imp * 1.5 + 80; END
    END
    IF (check_now)
      IF (abs(x - sx) + abs(y - sy) > settle_max) settle_max = abs(x - sx) + abs(y - sy); END
      IF (abs(phys_vx()) + abs(phys_vy()) > settle_v) settle_v = abs(phys_vx()) + abs(phys_vy()); END
    END
    IF (abs(phys_vx()) + abs(phys_vy()) > 15) last_motion = frame_no; END
    IF (y > 560) BREAK; END
    FRAME;
  END
  // pop!
  pigs_alive--; pigs_popped++;
  IF (armed)
    play_sound(s_pop, 70, snd_rand(110, 140), snd_pan(x));
    play_sound(s_squeal, 45, snd_rand(90, 120) - big * 15, snd_pan(x));
  END
  FOR i = 0 TO 5 puff(x + rand(-r, r), y + rand(-r, r), 60 + rand(0, 60)); END
  FOR i = 0 TO 5
    IF (n_debris < 140) debris(x, y, rand(-200, 200), rand(-300, -60), g_chip[0]); END
  END
  score += 5000;
  popup(x, y - 20, 5000, '#80ff60');
END

// The slingshot, and the dotted path of the last shot.
PROCESS sling();
PRIVATE i;
BEGIN
  ctype = c_scroll; z = 5;
  graph = g_sling; x = SLX; y = 410 - 55;
  LOOP
    IF (phase == 0 AND fl_n > 0)
      set_color('#ffffffa0');
      FOR i = 2 TO fl_n - 1 STEP 5 circle(fl_x[i], fl_y[i], 2); END
    END
    FRAME;
  END
END

// Draws a band from a fork tip to the pouch as a row of dots.
FUNCTION band(ax, ay, bx, by);
PRIVATE i, n;
BEGIN
  n = int(fget_distance(ax, ay, bx, by) / 3) + 1;
  FOR i = 0 TO n
    draw_rect(ax + (bx - ax) * i / (n + 0.001) - 2, ay + (by - ay) * i / (n + 0.001) - 2, 4, 4);
  END
  RETURN 0;
END

// A bird: waits in the queue, hops onto the slingshot, is dragged and
// released, flies as a physics body, uses its power on a click.
PROCESS bird(idx, kind);
PRIVATE r, st, t, px, py, dx, dy, d, vx, vy, grab, prevl, touched, used, still, life, k, qx, qy, qvx, qvy,
        creak_d, imp, snd_t;
BEGIN
  ctype = c_scroll; z = -5;
  graph = g_bird[kind]; r = bird_r[kind];
  LOOP
    SWITCH (st)
      CASE 0                            // queued on the ground
        x = SLX - 48 - (idx - load_idx - 1) * 32;
        y = 410 - r;
        IF ((frame_no + idx * 47) % 140 < 12) y -= sin(((frame_no + idx * 47) % 140) * 15000) * 10; END
        IF (idx == load_idx AND phase == 0 AND state == 3)
          st = 1; t = 0; px = x; py = y;
          play_sound(s_hop, 40, 100 + kind * 15, snd_pan(x));
        END
      CASE 1                            // hop onto the slingshot
        t++;
        x = px + (SLX - px) * t * 0.05;
        y = py + (SLY - py) * t * 0.05 - sin(t * 9000) * 40;
        IF (t >= 20) st = 2; x = SLX; y = SLY; END
      CASE 2                            // in the pouch: drag and release
        IF (mouse.left AND NOT prevl AND cam_ix < 30 AND fget_distance(mouse.x + cam_ix, mouse.y, x, y) < 55)
          grab = 1; pan = 0; creak_d = 0;
        END
        IF (grab)
          dx = mouse.x + cam_ix - SLX; dy = mouse.y - SLY;
          d = sqrt(dx * dx + dy * dy);
          IF (d > PULL) dx = dx * PULL / d; dy = dy * PULL / d; d = PULL; END
          x = SLX + dx; y = SLY + dy;
          vx = -dx * KPULL; vy = -dy * KPULL;
          IF (d > 4) angle = fget_angle(0, 0, vx, vy); END
          // the band creaks every 12 px it is stretched further
          IF (d > creak_d + 12)
            creak_d = d;
            play_sound(s_creak, 20 + d * 0.3, 70 + d, snd_pan(x));
          END
          IF (d < creak_d - 12) creak_d = d; END
          // preview: the same semi-implicit Euler steps the physics takes
          qx = x; qy = y; qvx = vx; qvy = vy; pv_n = 0;
          FOR k = 1 TO 72
            qvy += GRAV * DT; qx += qvx * DT; qy += qvy * DT;
            IF (k % 4 == 0)
              pv_x[pv_n] = qx; pv_y[pv_n] = qy; pv_n++;
              IF (d > 12) set_color('#ffffff'); circle(qx, qy, 3 - k / 40); END
            END
          END
          IF (NOT mouse.left)
            grab = 0;
            IF (d > 12)
              angle = 0;
              phys_circle(r);
              SWITCH (kind)
                CASE 0 phys_material(3, 0.6, 0.3);
                CASE 1 phys_material(3, 0.6, 0.3);
                CASE 2 phys_material(2.5, 0.5, 0.2);
                CASE 3 phys_material(10, 0.7, 0.1);
              END
              phys_bullet(1);
              phys_velocity(vx, vy);
              st = 3; phase = 1; fl_n = 0; shots++; hint = 0;
              play_sound(s_whoosh, 30 + d * 0.5, 80 + d * 0.4, snd_pan(x));
              play_sound(s_call[kind], 70, snd_rand(92, 112), snd_pan(x));
            ELSE x = SLX; y = SLY; angle = 0; END
          END
        END
        IF (st == 2)
          set_color('#5a3418');
          band(SLX - 13, SLY - 2, x - r * 0.7, y);
          band(SLX + 13, SLY - 2, x - r * 0.7, y);
        END
      CASE 3                            // flying
        IF (fl_n < 300) fl_x[fl_n] = x; fl_y[fl_n] = y; fl_n++; END
        fly_x = x; life++;
        IF (y < 0) set_color('#ffffff'); circle(x, 30, 4); circle(x, 40, 2); END   // above the screen
        IF (NOT touched AND phys_contact(0)) touched = 1; END
        // bumps and landings, as loud as the hit
        imp = phys_impact();
        IF (snd_t > 0) snd_t--; END
        IF (imp > 90 AND snd_t == 0 AND snd_slot())
          play_sound(s_thud, clamp(imp * 0.12, 20, 90), snd_rand(90, 110) - kind * 8, snd_pan(x));
          snd_t = 8;
        END
        IF (mouse.left AND NOT prevl AND NOT used AND NOT touched AND kind > 0)
          used = 1; abilities++;
          vx = phys_vx(); vy = phys_vy();
          SWITCH (kind)
            CASE 1                      // split into three
              play_sound(s_split, 60, 100, snd_pan(x));
              play_sound(s_call[1], 50, 125, snd_pan(x));
              shard(x - get_distx(fget_angle(0, 0, vx, vy) + 90000, 14), y - get_disty(fget_angle(0, 0, vx, vy) + 90000, 14), vx * cos(12000) - vy * sin(12000), vx * sin(12000) + vy * cos(12000));
              shard(x + get_distx(fget_angle(0, 0, vx, vy) + 90000, 14), y + get_disty(fget_angle(0, 0, vx, vy) + 90000, 14), vx * cos(12000) + vy * sin(12000), -vx * sin(12000) + vy * cos(12000));
            CASE 2                      // a burst of speed
              play_sound(s_zoom, 70, 100, snd_pan(x));
              phys_velocity(vx * 2.2, vy * 2.2);
              FOR k = 0 TO 4 puff(x - vx * 0.02 * k, y - vy * 0.02 * k, 40); END
            CASE 3                      // a dive straight down
              play_sound(s_dive, 70, 100, snd_pan(x));
              phys_velocity(vx * 0.2, 1100);
              puff(x, y, 70);
          END
        END
        IF (abs(phys_vx()) + abs(phys_vy()) < 30) still++; ELSE still = 0; last_motion = frame_no; END
        IF (still > 45 OR life > 480 OR y > 560) BREAK; END
    END
    prevl = mouse.left;
    FRAME;
  END
  FOR k = 0 TO 3 puff(x + rand(-8, 8), y + rand(-8, 8), 70); END
  phase = 2; wait_t = 0;
END

// The blue bird's extra pieces.
PROCESS shard(x, y, vx, vy);
PRIVATE still, life;
BEGIN
  ctype = c_scroll; z = -5; graph = g_bird[1];
  phys_circle(8);
  phys_material(3, 0.6, 0.3);
  phys_bullet(1);
  phys_velocity(vx, vy);
  LOOP
    life++;
    IF (abs(phys_vx()) + abs(phys_vy()) < 30) still++; ELSE still = 0; last_motion = frame_no; END
    IF (still > 45 OR life > 420 OR y > 560) BREAK; END
    FRAME;
  END
  puff(x, y, 50);
END

// Cheap particles: no physics body, just gravity, spin and a fade.
PROCESS debris(x, y, vx, vy, graph);
PRIVATE t, spin;
BEGIN
  ctype = c_scroll; z = -3; n_debris++;
  spin = rand(-20000, 20000);
  FOR t = 0 TO 44
    vy += 15; x += vx * DT; y += vy * DT; angle += spin;
    alpha = 100 - t * 2;
    FRAME;
  END
  n_debris--;
END

PROCESS puff(x, y, size);
PRIVATE t;
BEGIN
  ctype = c_scroll; z = -4; graph = g_puff;
  FOR t = 0 TO 29
    size += 3; alpha = 90 - t * 3; y -= 0.3;
    FRAME;
  END
END

PROCESS popup(x, y, v, col);
PRIVATE t;
BEGIN
  ctype = c_scroll;
  FOR t = 0 TO 59
    y -= 0.6;
    set_color(col);
    text(x - digits(v) * 3, y, "" + v);
    FRAME;
  END
END

// =====================================================================
// Screens and buttons
// =====================================================================

PROCESS ui_button(x, y, graph, code);
PRIVATE prevl;
BEGIN
  z = -60; prevl = 1;
  LOOP
    size = 100;
    IF (abs(mouse.x - x) < 55 AND abs(mouse.y - y) < 17 + (code >= 10) * 15)
      size = 108;
      IF (mouse.left AND NOT prevl) btn_hit = code; play_sound(s_click, 50, 100, 0); END
    END
    prevl = mouse.left;
    FRAME;
  END
END

PROCESS sprite(x, y, graph, z);
BEGIN
  LOOP FRAME; END
END

// A star on the result panel pops in after a delay.
PROCESS star_pop(x, y, lit, delay);
PRIVATE t;
BEGIN
  z = -58; graph = g_star0;
  IF (lit) graph = g_star; END
  size = 0;
  FRAME(delay * 100);
  IF (lit) play_sound(s_star, 70, 100 + delay * 5, (x - 400) / 2); END
  FOR t = 1 TO 12 size = t * 10; FRAME; END
  LOOP FRAME; END
END

FUNCTION clear_ui();
BEGIN
  signal(TYPE ui_button, s_kill); signal(TYPE sprite, s_kill); signal(TYPE star_pop, s_kill);
  btn_hit = 0;
  RETURN 0;
END

FUNCTION clear_world();
BEGIN
  signal(TYPE bird, s_kill); signal(TYPE shard, s_kill); signal(TYPE block, s_kill);
  signal(TYPE pig, s_kill); signal(TYPE terrain, s_kill); signal(TYPE sling, s_kill);
  signal(TYPE debris, s_kill); signal(TYPE puff, s_kill); signal(TYPE popup, s_kill);
  FRAME;
  n_debris = 0; pigs_alive = 0; n_blocks = 0;
  RETURN 0;
END

FUNCTION camera_step();
BEGIN
  cam_x += (cam_t - cam_x) * 0.08;
  cam_x = clamp(cam_x, 0, WW - SW);
  cam_ix = int(cam_x);
  scroll.x0 = cam_ix;
  RETURN 0;
END

// Builds the level from its number: generate, let it settle with damage
// off while the camera shows the targets, and start over from the next
// seed if anything moved.
FUNCTION build_level();
PRIVATE att, i;
BEGIN
  clear_ui();
  state = 2; armed = 0;
  FOR att = 0 TO 5
    clear_world();
    // rand() is an LCG: close seeds start alike, so spread the seed
    // (Knuth's multiplicative hash) and throw the first numbers away.
    rand_seed((level * 7919 + att * 104729 + 11) * 2654435761);
    FOR i = 0 TO 7 rand(0, 99); END
    pigs_alive = 0; n_blocks = 0;
    gen_terrain();
    terrain();
    gen_structures();
    gen_birds();
    rand_seed();
    settle_max = 0; settle_ang = 0; settle_v = 0;
    FOR i = 1 TO 90
      cam_t = WW - SW; camera_step(); frame_no++;
      FRAME;
    END
    check_now = 1; FRAME; FRAME; check_now = 0;
    attempts = att + 1;
    IF (settle_max < 2.5 AND settle_ang < 2000 AND settle_v < 4) BREAK; END
  END
  // points for stars: all pigs plus a share of the blocks
  star2 = pigs_alive * 5000 + n_blocks * 150;
  star3 = pigs_alive * 5000 + n_blocks * 280 + 10000;
  sling();
  FOR i = 0 TO nbirds - 1 bird(i, bird_kind[i]); END
  score = 0; blocks_broken = 0; pigs_popped = 0; fl_n = 0; pv_n = 0; max_imp = 0;
  load_idx = 0; phase = 0; pan = 0; wait_t = 0;
  armed = 1; state = 3;
  music(song_level, 0);
  RETURN 0;
END

FUNCTION show_result(won);
PRIVATE k;
BEGIN
  clear_ui();
  sprite(400, 230, g_panel, -55);
  IF (won)
    state = 4;
    play_sound(s_clear, 70, 100, 0);
    music(song_win, 1);
    sprite(400, 140, g_clear, -57);
    FOR k = 0 TO 2 star_pop(330 + k * 70, 200 - (k == 1) * 10, stars_got > k, 3 + k * 3); END
    ui_button(530, 320, g_btn[1], 2);
  ELSE
    state = 5;
    sprite(400, 140, g_fail, -57);
    play_sound(s_fail, 70, 100, 0);
    play_sound(s_laugh, 50, 90, 0);
    song_stop(); song_now = 0;
    FOR k = 0 TO 2 star_pop(330 + k * 70, 200 - (k == 1) * 10, 0, 1); END
  END
  ui_button(270, 320, g_btn[2], 3);
  ui_button(400, 320, g_btn[0], 1);
  RETURN 0;
END

FUNCTION show_title();
BEGIN
  clear_ui(); clear_world();
  state = 0; cam_t = 0; cam_x = 0; camera_step();
  music(song_menu, 0);
  gfx_fill_rgba(g_world, 0, 0, 0, 0);
  gfx_rect(g_world, 0, 410, WW, 70, 110, 80, 48);
  gfx_rect(g_world, 0, 406, WW, 6, 80, 175, 64);
  sprite(400, 120, g_title, -50);
  sprite(300, 395, g_bird[0], -50); sprite(340, 399, g_bird[1], -50);
  sprite(380, 395, g_bird[2], -50); sprite(425, 391, g_bird[3], -50);
  sprite(500, 392, g_pig[2], -50); sprite(540, 396, g_pig[0], -50);
  ui_button(400, 230, g_btn[3], 4);
  ui_button(400, 280, g_btn[2], 3);
  RETURN 0;
END

FUNCTION show_levels();
PRIVATE k;
BEGIN
  clear_ui();
  state = 1;
  music(song_menu, 0);
  draw_level_tiles();
  k = sprite(400, 262, g_panel, -55);
  k.size = 125;
  sprite(400, 126, g_select, -57);
  FOR k = 0 TO 11 ui_button(214 + (k % 6) * 74, 190 + (k / 6) * 84, g_lv[k], 10 + k + 1); END
  ui_button(400, 380, g_btn[4], 5);
  RETURN 0;
END

// =====================================================================
// MAIN
// =====================================================================
PRIVATE calm, k;
BEGIN
  set_mode(SW, SH);
  set_fps(60, 0);
  phys_gravity(0, GRAV);
  make_graphics();
  make_sounds();
  start_scroll(0, 0, g_world, g_sky, 0, 0);
  scroll.ratio = 300;                   // the sky moves at a third of the speed
  show_title();

  LOOP
    frame_no++;
    bodies = phys_bodies(); fps_now = get_fps();
    SWITCH (state)
      CASE 0
        set_color('#ffffff');
        text(250, 320, "Drag the bird back and let go to launch it.");
        text(250, 334, "Click in flight: BLUE splits, YELLOW speeds up,");
        text(250, 348, "BLACK dives. Pop every pig to clear the level.");
        IF (btn_hit == 4 OR key_pressed(_enter) OR key_pressed(_space)) level = unlocked; build_level(); END
        IF (btn_hit == 3 OR key_pressed(_l)) show_levels(); END
      CASE 1
        IF (btn_hit > 10 AND btn_hit - 10 <= unlocked) level = btn_hit - 10; build_level(); END
        IF (btn_hit == 5 OR key_pressed(_esc)) show_title(); END
      CASE 3
        // camera: follow the bird in flight, arrows look around
        IF (key(_left) OR key(_a)) pan -= 10; END
        IF (key(_right) OR key(_d)) pan += 10; END
        pan = clamp(pan, 0, WW - SW);
        IF (phase == 0) cam_t = pan; END
        IF (phase == 1) cam_t = fly_x - 300; END
        IF (phase == 2)
          wait_t++;
          calm = frame_no - last_motion > 40;
          IF (pigs_alive == 0 AND (calm OR wait_t > 180))
            // bonus for the birds not used
            FOR k = load_idx + 1 TO nbirds - 1 score += 10000; play_sound(s_bonus, 60, 100 + k * 10, 0); END
            stars_got = 1;
            IF (score >= star2) stars_got = 2; END
            IF (score >= star3) stars_got = 3; END
            IF (stars_got > best[level]) best[level] = stars_got; END
            IF (level + 1 > unlocked) unlocked = level + 1; END
            signal(TYPE bird, s_kill);
            show_result(1);
          ELSE IF (pigs_alive > 0 AND (calm OR wait_t > 300))
            IF (load_idx + 1 < nbirds) load_idx++; phase = 0; pan = 0; play_sound(s_laugh, 45, snd_rand(95, 115), 60);
            ELSE show_result(0); END
          END END
        END
        IF (key_pressed(_r)) build_level(); END
        IF (key_pressed(_l)) clear_world(); show_levels(); END
      CASE 4, 5
        IF (btn_hit == 1 OR key_pressed(_r) OR (state == 5 AND key_pressed(_enter))) build_level(); END
        IF (state == 4 AND (btn_hit == 2 OR key_pressed(_n) OR key_pressed(_enter))) level++; build_level(); END
        IF (btn_hit == 3 OR key_pressed(_l)) clear_world(); show_levels(); END
    END
    btn_hit = 0;
    IF (state >= 2) camera_step(); END

    // HUD
    IF (state >= 2)
      set_color('#000000');
      draw_rect(0, 0, SW, 22, 'rgba(0,0,0,0.35)');
      set_color('#ffffff');
      text(10, 7, "LEVEL " + level);
      text(90, 7, "SCORE " + score);
      text(210, 7, "PIGS " + pigs_alive);
      text(280, 7, "BIRDS " + (nbirds - load_idx - (phase > 0)));
      text(560, 7, "R retry  L levels  arrows look");
      IF (state == 2) text(330, 40, "Level " + level + " - get ready!"); END
      IF (state == 3 AND hint AND phase == 0)
        text(230, 452, "Drag the bird back and release. Click in flight for its power.");
      END
      IF (state >= 4)
        set_color('#ffffff');
        text(400 - (6 + digits(score)) * 3, 260, "SCORE " + score);
      END
    END
    FRAME;
  END
END
