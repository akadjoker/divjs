PROGRAM racer;

// POCKET GP - a top-down racer in the style of Micro Machines.
// Every race runs on a new circuit. A dozen random "knots" are placed
// around the centre of a big map (sorted by angle, so the loop never
// crosses itself), pushed apart, their sharpest corners softened, and a
// Catmull-Rom spline through them gives the centreline, resampled to one
// point every 16 pixels. Tracks where two stretches come too close are
// thrown away and generated again. The centreline is then painted once,
// a few passes per frame, into a large graphic (grass, sand run-off,
// kerbs, asphalt, start line, trees, tyre walls, oil and puddles) that a
// scroll window follows. Minimap, checkpoints, positions and the AI all
// work from the same list of centreline points.
//
// The cars keep their velocity apart from their heading: every frame
// the velocity is split into a forward and a sideways part, and grip only
// removes a limited amount of the sideways part, so a fast car slides
// (less grip on grass, sand, oil and with the handbrake). Sliding hard
// leaves skid marks drawn straight into the track graphic.

GLOBAL
  MAPW = 2560; MAPH = 1920;   // track graphic, in pixels
  HW = 56;                    // half width of the asphalt
  GAP = 16;                    // distance between centreline points
  LAPS = 3;

  // ---- centreline: point i, heading to the next point, curvature
  np = 0;
  tx[1023]; ty[1023];
  ta[1023];                   // DIV angle from point i to point i+1
  turn[1023];                 // heading change at point i (signed)
  bend[1023];                 // heading change over the next 5 points
  vcor[1023];                 // fastest safe speed through point i
  runoff[1023];               // 1 = corner: sand trap on the outside

  // ---- generation scratch: knots and the dense spline
  nk = 0; kx[15]; ky[15]; kidx[15];
  nd = 0; dxs[1023]; dys[1023];

  // ---- checkpoints (gate 0 is the start/finish line)
  ng = 0; gate[15];

  // ---- scenery: solid obstacles and slippery patches
  nob = 0; ob_x[99]; ob_y[99]; ob_r[99];
  nsl = 0; sl_x[7]; sl_y[7]; sl_r[7];

  // ---- the four cars (0 = player)
  cx[3]; cy[3]; cvx[3]; cvy[3];     // position mirror, velocity
  cpx[3]; cpy[3];                   // push from collisions, applied by the car
  cang[3]; cni[3]; cdist[3]; cscan[3];
  cgates[3];                        // checkpoints passed since the start
  clapst[3]; cfin[3]; ctime[3]; cprog[3]; crank[3]; cmiss[3];
  cskill[3]; clane[3]; cstuck[3]; crev[3];
  ai_thr = 0; ai_brk = 0; ai_steer = 0.0;

  // ---- graphics
  g_map = 0; g_mini = 0; g_dust = 0; g_car[3]; g_big[3]; g_pos[3];
  g_title = 0; g_fin = 0;

  // ---- race state
  state = 0;          // 0 building, 1 title, 2 countdown, 3 racing, 4 results
  gen_pct = 0; seed = 0; tries = 0;
  race_t = 0.0; count_t = 0.0; msg_t = 0.0;
  fin_count = 0; last_lap = 0.0; best_lap = 0.0;
  p_lap = 0; p_pos = 4;             // player's lap and position (HUD)
  cam_x = 0.0; cam_y = 0.0;
  n_dust = 0; n_bumps = 0; n_hits = 0;
  autopilot = 0;                    // 1 = the AI drives the player car (tests)
  first_race = 1;

// =====================================================================
// Small helpers
// =====================================================================

// Wraps an angle difference into -180000..180000
FUNCTION adiff(a);
BEGIN
  a = a % 360000;
  IF (a > 180000) a -= 360000; END
  IF (a < -180000) a += 360000; END
  RETURN a;
END

// "1:05.37" from seconds
FUNCTION fmt(t);
PRIVATE m, s, cs, r;
BEGIN
  m = int(t * 0.0166667 + 0.00001);
  s = int(t - m * 60);
  cs = int((t - m * 60 - s) * 100);
  r = "" + m + ":";
  IF (s < 10) r = r + "0"; END
  r = r + s + ".";
  IF (cs < 10) r = r + "0"; END
  RETURN r + cs;
END

FUNCTION cname(i);
BEGIN
  SWITCH (i)
    CASE 0 RETURN "YOU";
    CASE 1 RETURN "RED";
    CASE 2 RETURN "BLUE";
  END
  RETURN "GREEN";
END

FUNCTION ccol(i);
BEGIN
  SWITCH (i)
    CASE 0 RETURN "#ffd23c";
    CASE 1 RETURN "#ff5046";
    CASE 2 RETURN "#50a0ff";
  END
  RETURN "#50e070";
END

FUNCTION ordinal(n);
BEGIN
  SWITCH (n)
    CASE 1 RETURN "1st";
    CASE 2 RETURN "2nd";
    CASE 3 RETURN "3rd";
  END
  RETURN n + "th";
END

// Distance from (px, py) to the nearest centreline point (every 2nd
// point is enough for placing scenery)
FUNCTION track_dist(px, py);
PRIVATE i, ex, ey, d, best;
BEGIN
  best = 99999999;
  i = 0;
  WHILE (i < np)
    ex = tx[i] - px; ey = ty[i] - py;
    d = ex * ex + ey * ey;
    IF (d < best) best = d; END
    i += 2;
  END
  RETURN sqrt(best);
END

// =====================================================================
// Graphics
// =====================================================================

FUNCTION big_text(w, h, s, r, g, b, sz);
PRIVATE gr;
BEGIN
  gr = new_graphic(w, h);
  gfx_fill_rgba(gr, 0, 0, 0, 0);
  gfx_text(gr, 3, 3, s, 0, 0, 0, sz);               // shadow
  gfx_text(gr, 0, 0, s, r, g, b, sz);
  RETURN gr;
END

// A little car seen from above, facing right (angle 0): 24x13
FUNCTION make_car(r, g, b);
PRIVATE gr;
BEGIN
  gr = new_graphic(24, 13);
  gfx_fill_rgba(gr, 0, 0, 0, 0);
  gfx_rect(gr, 3, 0, 5, 2, 20, 20, 20);             // wheels
  gfx_rect(gr, 16, 0, 5, 2, 20, 20, 20);
  gfx_rect(gr, 3, 11, 5, 2, 20, 20, 20);
  gfx_rect(gr, 16, 11, 5, 2, 20, 20, 20);
  gfx_rect(gr, 1, 2, 22, 9, r * 2 / 3, g * 2 / 3, b * 2 / 3);
  gfx_rect(gr, 2, 3, 20, 7, r, g, b);               // body
  gfx_rect(gr, 13, 3, 4, 7, 150, 210, 250);         // windscreen
  gfx_rect(gr, 7, 4, 5, 5, r * 3 / 4, g * 3 / 4, b * 3 / 4);  // roof
  gfx_rect(gr, 2, 6, 20, 1, 255, 255, 255);         // racing stripe
  gfx_rect(gr, 22, 3, 2, 2, 255, 250, 200);         // headlights
  gfx_rect(gr, 22, 8, 2, 2, 255, 250, 200);
  RETURN gr;
END

FUNCTION make_graphics();
BEGIN
  g_car[0] = make_car(250, 205, 50);
  g_car[1] = make_car(230, 60, 50);
  g_car[2] = make_car(60, 130, 240);
  g_car[3] = make_car(60, 200, 90);
  g_dust = new_graphic(12, 12);
  gfx_fill_rgba(g_dust, 0, 0, 0, 0);
  gfx_circle(g_dust, 6, 6, 5, 190, 170, 120);
  g_map = new_graphic(MAPW, MAPH);
  g_mini = new_graphic(160, 120);
  g_big[0] = big_text(80, 90, "3", 255, 220, 60, 80);
  g_big[1] = big_text(80, 90, "2", 255, 220, 60, 80);
  g_big[2] = big_text(80, 90, "1", 255, 220, 60, 80);
  g_big[3] = big_text(200, 90, "GO!", 90, 240, 90, 80);
  g_pos[0] = big_text(90, 44, "1st", 255, 220, 60, 36);
  g_pos[1] = big_text(90, 44, "2nd", 230, 230, 240, 36);
  g_pos[2] = big_text(90, 44, "3rd", 230, 160, 90, 36);
  g_pos[3] = big_text(90, 44, "4th", 200, 205, 215, 36);
  g_title = big_text(360, 64, "POCKET GP", 255, 210, 60, 56);
  g_fin = big_text(340, 64, "FINISHED!", 255, 255, 255, 52);
  RETURN 0;
END

// =====================================================================
// Track generation
// =====================================================================

// Random knots around the centre, pushed apart, sharp corners softened
FUNCTION make_knots();
PRIVATE k, i, j, n, a, r, ex, ey, d, push, a1, a2, pv, nx;
BEGIN
  nk = rand(11, 15);
  FOR k = 0 TO nk - 1
    a = k * 360000 / nk + rand(-6000, 6000);
    r = rand(300, 880);
    kx[k] = 1280 + get_distx(a, r) * 1.3;
    ky[k] = 960 + get_disty(a, r) * 0.95;
  END
  FOR n = 0 TO 5
    FOR i = 0 TO nk - 2                              // push apart
      FOR j = i + 1 TO nk - 1
        ex = kx[j] - kx[i]; ey = ky[j] - ky[i];
        d = sqrt(ex * ex + ey * ey) + 0.01;
        IF (d < 270)
          push = (270 - d) * 0.5 / d;
          kx[i] -= ex * push; ky[i] -= ey * push;
          kx[j] += ex * push; ky[j] += ey * push;
        END
      END
    END
    FOR i = 0 TO nk - 1                              // soften hairpins
      pv = (i + nk - 1) % nk; nx = (i + 1) % nk;
      a1 = fget_angle(kx[i], ky[i], kx[pv], ky[pv]);
      a2 = fget_angle(kx[i], ky[i], kx[nx], ky[nx]);
      IF (abs(adiff(a1 - a2)) < 65000)
        kx[i] += ((kx[pv] + kx[nx]) * 0.5 - kx[i]) * 0.35;
        ky[i] += ((ky[pv] + ky[nx]) * 0.5 - ky[i]) * 0.35;
      END
      kx[i] = clamp(kx[i], 230, MAPW - 230);
      ky[i] = clamp(ky[i], 210, MAPH - 210);
    END
  END
  RETURN 0;
END

// Catmull-Rom spline through the knots, 20 samples per segment
FUNCTION spline();
PRIVATE k, s, t, t2, t3, p0, p1, p2, p3;
BEGIN
  nd = 0;
  FOR k = 0 TO nk - 1
    p0 = (k + nk - 1) % nk; p1 = k; p2 = (k + 1) % nk; p3 = (k + 2) % nk;
    FOR s = 0 TO 19
      t = s * 0.05; t2 = t * t; t3 = t2 * t;
      dxs[nd] = 0.5 * (2 * kx[p1] + (kx[p2] - kx[p0]) * t
              + (2 * kx[p0] - 5 * kx[p1] + 4 * kx[p2] - kx[p3]) * t2
              + (3 * kx[p1] - kx[p0] - 3 * kx[p2] + kx[p3]) * t3);
      dys[nd] = 0.5 * (2 * ky[p1] + (ky[p2] - ky[p0]) * t
              + (2 * ky[p0] - 5 * ky[p1] + 4 * ky[p2] - ky[p3]) * t2
              + (3 * ky[p1] - ky[p0] - 3 * ky[p2] + ky[p3]) * t3);
      nd++;
    END
  END
  RETURN 0;
END

// Walks the dense spline and drops a point every GAP pixels
FUNCTION resample();
PRIVATE i, j, seg, pos, acc, ex, ey;
BEGIN
  tx[0] = dxs[0]; ty[0] = dys[0]; np = 1; acc = 0;
  FOR i = 0 TO nd - 1
    IF (i % 20 == 0) kidx[i / 20] = np; END          // a knot: remember where
    j = (i + 1) % nd;
    ex = dxs[j] - dxs[i]; ey = dys[j] - dys[i];
    seg = sqrt(ex * ex + ey * ey) + 0.0001;
    pos = 0;
    WHILE (acc + seg - pos >= GAP AND np < 1000)
      pos += GAP - acc; acc = 0;
      tx[np] = dxs[i] + ex * pos / seg;
      ty[np] = dys[i] + ey * pos / seg;
      np++;
    END
    acc += seg - pos;
  END
  // the last point may sit on top of the first one
  ex = tx[np - 1] - tx[0]; ey = ty[np - 1] - ty[0];
  IF (ex * ex + ey * ey < 64) np--; END
  RETURN 0;
END

// Headings, curvature and the corner speed of every point
FUNCTION measure();
PRIVATE i, k, th, rr;
BEGIN
  FOR i = 0 TO np - 1
    k = (i + 1) % np;
    ta[i] = fget_angle(tx[i], ty[i], tx[k], ty[k]);
  END
  FOR i = 0 TO np - 1
    turn[i] = adiff(ta[i] - ta[(i + np - 1) % np]);
  END
  FOR i = 0 TO np - 1
    bend[i] = 0;
    FOR k = 0 TO 4 bend[i] += turn[(i + k) % np]; END
    // 5 segments = 80 px turning by th radians: radius 80 / th
    th = abs(bend[i]) * 0.0000174533 + 0.001;
    rr = 80 / th;
    vcor[i] = min3(sqrt(450 * rr), rr * 2.4, 420);
    runoff[i] = (abs(bend[i]) > 22000);
  END
  RETURN 0;
END

FUNCTION min3(a, b, c);
BEGIN
  IF (b < a) a = b; END
  IF (c < a) a = c; END
  RETURN a;
END

// Rotates the point list so that index 0 (the start line) sits at the
// end of the straightest stretch, and builds the checkpoint list
FUNCTION place_start();
PRIVATE i, k, s, sum, best, bi, j, t;
BEGIN
  // sliding window: total turning from 12 points behind to 4 ahead
  sum = 0;
  FOR k = -12 TO 4 sum += abs(turn[(k + np) % np]); END
  best = sum; bi = 0;
  FOR i = 1 TO np - 1
    sum += abs(turn[(i + 4) % np]) - abs(turn[(i - 13 + np) % np]);
    IF (sum < best) best = sum; bi = i; END
  END
  FOR i = 0 TO np - 1 dxs[i] = tx[(i + bi) % np]; dys[i] = ty[(i + bi) % np]; END
  FOR i = 0 TO np - 1 tx[i] = dxs[i]; ty[i] = dys[i]; END
  // checkpoints: the start line plus one gate at every knot (the corners)
  FOR k = 0 TO nk - 1 kidx[k] = (kidx[k] - bi + np * 2) % np; END
  FOR i = 1 TO nk - 1                                 // insertion sort
    t = kidx[i]; j = i - 1;
    WHILE (j >= 0 AND kidx[j] > t) kidx[j + 1] = kidx[j]; j--; END
    kidx[j + 1] = t;
  END
  gate[0] = 0; ng = 1;
  FOR k = 0 TO nk - 1
    IF (kidx[k] - gate[ng - 1] > 10 AND kidx[k] < np - 10)
      gate[ng] = kidx[k]; ng++;
    END
  END
  RETURN 0;
END

// Paints the start/finish line: a checker band across the track
FUNCTION paint_start();
PRIVATE k, j, pa, px, py, c;
BEGIN
  pa = ta[0] + 90000;
  FOR k = -HW / 5 TO HW / 5 - 1
    FOR j = 0 TO 1
      px = tx[0] + get_distx(pa, k * 5 + 2) + get_distx(ta[0], j * 5 - 5);
      py = ty[0] + get_disty(pa, k * 5 + 2) + get_disty(ta[0], j * 5 - 5);
      c = 20 + 225 * ((k + j + 100) % 2);
      gfx_rect(g_map, px - 3, py - 3, 6, 6, c, c, c);
    END
  END
  // grid boxes behind the line
  FOR k = 0 TO 3
    j = np - 2 - (k / 2) * 3;
    px = tx[j] + get_distx(pa, 22 - (k % 2) * 44);
    py = ty[j] + get_disty(pa, 22 - (k % 2) * 44);
    gfx_circle_outline(g_map, px, py, 9, 220, 220, 220);
  END
  RETURN 0;
END

FUNCTION paint_tree(px, py, r);
BEGIN
  gfx_circle(g_map, px + 5, py + 5, r, 36, 70, 30);        // shadow
  gfx_circle(g_map, px, py, r, 30, 96, 38);
  gfx_circle(g_map, px - r / 4, py - r / 4, r * 2 / 3, 46, 124, 48);
  gfx_circle(g_map, px - r / 3, py - r / 3, r / 3, 70, 150, 60);
  gfx_circle(g_mini, px / 16, py / 16, 1, 30, 80, 30);
  ob_x[nob] = px; ob_y[nob] = py; ob_r[nob] = r * 3 / 4; nob++;
  RETURN 0;
END

FUNCTION paint_tyre(px, py);
BEGIN
  gfx_circle(g_map, px, py, 7, 22, 22, 24);
  gfx_circle(g_map, px, py, 3, 80, 80, 84);
  ob_x[nob] = px; ob_y[nob] = py; ob_r[nob] = 7; nob++;
  RETURN 0;
END

// Oil (dark, rainbow rim) or a puddle (blue) on the asphalt
FUNCTION paint_slick(i);
PRIVATE px, py, r, pa;
BEGIN
  pa = ta[i] + 90000;
  r = rand(15, 22);
  px = tx[i] + get_distx(pa, rand(-HW + r, HW - r));
  py = ty[i] + get_disty(pa, rand(-HW + r, HW - r));
  IF (rand(0, 1))
    gfx_circle(g_map, px, py, r, 120, 60, 140);
    gfx_circle(g_map, px, py, r - 2, 18, 18, 22);
    gfx_circle(g_map, px + r / 3, py - r / 3, r / 3, 40, 40, 55);
  ELSE
    gfx_circle(g_map, px, py, r, 90, 130, 180);
    gfx_circle(g_map, px - 3, py - 2, r - 5, 120, 165, 210);
  END
  sl_x[nsl] = px; sl_y[nsl] = py; sl_r[nsl] = r; nsl++;
  RETURN 0;
END

// Builds a new circuit over many frames, then puts the cars on the grid
PROCESS builder();
PRIVATE i, j, k, n, ok, lim, ex, ey, c, pa, px, py, r, sd;
BEGIN
  state = 0; gen_pct = 0; tries = 0;
  FRAME;
  seed = rand(1, 999999);
  rand_seed(seed);
  ok = 0;
  WHILE (ok == 0)
    tries++;
    make_knots(); spline();
    FRAME;
    resample();
    FRAME;
    measure();
    FRAME;
    ok = 1;
    FOR i = 0 TO np - 1                               // no kinks
      IF (abs(turn[i]) > 30000) ok = 0; END
    END
    // no two stretches of track closer than a track width (+ margin)
    i = 0;
    WHILE (i < np AND ok)
      j = i + 17; lim = i + np - 17;
      IF (lim > np - 1) lim = np - 1; END
      WHILE (j <= lim)
        ex = tx[i] - tx[j]; ey = ty[i] - ty[j];
        IF (abs(ex) < 150 AND abs(ey) < 150)
          IF (ex * ex + ey * ey < 22500) ok = 0; END
        END
        j += 2;
      END
      i += 2;
      IF (i % 24 == 0) gen_pct = i * 30 / np; FRAME; END
    END
  END
  place_start();
  FRAME;
  measure();
  gen_pct = 30;
  FRAME;

  // grass: base colour, mowed stripes, darker blotches
  gfx_fill(g_map, 66, 128, 50);
  FOR k = 0 TO MAPH / 80
    IF (k % 2) gfx_rect(g_map, 0, k * 80, MAPW, 40, 72, 136, 54); END
  END
  FOR k = 0 TO 119
    gfx_circle(g_map, rand(0, MAPW), rand(0, MAPH), rand(20, 60), 60, rand(112, 122), 46);
  END
  FRAME;
  FOR k = 0 TO 2999
    gfx_pixel(g_map, rand(0, MAPW), rand(0, MAPH), 48, 100, 38);
    IF (k % 1000 == 999) FRAME; END
  END
  gfx_fill_rgba(g_mini, 20, 50, 24, 80);
  gen_pct = 45;

  // sand traps on the outside of corners
  FOR i = 0 TO np - 1
    IF (runoff[i])
      pa = ta[i] - sign(bend[i]) * 90000;
      gfx_circle(g_map, tx[i] + get_distx(pa, 22), ty[i] + get_disty(pa, 22), HW + 20, 214, 190, 130);
    END
  END
  FRAME;
  // kerbs (red/white on corners), white edge line, asphalt
  FOR i = 0 TO np - 1
    IF (runoff[i] OR runoff[(i + 2) % np] OR runoff[(i + np - 2) % np])
      IF ((i / 2) % 2) gfx_circle(g_map, tx[i], ty[i], HW + 8, 220, 40, 40);
      ELSE gfx_circle(g_map, tx[i], ty[i], HW + 8, 240, 240, 240); END
    END
  END
  FRAME;
  FOR i = 0 TO np - 1 gfx_circle(g_map, tx[i], ty[i], HW + 2, 235, 235, 235); END
  FRAME;
  FOR i = 0 TO np - 1
    gfx_circle(g_map, tx[i], ty[i], HW, 88, 88, 94);
    gfx_circle(g_mini, tx[i] / 16, ty[i] / 16, 3, 150, 150, 155);
  END
  FRAME;
  FOR k = 0 TO 2499                                   // asphalt grain
    i = rand(0, np - 1); pa = rand(0, 359999); r = rand(0, HW - 2);
    c = rand(70, 105);
    gfx_pixel(g_map, tx[i] + get_distx(pa, r), ty[i] + get_disty(pa, r), c, c, c + 4);
    IF (k % 800 == 799) FRAME; END
  END
  paint_start();
  gfx_rect(g_mini, tx[0] / 16 - 1, ty[0] / 16 - 1, 3, 3, 255, 255, 255);
  gen_pct = 65;
  FRAME;

  // scenery: tyre walls outside the sharpest corners, trees on the grass,
  // oil and puddles on the track (never near the start)
  nob = 0; nsl = 0;
  i = 20;
  WHILE (i < np - 10 AND nob < 40)
    IF (abs(bend[i]) > 34000)
      pa = ta[i] - sign(bend[i]) * 90000;
      FOR k = -2 TO 2
        j = (i + k + np) % np;
        px = tx[j] + get_distx(pa, HW + 50); py = ty[j] + get_disty(pa, HW + 50);
        IF (track_dist(px, py) > HW + 40) paint_tyre(px, py); END
      END
      i += 14;
      FRAME;
    END
    i++;
  END
  n = 0;
  WHILE (n < 300 AND nob < 96)
    px = rand(40, MAPW - 40); py = rand(40, MAPH - 40);
    r = rand(12, 22);
    IF (track_dist(px, py) > HW + 70 + r) paint_tree(px, py, r); END
    n++;
    IF (n % 6 == 0) FRAME; gen_pct = 65 + n / 10; END
  END
  FOR k = 0 TO rand(3, 5)
    paint_slick(rand(np / 8, np - 20));
  END
  gen_pct = 100;

  // the grid: two rows of two behind the line, the player at the back
  pa = ta[0] + 90000;
  FOR k = 0 TO 3
    sd = (k + 1) % 4;                   // slots 0..2: AI, slot 3: player
    j = np - 2 - (k / 2) * 3;
    car(sd, tx[j] + get_distx(pa, 22 - (k % 2) * 44), ty[j] + get_disty(pa, 22 - (k % 2) * 44), ta[j]);
  END
  cam_x = tx[np - 4] - 320; cam_y = ty[np - 4] - 240;
  IF (first_race) state = 1; ELSE state = 2; count_t = 3.99; END
END

// =====================================================================
// Cars
// =====================================================================

// Keeps cni[ci] on the nearest centreline point: a small window around
// the last one every frame, the whole track every 20 frames
FUNCTION track_near(ci, px, py);
PRIVATE i, k, best, bi, ex, ey, d;
BEGIN
  best = 999999999; bi = cni[ci];
  FOR k = -8 TO 8
    i = (cni[ci] + k + np) % np;
    ex = tx[i] - px; ey = ty[i] - py; d = ex * ex + ey * ey;
    IF (d < best) best = d; bi = i; END
  END
  cscan[ci]++;
  IF (cscan[ci] >= 20)
    cscan[ci] = 0;
    FOR i = 0 TO np - 1
      ex = tx[i] - px; ey = ty[i] - py; d = ex * ex + ey * ey;
      IF (d < best - 900) best = d; bi = i; END
    END
  END
  cni[ci] = bi; cdist[ci] = sqrt(best);
  RETURN 0;
END

// Computer driver: aims at a point ahead on the centreline (shifted to
// its lane, or around a car in front) and keeps to the speed that lets
// it brake in time for the tightest corner ahead
FUNCTION ai_drive(ci, px, py, sp);
PRIVATE i, j, k, la, pa, off, gx, gy, want, vt, v2, ex, ey, fx, fy, fw, sd, dec, vfol;
BEGIN
  la = 2 + int(sp * 0.012);
  i = (cni[ci] + la) % np;
  off = clane[ci];
  fx = get_distx(cang[ci], 1); fy = get_disty(cang[ci], 1);
  vfol = 999;
  FOR j = 0 TO 3                     // a car close ahead: go round it
    IF (j != ci)                     // (sd > 0: it is on our left)
      ex = cx[j] - px; ey = cy[j] - py;
      fw = ex * fx + ey * fy;
      sd = ex * fy - ey * fx;
      IF (fw > 0 AND fw < 80 AND abs(sd) < 24)
        IF (sd > 0) off -= 26; ELSE off += 26; END
        IF (fw < 40) vfol = sqrt(cvx[j] * cvx[j] + cvy[j] * cvy[j]); END
      END
    END
  END
  off = clamp(off, -HW + 16, HW - 16);
  pa = ta[i] + 90000;
  gx = tx[i] + get_distx(pa, off); gy = ty[i] + get_disty(pa, off);
  // steer the nose towards the target, plus a little extra when the
  // velocity lags behind (the car slides), but never more than 25 degrees
  // past the target: a sliding car keeps turning in without spinning
  want = fget_angle(px, py, gx, gy);
  IF (sp > 60)
    want += clamp(adiff(want - fget_angle(0, 0, cvx[ci], cvy[ci])), -25000, 25000);
  END
  ai_steer = clamp(adiff(want - cang[ci]) * 0.0001, -1, 1);

  dec = 400 * cskill[ci];
  vt = 999;
  FOR k = 1 TO 24
    i = (cni[ci] + k) % np;
    v2 = vcor[i] * cskill[ci];
    v2 = sqrt(v2 * v2 + 2 * dec * k * GAP);
    IF (v2 < vt) vt = v2; END
  END
  IF (cdist[ci] > HW + 10) vt = clamp(vt, 0, 140); END
  IF (vfol < vt) vt = vfol; END      // no room yet: follow it
  ai_thr = (sp < vt);
  ai_brk = (sp > vt + 20);

  // stuck against something: back off for a moment
  IF (state == 3 AND sp < 25) cstuck[ci] += get_delta(); ELSE cstuck[ci] = 0; END
  IF (cstuck[ci] > 1.2) crev[ci] = 0.9; cstuck[ci] = 0; END
  IF (crev[ci] > 0)
    crev[ci] -= get_delta();
    ai_thr = 0; ai_brk = 1; ai_steer = -ai_steer;
  END
  RETURN 0;
END

// Called by the car on itself: counts checkpoints, laps and the finish
FUNCTION checkpoints(ci);
PRIVATE g, k, lt;
BEGIN
  IF (cfin[ci]) RETURN 0; END
  g = cgates[ci] % ng;
  k = (cni[ci] - gate[g] + np) % np;
  cmiss[ci] = (k >= 12 AND k < np / 2 AND cgates[ci] > 0);
  IF (k < 6 AND cdist[ci] < HW + 40)
    cgates[ci]++;
    IF (g == 0)
      IF (cgates[ci] > 1)                           // a lap is done
        lt = race_t - clapst[ci];
        IF (ci == 0)
          last_lap = lt;
          IF (best_lap == 0 OR lt < best_lap) best_lap = lt; END
        END
      END
      clapst[ci] = race_t;
      IF (cgates[ci] == LAPS * ng + 1)              // chequered flag
        fin_count++; cfin[ci] = fin_count; ctime[ci] = race_t;
      ELSE
        IF (ci == 0 AND cgates[ci] == (LAPS - 1) * ng + 1) msg_t = 2.5; END
      END
    END
  END
  RETURN 0;
END

PROCESS dust(px, py);
PRIVATE t;
BEGIN
  ctype = c_scroll; z = 5; graph = g_dust;
  x = px; y = py; size = 70; alpha = 60;
  n_dust++;
  FOR t = 1 TO 24
    size += 6; alpha = 60 - t * 5 / 2;
    y -= 0.3;
    FRAME;
  END
  n_dust--;
END

PROCESS car(ci, px0, py0, a0);
PRIVATE vx, vy, fx, fy, rx, ry, fwd, lat, dl, dt, sp, thr, brk, steer, hb,
        surf, grip, cap, vmax, rate, i, ex, ey, d, nx, ny, vn, ov,
        skid, lwx, lwy, rwx, rwy, wx, wy, bx, by, dust_t;
BEGIN
  ctype = c_scroll; z = 0; graph = g_car[ci];
  x = px0; y = py0; angle = a0;
  cang[ci] = a0; cvx[ci] = 0; cvy[ci] = 0; cpx[ci] = 0; cpy[ci] = 0;
  cgates[ci] = 0; cfin[ci] = 0; ctime[ci] = 0; clapst[ci] = 0;
  cscan[ci] = ci * 5; cni[ci] = np - 3; cstuck[ci] = 0; crev[ci] = 0;
  cskill[ci] = 1.0;
  IF (ci == 1) cskill[ci] = 0.95; END              // RED is the quickest
  IF (ci == 2) cskill[ci] = 0.92; END
  IF (ci == 3) cskill[ci] = 0.89; END
  clane[ci] = rand(-14, 14);
  LOOP
    dt = clamp(get_delta(), 0, 0.05);
    // x, y are the truth (a test can move the car); pushes from others
    x += cpx[ci]; y += cpy[ci]; cpx[ci] = 0; cpy[ci] = 0;
    vx = cvx[ci]; vy = cvy[ci];
    sp = sqrt(vx * vx + vy * vy);
    track_near(ci, x, y);

    // ---- who is driving
    thr = 0; brk = 0; steer = 0; hb = 0;
    IF (state >= 3)
      IF (ci == 0 AND autopilot == 0 AND cfin[0] == 0)
        thr = key(_up); brk = key(_down); hb = key(_space);
        steer = key(_left) - key(_right);
      ELSE
        ai_drive(ci, x, y, sp);
        thr = ai_thr; brk = ai_brk; steer = ai_steer;
      END
    END

    // ---- surface under the car
    surf = 0;                                       // asphalt
    IF (cdist[ci] > HW) surf = 1; END               // kerb
    IF (cdist[ci] > HW + 8)
      surf = 2;                                     // grass
      IF (runoff[cni[ci]] AND cdist[ci] < HW + 42) surf = 3; END   // sand
    END
    FOR i = 0 TO nsl - 1
      ex = x - sl_x[i]; ey = y - sl_y[i];
      IF (ex * ex + ey * ey < sl_r[i] * sl_r[i]) surf = 4; END      // oil
    END
    SWITCH (surf)
      CASE 0 grip = 6.0; cap = 520; vmax = 330;
      CASE 1 grip = 5.0; cap = 450; vmax = 315;
      CASE 2 grip = 2.2; cap = 250; vmax = 150;
      CASE 3 grip = 1.8; cap = 200; vmax = 110;
      CASE 4 grip = 0.4; cap = 50;  vmax = 330;
    END
    IF (ci > 0) vmax = vmax * (0.35 + cskill[ci] * 0.65); END
    IF (hb) grip = grip * 0.3; cap = cap * 0.35; END

    // ---- split the velocity into forward and sideways parts
    fx = get_distx(cang[ci], 1); fy = get_disty(cang[ci], 1);
    rx = -fy; ry = fx;
    fwd = vx * fx + vy * fy;
    lat = vx * rx + vy * ry;

    // engine, brakes, reverse, rolling drag
    IF (thr AND fwd < vmax)
      fwd += 320 * (1.0 - 0.6 * fwd / (vmax + 0.01)) * dt;
    END
    IF (fwd > vmax) fwd -= 380 * dt; END
    IF (brk)
      IF (fwd > 5) fwd -= 560 * dt; ELSE IF (fwd > -110) fwd -= 220 * dt; END END
    END
    IF (thr == 0 AND brk == 0) fwd -= fwd * 0.9 * dt; END
    IF (hb) fwd -= fwd * 0.7 * dt; END

    // grip: only a limited amount of the slide is removed each frame
    dl = abs(lat) * grip * dt;
    IF (dl > cap * dt) dl = cap * dt; END
    IF (dl > abs(lat)) dl = abs(lat); END
    lat -= sign(lat) * dl;

    // steering: quicker at low speed, reversed when backing up
    rate = (240000 - abs(fwd) * 280) * clamp(abs(fwd) * 0.02, 0, 1);
    IF (hb) rate = rate * 1.4; END
    IF (fwd < 0) steer = -steer; END
    cang[ci] = (cang[ci] + steer * rate * dt) % 360000;

    vx = fx * fwd + rx * lat; vy = fy * fwd + ry * lat;
    x += vx * dt; y += vy * dt;

    // ---- scenery: bounce off trees and tyres
    FOR i = 0 TO nob - 1
      ex = x - ob_x[i]; ey = y - ob_y[i];
      IF (abs(ex) < 40 AND abs(ey) < 40)
        d = sqrt(ex * ex + ey * ey) + 0.01;
        IF (d < ob_r[i] + 9)
          nx = ex / d; ny = ey / d;
          x += nx * (ob_r[i] + 9 - d); y += ny * (ob_r[i] + 9 - d);
          vn = vx * nx + vy * ny;
          IF (vn < 0)
            vx -= nx * vn * 1.4; vy -= ny * vn * 1.4;
            vx = vx * 0.8; vy = vy * 0.8;
            n_hits++;
          END
        END
      END
    END
    // ---- other cars: push both apart, share the impact
    FOR i = 0 TO 3
      IF (i != ci AND state >= 1)          // (cx/cy are set once all exist)
        ex = x - cx[i]; ey = y - cy[i];
        IF (abs(ex) < 22 AND abs(ey) < 22)
          d = sqrt(ex * ex + ey * ey) + 0.01;
          IF (d < 20)
            nx = ex / d; ny = ey / d; ov = (20 - d) * 0.5;
            x += nx * ov; y += ny * ov;
            cpx[i] -= nx * ov; cpy[i] -= ny * ov;
            vn = (vx - cvx[i]) * nx + (vy - cvy[i]) * ny;
            IF (vn < 0)
              vx -= nx * vn * 0.65; vy -= ny * vn * 0.65;
              cvx[i] += nx * vn * 0.65; cvy[i] += ny * vn * 0.65;
              n_bumps++;
            END
          END
        END
      END
    END
    IF (x < 12 OR x > MAPW - 12) vx = 0; x = clamp(x, 12, MAPW - 12); END
    IF (y < 12 OR y > MAPH - 12) vy = 0; y = clamp(y, 12, MAPH - 12); END

    // ---- skid marks (into the track graphic) and dust
    bx = x - fx * 8; by = y - fy * 8;
    wx = bx + rx * 5; wy = by + ry * 5;
    IF (abs(lat) > 75 OR (hb AND abs(fwd) > 60) OR (brk AND fwd > 150))
      IF (skid)
        IF (surf >= 2)
          gfx_line(g_map, lwx, lwy, wx, wy, 92, 90, 50);
          gfx_line(g_map, rwx, rwy, bx - rx * 5, by - ry * 5, 92, 90, 50);
        ELSE
          gfx_line(g_map, lwx, lwy, wx, wy, 40, 40, 44);
          gfx_line(g_map, rwx, rwy, bx - rx * 5, by - ry * 5, 40, 40, 44);
        END
      END
      skid = 1;
    ELSE
      skid = 0;
    END
    lwx = wx; lwy = wy; rwx = bx - rx * 5; rwy = by - ry * 5;
    dust_t -= dt;
    IF (surf >= 2 AND surf <= 3 AND sp > 60 AND dust_t <= 0 AND n_dust < 30)
      dust(bx, by); dust_t = 0.07;
    END

    cvx[ci] = vx; cvy[ci] = vy; cx[ci] = x; cy[ci] = y;
    angle = cang[ci];
    IF (state >= 3) checkpoints(ci); END

    // ---- the camera looks ahead of the player
    IF (ci == 0)
      cam_x += (x + vx * 0.35 - 320 - cam_x) * clamp(5 * dt, 0, 1);
      cam_y += (y + vy * 0.35 - 240 - cam_y) * clamp(5 * dt, 0, 1);
      scroll.x0 = clamp(int(cam_x), 0, MAPW - 640);
      scroll.y0 = clamp(int(cam_y), 0, MAPH - 480);
    END
    FRAME;
  END
END

// =====================================================================
// HUD and race control
// =====================================================================

PROCESS banner();
BEGIN
  x = 320; y = 170; z = -30;
  LOOP
    graph = 0;
    IF (state == 1) graph = g_title; y = 110; END
    IF (state == 2) graph = g_big[clamp(3 - int(count_t + 0.999), 0, 2)]; y = 180; END
    IF (state == 3 AND race_t < 1.0) graph = g_big[3]; y = 180; END
    IF (state == 4) graph = g_fin; y = 100; END
    FRAME;
  END
END

PROCESS pos_badge();
BEGIN
  x = 162; y = 36; z = -30;
  LOOP
    graph = 0;
    IF (state >= 2) graph = g_pos[p_pos - 1]; END
    FRAME;
  END
END

PROCESS panel(g, px, py);
BEGIN
  graph = g; x = px; y = py; z = -20;
  LOOP FRAME; END
END

// Progress of every car (checkpoints, then points to the next one) and
// the live order; finished cars keep their finishing place
FUNCTION rank_cars();
PRIVATE i, j, g, r;
BEGIN
  FOR i = 0 TO 3
    g = cgates[i] % ng;
    cprog[i] = cgates[i] * 1000 - (gate[g] - cni[i] + np) % np;
    IF (cfin[i]) cprog[i] = 1000000 - cfin[i] * 1000; END
  END
  FOR i = 0 TO 3
    r = 1;
    FOR j = 0 TO 3
      IF (cprog[j] > cprog[i] OR (cprog[j] == cprog[i] AND j < i)) r++; END
    END
    crank[i] = r;
  END
  p_pos = crank[0];
  p_lap = clamp((cgates[0] - 1) / ng + 1, 1, LAPS);
  RETURN 0;
END

FUNCTION draw_hud();
PRIVATE i, j, yy;
BEGIN
  // top left: lap, times, position badge
  draw_rect(6, 6, 212, 70, 'rgba(0,0,0,0.55)');
  set_color('#ffffff');
  text(14, 12, "LAP " + p_lap + "/" + LAPS);
  IF (cfin[0]) text(14, 26, "TIME " + fmt(ctime[0]));
  ELSE text(14, 26, "TIME " + fmt(race_t)); END
  set_color('#c0c8d8');
  IF (last_lap > 0) text(14, 40, "LAST " + fmt(last_lap)); ELSE text(14, 40, "LAST -"); END
  set_color('#90ff90');
  IF (best_lap > 0) text(14, 54, "BEST " + fmt(best_lap)); ELSE text(14, 54, "BEST -"); END

  // minimap car dots and the running order under it
  FOR i = 3 TO 0 STEP -1
    draw_rect(476 + cx[i] / 16 - 2, 8 + cy[i] / 16 - 2, 4, 4, ccol(i));
  END
  draw_rect(476, 132, 160, 64, 'rgba(0,0,0,0.55)');
  FOR j = 1 TO 4
    FOR i = 0 TO 3
      IF (crank[i] == j)
        set_color(ccol(i));
        yy = 122 + j * 14;
        text(484, yy, j + ". " + cname(i));
        IF (cfin[i]) text(560, yy, fmt(ctime[i]));
        ELSE text(560, yy, "lap " + clamp((cgates[i] - 1) / ng + 1, 1, LAPS)); END
      END
    END
  END

  // speedometer
  i = int(sqrt(cvx[0] * cvx[0] + cvy[0] * cvy[0]));
  draw_rect(14, 452, 124, 16, 'rgba(0,0,0,0.55)');
  draw_rect(16, 454, clamp(i * 120 / 330, 0, 120), 12, '#ffd23c');
  set_color('#ffffff');
  text(144, 456, i / 3 + " km/h");

  IF (state == 3)
    IF (cmiss[0] AND (int(race_t * 4) % 2 == 0))
      set_color('#ff4040');
      text(220, 300, "MISSED A CHECKPOINT - GO BACK!");
    END
    IF (msg_t > 0)
      msg_t -= get_delta();
      set_color('#ffe060');
      text(284, 130, "FINAL LAP!");
    END
  END
  RETURN 0;
END

FUNCTION draw_results();
PRIVATE i, j, yy;
BEGIN
  draw_rect(150, 140, 340, 200, 'rgba(0,0,0,0.75)');
  set_color('#ffffff');
  text(170, 152, "RESULTS          TIME");
  FOR j = 1 TO 4
    FOR i = 0 TO 3
      IF (crank[i] == j)
        yy = 162 + j * 18;
        set_color(ccol(i));
        text(170, yy, ordinal(j) + "  " + cname(i));
        IF (cfin[i]) text(278, yy, fmt(ctime[i])); ELSE text(278, yy, "still racing..."); END
      END
    END
  END
  set_color('#90ff90');
  text(170, 270, "Your best lap: " + fmt(best_lap));
  set_color('#ffe060');
  text(170, 300, "SPACE / ENTER: next race, new track");
  RETURN 0;
END

FUNCTION new_race();
BEGIN
  signal(TYPE car, s_kill);
  signal(TYPE dust, s_kill);
  signal(TYPE builder, s_kill);
  n_dust = 0; fin_count = 0; race_t = 0; last_lap = 0; best_lap = 0;
  msg_t = 0; p_pos = 4; p_lap = 1;
  builder();
  RETURN 0;
END

// =====================================================================
// MAIN
// =====================================================================
BEGIN
  set_mode(640, 480);
  set_fps(60, 0);
  screen_color('#0a1208');
  make_graphics();
  start_scroll(0, 0, g_map, 0, 0, 0);
  panel(g_mini, 556, 68);
  banner();
  pos_badge();
  new_race();
  LOOP
    SWITCH (state)
      CASE 0
        draw_rect(0, 0, 640, 480, '#0a1208');
        set_color('#ffffff');
        text(250, 230, "Building track... " + gen_pct + "%");
      CASE 1
        draw_rect(120, 150, 400, 200, 'rgba(0,0,0,0.72)');
        set_color('#ffffff');
        text(140, 166, "3 laps against RED, BLUE and GREEN.");
        text(140, 184, "UP accelerate   DOWN brake / reverse");
        text(140, 200, "LEFT / RIGHT steer   SPACE handbrake");
        set_color('#c0c8d8');
        text(140, 222, "Grass, sand and oil make the car slide.");
        text(140, 238, "Every corner has a checkpoint: no cutting!");
        text(140, 254, "A new track is built for every race.");
        set_color('#60ff60');
        text(140, 290, "PRESS SPACE OR ENTER TO START");
        IF (key_pressed(_space) OR key_pressed(_enter))
          state = 2; count_t = 3.99; first_race = 0;
        END
      CASE 2
        count_t -= get_delta();
        IF (count_t <= 0) state = 3; race_t = 0; END
      CASE 3
        race_t += get_delta();
        IF (cfin[0]) state = 4; END
      CASE 4
        race_t += get_delta();
        IF (key_pressed(_space) OR key_pressed(_enter)) new_race(); END
    END
    IF (state >= 2)
      rank_cars();
      draw_hud();
      IF (state == 4) draw_results(); END
    END
    FRAME;
  END
END
