PROGRAM strike;

// DUNE STRIKE - a helicopter strike campaign in the style of Desert
// Strike (EA, 1992). Every campaign is generated from a seed:
//
// * Terrain: three value-noise lattices give the dunes (shaded by their
//   slope, lit from the top left), winding rocky ridges (a contour line
//   of a third noise) and a wiggly coastline along one random edge; a
//   few oases get a pond and palm trees. The map (2048x1536) is painted
//   once (three painter processes share the work over the first frames)
//   into a big graphic shown by a scroll window, plus a 1-pixel-per-tile
//   copy for the radar.
// * Bases are dropped on a jittered grid, sorted by distance from the
//   landing zone, and joined by a tree of curved dirt roads that tanks
//   and trucks patrol. The nearest bases carry the missions, the last
//   one is always the command bunker, so the war moves inland and the
//   defences (AAA, SAMs, bunkers, soldiers, tank patrols) grow with it.
// * The helicopter flies with inertia, is drawn ALT pixels above its
//   shadow (3/4 view) and has guns, Hydra rockets and homing Hellfires.
//   Hovering slowly over a crate or a pilot lowers the winch.
// * Shots and particles live in fixed pools drawn by manager processes;
//   wrecks and scorch marks are painted into the map for good.
// * Sound, made by the engine (sfx, sfx_tone, song_*), no files: the
//   rotor's chop, chain gun, Hydra rockets, Hellfire launches with a
//   lock-on (or no-lock) tone, explosions by size, fading with distance
//   from the screen and panned, enemy guns, flak, tank shells and SAM
//   launches, a missile warning while a SAM is in the air, hits on the
//   armour, the winch, pickups and rescues, low fuel and low armour
//   alarms. Music: a desert march on the title, a tense briefing theme,
//   battle music (faster for the command bunker), jingles for a mission
//   complete, game over and a won campaign.
//
// Controls: LEFT/RIGHT turn, UP thrust, DOWN brake/reverse, A/D (or
// SHIFT+LEFT/RIGHT) strafe, SPACE guns, Z Hydra rockets, X Hellfire, M map/briefing (pause),
// N music on/off.

GLOBAL
  MW = 128; MH = 96; WW = 2048; WH = 1536;   // map size in 16 px tiles / pixels
  E = 127;                                   // last entity slot
  ALT = 30;                                  // flying height above the shadow

  // ---- game state
  state = 1;       // 0 title, 1 building map, 2 briefing, 3 flying, 4 shot down, 5 game over, 6 campaign won
  paused = 0; seed = 0; campaign = 1; score = 0; lives = 3; gen_pct = 0;
  msg_id = 0; msg_t = 0.0; down_t = 0.0; done_t = 0.0; game_t = 0.0;
  diff = 0; rfac = 1.0; dfac = 1.0;          // difficulty: reload and damage factors

  // ---- the helicopter
  hx = 0.0; hy = 0.0; hvx = 0.0; hvy = 0.0; hang = 90000; hspd = 0.0; heli_on = 0;
  armor = 100.0; fuel = 100.0; n_gun = 0; n_hyd = 0; n_hf = 0;
  gun_rl = 0.0; hyd_rl = 0.0; hf_rl = 0.0; gun_side = 1; hurt_t = 0.0; inv_t = 0.0;
  winch = -1; carry = 0; cg[5]; unload_t = 0.0;
  shots_fired = 0; crates_got = 0; kills = 0;  // statistics (also read by the tests)
  cam_x = 0.0; cam_y = 0.0;

  // ---- terrain generator
  lat[299]; lat2[899]; lat3[499]; sw8[8];
  coast = 0; t_dc = 0; ln_y = 0;             // sea edge (0 W, 1 E, 2 N, 3 S); last coast distance; land_near's y
  oa_x[3]; oa_y[3];                          // oasis centres, in tiles
  rp_x[399]; rp_y[399]; n_rp = 0;            // road points; road r runs rd_a[r]..rd_b[r]
  rd_a[9]; rd_b[9]; n_rd = 0;
  rk[1999]; n_rk = 0; n_paint = 0;           // rock tiles, painters done
  st_x[9]; st_y[9]; n_st = 0;                // bases, nearest to the landing zone first
  lz_x = 0; lz_y = 0;                        // landing zone (helipad)

  // ---- missions: 0 radar, 1 rescue, 2 SAM battery, 3 convoy, 4 command bunker
  nm = 5; cur_m = 0; m_left = 0;
  m_type[4]; m_need[4]; m_got[4];

  // ---- entities. Kinds: 0 radar, 1 SAM, 2 AAA, 3 tank, 4 truck, 5 bunker,
  // 6 command bunker, 7 barracks, 8 prison camp, 9 pilot, 10 fuel crate,
  // 11 ammo crate, 12 armour crate, 13 soldier
  e_on[127]; e_gen[127]; e_kind[127]; e_x[127]; e_y[127]; e_hp[127];
  e_grp[127]; e_tgt[127]; e_lift[127]; e_gone[127]; e_fl[127];
  e_ri[127]; e_dir[127]; e_rd[127]; e_aim[127];
  near[127]; n_near = 0;                     // entities around the helicopter this frame
  k_hp[13]; k_rad[13]; k_pts[13]; g_k[13];

  // ---- pools: player shots, enemy shots, particles, burning wrecks
  pb_on[47]; pb_k[47]; pb_x[47]; pb_y[47]; pb_a[47]; pb_spd[47]; pb_t[47];
  pb_life[47]; pb_tg[47]; pb_tgen[47]; pb_cur = 0;
  eb_on[79]; eb_k[79]; eb_x[79]; eb_y[79]; eb_a[79]; eb_spd[79]; eb_t[79];
  eb_h[79]; eb_dmg[79]; eb_cur = 0;
  fx_on[199]; fx_k[199]; fx_x[199]; fx_y[199]; fx_h[199]; fx_vx[199]; fx_vy[199];
  fx_vh[199]; fx_life[199]; fx_max[199]; fx_s[199]; fx_cur = 0; n_fx = 0;
  bf_x[23]; bf_y[23]; bf_t[23]; bf_cur = 0;

  // ---- graphics
  g_map = 0; g_mini = 0; g_heli = 0; g_rotor = 0; g_shadow = 0; g_tur = 0;
  g_title = 0; g_over = 0; g_win = 0; g_dim = 0;

  // ---- sound: ids made once, a private random generator for the pitch
  // variations (the campaign's seeded rand() sequence stays untouched),
  // times of the last sounds of each kind (rate limits), the music wanted
  sn_gun[1]; sn_hydra = 0; sn_pop = 0; sn_hf = 0; sn_lock = 0; sn_nolock = 0; sn_boom[2];
  sn_ting = 0; sn_thud = 0; sn_emg = 0; sn_flak = 0; sn_tank = 0; sn_sam = 0; sn_warn = 0;
  sn_clang = 0; sn_chop = 0; sn_winch = 0; sn_pilot = 0; sn_fuel = 0; sn_ammo = 0; sn_armor = 0;
  sn_freed = 0; sn_down = 0; sn_sputter = 0; sn_alarm = 0; sn_alarm2 = 0; sn_menu = 0; sn_takeoff = 0;
  sn_r = 777; sn_tick = 0; sn_gi = 0; sn_t = 0; sn_sams = 0; sn_prev = -1;
  sn_gun_t = -99; sn_hit_t = -99; sn_clang_t = -99; sn_boom_t[2]; sn_ef_t[3];
  sn_music = 1; sn_want = 0; sn_cur = -1; sn_loop = 1;
  song_title = 0; song_brief = 0; song_war = 0; song_final = 0; song_done = 0; song_over = 0; song_won = 0;

// ==== Small helpers (there are no min/max natives) ====
FUNCTION fmin(a, b); BEGIN IF (a < b) RETURN a; END RETURN b; END
FUNCTION fmax(a, b); BEGIN IF (a > b) RETURN a; END RETURN b; END

// 1 for the kinds the player can shoot (not pilots or crates)
FUNCTION hostile(k); BEGIN RETURN (k < 9 OR k == 13); END

// Scrambles a seed: close seeds would otherwise start rand() alike
FUNCTION hash(v);
PRIVATE i;
BEGIN
  FOR i = 0 TO 3 v = (v * 7919 + 104729) % 999983; v = (v * v + 12345) % 999979; END RETURN v; END

FUNCTION init_tables();
PRIVATE k;
BEGIN
  sw8[0] = 0;  sw8[1] = 3;  sw8[2] = 10; sw8[3] = 20; sw8[4] = 32;
  sw8[5] = 44; sw8[6] = 54; sw8[7] = 61; sw8[8] = 64;   // smoothstep * 64
  //            radar SAM AAA tank truck bunk CMD barr pris pilot F  A  +  soldier
  k_hp[0] = 60; k_hp[1] = 50; k_hp[2] = 40; k_hp[3] = 45; k_hp[4] = 20;
  k_hp[5] = 70; k_hp[6] = 420; k_hp[7] = 60; k_hp[8] = 50; k_hp[13] = 3;
  FOR k = 9 TO 12 k_hp[k] = 1; END
  k_rad[0] = 14; k_rad[1] = 12; k_rad[2] = 11; k_rad[3] = 11; k_rad[4] = 11;
  k_rad[5] = 12; k_rad[6] = 26; k_rad[7] = 20; k_rad[8] = 18; k_rad[13] = 5;
  FOR k = 9 TO 12 k_rad[k] = 7; END
  k_pts[0] = 300; k_pts[1] = 250; k_pts[2] = 200; k_pts[3] = 150; k_pts[4] = 100;
  k_pts[5] = 200; k_pts[6] = 2000; k_pts[7] = 100; k_pts[8] = 100; k_pts[13] = 25;
END

// ==== Sound ====

// A random number for sound variations only (a small LCG of our own).
FUNCTION srnd(a, b);
BEGIN
  sn_r = (sn_r * 1103 + 4271) % 65521;
  RETURN a + sn_r % (b - a + 1);
END

// Plays snd for something at map point (px, py): full volume on the
// screen, fading out 250 px beyond it, panned by where it is.
FUNCTION sn_at(snd, vol, pitch, px, py);
PRIVATE dx, dy, d;
BEGIN
  dx = px - cam_x - 320; dy = py - cam_y - 240;
  d = fmax(abs(dx) - 320, abs(dy) - 240);
  IF (d > 250) RETURN 0; END
  IF (d > 0) vol = vol * (250 - d) / 250; END
  play_sound(snd, vol, pitch, clamp(int(dx) / 4, -80, 80));
  RETURN 1;
END

FUNCTION make_sounds();
PRIVATE k;
BEGIN
  sn_gun[0] = sfx_tone(wave_noise, 3200, 700, 70, 44);
  sn_gun[1] = sfx_tone(wave_noise, 2600, 500, 80, 44);
  sn_hydra = sfx_tone(wave_noise, 500, 2400, 300, 42);
  sn_pop = sfx_tone(wave_square, 320, 120, 60, 30);
  sn_hf = sfx_tone(wave_noise, 240, 1500, 650, 46);
  sn_lock = sfx_tone(wave_square, 1760, 1760, 55, 24);
  sn_nolock = sfx_tone(wave_square, 330, 300, 120, 26);
  sn_boom[0] = sfx(sfx_explosion, 4);            // rocket, vehicle, building
  sn_boom[1] = sfx(sfx_explosion, 15);
  sn_boom[2] = sfx(sfx_explosion, 29);
  sn_ting = sfx_tone(wave_triangle, 2400, 1900, 60, 30);
  sn_thud = sfx(sfx_hit, 3);
  sn_emg = sfx_tone(wave_noise, 2400, 900, 60, 34);
  sn_flak = sfx(sfx_hit, 23);
  sn_tank = sfx_tone(wave_noise, 900, 80, 280, 60);
  sn_sam = sfx_tone(wave_noise, 300, 1900, 750, 44);
  sn_warn = sfx_tone(wave_square, 1320, 1320, 70, 22);
  sn_clang = sfx(sfx_hit, 17);
  sn_chop = sfx_tone(wave_noise, 260, 110, 75, 48);
  sn_winch = sfx_tone(wave_square, 220, 240, 45, 18);
  sn_pilot = sfx(sfx_coin, 11);
  sn_fuel = sfx_tone(wave_sine, 180, 520, 360, 55);
  sn_ammo = sfx(sfx_blip, 7);
  sn_armor = sfx(sfx_powerup, 3);
  sn_freed = sfx(sfx_powerup, 12);
  sn_down = sfx_tone(wave_saw, 900, 60, 1200, 28);
  sn_sputter = sfx_tone(wave_square, 180, 40, 1400, 36);
  sn_alarm = sfx_tone(wave_square, 880, 880, 110, 24);
  sn_alarm2 = sfx_tone(wave_square, 660, 660, 110, 24);
  sn_menu = sfx(sfx_blip, 2);
  sn_takeoff = sfx_tone(wave_noise, 200, 1400, 900, 40);
  FOR k = 0 TO 2 sn_boom_t[k] = -99; END
  FOR k = 0 TO 3 sn_ef_t[k] = -99; END
END

// The battle tune; the command bunker gets it faster, with a saw lead.
FUNCTION war_song(bpm, lead);
PRIVATE s;
BEGIN
  s = song_new(bpm);
  song_track(s, lead,
    "E5 . E5 . G5 . E5 . A5 . G5 . E5 . D5 . | E5 . E5 . G5 . B5 . A5 - G5 - E5 - - - |" +
    "C5 . C5 . E5 . C5 . D5 . D5 . F#5 . A5 . | B5 - - - A5 - G5 - F#5 - - - D#5 - - - ", 22);
  song_track(s, inst_bass,
    "E4 . E4 E5 . E4 E4 E5 E4 . E4 E5 . E4 E5 . | E4 . E4 E5 . E4 E4 E5 E4 . E4 E5 . E4 E5 . |" +
    "C4 . C4 C5 . C4 C4 C5 D4 . D4 D5 . D4 D5 . | B3 . B3 B4 . B3 B3 B4 B3 . B3 B4 . B3 B4 . ", 46);
  song_track(s, inst_drums, "k . h k s . h . k k h . s . h h ", 36);
  RETURN s;
END

FUNCTION make_songs();
BEGIN
  // Title: a desert march in E (harmonic minor)
  song_title = song_new(108);
  song_track(song_title, inst_square,
    "E5 - - F5 E5 - D#5 - E5 - - - B4 - - - | C5 - B4 - A4 - G#4 - A4 - B4 - E4 - - - |" +
    "E5 - - F5 E5 - D#5 - E5 - G5 - F5 - E5 - | D5 - C5 - B4 - A4 - G#4 - - - E4 - - - ", 30);
  song_track(song_title, inst_bass,
    "E4 . . E4 . . E4 . E4 . . E4 . . B3 . | A3 . . A3 . . A3 . E4 . . E4 . . E4 . |" +
    "E4 . . E4 . . E4 . E4 . . E4 . . B3 . | D4 . . D4 . . C4 . B3 . . B3 . . E4 . ", 50);
  song_track(song_title, inst_pad,
    "E4 - - - - - - - - - - - - - - - | A3 - - - - - - - - - - - - - - - |" +
    "E4 - - - - - - - - - - - - - - - | B3 - - - - - - - - - - - - - - - ", 18);
  song_track(song_title, inst_drums, "k . . k s . . . k . k . s . s s ", 38);
  // Briefing: tense, a radar ping every two bars
  song_brief = song_new(90);
  song_track(song_brief, inst_pad,
    "E4 - - - - - - - - - - - - - - - | C4 - - - - - - - - - - - - - - - |" +
    "D4 - - - - - - - - - - - - - - - | B3 - - - - - - - - - - - - - - - ", 24);
  song_track(song_brief, inst_bass,
    "E4 . . . . . . . E4 . . . . . . . | C4 . . . . . . . C4 . . . . . . . |" +
    "D4 . . . . . . . D4 . . . . . . . | B3 . . . . . . . B3 . . . . . . . ", 45);
  song_track(song_brief, inst_sine, "E6 . . . . . . . . . . . . . . . | . . . . . . . . . . . . . . . . ", 14);
  song_track(song_brief, inst_drums, "k . h . h . h . k . h . h . h h ", 24);
  song_war = war_song(138, inst_square);
  song_final = war_song(152, inst_saw);
  // Jingles, played once
  song_done = song_new(132);
  song_track(song_done, inst_square, "E5 . G5 . B5 . E6 - - - B5 . E6 - - - - - - - . . . . ", 40);
  song_track(song_done, inst_bass, "E4 - - - - - - - B3 - - - E4 - - - - - - - . . . . ", 55);
  song_track(song_done, inst_drums, "k . . . s . . . k . k . s . . . k . . . . . . . ", 40);
  song_over = song_new(88);
  song_track(song_over, inst_square, "B4 - A4 - G4 - F#4 - E4 - - - D#4 - - - E4 - - - - - - - . . . . ", 38);
  song_track(song_over, inst_bass, "E4 - - - C4 - - - B3 - - - B3 - - - E3 - - - - - - - . . . . ", 55);
  song_track(song_over, inst_drums, "k . . . . . . . k . . . s . . . k . . . . . . . . . . . ", 36);
  song_won = song_new(120);
  song_track(song_won, inst_square,
    "E5 . E5 . E5 . B4 . E5 - - - G5 - - - | F#5 . F#5 . F#5 . D5 . F#5 - - - A5 - - - |" +
    "G5 - - - F#5 - - - E5 - - - D#5 - - - | E5 - - - - - - - . . . . . . . . ", 38);
  song_track(song_won, inst_bass,
    "E4 - - - E4 - - - E4 - - - E4 - - - | D4 - - - D4 - - - D4 - - - D4 - - - |" +
    "C4 - - - C4 - - - B3 - - - B3 - - - | E4 - - - - - - - . . . . . . . . ", 50);
  song_track(song_won, inst_drums,
    "k . s . k . s . k . s . k k s s | k . s . k . s . k . s . k k s s |" +
    "k . s . k . s . k . s . k k s s | k . . . . . . . . . . . . . . . ", 40);
  music_volume(38);
END

FUNCTION want_song(sng, lp); BEGIN sn_want = sng; sn_loop = lp; END

// Picks the music for the screen, plays the screen changes, the rotor,
// the winch and the alarms, and toggles the music with N. A jingle
// (loop 0) plays even with the music off.
PROCESS snd_director();
BEGIN
  LOOP
    sn_tick++;
    IF (state <= 1) want_song(song_title, 1); END
    IF (state == 2) want_song(song_brief, 1); END
    IF (state == 3 OR state == 4)
      IF (done_t > 0 AND state == 3) want_song(song_done, 0);
      ELSE IF (cur_m == nm - 1) want_song(song_final, 1); ELSE want_song(song_war, 1); END END
    END
    IF (state == 5) want_song(song_over, 0); END
    IF (state == 6) want_song(song_won, 0); END
    IF (key_pressed(_n)) sn_music = 1 - sn_music; sn_cur = -1; END
    IF (sn_want != sn_cur)
      IF (sn_want AND (sn_music OR sn_loop == 0)) song_play(sn_want, sn_loop); ELSE song_stop(); END
      sn_cur = sn_want;
    END
    // screen changes
    IF (state != sn_prev)
      IF (sn_prev == 0 AND state == 2) play_sound(sn_menu, 60, 100, 0); END
      IF (sn_prev == 2 AND state == 3) play_sound(sn_takeoff, 55, 100, 0); END
      IF (sn_prev == 3 AND state == 2 AND paused) play_sound(sn_menu, 50, 120, 0); END
      IF (sn_prev >= 5 AND state == 1) play_sound(sn_menu, 60, 100, 0); END
      sn_prev = state;
    END
    IF (state == 3 AND heli_on AND paused == 0)
      // the rotor's chop, a little faster and higher with speed
      IF (sn_tick % 5 == 0) play_sound(sn_chop, 20 + hspd / 12, 90 + hspd / 8 + srnd(-4, 4), 0); END
      IF (winch >= 0 AND sn_tick % 7 == 0) play_sound(sn_winch, 35, 90 + e_lift[winch] * 3, 0); END
      IF (sn_sams > 0 AND sn_tick % 18 == 0) play_sound(sn_warn, 45, 100, 0); END   // missile warning
      IF (fuel < 25 AND sn_tick % 80 == 0) sn_beeps(sn_alarm, 45); END
      IF (armor <= 35 AND sn_tick % 100 == 40) sn_beeps(sn_alarm2, 40); END
    END
    FRAME;
  END
END

// Two short beeps of snd, eight frames apart.
PROCESS sn_beeps(snd, vol);
BEGIN
  play_sound(snd, vol, 100, 0);
  FRAME(800);
  play_sound(snd, vol, 100, 0);
END

// The sound of a message's event
FUNCTION msg_sound(id);
BEGIN
  IF (id == 1) play_sound(sn_down, 60, 100, 0); END
  IF (id == 2) play_sound(sn_sputter, 70, 100, 0); END
  IF (id == 4) play_sound(sn_freed, 60, 100, 0); END
  IF (id == 5) play_sound(sn_pilot, 60, 100, 0); END
  IF (id == 6) play_sound(sn_fuel, 70, 100, 0); END
  IF (id == 7) play_sound(sn_ammo, 60, 100, 0); play_sound(sn_thud, 60, 70, 0); END
  IF (id == 8) play_sound(sn_armor, 65, 100, 0); END
  IF (id == 9) play_sound(sn_pilot, 60, 130, 0); END
END

// An enemy shot of kind k fired at (px, py): each kind a few frames apart at most
FUNCTION efire_sound(k, px, py);
BEGIN
  IF (sn_tick - sn_ef_t[k] < 4) RETURN 0; END
  sn_ef_t[k] = sn_tick;
  IF (k == 0) sn_at(sn_emg, 40, srnd(85, 115), px, py); END
  IF (k == 1) sn_at(sn_flak, 50, srnd(60, 75), px, py); END
  IF (k == 2) sn_at(sn_tank, 60, srnd(90, 110), px, py); END
  IF (k == 3) sn_at(sn_sam, 70, 100, px, py); END
END

// ==== Generated sprites. Everything faces right (angle 0). ====
FUNCTION blank(w, h);
PRIVATE g;
BEGIN
  g = new_graphic(w, h); gfx_fill_rgba(g, 0, 0, 0, 0); RETURN g;
END

// The helicopter seen from above; sh = 1 draws the flat black shadow
FUNCTION draw_heli(sh);
PRIVATE g, r, gg, b;
BEGIN
  g = blank(44, 24);
  r = 96; gg = 104; b = 62;
  IF (sh) r = 0; gg = 0; b = 0; END
  gfx_rect(g, 4, 11, 20, 3, r * 3 / 4, gg * 3 / 4, b * 3 / 4);      // tail boom
  gfx_rect(g, 2, 6, 4, 13, r, gg, b);                               // tail fin
  gfx_rect(g, 19, 2, 6, 20, r * 3 / 4, gg * 3 / 4, b * 3 / 4);      // stub wings
  gfx_circle(g, 23, 12, 7, r, gg, b); gfx_circle(g, 30, 12, 7, r, gg, b);   // cabin
  gfx_circle(g, 36, 12, 4, r, gg, b);                               // nose
  IF (sh == 0)
    gfx_rect(g, 17, 1, 10, 3, 50, 50, 50); gfx_rect(g, 17, 20, 10, 3, 50, 50, 50);  // rocket pods
    gfx_circle(g, 34, 12, 4, 120, 190, 220); gfx_circle(g, 35, 11, 2, 200, 235, 250); // canopy
    gfx_line(g, 2, 12, 22, 12, 60, 66, 40); gfx_rect(g, 40, 11, 4, 2, 40, 40, 40);   // gun
  END
  RETURN g;
END

// A ring of sandbags, the base of the SAM and AAA sites
FUNCTION sandbags(g, c, r);
BEGIN
  gfx_circle(g, c, c, r, 150, 128, 88); gfx_circle(g, c, c, r - 3, 120, 104, 72);
  gfx_circle(g, c, c, r - 4, 176, 150, 104);
END

FUNCTION crate(r, gg, b, s);
PRIVATE g;
BEGIN
  g = blank(16, 16);
  gfx_rect(g, 0, 0, 16, 16, 40, 34, 24); gfx_rect(g, 1, 1, 14, 14, r, gg, b);
  gfx_text(g, 4, 2, s, 255, 255, 255, 12); RETURN g;
END

FUNCTION big_text(w, s, r, gg, b);
PRIVATE g;
BEGIN
  g = blank(w, 56);
  gfx_text(g, 4, 4, s, 0, 0, 0, 44); gfx_text(g, 0, 0, s, r, gg, b, 44); RETURN g;
END

FUNCTION make_graphics();
PRIVATE g, i;
BEGIN
  g_heli = draw_heli(0); g_shadow = draw_heli(1);
  g_rotor = blank(52, 52);                                           // two blades
  gfx_line(g_rotor, 2, 25, 50, 27, 30, 30, 30); gfx_line(g_rotor, 2, 26, 50, 26, 30, 30, 30);
  gfx_line(g_rotor, 25, 2, 27, 50, 30, 30, 30); gfx_line(g_rotor, 26, 2, 26, 50, 30, 30, 30);
  gfx_circle(g_rotor, 26, 26, 3, 50, 50, 50);

  g = blank(30, 30); g_k[0] = g;                                     // radar: pad + dish
  gfx_rect(g, 8, 8, 14, 14, 120, 116, 104); gfx_rect(g, 10, 10, 10, 10, 90, 88, 80);
  gfx_circle(g, 20, 15, 9, 230, 230, 220); gfx_circle(g, 17, 15, 8, 150, 150, 140);
  gfx_line(g, 15, 15, 27, 15, 60, 60, 60);
  g = blank(30, 30); g_k[1] = g; sandbags(g, 15, 14);                // SAM launcher
  gfx_rect(g, 8, 10, 12, 10, 84, 92, 56);
  gfx_rect(g, 10, 9, 16, 3, 235, 235, 225); gfx_rect(g, 10, 18, 16, 3, 235, 235, 225);
  gfx_rect(g, 25, 9, 3, 3, 210, 40, 30); gfx_rect(g, 25, 18, 3, 3, 210, 40, 30);
  g = blank(28, 28); g_k[2] = g; sandbags(g, 14, 13);                // AAA gun
  gfx_circle(g, 13, 14, 6, 84, 92, 56);
  gfx_rect(g, 14, 11, 13, 2, 40, 40, 40); gfx_rect(g, 14, 15, 13, 2, 40, 40, 40);
  g = blank(24, 16); g_k[3] = g;                                     // tank hull
  gfx_rect(g, 0, 0, 24, 4, 40, 40, 36); gfx_rect(g, 0, 12, 24, 4, 40, 40, 36);
  gfx_rect(g, 2, 3, 20, 10, 92, 98, 58); gfx_rect(g, 3, 4, 18, 3, 116, 122, 76);
  g_tur = blank(24, 12);                                             // tank turret
  gfx_rect(g_tur, 12, 5, 12, 2, 40, 40, 36);
  gfx_circle(g_tur, 12, 6, 5, 72, 78, 44); gfx_circle(g_tur, 11, 5, 2, 116, 122, 76);
  g = blank(26, 14); g_k[4] = g;                                     // truck
  gfx_rect(g, 1, 0, 17, 14, 128, 110, 70); gfx_line(g, 5, 1, 5, 12, 100, 86, 54);
  gfx_line(g, 11, 1, 11, 12, 100, 86, 54);
  gfx_rect(g, 18, 2, 8, 10, 92, 98, 58); gfx_rect(g, 22, 3, 3, 8, 150, 200, 220);
  g = blank(26, 26); g_k[5] = g;                                     // gun bunker
  gfx_circle(g, 13, 13, 12, 110, 106, 96); gfx_circle(g, 12, 12, 10, 150, 146, 132);
  gfx_rect(g, 16, 10, 9, 4, 30, 30, 30);
  g = blank(58, 46); g_k[6] = g;                                     // command bunker
  gfx_rect(g, 0, 0, 58, 46, 96, 92, 82); gfx_rect(g, 3, 3, 52, 40, 148, 142, 126);
  gfx_rect(g, 10, 10, 38, 26, 120, 116, 104); gfx_rect(g, 22, 16, 14, 14, 180, 40, 30);
  gfx_line(g, 6, 40, 52, 6, 70, 70, 70); gfx_circle(g, 48, 10, 5, 220, 220, 210);
  g = blank(42, 28); g_k[7] = g;                                     // barracks
  gfx_rect(g, 0, 0, 42, 28, 110, 90, 60); gfx_rect(g, 1, 1, 40, 12, 168, 142, 96);
  gfx_rect(g, 1, 14, 40, 13, 140, 116, 78); gfx_rect(g, 18, 22, 6, 6, 50, 40, 30);
  g = blank(40, 36); g_k[8] = g;                                     // prison camp
  gfx_rect_outline(g, 0, 0, 40, 36, 70, 60, 50); gfx_rect_outline(g, 2, 2, 36, 32, 110, 100, 90);
  gfx_rect(g, 10, 8, 20, 16, 150, 120, 80); gfx_rect(g, 10, 8, 20, 5, 110, 80, 50);
  gfx_rect(g, 30, 26, 8, 8, 90, 70, 40);
  g = blank(10, 10); g_k[9] = g;                                     // pilot (orange suit)
  gfx_circle(g, 5, 5, 4, 240, 140, 30); gfx_circle(g, 5, 5, 2, 250, 220, 180);
  g_k[10] = crate(200, 50, 40, "F"); g_k[11] = crate(90, 100, 50, "A");
  g_k[12] = crate(50, 90, 190, "+");
  g = blank(12, 10); g_k[13] = g;                                    // soldier
  gfx_line(g, 5, 5, 11, 5, 30, 30, 30);
  gfx_circle(g, 5, 5, 4, 70, 76, 44); gfx_circle(g, 5, 5, 2, 100, 106, 64);

  g_map = new_graphic(WW, WH); g_mini = new_graphic(MW, MH);
  g_dim = new_graphic(640, 480);                                     // briefing backdrop
  gfx_fill_rgba(g_dim, 12, 10, 6, 92); gfx_rect(g_dim, 12, 44, 392, 296, 110, 92, 60);
  g_title = big_text(330, "DUNE STRIKE", 240, 200, 90);
  g_over = big_text(300, "GAME OVER", 235, 70, 50);
  g_win = big_text(420, "CAMPAIGN WON", 110, 230, 110);
END

// ==== Terrain: value noise on three lattices ====
// Bilinear, smoothstepped value noise at tile (i, j): lattice la with
// spacing sp tiles and lw points per row. Returns 0..99.
FUNCTION noise(la, i, j, sp, lw);
PRIVATE a, b, k;
BEGIN
  a = sw8[(i % sp) * 8 / sp];
  b = sw8[(j % sp) * 8 / sp];
  k = (j / sp) * lw + i / sp;
  IF (la == 0)
    RETURN ((lat[k] * (64 - a) + lat[k + 1] * a) * (64 - b)
          + (lat[k + lw] * (64 - a) + lat[k + lw + 1] * a) * b) / 4096;
  END
  IF (la == 1)
    RETURN ((lat2[k] * (64 - a) + lat2[k + 1] * a) * (64 - b)
          + (lat2[k + lw] * (64 - a) + lat2[k + lw + 1] * a) * b) / 4096;
  END
  RETURN ((lat3[k] * (64 - a) + lat3[k + 1] * a) * (64 - b)
        + (lat3[k + lw] * (64 - a) + lat3[k + lw + 1] * a) * b) / 4096;
END

// Terrain class of tile (i, j): 0 sand, 1 rock ridge, 2 sea, 3 beach,
// 4 oasis pond, 5 oasis grass. Leaves the distance to the shore in t_dc.
FUNCTION ter(i, j);
BEGIN
  RETURN ter_n(i, j, noise(0, i, j, 8, 18));
END

// Same, when the first lattice's value n1 at (i, j) is already known
FUNCTION ter_n(i, j, n1);
PRIVATE d, k, dd;
BEGIN
  d = i;                                     // distance from the sea edge
  IF (coast == 1) d = MW - 1 - i; END
  IF (coast >= 2) d = j + (coast == 3) * (MH - 1 - 2 * j); END
  t_dc = d - 9 - (n1 - 50) / 3;              // the coastline wiggles with the dunes
  IF (t_dc < 0) RETURN 2; END
  IF (t_dc < 2) RETURN 3; END
  FOR k = 0 TO 3
    dd = (i - oa_x[k]) * (i - oa_x[k]) + (j - oa_y[k]) * (j - oa_y[k]);
    IF (dd <= 5) RETURN 4; END
    IF (dd <= 16) RETURN 5; END
  END
  // rocky ridges follow one contour line of the third lattice
  IF (n1 > 44) IF (abs(noise(2, i, j, 6, 23) - 50) < 3) RETURN 1; END END
  RETURN 0;
END

// Paints tile (i, j) into the map and its pixel into the radar map
FUNCTION paint_tile(i, j);
PRIVATE n1, h, h2, sh, t, px, py, v, r, g, b;
BEGIN
  n1 = noise(0, i, j, 8, 18);
  h = (n1 * 2 + noise(1, i, j, 4, 34)) / 3;
  h2 = (noise(0, i + 1, j + 1, 8, 18) * 2 + noise(1, i + 1, j + 1, 4, 34)) / 3;
  // slope towards the bottom right: faces turned to the light are brighter
  sh = clamp((h - h2) * 3, -12, 12);
  t = ter_n(i, j, n1);
  px = i * 16; py = j * 16; v = rand(-3, 3);
  SWITCH (t)
    CASE 0                                           // dunes
      r = 210 + sh + (h - 50) / 5 + v; g = 176 + sh + (h - 50) / 5 + v; b = 118 + sh / 2 + v;
      gfx_rect(g_map, px, py, 16, 16, r, g, b);
      gfx_circle(g_map, px + 8 + rand(-3, 3), py + 8 + rand(-3, 3), 11, r, g, b);   // softens the grid
      IF (h / 4 != h2 / 4)                           // dune crest: a contour line,
        v = rand(0, 5);                              // sunlit above, shaded below
        gfx_line(g_map, px, py + 4 + v, px + 16, py + 2 + v, r + 16, g + 14, b + 10);
        gfx_line(g_map, px, py + 6 + v, px + 16, py + 4 + v, r - 22, g - 22, b - 18);
        gfx_line(g_map, px, py + 7 + v, px + 16, py + 5 + v, r - 12, g - 12, b - 10);
      END
      gfx_pixel(g_map, px + rand(0, 15), py + rand(0, 15), r + 18, g + 18, b + 14);
      gfx_pixel(g_map, px + rand(0, 15), py + rand(0, 15), r - 26, g - 26, b - 20);
    CASE 1                                           // rock: gravel now, boulders later
      r = 196 + sh + v; g = 162 + sh + v; b = 112 + sh + v;
      gfx_rect(g_map, px, py, 16, 16, r, g, b);
      gfx_circle(g_map, px + 8, py + 8, 11, r, g, b);
    CASE 2                                           // sea, darker further out
      r = 36; g = fmax(62, 118 + t_dc * 5 + v); b = fmax(120, 176 + t_dc * 4 + v);
      gfx_rect(g_map, px, py, 16, 16, r, g, b);
      gfx_circle(g_map, px + 8, py + 8, 11, r, g, b);
      v = rand(3, 13);                                // waves
      IF (rand(0, 3) == 0) gfx_line(g_map, px + rand(0, 5), py + v, px + rand(9, 15), py + v, 90, 160, 210); END
      IF (t_dc == -1) gfx_circle(g_map, px + 8, py + rand(4, 12), 4, 200, 230, 240); END  // surf
    CASE 3                                           // beach
      r = 226 + v; g = 204 + v; b = 150 + v;
      IF (t_dc == 0) r -= 30; g -= 30; b -= 20; END  // wet sand
      gfx_rect(g_map, px, py, 16, 16, r, g, b);
      gfx_circle(g_map, px + 8, py + 8, 11, r, g, b);
    DEFAULT                                          // oases are painted afterwards
      r = 104; g = 142; b = 62;
      IF (t == 4) r = 44; g = 120; b = 140; END
  END
  gfx_rect(g_mini, i, j, 1, 1, r, g, b);
  RETURN t;
END

FUNCTION palm(px, py);
PRIVATE a;
BEGIN
  gfx_line(g_map, px, py, px + 6, py + 7, 110, 84, 50);                  // trunk
  FOR a = 0 TO 4
    gfx_line(g_map, px, py, px + get_distx(a * 72000 + 20000, 9), py + get_disty(a * 72000 + 20000, 9), 40, 100, 34);
  END
  gfx_circle(g_map, px, py, 2, 80, 70, 36);
END

// Adds a curved road (a quadratic Bezier) from (ax, ay) to (bx, by)
FUNCTION make_road(ax, ay, bx, by);
PRIVATE n, k, u, d, cx, cy;
BEGIN
  d = int(fget_distance(ax, ay, bx, by));
  n = d / 30 + 2;
  IF (n_rp + n >= 399 OR n_rd > 9) RETURN 0; END
  cx = clamp((ax + bx) / 2 + rand(-d / 4, d / 4), 64, WW - 64);
  cy = clamp((ay + by) / 2 + rand(-d / 4, d / 4), 64, WH - 64);
  rd_a[n_rd] = n_rp;
  FOR k = 0 TO n
    u = n - k;
    rp_x[n_rp] = (ax * u * u + 2 * cx * u * k + bx * k * k) / (n * n);
    rp_y[n_rp] = (ay * u * u + 2 * cy * u * k + by * k * k) / (n * n);
    n_rp++;
  END
  rd_b[n_rd] = n_rp - 1; n_rd++;
END

// Paints road segment p -> p+1: a wide sandy verge, then the packed track
FUNCTION paint_road(p);
PRIVATE n, k, px, py;
BEGIN
  n = int(fget_distance(rp_x[p], rp_y[p], rp_x[p + 1], rp_y[p + 1])) / 3 + 1;
  FOR k = 0 TO n                             // the verge
    px = rp_x[p] + (rp_x[p + 1] - rp_x[p]) * k / n; py = rp_y[p] + (rp_y[p + 1] - rp_y[p]) * k / n;
    gfx_circle(g_map, px, py, 8, 188, 156, 108);
  END
  FOR k = 0 TO n                             // the packed track with ruts
    px = rp_x[p] + (rp_x[p + 1] - rp_x[p]) * k / n; py = rp_y[p] + (rp_y[p + 1] - rp_y[p]) * k / n;
    gfx_circle(g_map, px, py, 5, 154, 128, 92); gfx_pixel(g_map, px + rand(-3, 3), py + rand(-3, 3), 120, 100, 72);
  END
  gfx_rect(g_mini, px / 16, py / 16, 1, 1, 120, 96, 70);
END

// A land point near (px, py), at most r pixels away (tries a few times).
// Returns x; the y is left in ln_y.
FUNCTION land_near(px, py, r);
PRIVATE k, tx, ty, t;
BEGIN
  FOR k = 0 TO 11
    tx = clamp(px + rand(-r, r), 40, WW - 40); ty = clamp(py + rand(-r, r), 40, WH - 40);
    t = ter(tx / 16, ty / 16);
    IF (t == 0 OR t == 5) ln_y = ty; RETURN tx; END
  END
  ln_y = py; RETURN px;
END

// ==== Map builder: spreads the generation over many frames ====
PROCESS builder(next_state);
PRIVATE i, j, k, n, t, a, b, px, py, best, bd, d, tries, lst[5];
BEGIN
  state = 1; gen_pct = 0;
  FRAME;
  rand_seed(hash(seed));
  FOR i = 0 TO 4 rand(0, 999); END                   // throw the first numbers away
  FOR i = 0 TO 299 lat[i] = rand(0, 99); END
  FOR i = 0 TO 899 lat2[i] = rand(0, 99); END
  FOR i = 0 TO 499 lat3[i] = rand(0, 99); END
  coast = rand(0, 3);
  FOR k = 0 TO 3 oa_x[k] = -99; oa_y[k] = -99; END
  FOR k = 0 TO 3                                     // oases, away from the sea
    FOR i = 0 TO 9
      px = rand(12, MW - 13); py = rand(10, MH - 11);
      IF (ter(px, py) == 0 AND t_dc > 12) oa_x[k] = px; oa_y[k] = py; BREAK; END
    END
  END
  FRAME;

  // landing zone: walk inland from the middle of the coast
  a = (coast == 0) - (coast == 1); b = (coast == 2) - (coast == 3);   // inland step
  px = rand(MW / 4, MW * 3 / 4); py = rand(MH / 4, MH * 3 / 4);
  IF (a != 0) px = MW / 2 - a * (MW / 2 - 2); ELSE py = MH / 2 - b * (MH / 2 - 2); END
  WHILE ((ter(px, py) != 0 OR t_dc < 5) AND px > 0 AND py > 0 AND px < MW - 1 AND py < MH - 1)
    px += a; py += b;
  END
  lz_x = px * 16 + 8; lz_y = py * 16 + 8;

  // bases on a jittered 4 x 2 grid, on land and away from the LZ
  n_st = 0;
  FOR k = 0 TO 7
    FOR tries = 0 TO 29
      px = (k % 4) * 512 + rand(90, 420); py = (k / 4) * 768 + rand(120, 640);
      t = ter(px / 16, py / 16);
      IF ((t == 0 OR t == 1) AND t_dc > 6 AND fget_distance(px, py, lz_x, lz_y) > 420)
        st_x[n_st] = px; st_y[n_st] = py; n_st++; BREAK;
      END
    END
    FRAME;
  END
  // sort them by distance from the landing zone (selection sort)
  FOR i = 0 TO n_st - 2
    best = i; bd = fget_distance(st_x[i], st_y[i], lz_x, lz_y);
    FOR j = i + 1 TO n_st - 1
      d = fget_distance(st_x[j], st_y[j], lz_x, lz_y);
      IF (d < bd) bd = d; best = j; END
    END
    a = st_x[i]; st_x[i] = st_x[best]; st_x[best] = a;
    a = st_y[i]; st_y[i] = st_y[best]; st_y[best] = a;
  END
  // roads: base i joins the nearest of the LZ and the bases before it
  n_rp = 0; n_rd = 0;
  FOR i = 0 TO n_st - 1
    a = lz_x; b = lz_y; bd = fget_distance(st_x[i], st_y[i], lz_x, lz_y);
    FOR j = 0 TO i - 1
      d = fget_distance(st_x[i], st_y[i], st_x[j], st_y[j]);
      IF (d < bd) bd = d; a = st_x[j]; b = st_y[j]; END
    END
    make_road(st_x[i], st_y[i], a, b);
  END

  // missions: the four kinds shuffled, then the command bunker
  nm = fmin(5, n_st);
  FOR i = 0 TO 3 lst[i] = i; END
  FROM i = 3 TO 1;                                  // FROM counts down here
    j = rand(0, i); t = lst[i]; lst[i] = lst[j]; lst[j] = t;
  END
  FOR i = 0 TO nm - 2 m_type[i] = lst[i]; m_got[i] = 0; m_need[i] = 0; END
  m_type[nm - 1] = 4; m_got[nm - 1] = 0; m_need[nm - 1] = 0;
  gen_pct = 5;

  // paint the terrain: three painters work on three bands of rows at
  // once, each within its own instruction budget
  n_rk = 0; n_paint = 0;
  FOR k = 0 TO 2 painter(k * 32, k * 32 + 31); END
  WHILE (n_paint < 3) FRAME; END
  // oases: grass, a pond and a ring of palm trees
  FOR k = 0 TO 3
    IF (oa_x[k] > 0)
      px = oa_x[k] * 16 + 8; py = oa_y[k] * 16 + 8;
      gfx_circle(g_map, px, py, 70, 150, 160, 90); gfx_circle(g_map, px, py, 64, 104, 142, 62);
      gfx_circle(g_map, px, py, 40, 190, 176, 120); gfx_circle(g_map, px, py, 36, 44, 120, 140);
      gfx_circle(g_map, px - 6, py - 6, 22, 60, 140, 160);
      FOR i = 0 TO 11
        a = i * 30000 + rand(-8000, 8000); d = rand(46, 60);
        palm(px + get_distx(a, d), py + get_disty(a, d));
      END
    END
  END
  // boulders over the ridges, painted last so they spill over the tiles
  FOR k = 0 TO n_rk - 1
    px = (rk[k] % MW) * 16 + 8; py = (rk[k] / MW) * 16 + 8;
    FOR i = 0 TO 1
      px += rand(-5, 5); py += rand(-5, 5); d = rand(5, 10);
      gfx_circle(g_map, px + 2, py + 3, d, 116, 90, 64);                  // shadow side
      gfx_circle(g_map, px, py, d - 1, 150, 118, 84);
      gfx_circle(g_map, px - d / 4, py - d / 4, d / 2, 180, 148, 110);    // lit top
    END
    IF (k % 80 == 79) FRAME; END
  END
  // bases' clearings, roads and the helipad
  FOR i = 0 TO n_st - 1
    gfx_circle(g_map, st_x[i], st_y[i], 76, 196, 168, 118); gfx_circle(g_map, st_x[i], st_y[i], 70, 206, 178, 126);
  END
  FOR k = 0 TO n_rd - 1
    FOR i = rd_a[k] TO rd_b[k] - 1
      paint_road(i);
      IF (i % 2 == 0) FRAME; END
    END
  END
  gfx_circle(g_map, lz_x, lz_y, 26, 240, 200, 60); gfx_circle(g_map, lz_x, lz_y, 23, 110, 110, 104);
  gfx_rect(g_map, lz_x - 8, lz_y - 10, 4, 20, 240, 240, 230);            // the H of the helipad
  gfx_rect(g_map, lz_x + 4, lz_y - 10, 4, 20, 240, 240, 230); gfx_rect(g_map, lz_x - 4, lz_y - 2, 8, 4, 240, 240, 230);
  gen_pct = 92; FRAME;

  // the war: every base gets defences that grow with its distance
  FOR i = 0 TO n_st - 1 populate(i); FRAME; END
  FOR k = 0 TO 13                                     // loose crates and AAA
    px = land_near(rand(100, WW - 100), rand(100, WH - 100), 60); py = ln_y;
    IF (k < 6) spawn(10, px, py, -1, 0); END
    IF (k >= 6 AND k < 9) spawn(11, px, py, -1, 0); END
    IF (k >= 9 AND k < 11) spawn(12, px, py, -1, 0); END
    IF (k >= 11 AND fget_distance(px, py, lz_x, lz_y) > 400) spawn(2, px, py, -1, 0); END
  END
  spawn(10, lz_x + 40, lz_y + 30, -1, 0);             // a start-up fuel crate
  FOR k = 0 TO 3 road_unit(3 + k % 2, rand(1, n_rd - 1), -1, 0); END
  gen_pct = 100; cur_m = 0;
  start_mission(); respawn();
  cam_x = hx - 320; cam_y = hy - 240; state = next_state;
END

// Paints tile rows j0..j1, a third of a row per frame, and lists the
// rock tiles for the boulders painted afterwards
PROCESS painter(j0, j1);
PRIVATE i, j;
BEGIN
  FOR j = j0 TO j1
    FOR i = 0 TO MW - 1
      IF (paint_tile(i, j) == 1 AND n_rk < 2000) rk[n_rk] = j * MW + i; n_rk++; END
      IF (i % 43 == 42 OR i == MW - 1) FRAME; END
    END
    gen_pct = 5 + (j - j0) * 75 / 32;
  END
  n_paint++;
END

// Kind k on land near base i (within r pixels), in its mission group
FUNCTION at_base(k, i, r, tgt);
PRIVATE px, g;
BEGIN
  g = -1;
  IF (i < nm) g = i; END
  px = land_near(st_x[i], st_y[i], r); RETURN spawn(k, px, ln_y, g, tgt);
END

// Defences and mission targets of base i
FUNCTION populate(i);
PRIVATE k, g, t, lv;
BEGIN
  lv = i; g = -1; t = -1;
  IF (i < nm) g = i; t = m_type[i]; END
  FOR k = 1 TO 1 + rand(0, 1) at_base(7, i, 60, 0); END    // barracks may hide a crate
  FOR k = 1 TO 2 + lv / 2 at_base(13, i, 70, 0); END       // soldiers
  FOR k = 1 TO 1 + lv / 2 at_base(2, i, 90, 0); END        // AAA
  IF (lv >= 2) at_base(5, i, 80, 0); END                    // gun bunker
  IF (lv >= 3) at_base(1, i, 90, 0); END                    // a SAM
  FOR k = 1 TO lv / 2 road_unit(3, i, g, 0); END           // tank patrols
  SWITCH (t)
    CASE 0 FOR k = 1 TO 2 + lv / 3 at_base(0, i, 110, 1); END           // radar sites
    CASE 1 at_base(8, i, 30, 0); m_need[i] = 3 + lv / 2;              // prison camp
    CASE 2 FOR k = 1 TO 3 + lv / 3 at_base(1, i, 100, 1); END           // SAM battery
    CASE 3 FOR k = 1 TO 4 road_unit(4, i, g, 1); END road_unit(3, i, g, 0);   // convoy
    CASE 4 at_base(6, i, 20, 1); at_base(5, i, 80, 0); at_base(5, i, 80, 0); at_base(1, i, 100, 0);
  END
END

// ==== Entities ====
FUNCTION spawn(k, px, py, g, tgt);
PRIVATE s;
BEGIN
  FOR s = 0 TO E
    IF (e_on[s] == 0)
      e_on[s] = 1; e_gen[s]++; e_kind[s] = k; e_x[s] = px; e_y[s] = py;
      e_hp[s] = k_hp[k]; e_grp[s] = g; e_tgt[s] = tgt; e_lift[s] = 0;
      e_gone[s] = 0; e_fl[s] = 0; e_aim[s] = 0; e_ri[s] = -1;
      ent(s);
      RETURN s;
    END
  END
  RETURN -1;
END

// A tank or truck somewhere on road r, driving one way or the other
FUNCTION road_unit(k, r, g, tgt);
PRIVATE s, p;
BEGIN
  IF (r < 0 OR r >= n_rd) RETURN -1; END
  FOR s = 0 TO 9                              // not next to the landing zone
    p = rand(rd_a[r], rd_b[r]);
    IF (fget_distance(rp_x[p], rp_y[p], lz_x, lz_y) > 360) BREAK; END
  END
  s = spawn(k, rp_x[p], rp_y[p], g, tgt);
  IF (s >= 0)
    e_ri[s] = p; e_rd[s] = r; e_dir[s] = 1;
    IF (p == rd_b[r] OR rand(0, 1)) e_dir[s] = -1; END
    IF (p == rd_a[r]) e_dir[s] = 1; END
  END
  RETURN s;
END

// Angle to fire at the helicopter with a projectile of speed spd, aiming
// where it will be (lead)
FUNCTION lead_angle(px, py, spd);
PRIVATE t;
BEGIN
  t = fget_distance(px, py, hx, hy) / (spd + 0.001);
  RETURN fget_angle(px, py, hx + hvx * t, hy + hvy * t);
END

FUNCTION eshot(k, px, py, a, spd, dmg);
PRIVATE j, i;
BEGIN
  FOR j = 0 TO 79
    i = (eb_cur + j) % 80;
    IF (eb_on[i] == 0)
      eb_on[i] = 1; eb_k[i] = k; eb_x[i] = px; eb_y[i] = py; eb_a[i] = a;
      eb_spd[i] = spd; eb_t[i] = 0; eb_h[i] = 4; eb_dmg[i] = dmg * dfac;
      efire_sound(k, px, py);
      eb_cur = i + 1; RETURN i;
    END
  END
  RETURN -1;
END

PROCESS turret(s);
PRIVATE gen;
BEGIN
  gen = e_gen[s]; ctype = c_scroll; z = 5; graph = g_tur;
  WHILE (e_on[s] AND e_gen[s] == gen AND e_hp[s] > 0)
    x = e_x[s]; y = e_y[s]; angle = e_aim[s];
    FRAME;
  END
END

// One ground object. Its ground position is (px, py); pickups being
// winched up are drawn e_lift pixels higher.
PROCESS ent(s);
PRIVATE k, dt, rl, d, dx, dy, a, px, py, hx0, hy0, tx, ty, wt, spd, p;
BEGIN
  k = e_kind[s];
  px = e_x[s]; py = e_y[s]; hx0 = px; hy0 = py; tx = px; ty = py;
  x = px; y = py; ctype = c_scroll; z = 8; graph = g_k[k];
  IF (k == 3 OR k == 4 OR k == 13) z = 6; END              // movers above buildings
  IF (k >= 9 AND k <= 12) z = 7; END
  IF (k == 3) turret(s); END
  rl = rand(80, 300) * 0.01; spd = 28 + rand(0, 12);        // staggered first shots
  angle = rand(0, 3) * 90000;
  IF (k >= 5 AND k <= 12) angle = 0; END
  LOOP
    IF (e_hp[s] <= 0) BREAK; END
    IF (state == 3 OR state == 4)
      dt = get_delta(); rl -= dt;
      dx = hx - px; dy = hy - py; d = 9999;
      IF (heli_on AND abs(dx) < 330 AND abs(dy) < 330) d = sqrt(dx * dx + dy * dy); END
      SWITCH (k)
        CASE 0                                       // radar: the dish turns
          angle = (angle + int(150000 * dt)) % 360000;
        CASE 1                                       // SAM: turns and launches
          IF (d < 320) angle = lerp_angle(angle, fget_angle(px, py, hx, hy), 0.1); END
          IF (d < 270 AND rl <= 0)
            rl = 4.2 * rfac; eshot(3, px, py, angle, 130 + diff * 8, 20); fx_add(2, px, py, 4, 0, 0, 10, 40, 8);
          END
        CASE 2                                       // AAA: bursts of flak
          IF (d < 280) angle = lerp_angle(angle, lead_angle(px, py, 260), 0.2); END
          IF (d < 240 AND rl <= 0)
            rl = 1.5 * rfac; FOR p = 0 TO 2 eshot(1, px, py, angle + rand(-5000, 5000), 250 + p * 10, 4); END
          END
        CASE 3, 4                                    // vehicles follow their road
          IF (e_ri[s] >= 0)
            p = e_ri[s]; a = fget_angle(px, py, rp_x[p], rp_y[p]);
            IF (fget_distance(px, py, rp_x[p], rp_y[p]) < spd * dt + 1)
              p += e_dir[s];
              // turn round at the road's ends, and well before the landing zone
              IF (p < rd_a[e_rd[s]] OR p > rd_b[e_rd[s]]) e_dir[s] = -e_dir[s]; p += 2 * e_dir[s];
              ELSE IF (fget_distance(rp_x[p], rp_y[p], lz_x, lz_y) < 300) e_dir[s] = -e_dir[s]; p += 2 * e_dir[s]; END END
              e_ri[s] = p;
            ELSE
              px += get_distx(a, spd * dt); py += get_disty(a, spd * dt);
              angle = lerp_angle(angle, a, 0.15);
            END
          END
          IF (k == 3)                                // tank: turret tracks, then fires
            IF (d < 280)
              a = lead_angle(px, py, 170); e_aim[s] = lerp_angle(e_aim[s], a, 0.06);
              IF (rl <= 0 AND abs(normalize_angle(a - e_aim[s] + 180000) - 180000) < 8000)
                rl = 2.6 * rfac; eshot(2, px + get_distx(e_aim[s], 12), py + get_disty(e_aim[s], 12), e_aim[s], 170, 8);
              END
            ELSE
              e_aim[s] = lerp_angle(e_aim[s], angle, 0.05);
            END
          END
        CASE 5, 6                                    // bunkers: machine guns
          IF (d < 230 AND rl <= 0)
            rl = 0.9 * rfac; a = lead_angle(px, py, 300);
            eshot(0, px, py, a + rand(-3000, 3000), 300, 3);
            IF (k == 6) eshot(0, px, py, a + 9000, 300, 3); eshot(0, px, py, a - 9000, 300, 3); END
          END
        CASE 9                                       // pilot: runs to a hovering helicopter
          IF (d < 120 AND d > 6 AND hspd < 60 AND e_lift[s] == 0)
            angle = fget_angle(px, py, hx, hy); px += get_distx(angle, 26 * dt); py += get_disty(angle, 26 * dt);
          END
        CASE 13                                      // soldier: patrols, then shoots
          IF (d < 190)
            angle = fget_angle(px, py, hx, hy);
            IF (rl <= 0) rl = 1.7 * rfac; eshot(0, px, py, lead_angle(px, py, 240), 240, 2); END
          ELSE
            wt -= dt;
            IF (wt <= 0) wt = rand(2, 5); tx = hx0 + rand(-60, 60); ty = hy0 + rand(-60, 60); END
            IF (fget_distance(px, py, tx, ty) > 2)
              angle = fget_angle(px, py, tx, ty);
              px += get_distx(angle, 14 * dt); py += get_disty(angle, 14 * dt);
            END
          END
      END
      e_x[s] = px; e_y[s] = py;
      IF (e_fl[s] > 0) e_fl[s] -= dt; END
    END
    x = px; y = py - e_lift[s];
    alpha = 100 - (e_fl[s] > 0) * 55;                // hit flash
    FRAME;
  END
  IF (e_gone[s] == 0) wrecked(s, k, px, py); END
  e_on[s] = 0;
END

// Burnt ground painted into the map (and the radar map) for good
FUNCTION scorch(px, py, r);
PRIVATE k;
BEGIN
  gfx_circle(g_map, px, py, r, 120, 98, 70); gfx_circle(g_map, px + 1, py + 1, r * 2 / 3, 70, 58, 44);
  FOR k = 0 TO r / 3
    gfx_rect(g_map, px + rand(-r, r), py + rand(-r, r), rand(2, 4), rand(1, 3), 40, 36, 30);
  END
  gfx_rect(g_mini, px / 16, py / 16, 1, 1, 50, 44, 36);
END

// What is left of entity s: explosion, wreck painted into the map,
// flames that burn on, and whatever the building held
FUNCTION wrecked(s, k, px, py);
PRIVATE j, n;
BEGIN
  score += k_pts[k]; kills++;
  IF (k == 13)
    sn_at(sn_thud, 45, srnd(70, 90), px, py);
    gfx_circle(g_map, px, py, 3, 110, 40, 30);
    FOR j = 0 TO 5 fx_add(0, px, py, 3, rand(-40, 40), rand(-40, 40), rand(40, 90), 30, 2); END RETURN 0; END
  IF (k >= 1 AND k <= 4)                            // burnt-out vehicle or gun pit
    explode(px, py, 2, 0); scorch(px, py, 12); fire_add(px, py, 12);
    gfx_rect(g_map, px - 9, py - 5, 18, 10, 36, 34, 30);
    gfx_rect(g_map, px - 6, py - 3, 10, 5, 70 + (k < 3) * 30, 50, 36);
    RETURN 0;
  END
  // buildings: rubble and fires
  explode(px, py, 3, 0);
  IF (k == 6) explode(px + 14, py - 8, 3, 0); explode(px - 12, py + 10, 3, 0); END
  scorch(px, py, k_rad[k] + 6);
  FOR j = 0 TO k_rad[k] / 2
    n = rand(90, 150);
    gfx_rect(g_map, px + rand(-k_rad[k], k_rad[k]), py + rand(-k_rad[k], k_rad[k]), rand(3, 7), rand(2, 5), n, n - 6, n - 16);
  END
  fire_add(px - 5, py, 20); fire_add(px + 6, py + 4, 16);
  IF (k == 7 AND rand(0, 1) == 0) spawn(10 + rand(0, 2), px, py + 4, -1, 0); END
  IF (k == 8)                                        // the prisoners run out
    FOR j = 1 TO m_need[e_grp[s]] spawn(9, px + rand(-24, 24), py + rand(-20, 20), e_grp[s], 0); END msg(4); END
END

// ==== Particles: debris and sparks thrown up (height h), fireballs, smoke ====
FUNCTION fx_add(k, px, py, h, vx, vy, vh, life, sz);
PRIVATE j, i;
BEGIN
  IF (n_fx >= 190) RETURN -1; END    // pool (nearly) full: the particle is dropped
  FOR j = 0 TO 39
    i = (fx_cur + j) % 200;
    IF (fx_on[i] == 0)
      fx_on[i] = 1; fx_k[i] = k; fx_x[i] = px; fx_y[i] = py; fx_h[i] = h;
      fx_vx[i] = vx; fx_vy[i] = vy; fx_vh[i] = vh; fx_life[i] = life; fx_max[i] = life; fx_s[i] = sz;
      fx_cur = i + 1; n_fx++; RETURN i;
    END
  END
  RETURN -1;
END

// sz 1 small (rocket), 2 vehicle, 3 building; h0 = height it happens at
FUNCTION explode(px, py, sz, h0);
PRIVATE j, a, sp;
BEGIN
  FOR j = 1 TO sz * 3
    fx_add(1, px + rand(-sz * 5, sz * 5), py + rand(-sz * 5, sz * 5), h0 + rand(0, sz * 6), 0, 0, 20,
           rand(16, 26) + sz * 4, rand(5, 8) + sz * 3);
  END
  FOR j = 1 TO sz * 5                                // debris thrown into the air
    a = rand(0, 359999); sp = rand(30, 60 + sz * 25);
    fx_add(0, px, py, h0 + 2, get_distx(a, sp), get_disty(a, sp), rand(60, 140 + sz * 30), rand(40, 70), 2);
  END
  FOR j = 1 TO sz fx_add(2, px + rand(-6, 6), py + rand(-6, 6), 6, 4, 0, 14, rand(70, 110), rand(6, 9) + sz * 2); END
  IF (sz >= 2) fx_add(3, px, py, h0 + 4, 0, 0, 0, 10, 10 + sz * 10); END
  IF (sn_tick - sn_boom_t[sz - 1] >= 3)            // one of each size every few frames
    sn_boom_t[sz - 1] = sn_tick;
    sn_at(sn_boom[sz - 1], 40 + sz * 20, 165 - sz * 35 + srnd(-10, 10), px, py);
  END
END

FUNCTION fire_add(px, py, t);
BEGIN
  bf_cur = (bf_cur + 1) % 24;
  bf_x[bf_cur] = px; bf_y[bf_cur] = py; bf_t[bf_cur] = t;
END

PROCESS fxman();
PRIVATE i, q, r, sx, sy, dt;
BEGIN
  ctype = c_scroll;
  LOOP
    IF (state >= 2 AND paused == 0)
      dt = get_delta();
      FOR i = 0 TO 23                                // burning wrecks smoke on
        IF (bf_t[i] > 0)
          bf_t[i] -= dt;
          IF (abs(bf_x[i] - cam_x - 320) < 360 AND abs(bf_y[i] - cam_y - 240) < 300)
            IF (rand(0, 99) < 22) fx_add(2, bf_x[i] + rand(-4, 4), bf_y[i], 4, 8, -2, 16, rand(60, 100), rand(4, 7)); END
            IF (rand(0, 99) < 14) fx_add(1, bf_x[i] + rand(-5, 5), bf_y[i] + rand(-3, 3), 2, 0, 0, 14, rand(10, 18), rand(2, 4)); END
          END
        END
      END
      FOR i = 0 TO 199
        IF (fx_on[i])
          fx_life[i]--;
          IF (fx_life[i] <= 0)
            fx_on[i] = 0; n_fx--;
          ELSE
            fx_x[i] += fx_vx[i] * dt; fx_y[i] += fx_vy[i] * dt; fx_h[i] += fx_vh[i] * dt;
            IF (fx_k[i] == 0)                        // debris falls and bounces
              fx_vh[i] -= 320 * dt;
              IF (fx_h[i] < 0) fx_h[i] = 0; fx_vh[i] = -fx_vh[i] * 0.3; fx_vx[i] *= 0.5; fx_vy[i] *= 0.5; END
            END
            q = fx_life[i] / (fx_max[i] + 0.001);
            sx = fx_x[i]; sy = fx_y[i] - fx_h[i];
            IF (abs(sx - cam_x - 320) < 340 AND abs(sy - cam_y - 240) < 260)
              SWITCH (fx_k[i])
                CASE 0 draw_rect(sx - 1, sy - 1, fx_s[i], fx_s[i], "rgba(50,40,30," + fmin(1, q * 2) + ")");
                CASE 1 r = fx_s[i] * (0.5 + (1 - q) * 0.8);
                  set_color("rgba(255," + int(60 + q * 190) + ",40," + fmin(1, q * 1.6) + ")"); circle(sx, sy, r);
                  IF (q > 0.5) set_color("rgba(255,250,200," + (q - 0.5) * 2 + ")"); circle(sx, sy, r * 0.5); END
                CASE 2 set_color("rgba(60,56,52," + q * 0.5 + ")"); circle(sx, sy, fx_s[i] * (1.6 - q));
                CASE 3 set_color("rgba(255,255,220," + q * 0.6 + ")"); circle(sx, sy, fx_s[i] * (1.3 - q));
                CASE 4 set_color("rgba(200,170,120," + q * 0.7 + ")"); circle(sx, sy, fx_s[i] * (1.5 - q));
              END
            END
          END
        END
      END
    END
    FRAME;
  END
END

// ==== Player weapons: 0 gun, 1 Hydra rocket, 2 Hellfire (homing) ====
FUNCTION pshot(k, a, tg);
PRIVATE j, i, o;
BEGIN
  FOR j = 0 TO 47
    i = (pb_cur + j) % 48;
    IF (pb_on[i] == 0)
      gun_side = -gun_side; o = gun_side * 7;         // left and right pods in turn
      pb_on[i] = 1; pb_k[i] = k; pb_a[i] = a; pb_t[i] = 0; pb_tg[i] = tg;
      pb_x[i] = hx + get_distx(hang, 10) + get_distx(hang + 90000, o);
      pb_y[i] = hy + get_disty(hang, 10) + get_disty(hang + 90000, o);
      IF (k == 0) pb_spd[i] = 520; pb_life[i] = 0.46; END
      IF (k == 1) pb_spd[i] = 330; pb_life[i] = 0.8; END
      IF (k == 2) pb_spd[i] = 110; pb_life[i] = 2.6; pb_tgen[i] = e_gen[fmax(tg, 0)]; END
      pb_cur = i + 1; shots_fired++; RETURN i;
    END
  END
  RETURN -1;
END

FUNCTION hit(s, dmg);
BEGIN
  IF (e_on[s] AND hostile(e_kind[s]) AND e_hp[s] > 0) e_hp[s] -= dmg; e_fl[s] = 0.08; END
END

// Damage to everything within r pixels of (px, py)
FUNCTION splash(px, py, r, dmg);
PRIVATE j, s;
BEGIN
  FOR j = 0 TO n_near - 1
    s = near[j];
    IF (fget_distance(px, py, e_x[s], e_y[s]) < r + k_rad[e_kind[s]]) hit(s, dmg); END
  END
END

// Best Hellfire target: the nearest enemy within 380 px ahead
FUNCTION pick_target();
PRIVATE j, s, d, best, bd, da;
BEGIN
  best = -1; bd = 380;
  FOR j = 0 TO n_near - 1
    s = near[j];
    IF (e_on[s] AND hostile(e_kind[s]) AND e_kind[s] != 13 AND e_hp[s] > 0)
      d = fget_distance(hx, hy, e_x[s], e_y[s]);
      da = abs(normalize_angle(fget_angle(hx, hy, e_x[s], e_y[s]) - hang + 180000) - 180000);
      IF (d < bd AND da < 50000) bd = d; best = s; END
    END
  END
  RETURN best;
END

PROCESS pshots();
PRIVATE i, j, s, dt, h, q, hs, r, sx, sy;
BEGIN
  ctype = c_scroll;
  LOOP
    n_near = 0;                                      // who is around the helicopter
    FOR s = 0 TO E
      IF (e_on[s] AND abs(e_x[s] - hx) < 440 AND abs(e_y[s] - hy) < 380) near[n_near] = s; n_near++; END
    END
    IF ((state == 3 OR state == 4) AND paused == 0)
      dt = get_delta();
      FOR i = 0 TO 47
        IF (pb_on[i])
          pb_t[i] += dt;
          IF (pb_k[i] == 2)                          // Hellfire: speeds up and homes
            pb_spd[i] = fmin(pb_spd[i] + 380 * dt, 330);
            s = pb_tg[i];
            IF (s >= 0)
              IF (e_on[s] AND e_gen[s] == pb_tgen[i] AND e_hp[s] > 0)
                pb_a[i] = lerp_angle(pb_a[i], fget_angle(pb_x[i], pb_y[i], e_x[s], e_y[s]), 0.12);
              ELSE
                pb_tg[i] = -1;
              END
            END
            IF (rand(0, 1) == 0) fx_add(2, pb_x[i], pb_y[i], ALT * (1 - pb_t[i] / pb_life[i]), 0, 0, 6, 30, 3); END
          END
          pb_x[i] += get_distx(pb_a[i], pb_spd[i] * dt); pb_y[i] += get_disty(pb_a[i], pb_spd[i] * dt);
          q = pb_t[i] / pb_life[i]; h = ALT * (1 - q);  // shots fall from the helicopter to the ground
          hs = -1;
          FOR j = 0 TO n_near - 1
            s = near[j];
            IF (hostile(e_kind[s]) AND e_hp[s] > 0)
              r = k_rad[e_kind[s]];
              IF (abs(pb_x[i] - e_x[s]) < r AND abs(pb_y[i] - e_y[s]) < r) hs = s; BREAK; END
            END
          END
          IF (pb_k[i] == 2 AND pb_tg[i] >= 0 AND hs != pb_tg[i] AND q < 0.9) hs = -1; END
          IF (hs >= 0 OR q >= 1)
            pb_on[i] = 0;
            SWITCH (pb_k[i])
              CASE 0
                IF (hs >= 0) hit(hs, 3); fx_add(0, pb_x[i], pb_y[i], 4, rand(-30, 30), rand(-30, 30), 50, 12, 2);
                  IF (sn_tick - sn_hit_t >= 5)       // armour pings, soft targets thud
                    sn_hit_t = sn_tick;
                    IF (e_kind[hs] == 3 OR e_kind[hs] == 5 OR e_kind[hs] == 6) sn_at(sn_ting, 30, srnd(90, 115), pb_x[i], pb_y[i]);
                    ELSE sn_at(sn_thud, 30, srnd(100, 130), pb_x[i], pb_y[i]); END
                  END
                ELSE fx_add(4, pb_x[i], pb_y[i], 0, 0, 0, 8, 14, 3); END
              CASE 1 explode(pb_x[i], pb_y[i], 1, 0); splash(pb_x[i], pb_y[i], 22, 20);
              CASE 2 explode(pb_x[i], pb_y[i], 2, 0); splash(pb_x[i], pb_y[i], 30, 90);
            END
          ELSE
            sx = pb_x[i]; sy = pb_y[i] - h;
            SWITCH (pb_k[i])
              CASE 0 draw_rect(sx - 1, sy - 1, 3, 3, '#fff4a0');
              CASE 1 set_color('#ffb040'); circle(sx - get_distx(pb_a[i], 4), sy - get_disty(pb_a[i], 4), 2);
                draw_rect(sx - 1, sy - 1, 3, 3, '#f0f0f0');
              CASE 2 set_color('#ff7020'); circle(sx - get_distx(pb_a[i], 5), sy - get_disty(pb_a[i], 5), 3);
                draw_rect(sx - 2, sy - 2, 5, 5, '#ffffff');
            END
          END
        END
      END
    END
    FRAME;
  END
END

// ==== Enemy fire: 0 bullet, 1 flak, 2 tank shell, 3 SAM (homing) ====
FUNCTION hurt(d);
BEGIN
  IF (inv_t > 0 OR heli_on == 0) RETURN 0; END
  armor -= d; hurt_t = 0.15;
  IF (sn_tick - sn_clang_t >= 6) sn_clang_t = sn_tick; play_sound(sn_clang, 80, srnd(70, 85), 0); END
  IF (armor <= 0) armor = 0; heli_down(1); END
END

PROCESS eshots();
PRIVATE i, dt, sx, sy, life;
BEGIN
  ctype = c_scroll;
  LOOP
    sn_sams = 0;
    IF ((state == 3 OR state == 4) AND paused == 0)
      dt = get_delta();
      FOR i = 0 TO 79
        IF (eb_on[i])
          eb_t[i] += dt; life = 1.3;
          IF (eb_k[i] == 3)                          // SAM: slow turn, smoke trail
            life = 4.5; sn_sams++;
            IF (heli_on) eb_a[i] = lerp_angle(eb_a[i], fget_angle(eb_x[i], eb_y[i], hx, hy), 0.035); END
            IF (rand(0, 1) == 0) fx_add(2, eb_x[i], eb_y[i], eb_h[i], 0, 0, 5, 40, 3); END
          END
          eb_x[i] += get_distx(eb_a[i], eb_spd[i] * dt); eb_y[i] += get_disty(eb_a[i], eb_spd[i] * dt);
          eb_h[i] += (ALT - eb_h[i]) * 0.06;         // climbs to the helicopter's height
          IF (eb_t[i] > life)
            eb_on[i] = 0;
            IF (eb_k[i] >= 1) fx_add(2, eb_x[i], eb_y[i], eb_h[i], 0, 0, 4, 30, 5); END
          ELSE
            IF (heli_on AND abs(eb_x[i] - hx) < 10 AND abs(eb_y[i] - hy) < 10)
              eb_on[i] = 0; hurt(eb_dmg[i]);
              IF (eb_k[i] == 3) explode(hx, hy, 1, ALT); ELSE fx_add(3, hx, hy, ALT, 0, 0, 0, 6, 6); END
            ELSE
              sx = eb_x[i]; sy = eb_y[i] - eb_h[i];
              SWITCH (eb_k[i])
                CASE 0 draw_rect(sx - 1, sy - 1, 3, 3, '#ffe060');
                CASE 1 set_color('#ff9030'); circle(sx, sy, 3);
                CASE 2 set_color('#303030'); circle(sx, sy, 3); draw_rect(sx - 1, sy - 1, 2, 2, '#ffd080');
                CASE 3 draw_rect(sx - 2, sy - 2, 5, 5, '#f0f0f0'); set_color('#ff5020');
                  circle(sx - get_distx(eb_a[i], 5), sy - get_disty(eb_a[i], 5), 3);
              END
            END
          END
        END
      END
    END
    FRAME;
  END
END

// ==== The helicopter ====
FUNCTION respawn();
PRIVATE i;
BEGIN
  hx = lz_x; hy = lz_y; hvx = 0; hvy = 0; hang = 90000; hspd = 0;
  armor = 100; fuel = 100; n_gun = 900; n_hyd = 38; n_hf = 8;
  heli_on = 1; inv_t = 2; winch = -1; carry = 0;
  FOR i = 0 TO 47 pb_on[i] = 0; END
  FOR i = 0 TO 79 eb_on[i] = 0; END
END

// Shot down (why 1) or out of fuel (why 2)
FUNCTION heli_down(why);
PRIVATE i, tx;
BEGIN
  IF (heli_on == 0) RETURN 0; END
  heli_on = 0; lives--; hurt_t = 0;
  explode(hx, hy, 3, ALT); explode(hx, hy, 2, 0); scorch(hx, hy, 14); fire_add(hx, hy, 12);
  play_sound(sn_boom[2], 100, 60, 0);
  IF (winch >= 0) e_lift[winch] = 0; winch = -1; END
  // pilots on board survive the crash and wait where they were found
  FOR i = 0 TO carry - 1 tx = land_near(st_x[cg[i]], st_y[cg[i]], 50); spawn(9, tx, ln_y, cg[i], 0); END
  carry = 0; msg(why); state = 4; down_t = 3.0;
END

// How far a crate or pilot on the ground is from the winch. The player sees
// the helicopter ALT pixels above its shadow and puts either one over the
// thing to lift, so the whole vertical line between them counts.
FUNCTION winch_dist(ex, ey);
PRIVATE dy;
BEGIN
  dy = 0;
  IF (ey > hy) dy = ey - hy; END
  IF (ey < hy - ALT) dy = hy - ALT - ey; END
  RETURN sqrt((ex - hx) * (ex - hx) + dy * dy);
END

// Something winched aboard
FUNCTION collect(s);
PRIVATE k;
BEGIN
  k = e_kind[s];
  e_gone[s] = 1; e_hp[s] = 0; e_lift[s] = 0; winch = -1;
  IF (k == 9) cg[carry] = e_grp[s]; carry++; msg(5); RETURN 0; END
  crates_got++; score += 50;
  IF (k == 10) fuel = fmin(100, fuel + 55); msg(6); END
  IF (k == 11) n_gun = fmin(1200, n_gun + 450); n_hyd = fmin(38, n_hyd + 19); n_hf = fmin(8, n_hf + 4); msg(7); END
  IF (k == 12) armor = fmin(100, armor + 45); msg(8); END
END

PROCESS rotor();
BEGIN
  ctype = c_scroll; z = -22; graph = g_rotor; alpha = 60; size = 125;
  LOOP
    graph = g_rotor * heli_on;
    x = hx + get_distx(hang, 4); y = hy - ALT + get_disty(hang, 4) + sin(game_t * 200000) * 1.5;
    IF (paused == 0) angle = (angle + 47000) % 360000; END
    FRAME;
  END
END

PROCESS hshadow();
BEGIN
  ctype = c_scroll; z = 3; graph = g_shadow; alpha = 38; size = 125;
  LOOP
    graph = g_shadow * heli_on;
    x = hx + 7; y = hy + 3; angle = hang;
    FRAME;
  END
END

PROCESS heli();
PRIVATE dt, ax, ay, j, s, d, best, bd;
BEGIN
  ctype = c_scroll; z = -20; graph = g_heli; size = 125;
  rotor(); hshadow();
  LOOP
    IF (state == 3 AND heli_on AND paused == 0)
      dt = get_delta();
      ax = 0; ay = 0;                                // thrust this frame
      // strafe sideways: A/D always, or SHIFT with the arrows
      IF (key(_a) OR (key(_shift) AND key(_left))) ax += get_distx(hang + 90000, 200); ay += get_disty(hang + 90000, 200); END
      IF (key(_d) OR (key(_shift) AND key(_right))) ax += get_distx(hang - 90000, 200); ay += get_disty(hang - 90000, 200); END
      IF (NOT key(_shift))
        IF (key(_left)) hang += int(190000 * dt); END
        IF (key(_right)) hang -= int(190000 * dt); END
        hang = normalize_angle(hang);
      END
      IF (key(_up)) ax += get_distx(hang, 230); ay += get_disty(hang, 230); END
      IF (key(_down)) ax -= get_distx(hang, 130); ay -= get_disty(hang, 130); END
      // inertia: thrust accelerates, air drag slows (top speed ~ 190 px/s)
      hvx += (ax - hvx * 1.2) * dt; hvy += (ay - hvy * 1.2) * dt;
      hx = clamp(hx + hvx * dt, 20, WW - 20); hy = clamp(hy + hvy * dt, 40, WH - 20);
      hspd = sqrt(hvx * hvx + hvy * hvy);
      fuel -= dt * (0.7 + hspd * 0.002);
      inv_t -= dt; hurt_t -= dt;

      // weapons
      gun_rl -= dt; hyd_rl -= dt; hf_rl -= dt;
      IF (key(_space) AND gun_rl <= 0 AND n_gun > 0)
        gun_rl = 0.07; n_gun--; pshot(0, hang + rand(-1500, 1500), -1);
        IF (sn_tick - sn_gun_t >= 4)                 // the chain gun: two sounds in turn, pitch varied
          sn_gun_t = sn_tick; sn_gi = 1 - sn_gi;
          play_sound(sn_gun[sn_gi], 36, srnd(88, 116), 0);
        END
      END
      IF ((key(_z) OR key_pressed(_z)) AND hyd_rl <= 0 AND n_hyd > 0)
        hyd_rl = 0.25; n_hyd--; pshot(1, hang, -1);
        play_sound(sn_hydra, 50, srnd(92, 110), 0); play_sound(sn_pop, 40, srnd(90, 110), 0);
      END
      IF ((key(_x) OR key_pressed(_x)) AND hf_rl <= 0 AND n_hf > 0)
        hf_rl = 0.9; n_hf--; sn_t = pick_target(); pshot(2, hang, sn_t);
        play_sound(sn_hf, 60, 100, 0);
        IF (sn_t >= 0) sn_beeps(sn_lock, 35); ELSE play_sound(sn_nolock, 35, 100, 0); END   // lock-on tone
      END

      // winch: hover slowly over a crate or a pilot to lift it aboard
      IF (winch < 0)
        IF (hspd < 60)
          best = -1; bd = 20;
          FOR j = 0 TO n_near - 1
            s = near[j];
            IF (e_on[s] AND e_kind[s] >= 9 AND e_kind[s] <= 12 AND e_hp[s] > 0)
              IF (e_kind[s] != 9 OR carry < 6)
                d = winch_dist(e_x[s], e_y[s]);
                IF (d < bd) bd = d; best = s; END
              END
            END
          END
          winch = best;
        END
      ELSE
        IF (e_on[winch] == 0 OR e_hp[winch] <= 0 OR hspd > 90 OR winch_dist(e_x[winch], e_y[winch]) > 30)
          IF (e_on[winch]) e_lift[winch] = 0; END
          winch = -1;
        ELSE
          e_lift[winch] += 34 * dt;
          IF (e_lift[winch] >= ALT - 4) collect(winch); END
        END
      END

      // landing zone: drop the rescued pilots one by one
      IF (carry > 0 AND hspd < 45 AND fget_distance(hx, hy, lz_x, lz_y) < 40)
        unload_t -= dt;
        IF (unload_t <= 0) unload_t = 0.45; carry--; m_got[cg[carry]]++; score += 500; msg(9); END
      END
      IF (fuel <= 0) fuel = 0; heli_down(2); END
    END
    graph = g_heli * heli_on;
    x = hx; y = hy - ALT + sin(game_t * 200000) * 1.5; angle = hang;   // a slight hover bob
    alpha = 100 - (inv_t > 0 AND (int(game_t * 10) % 2) == 0) * 50;   // blinks after a respawn
    FRAME;
  END
END

// ==== Missions ====
FUNCTION m_name(t);
BEGIN
  SWITCH (t)
    CASE 0 RETURN "DESTROY THE RADAR SITES";
    CASE 1 RETURN "RESCUE THE DOWNED PILOTS";
    CASE 2 RETURN "KNOCK OUT THE SAM BATTERY";
    CASE 3 RETURN "DESTROY THE SUPPLY CONVOY";
  END
  RETURN "DESTROY THE COMMAND BUNKER";
END

// Two lines (n = 0, 1) of briefing for mission type t
FUNCTION m_brief(t, n);
BEGIN
  SWITCH (t * 2 + n)
    CASE 0 RETURN "Blind the enemy: every radar dish";
    CASE 1 RETURN "at the marked base must go.";
    CASE 2 RETURN "Blast open the prison camp, winch";
    CASE 3 RETURN "the pilots up, land them at the LZ.";
    CASE 4 RETURN "SAM launchers guard the base.";
    CASE 5 RETURN "Outrun the missiles, hit the pits.";
    CASE 6 RETURN "Supply trucks run along the road";
    CASE 7 RETURN "near the base. Stop all of them.";
    CASE 8 RETURN "The enemy commander hides in a";
  END
  RETURN "fortified bunker. Hellfires work.";
END

FUNCTION msg(id); BEGIN msg_id = id; msg_t = 2.5; msg_sound(id); END

FUNCTION msg_text(id);
BEGIN
  SWITCH (id)
    CASE 1 RETURN "SHOT DOWN!";
    CASE 2 RETURN "OUT OF FUEL - THE HELICOPTER GOES DOWN";
    CASE 3 RETURN "MISSION COMPLETE";
    CASE 4 RETURN "PRISONERS FREED - PICK THEM UP";
    CASE 5 RETURN "PILOT ABOARD - FLY HIM TO THE LZ";
    CASE 6 RETURN "FUEL";
    CASE 7 RETURN "AMMUNITION";
    CASE 8 RETURN "ARMOUR REPAIRED";
    CASE 9 RETURN "PILOT RESCUED";
    CASE 10 RETURN "ENEMY REINFORCEMENTS ON THE ROADS";
  END
  RETURN "";
END

// Difficulty and reinforcements for mission cur_m
FUNCTION start_mission();
PRIVATE k;
BEGIN
  diff = cur_m + (campaign - 1) * 2;
  rfac = 1.0 / (1 + diff * 0.12);                  // shorter reloads
  dfac = 1 + diff * 0.12;                          // harder hits
  IF (diff > 0) FOR k = 1 TO diff road_unit(3, rand(0, n_rd - 1), -1, 0); END msg(10); END
END

// How many targets of the current mission are left
FUNCTION mission_left();
PRIVATE s, n;
BEGIN
  IF (m_type[cur_m] == 1) RETURN m_need[cur_m] - m_got[cur_m]; END
  n = 0;
  FOR s = 0 TO E n += (e_on[s] AND e_tgt[s] AND e_grp[s] == cur_m AND e_hp[s] > 0); END RETURN n; END

// ==== Screens ====
PROCESS panel(g, px, py, pz, sz, st);
BEGIN
  x = px; y = py; z = pz; size = sz;
  LOOP
    graph = 0;
    IF (st == 1 AND state >= 3 AND state <= 4) graph = g; END   // radar in flight
    IF (st == 2 AND state == 2) graph = g; END                  // briefing map
    IF (st == 3 AND state == 0) graph = g_title; END            // big lettering
    IF (st == 3 AND state == 5) graph = g_over; END
    IF (st == 3 AND state == 6) graph = g_win; END
    FRAME;
  END
END

FUNCTION bar(px, py, v, c);
BEGIN
  draw_rect(px, py, 62, 8, '#302418'); draw_rect(px + 1, py + 1, v * 0.6, 6, c);
END

// Colour of an entity's dot on the radar: blinking mission targets,
// white pilots, green crates, red enemies
FUNCTION dot_col(s);
PRIVATE k;
BEGIN
  k = e_kind[s];
  IF (e_tgt[s] AND e_grp[s] == cur_m)
    IF (int(game_t * 4) % 2 == 0) RETURN '#ffff40'; END
    RETURN '#ff8020';
  END
  IF (k == 9) RETURN '#ffffff'; END
  IF (k >= 10 AND k <= 12) RETURN '#40ff60'; END
  RETURN '#e03020';
END

FUNCTION draw_hud();
PRIVATE s, c, a, sx, sy, tx, ty;
BEGIN
  draw_rect(0, 0, 640, 20, 'rgba(20,14,6,0.75)');
  IF (armor > 35) bar(44, 5, armor, '#60d060'); ELSE bar(44, 5, armor, '#ff4030'); END
  IF (fuel > 25) bar(146, 5, fuel, '#e0c040'); ELSE bar(146, 5, fuel, '#ff4030'); END
  set_color('#e8d8b0'); text(6, 6, "ARMOR"); text(116, 6, "FUEL");
  text(216, 6, "GUN " + n_gun); text(284, 6, "HYD " + n_hyd); text(344, 6, "HF " + n_hf);
  text(390, 6, "PILOTS " + carry + "/6"); text(482, 6, "HELI " + lives);
  text(536, 6, "" + score);
  // mission line
  draw_rect(0, 462, 500, 18, 'rgba(20,14,6,0.75)');
  set_color('#ffe070');
  text(6, 467, "MISSION " + (cur_m + 1) + "/" + nm + ": " + m_name(m_type[cur_m]) + "  LEFT " + fmax(m_left, 0));
  set_color('#a09070'); text(372, 467, "M: MAP  N: MUSIC");
  // radar: the painted mini map plus live dots
  FOR s = 0 TO E
    IF (e_on[s] AND e_kind[s] != 13)                 // soldiers are too small
      draw_rect(504 + e_x[s] / 16, 376 + e_y[s] / 16, 2, 2, dot_col(s));
    END
  END
  draw_rect(502 + lz_x / 16, 374 + lz_y / 16, 5, 5, '#40a0ff');
  draw_rect(503 + hx / 16, 375 + hy / 16, 3, 3, '#ffffff');
  sx = 504 + cam_x / 16; sy = 376 + cam_y / 16;          // camera frame
  set_color('#ffffff');
  draw_rect(sx, sy, 40, 1); draw_rect(sx, sy + 30, 40, 1); draw_rect(sx, sy, 1, 30); draw_rect(sx + 40, sy, 1, 31);
  // objective pointer around the helicopter: the base, or the LZ with pilots
  tx = st_x[cur_m]; ty = st_y[cur_m];
  IF (carry > 0) tx = lz_x; ty = lz_y; END
  IF (heli_on AND fget_distance(hx, hy, tx, ty) > 150)
    a = fget_angle(hx, hy, tx, ty); set_color('#ffe040');
    circle(hx - cam_x + get_distx(a, 58), hy - ALT - cam_y + get_disty(a, 58), 4);
    circle(hx - cam_x + get_distx(a, 50), hy - ALT - cam_y + get_disty(a, 50), 3);
    circle(hx - cam_x + get_distx(a, 43), hy - ALT - cam_y + get_disty(a, 43), 2);
  END
  IF (fuel < 25 AND heli_on AND int(game_t * 3) % 2 == 0) set_color('#ff4030'); text(290, 30, "LOW FUEL"); END
  IF (winch >= 0 AND heli_on)                       // the winch rope
    set_color('#303030');
    FOR s = 1 TO 5
      draw_rect(e_x[winch] - cam_x, hy - ALT - cam_y + (e_y[winch] - e_lift[winch] - hy + ALT) * s / 6, 1, 3);
    END
  END
  IF (msg_t > 0) draw_rect(150, 90, 340, 20, 'rgba(0,0,0,0.5)'); set_color('#ffffff'); text(160, 96, msg_text(msg_id)); END
  IF (hurt_t > 0) draw_rect(0, 0, 640, 480, 'rgba(255,40,20,0.22)'); END
END

FUNCTION draw_briefing();
PRIVATE m, px, py;
BEGIN
  set_color('#ffe070');
  text(16, 16, "CAMPAIGN " + campaign + "  -  MAP #" + seed + "  -  MISSION " + (cur_m + 1) + " OF " + nm);
  FOR m = 0 TO nm - 1                              // mission markers
    px = 16 + st_x[m] * 3 / 16; py = 48 + st_y[m] * 3 / 16;
    set_color('#a0a0a0');
    IF (m < cur_m) set_color('#40e060'); END
    IF (m == cur_m AND int(game_t * 3) % 2 == 0) set_color('#ffff40'); END
    circle(px, py, 7);
    set_color('#000000'); text(px - 2, py - 3, "" + (m + 1));
  END
  set_color('#40a0ff'); circle(16 + lz_x * 3 / 16, 48 + lz_y * 3 / 16, 5);
  text(22 + lz_x * 3 / 16, 42 + lz_y * 3 / 16, "LZ");
  IF (heli_on) set_color('#ffffff'); circle(16 + hx * 3 / 16, 48 + hy * 3 / 16, 3); END
  FOR m = 0 TO nm - 1                              // the mission list
    set_color('#a09880');
    IF (m < cur_m) set_color('#40e060'); END
    IF (m == cur_m) set_color('#ffff60'); END
    text(412, 50 + m * 26, "" + (m + 1) + " " + m_name(m_type[m]));
    IF (m < cur_m) text(424, 61 + m * 26, "done"); END
  END
  set_color('#ffffff'); text(412, 190, m_brief(m_type[cur_m], 0)); text(412, 202, m_brief(m_type[cur_m], 1));
  set_color('#c8b890');
  text(16, 352, "ARROWS  turn / thrust      A/D (or SHIFT+LEFT/RIGHT)  strafe");
  text(16, 366, "SPACE  guns (fast, weak)   Z  Hydra rockets   X  Hellfire (homing)");
  text(16, 380, "Hover slowly over crates (Fuel, Ammo, +Armour) and pilots to winch");
  text(16, 394, "them up. Land pilots at the LZ. Watch the fuel: empty means a crash.");
  text(16, 408, "M  map (pause)      N  music on/off");
  set_color('#60ff60');
  IF (paused) text(16, 420, "M / SPACE: back to the fight"); ELSE text(16, 420, "SPACE: take off"); END
END

// Kills the old world and generates a new campaign map
FUNCTION new_campaign(next_state);
PRIVATE i;
BEGIN
  signal(TYPE ent, s_kill); signal(TYPE turret, s_kill); signal(TYPE builder, s_kill);
  signal(TYPE painter, s_kill);
  FOR i = 0 TO E e_on[i] = 0; END
  FOR i = 0 TO 47 pb_on[i] = 0; END
  FOR i = 0 TO 79 eb_on[i] = 0; END
  FOR i = 0 TO 199 fx_on[i] = 0; END
  FOR i = 0 TO 23 bf_t[i] = 0; END
  n_fx = 0;
  heli_on = 0; paused = 0; msg_t = 0; done_t = 0; winch = -1; carry = 0;
  seed = (seed * 31 + int(get_time() * 1000) + rand(1, 999)) % 99991 + 1;
  builder(next_state);
END

// ==== MAIN ====
PRIVATE dt, tx, ty;
BEGIN
  set_mode(640, 480); set_fps(60, 0); screen_color('#000000');
  init_tables(); make_graphics(); make_sounds(); make_songs();
  define_region(1, 0, 0, 640, 480);
  start_scroll(0, 0, g_map, 0, 1, 0);         // the painted map, moved by scroll.x0 / y0
  heli(); pshots(); eshots(); fxman(); snd_director();
  panel(g_mini, 568, 424, -50, 100, 1);
  panel(g_mini, 208, 192, -60, 300, 2);
  panel(g_dim, 320, 240, -55, 100, 2);
  panel(0, 320, 150, -70, 100, 3);
  seed = rand(1, 99999); new_campaign(0);
  LOOP
    dt = get_delta(); game_t += dt; msg_t -= dt;
    // camera: ahead of the helicopter, smoothed; the title screen drifts
    IF (state == 0 OR state == 1)
      tx = WW / 2 + sin(game_t * 6000) * 700 - 320; ty = WH / 2 + cos(game_t * 5000) * 450 - 240;
    ELSE
      tx = hx + hvx * 0.6 - 320; ty = hy - ALT + hvy * 0.6 - 250;
    END
    IF (paused == 0) cam_x += (tx - cam_x) * fmin(1, 4 * dt); cam_y += (ty - cam_y) * fmin(1, 4 * dt); END
    cam_x = clamp(cam_x, 0, WW - 640); cam_y = clamp(cam_y, 0, WH - 480);
    scroll.x0 = int(cam_x); scroll.y0 = int(cam_y);

    SWITCH (state)
      CASE 0                                         // title
        draw_rect(120, 200, 400, 150, 'rgba(0,0,0,0.65)');
        set_color('#ffffff');
        text(140, 214, "A new desert, new bases and new missions");
        text(140, 228, "are generated for every campaign.");
        text(140, 250, "Fly your attack helicopter deep into");
        text(140, 264, "enemy land, one mission after another.");
        set_color('#60ff60'); text(140, 300, "PRESS SPACE TO SEE THE BRIEFING");
        set_color('#c0b090'); text(140, 322, "map #" + seed);
        IF (key_pressed(_space) OR key_pressed(_enter)) state = 2; END
      CASE 1                                         // generating
        draw_rect(0, 0, 640, 480, 'rgba(0,0,0,0.75)'); // hides the half-painted map
        set_color('#ffffff'); text(190, 236, "Generating the desert... " + gen_pct + "%");
      CASE 2                                         // briefing / map screen
        draw_briefing();
        IF (key_pressed(_space) OR key_pressed(_enter) OR (paused AND key_pressed(_m))) state = 3; paused = 0; END
      CASE 3, 4                                      // flying / shot down
        m_left = mission_left();
        IF (state == 3 AND m_left <= 0 AND done_t <= 0) done_t = 3.0; msg(3); score += 1000 * (cur_m + 1); END
        IF (done_t > 0 AND state == 3)             // a short pause, then the next briefing
          done_t -= dt;
          IF (done_t <= 0)
            cur_m++;
            IF (cur_m >= nm) cur_m = nm - 1; state = 6; ELSE start_mission(); state = 2; END
          END
        END
        IF (state == 4)                            // after a crash: next helicopter or game over
          down_t -= dt;
          IF (down_t <= 0) IF (lives > 0) respawn(); state = 3; ELSE state = 5; END END
        END
        IF (state == 3 AND key_pressed(_m)) state = 2; paused = 1; END
        draw_hud();
      CASE 5, 6                                      // game over / campaign won
        draw_rect(120, 190, 400, 120, 'rgba(0,0,0,0.7)');
        set_color('#ffffff');
        text(140, 206, "Score " + score + "    missions done " + (cur_m + (state == 6)) + " of " + nm);
        text(140, 222, "Targets destroyed " + kills);
        set_color('#60ff60');
        IF (state == 5) text(140, 256, "SPACE: new campaign on a new map");
        ELSE text(140, 256, "SPACE: next campaign (harder), new map"); END
        IF (key_pressed(_space) OR key_pressed(_enter))
          IF (state == 5) campaign = 1; score = 0; kills = 0; ELSE campaign++; END
          lives = 3; new_campaign(2);
        END
    END
    FRAME;
  END
END
