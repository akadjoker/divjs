PROGRAM pathfind_demo;

GLOBAL g_target_x = 760;
GLOBAL g_target_y = 440;
GLOBAL g_path = 0;
GLOBAL g_path_len = 0;
GLOBAL g_path_idx = 1;
GLOBAL g_repath_cd = 0;
GLOBAL g_grid = 16;
GLOBAL g_diag = 1;
GLOBAL g_wall_type = 0;
GLOBAL g_mouse_prev = 0;
GLOBAL g_last_repath_ok = 0;
GLOBAL g_step_state = 0;

PROCESS wall(px, py, w, h);
BEGIN
  x = px;
  y = py;
  width = w;
  height = h;

  LOOP
    set_color('#37506a');
    draw_rect(x, y, width, height);

    set_color('#5a7c9d');
    draw_rect(x + 2, y + 2, width - 4, height - 4);

    FRAME;
  END
END

PROCESS bot();
PRIVATE speed = 130; ang = 0; eye_x = 0; eye_y = 0;
BEGIN
  x = 60;
  y = 60;
  width = 16;
  height = 16;

  LOOP
    IF (g_repath_cd <= 0)
      IF (g_path) path_clear(g_path); END

      g_path = path_find(x + 8, y + 8, g_target_x, g_target_y, g_wall_type, g_grid, g_diag, 8192);
      g_path_len = path_length(g_path);
      g_last_repath_ok = 0;
      IF (g_path)
        g_last_repath_ok = path_assign(g_path, 1);
      END
      g_repath_cd = 0.22;
    ELSE
      g_repath_cd = g_repath_cd - get_delta();
    END

    g_step_state = path_step(speed, 2);
    g_path_idx = path_index();

    IF (g_path_idx < g_path_len)
      // DIV angle towards the next waypoint (0 right, 90000 up).
      ang = fget_angle(x + 8, y + 8, path_get_x(g_path, g_path_idx), path_get_y(g_path, g_path_idx));
      angle = ang;
    END

    set_color('#6bff99');
    draw_rect(x, y, width, height);

    eye_x = x + 8 + get_distx(ang, 5);
    eye_y = y + 8 + get_disty(ang, 5);
    set_color('#eafff3');
    circle(eye_x, eye_y, 2);

    set_color('#143925');
    circle(x + 8, y + 8, 3);

    FRAME;
  END
END

BEGIN
  set_mode(860, 520);
  set_fps(60, 0);  // written for 60 fps (DIV's default is 18)
  screen_color('#0e1a29');

  g_wall_type = TYPE wall;

  wall(180, 40, 24, 360);
  wall(320, 160, 24, 300);
  wall(470, 40, 24, 260);
  wall(620, 210, 24, 270);
  wall(730, 60, 24, 210);
  wall(80, 260, 180, 24);
  wall(410, 340, 170, 24);

  bot();

  // WRITE texts persist until delete_text, so they are written once;
  // OFFSET keeps the numbers live without rewriting them every frame.
  set_color('#ffcf5a');
  write(0, 16, 14, 0, 'PATHFIND DEMO (A* GRID)');
  write(0, 16, 34, 0, 'click: new target');
  write(0, 16, 54, 0, 'path points:');
  write_int(0, 130, 54, 0, OFFSET g_path_len);
  write(0, 16, 74, 0, 'path id:');
  write_int(0, 130, 74, 0, OFFSET g_path);
  write(0, 16, 94, 0, 'repath ok:');
  write_int(0, 130, 94, 0, OFFSET g_last_repath_ok);
  write(0, 16, 114, 0, 'path idx:');
  write_int(0, 130, 114, 0, OFFSET g_path_idx);
  write(0, 16, 134, 0, 'step state:');
  write_int(0, 130, 134, 0, OFFSET g_step_state);

  LOOP
    IF (mouse_button(0))
      IF (g_mouse_prev == 0)
        g_target_x = mouse_x();
        g_target_y = mouse_y();
        g_repath_cd = 0;
      END
      g_mouse_prev = 1;
    ELSE
      g_mouse_prev = 0;
    END

    IF (g_path)
      FOR i = 0 TO g_path_len - 1
        set_color('#5cc6ff');
        circle(path_get_x(g_path, i), path_get_y(g_path, i), 2);
      END
    END

    set_color('#ffcf5a');
    circle(g_target_x, g_target_y, 6);

    FRAME;
  END
END
