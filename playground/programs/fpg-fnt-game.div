PROGRAM div_fpg_fnt_game;

GLOBAL g_lib = 0;
GLOBAL g_fnt = 0;
GLOBAL g_anim = 1;
GLOBAL g_anim_dir = 1;
GLOBAL g_tick = 0;
GLOBAL g_score = 0;
GLOBAL g_debug = 1;
GLOBAL g_debug_key = 'Tab';
GLOBAL g_debug_latch = 0;
GLOBAL g_last_px = 0;
GLOBAL g_last_py = 0;
GLOBAL g_last_collider = -1;
GLOBAL g_last_collided = -1;
GLOBAL k_left = 'ArrowLeft';
GLOBAL k_right = 'ArrowRight';
GLOBAL k_up = 'ArrowUp';
GLOBAL k_down = 'ArrowDown';
GLOBAL k_a = 'a';
GLOBAL k_d = 'd';
GLOBAL k_w = 'w';
GLOBAL k_s = 's';

PROCESS enemy(px, py, g0, cbox_code);
PRIVATE file = 0; graph = 0; base_y = 0; phase = 0;
BEGIN
  x = px;
  y = py;
  base_y = py;
  width = 32;
  height = 32;
  file = g_lib;
  graph = g0;
  set_collision_shape(0);
  clear_collision_boxes();
  add_collision_box(6, 6, 20, 20, cbox_code);

  LOOP
    phase = phase + 5000;
    y = base_y + sin(phase) * 6 / 100000;

    IF (g_anim >= g0 AND g_anim <= g0 + 2)
      graph = g_anim;
    END

    IF (g_debug)
      set_color('#20d6ee33');
      draw_rect(x + 6, y + 6, 20, 20);
      set_color('#20d6ee');
      circle(x + 16, y + 16, 2);
    END

    FRAME;
  END
END

// The current animation frame, shown at double size. This was an xput()
// every frame, but xput draws permanently into the background (as in
// DIV), so every frame piled up on top of the previous ones.
PROCESS preview();
PRIVATE file = 0; graph = 0;
BEGIN
  x = 740;
  y = 70;
  size = 200;
  file = g_lib;
  LOOP
    graph = g_anim;
    FRAME;
  END
END

PROCESS player();
PRIVATE file = 0; graph = 0; speed = 3; hit = 0;
BEGIN
  x = 390;
  y = 360;
  width = 32;
  height = 32;
  file = g_lib;
  graph = 1;
  set_collision_shape(0);
  clear_collision_boxes();
  add_collision_box(8, 8, 16, 16, 101);

  LOOP
     IF (key(k_left) OR key(k_a))  x = x - speed; END
     IF (key(k_right) OR key(k_d)) x = x + speed; END
     IF (key(k_up) OR key(k_w))    y = y - speed; END
     IF (key(k_down) OR key(k_s))  y = y + speed; END

    IF (x < 16) x = 16; END
    IF (x > 784) x = 784; END
    IF (y < 90) y = 90; END
    IF (y > 470) y = 470; END

    graph = g_anim;

    hit = collision(TYPE enemy);
    IF (hit)
      g_score = g_score + 1;
      g_last_px = penetration_x();
      g_last_py = penetration_y();
      g_last_collider = collider_cbox();
      g_last_collided = collided_cbox();
    ELSE
      g_last_px = 0;
      g_last_py = 0;
      g_last_collider = -1;
      g_last_collided = -1;
    END

    IF (g_debug)
      set_color('#59ff8d33');
      draw_rect(x + 8, y + 8, 16, 16);
      set_color('#59ff8d');
      circle(x + 16, y + 16, 2);

      IF (g_last_px > 0)
        draw_rect(x + 16, y + 15, g_last_px, 2);
      END
      IF (g_last_px < 0)
        draw_rect(x + 16 + g_last_px, y + 15, -g_last_px, 2);
      END

      IF (g_last_py > 0)
        draw_rect(x + 15, y + 16, 2, g_last_py);
      END
      IF (g_last_py < 0)
        draw_rect(x + 15, y + 16 + g_last_py, 2, -g_last_py);
      END

      circle(x + 16 + g_last_px, y + 16 + g_last_py, 3);
    END

    FRAME;
  END
END

BEGIN
  set_mode(800, 500);
  set_fps(60, 0);  // written for 60 fps (DIV's default is 18)
  screen_color('#0e1a29');

  g_lib = load_fpg('../assets/div-support/tutor0.fpg');
  g_fnt = load_fnt('../assets/div-support/tutor1.fnt');

  enemy(170, 220, 4, 11);
  enemy(320, 180, 8, 12);
  enemy(520, 240, 12, 13);
  enemy(660, 170, 16, 14);
  player();
  preview();

  // WRITE texts stay on screen until delete_text, so the HUD is written
  // once; OFFSET keeps the numbers in step with their variables.
  // The title uses the FNT (tutor1.fnt: ~40px tall, capitals only); the
  // data lines use the system font (0), which has lowercase letters and
  // fits the 14px line spacing - in the FNT they overlapped each other.
  set_color('#9bc8f2');
  write(g_fnt, 20, 18, 0, 'DIV FPG/FNT DEMO');
  write(0, 20, 66, 0, 'sprites: tutor0.fpg   font: tutor1.fnt');
  write(0, 20, 80, 0, 'collisions:');
  write_int(0, 120, 80, 0, OFFSET g_score);
  write(0, 20, 94, 0, 'debug (TAB):');
  write_int(0, 120, 94, 0, OFFSET g_debug);
  write(0, 20, 108, 0, 'pen x:');
  write_int(0, 120, 108, 0, OFFSET g_last_px);
  write(0, 20, 122, 0, 'pen y:');
  write_int(0, 120, 122, 0, OFFSET g_last_py);
  write(0, 20, 136, 0, 'cbox a/b:');
  write_int(0, 120, 136, 0, OFFSET g_last_collider);
  write(0, 140, 136, 0, '/');
  write_int(0, 150, 136, 0, OFFSET g_last_collided);

  LOOP
    g_tick = g_tick + 1;

    IF (key(g_debug_key))
      IF (g_debug_latch == 0)
        g_debug = 1 - g_debug;
      END
      g_debug_latch = 1;
    ELSE
      g_debug_latch = 0;
    END

    IF (g_tick % 8 == 0)
      g_anim = g_anim + g_anim_dir;
      IF (g_anim >= 3)
        g_anim = 3;
        g_anim_dir = -1;
      END
      IF (g_anim <= 1)
        g_anim = 1;
        g_anim_dir = 1;
      END
    END

    FRAME;
  END
END
