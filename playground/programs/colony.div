PROGRAM colony;

// ISLE OF SETTLERS - a tiny colony simulation in the spirit of The
// Settlers and Dwarf Fortress.
// Every game is played on a new island: two octaves of value noise minus
// a falloff towards the edges give the height (sea, shallows, beach,
// grass, stone outcrops), a cellular automaton grows the woods, berry
// bushes and fish are scattered, and a flood fill sinks every islet that
// cannot be walked to. The island is painted once into a big graphic
// shown through a scroll window and repainted a tile at a time.
// The settlers are autonomous: each one has hunger and rest, and a small
// utility AI picks the best job whenever it is free (eat, sleep, chop,
// mine, gather, fish, haul, build), scored by the player's priorities and
// the walking distance. The player only marks trees and rocks, places
// buildings and sets the priorities. One PATHFINDER process serves every
// settler with a breadth-first search spread over several frames.

GLOBAL
  MW = 64; MH = 64; NC = 4096;   // island size in 16-pixel tiles, cells
  PL = 96;                       // longest stored path, in cells
  CAP = 24; BCAP = 40;           // most settlers / buildings
  DAYLEN = 90;                   // seconds per day at normal speed
  WIN_POP = 16;                  // population that wins the game

  // ---- the island (one cell = row * MW + column)
  tile[4095];    // 0 sea, 1 shallows, 2 beach, 3 grass, 4 tree, 5 rock, 6 bush
  res[4095];     // what is left: stone chunks, berries, fish
  pass[4095];    // 1 = settlers can walk here
  mark[4095];    // 1 marked for cutting/mining, 2 unmarked but still listed
  pile_t[4095];  // goods on the ground: 1 wood, 2 stone, 3 food (kept
                 // while the cell is in the pile list, even when empty)
  pile_n[4095];
  claim[4095];   // settler slot + 1 that is working on this cell
  bad[4095];     // game time until which the cell is known unreachable
  mlist[399]; n_mark = 0;        // marked trees and rocks
  blist[299]; n_bush = 0;        // berry bushes
  flist[299]; n_fish = 0;        // fishing spots (shallows next to land)
  plist[199]; n_pile = 0;        // piles on the ground
  lat[80]; lat2[288]; lat3[288]; latf[80]; hist[199]; sw8[8];
  nb[7]; nbx[7]; nby[7];         // the 8 neighbours of a cell

  // ---- settlers
  c_used[23]; c_x[23]; c_y[23]; c_nm[23];
  c_job[23];     // see jname[] below
  c_st[23];      // 0 choosing, 1 walking to work, 2 working, 3 carrying, 4 asleep
  c_tgt[23];     // target cell (claimed) or -1
  c_dest[23];    // building walked to, -1 none
  c_site[23]; c_want[23];        // supply run: site and material
  c_hun[23]; c_rest[23]; c_hp[23];
  c_carry[23]; c_cn[23];         // carried goods type and amount
  c_hide[23];                    // 1 while asleep inside a house
  p_state[23];   // path: 0 none, 1 asked, 2 ready, 3 failed, 4 searching
  p_goal[23]; p_gsz[23]; p_start[23]; p_len[23]; p_idx[23]; p_full[23];
  pth[2303];                     // 24 paths of up to PL cells

  // ---- buildings: 0 house, 1 farm, 2 sawmill, 3 storage
  b_used[39]; b_kind[39]; b_tx[39]; b_ty[39]; b_done[39];
  b_nw[39]; b_ns[39]; b_hw[39]; b_hs[39]; b_iw[39]; b_is[39]; b_prog[39];
  k_w[3]; k_s[3]; k_work[3];

  // ---- job categories: 0 wood, 1 stone, 2 food, 3 haul, 4 build
  prio[4];
  cw[4];         // a category's appeal right now (priority minus crowding)
  jcat[10];      // job -> category, -1 for needs and strolling
  jname[10]; jcol[10]; syl[15];

  // ---- the colony
  stock_w = 0; stock_s = 0; stock_f = 0;
  pop = 0; beds = 6; houses = 0; mills = 0; born = 0;
  day = 1; day_t = 0.0; night = 0; dark = 0; warm = 0;
  msg = ""; msg_t = 0.0;

  // ---- graphics
  g_map = 0; g_mini = 0; g_side = 0; g_site = 0; g_dark = 0; g_warm = 0;
  g_title = 0; g_win = 0; g_lose = 0;
  g_bld[3]; g_col[5];

  // ---- game state
  state = 4;     // 0 title, 1 playing, 2 won, 3 lost, 4 building the island
  seed = 0; gen_pct = 0; game_t = 0.0; tscale = 1; paused = 0;
  cam_x = 0; cam_y = 0; start_c = 0;
  tool = 0;      // 0 mark trees/rocks, 1..4 place a building of kind tool-1
  sel = -1;      // selected settler slot
  sep_x = 0.0; sep_y = 0.0;
  lprev = 0; rprev = 0; drag = 0; ds_x = 0; ds_y = 0;
  w_lv = 0; s_lv = 0; b_lv = 0;

// =====================================================================
// Small helpers
// =====================================================================
FUNCTION cell_of(px, py);
BEGIN
  RETURN (int(py) / 16) * MW + int(px) / 16;
END

FUNCTION cpx(c);
BEGIN
  RETURN (c % MW) * 16 + 8;
END

FUNCTION cpy(c);
BEGIN
  RETURN (c / MW) * 16 + 8;
END

FUNCTION min(a, b);
BEGIN
  IF (a < b) RETURN a; END
  RETURN b;
END

FUNCTION max(a, b);
BEGIN
  IF (a > b) RETURN a; END
  RETURN b;
END

// The walkable cell closest to c (searching square rings), -1 if none
FUNCTION near_free(c);
PRIVATE cx, cy, r, i, j, n;
BEGIN
  IF (pass[c]) RETURN c; END
  cx = c % MW; cy = c / MW;
  FOR r = 1 TO 6
    FOR j = cy - r TO cy + r
      FOR i = cx - r TO cx + r
        IF (abs(i - cx) == r OR abs(j - cy) == r)
          IF (i > 0 AND j > 0 AND i < MW - 1 AND j < MH - 1)
            n = j * MW + i;
            IF (pass[n]) RETURN n; END
          END
        END
      END
    END
  END
  RETURN -1;
END

// Asks the pathfinder for a route from settler s to goal cell g. The goal
// may be solid (a tree, a building of gsz x gsz tiles): the path then
// ends on the walkable cell next to it.
FUNCTION set_goal(s, g, gsz);
BEGIN
  p_start[s] = near_free(cell_of(c_x[s], c_y[s]));
  IF (g < 0 OR p_start[s] < 0) p_state[s] = 3; RETURN 0; END
  p_goal[s] = g; p_gsz[s] = gsz;
  p_state[s] = 1;
  RETURN 0;
END

FUNCTION go_bld(s, b);
BEGIN
  c_dest[s] = b;
  set_goal(s, b_ty[b] * MW + b_tx[b], 2);
  RETURN 0;
END

// Is cell a within one step of cell b?
FUNCTION near_cell(a, b);
BEGIN
  RETURN (abs(a % MW - b % MW) <= 1 AND abs(a / MW - b / MW) <= 1);
END

// Is cell a touching the 2x2 footprint of building b?
FUNCTION near_bld(a, b);
PRIVATE i, j;
BEGIN
  i = a % MW; j = a / MW;
  RETURN (i >= b_tx[b] - 1 AND i <= b_tx[b] + 2 AND j >= b_ty[b] - 1 AND j <= b_ty[b] + 2);
END

// Nearest finished building of a kind to cell c (-1 none)
FUNCTION nearest_kind(c, k);
PRIVATE b, best, bd, d;
BEGIN
  best = -1; bd = 9999;
  FOR b = 0 TO BCAP - 1
    IF (b_used[b] AND b_done[b] AND b_kind[b] == k AND bad[b_ty[b] * MW + b_tx[b]] <= game_t)
      d = abs(b_tx[b] - c % MW) + abs(b_ty[b] - c / MW);
      IF (d < bd) bd = d; best = b; END
    END
  END
  RETURN best;
END

FUNCTION make_name();
BEGIN
  RETURN syl[rand(0, 7)] + syl[rand(8, 15)];
END

FUNCTION say(t);
BEGIN
  msg = t; msg_t = 6;
  RETURN 0;
END

FUNCTION init_tables();
PRIVATE d;
BEGIN
  sw8[0] = 0;  sw8[1] = 3;  sw8[2] = 10; sw8[3] = 20; sw8[4] = 32;
  sw8[5] = 44; sw8[6] = 54; sw8[7] = 61; sw8[8] = 64;   // smoothstep * 64
  nbx[0] = 1; nby[0] = 0;  nbx[1] = -1; nby[1] = 0;
  nbx[2] = 0; nby[2] = 1;  nbx[3] = 0;  nby[3] = -1;
  nbx[4] = 1; nby[4] = 1;  nbx[5] = 1;  nby[5] = -1;
  nbx[6] = -1; nby[6] = 1; nbx[7] = -1; nby[7] = -1;
  FOR d = 0 TO 7 nb[d] = nbx[d] + nby[d] * MW; END
  // building costs (wood, stone) and work (seconds for one builder)
  k_w[0] = 16; k_s[0] = 4; k_work[0] = 10;     // house
  k_w[1] = 10; k_s[1] = 0; k_work[1] = 6;      // farm
  k_w[2] = 14; k_s[2] = 8; k_work[2] = 12;     // sawmill
  k_w[3] = 8;  k_s[3] = 0; k_work[3] = 5;      // storage
  jname[0] = "idle";     jcol[0] = '#c0c0c0';
  jname[1] = "eating";   jcol[1] = '#60ff60';
  jname[2] = "sleeping"; jcol[2] = '#a080ff';
  jname[3] = "chopping"; jcol[3] = '#a06030';
  jname[4] = "mining";   jcol[4] = '#b0b0b8';
  jname[5] = "berries";  jcol[5] = '#ff3050';
  jname[6] = "fishing";  jcol[6] = '#40a0ff';
  jname[7] = "hauling";  jcol[7] = '#ffe040';
  jname[8] = "supplying"; jcol[8] = '#ffa040';
  jname[9] = "building"; jcol[9] = '#ff7000';
  jname[10] = "strolling"; jcol[10] = '#e0e0e0';
  syl[0] = "Al"; syl[1] = "Bo"; syl[2] = "Ca"; syl[3] = "Da"; syl[4] = "El";
  syl[5] = "Fi"; syl[6] = "Gu"; syl[7] = "Ma"; syl[8] = "ra"; syl[9] = "nn";
  syl[10] = "lo"; syl[11] = "rik"; syl[12] = "tha"; syl[13] = "mo"; syl[14] = "wen";
  syl[15] = "dur";
  prio[0] = 3; prio[1] = 2; prio[2] = 3; prio[3] = 3; prio[4] = 3;
  FOR d = 0 TO 10 jcat[d] = -1; END
  jcat[3] = 0; jcat[4] = 1; jcat[5] = 2; jcat[6] = 2; jcat[7] = 3; jcat[8] = 4; jcat[9] = 4;
  RETURN 0;
END

// =====================================================================
// Generated graphics (all facing right)
// =====================================================================
FUNCTION draw_settler(g, r, gg, b);
BEGIN
  gfx_rect(g, 3, 11, 2, 4, 60, 45, 35);            // legs
  gfx_rect(g, 6, 11, 2, 4, 60, 45, 35);
  gfx_rect(g, 2, 5, 7, 7, r, gg, b);               // tunic
  gfx_rect(g, 2, 9, 7, 1, r / 2, gg / 2, b / 2);   // belt
  gfx_circle(g, 5, 3, 3, 240, 200, 160);           // head
  gfx_rect(g, 3, 0, 5, 2, 110, 70, 40);            // hair
  gfx_pixel(g, 7, 3, 30, 30, 30);                  // eye (faces right)
  RETURN 0;
END

FUNCTION draw_building(g, k);
PRIVATE i;
BEGIN
  gfx_fill_rgba(g, 0, 0, 0, 0);
  IF (k == 0)                                      // house
    gfx_rect(g, 4, 14, 24, 17, 150, 105, 60);
    FOR i = 0 TO 3 gfx_line(g, 4, 17 + i * 4, 27, 17 + i * 4, 120, 80, 45); END
    FOR i = 0 TO 12
      gfx_line(g, 16 - i - 2, 2 + i, 16 + i + 2, 2 + i, 170, 50 + i * 2, 40);   // roof
    END
    gfx_rect(g, 13, 22, 6, 9, 80, 50, 30);         // door
    gfx_rect(g, 6, 19, 4, 4, 250, 230, 140);       // windows
    gfx_rect(g, 22, 19, 4, 4, 250, 230, 140);
    gfx_rect(g, 22, 3, 3, 7, 110, 100, 100);       // chimney
  END
  IF (k == 1)                                      // farm field
    gfx_rect(g, 1, 1, 30, 30, 120, 85, 45);
    FOR i = 0 TO 6
      gfx_line(g, 3, 4 + i * 4, 28, 4 + i * 4, 90, 170, 50);
      gfx_line(g, 3, 5 + i * 4, 28, 5 + i * 4, 200, 190, 70);
    END
    gfx_rect_outline(g, 0, 0, 32, 32, 160, 120, 70);
  END
  IF (k == 2)                                      // sawmill
    gfx_rect(g, 2, 8, 28, 22, 120, 110, 100);
    gfx_rect(g, 2, 5, 28, 5, 90, 70, 50);
    gfx_circle(g, 11, 20, 7, 200, 200, 210);       // saw blade
    gfx_circle(g, 11, 20, 2, 80, 80, 90);
    FOR i = 0 TO 2 gfx_rect(g, 20, 13 + i * 5, 10, 4, 150, 100, 50); END
  END
  IF (k == 3)                                      // storage yard
    gfx_rect(g, 1, 1, 30, 30, 170, 150, 110);
    gfx_rect_outline(g, 0, 0, 32, 32, 110, 80, 50);
    gfx_rect(g, 3, 4, 11, 10, 140, 90, 45);        // crates
    gfx_rect_outline(g, 3, 4, 11, 10, 90, 55, 25);
    gfx_rect(g, 17, 4, 11, 10, 140, 90, 45);
    gfx_rect_outline(g, 17, 4, 11, 10, 90, 55, 25);
    gfx_circle(g, 8, 23, 5, 120, 80, 50);          // barrels
    gfx_circle(g, 20, 23, 5, 120, 80, 50);
    gfx_circle(g, 8, 23, 2, 90, 60, 40);
    gfx_circle(g, 20, 23, 2, 90, 60, 40);
  END
  RETURN 0;
END

FUNCTION big_text(w, h, s, r, g, b, sz);
PRIVATE gr;
BEGIN
  gr = new_graphic(w, h);
  gfx_fill_rgba(gr, 0, 0, 0, 0);
  gfx_text(gr, 3, 3, s, 0, 0, 0, sz);
  gfx_text(gr, 0, 0, s, r, g, b, sz);
  RETURN gr;
END

FUNCTION make_graphics();
PRIVATE i, g;
BEGIN
  FOR i = 0 TO 5
    g = new_graphic(10, 15); gfx_fill_rgba(g, 0, 0, 0, 0);
    SWITCH (i)
      CASE 0 draw_settler(g, 60, 110, 200);
      CASE 1 draw_settler(g, 200, 60, 50);
      CASE 2 draw_settler(g, 60, 160, 70);
      CASE 3 draw_settler(g, 210, 180, 50);
      CASE 4 draw_settler(g, 150, 80, 180);
      DEFAULT draw_settler(g, 230, 130, 60);
    END
    g_col[i] = g;
  END
  FOR i = 0 TO 3
    g_bld[i] = new_graphic(32, 32); draw_building(g_bld[i], i);
  END
  g_site = new_graphic(32, 32);                    // construction scaffold
  gfx_fill_rgba(g_site, 0, 0, 0, 0);
  gfx_rect(g_site, 1, 1, 30, 30, 150, 130, 90);
  FOR i = 0 TO 3
    gfx_rect(g_site, 2 + i * 9, 2, 2, 28, 110, 80, 45);
    gfx_rect(g_site, 2, 2 + i * 9, 28, 2, 110, 80, 45);
  END
  gfx_line(g_site, 2, 2, 29, 29, 110, 80, 45);
  g_dark = new_graphic(480, 480); gfx_fill(g_dark, 10, 16, 60);
  g_warm = new_graphic(480, 480); gfx_fill(g_warm, 255, 120, 40);
  g_map = new_graphic(MW * 16, MH * 16);
  g_mini = new_graphic(128, 128);
  g_side = new_graphic(160, 480);
  gfx_fill(g_side, 44, 40, 34);
  gfx_rect(g_side, 0, 0, 2, 480, 100, 85, 60);
  gfx_rect(g_side, 14, 2, 132, 132, 100, 85, 60);   // minimap frame
  FOR i = 0 TO 3                                    // build buttons
    gfx_rect(g_side, 6, 196 + i * 22, 148, 20, 90, 75, 55);
    gfx_rect(g_side, 7, 197 + i * 22, 146, 18, 64, 54, 42);
  END
  g_title = big_text(300, 50, "ISLE OF SETTLERS", 250, 220, 120, 30);
  g_win = big_text(300, 50, "A THRIVING TOWN", 120, 240, 120, 30);
  g_lose = big_text(300, 50, "THE ISLE IS SILENT", 240, 90, 70, 28);
  RETURN 0;
END

// Paints one tile (terrain, resource, pile) into the map and the minimap
FUNCTION paint_tile(c);
PRIVATE px, py, t, v, i, mr, mg, mb, n;
BEGIN
  px = (c % MW) * 16; py = (c / MW) * 16;
  t = tile[c];
  v = rand(-6, 6);
  IF (t == 0)                                      // sea
    gfx_rect(g_map, px, py, 16, 16, 24, 50 + v, 115 + v);
    IF (rand(0, 3) == 0) gfx_line(g_map, px + 3, py + 8, px + 10, py + 8, 45, 80, 150); END
    mr = 24; mg = 52; mb = 115;
  END
  IF (t == 1)                                      // shallows, maybe fish
    gfx_rect(g_map, px, py, 16, 16, 50, 115 + v, 170 + v);
    FOR i = 1 TO res[c]
      n = rand(2, 11);
      gfx_rect(g_map, px + rand(1, 9), py + n, 4, 2, 210, 220, 235);
    END
    mr = 55; mg = 120; mb = 175;
  END
  IF (t == 2)                                      // beach
    gfx_rect(g_map, px, py, 16, 16, 212 + v, 194 + v, 140 + v);
    FOR i = 0 TO 2 gfx_pixel(g_map, px + rand(0, 15), py + rand(0, 15), 180, 160, 110); END
    mr = 214; mg = 196; mb = 142;
  END
  IF (t >= 3)                                      // grass under everything else
    gfx_rect(g_map, px, py, 16, 16, 78 + v, 138 + v, 58 + v / 2);
    FOR i = 0 TO 2 gfx_pixel(g_map, px + rand(0, 15), py + rand(0, 15), 60, 110, 44); END
    mr = 80; mg = 140; mb = 60;
  END
  IF (t == 4)                                      // tree
    gfx_rect(g_map, px + 7, py + 10, 3, 5, 100, 65, 35);
    gfx_circle(g_map, px + 8, py + 7, 6, 30, 90 + v, 35);
    gfx_circle(g_map, px + 6, py + 5, 3, 55, 125 + v, 50);
    mr = 30; mg = 88; mb = 36;
  END
  IF (t == 5)                                      // rock: smaller as it is mined
    gfx_circle(g_map, px + 8, py + 9, 3 + res[c], 110 + v, 108 + v, 104 + v);
    gfx_circle(g_map, px + 6, py + 7, 1 + res[c] / 2, 160, 158, 152);
    mr = 130; mg = 128; mb = 124;
  END
  IF (t == 6)                                      // berry bush
    gfx_circle(g_map, px + 8, py + 8, 6, 40, 110, 45);
    FOR i = 1 TO res[c]
      gfx_circle(g_map, px + rand(4, 12), py + rand(4, 12), 1, 230, 30, 60);
    END
    mr = 60; mg = 120; mb = 60;
    IF (res[c] > 0) mr = 170; mg = 70; mb = 80; END
  END
  // goods on the ground: logs, stones or food, one icon per two
  n = min((pile_n[c] + 1) / 2, 6);
  FOR i = 0 TO n - 1
    IF (pile_t[c] == 1) gfx_rect(g_map, px + 2, py + 13 - i * 2, 12, 2, 150 - i * 6, 95, 45); END
    IF (pile_t[c] == 2) gfx_circle(g_map, px + 3 + (i % 3) * 5, py + 12 - (i / 3) * 5, 2, 150, 150, 155); END
    IF (pile_t[c] == 3) gfx_circle(g_map, px + 3 + (i % 3) * 5, py + 12 - (i / 3) * 5, 2, 240, 150, 40); END
  END
  IF (n > 0) mr = 240; mg = 220; mb = 90; END
  gfx_rect(g_mini, (c % MW) * 2, (c / MW) * 2, 2, 2, mr, mg, mb);
  RETURN 0;
END

// Bilinear value noise: lattice la (spacing sp, lw points per row)
FUNCTION noise(la, i, j, sp, lw);
PRIVATE a, b, k;
BEGIN
  a = sw8[(i % sp) * 8 / sp];
  b = sw8[(j % sp) * 8 / sp];
  k = (j / sp) * lw + i / sp;
  IF (la == 0)
    RETURN ((lat[k] * (64 - a) + lat[k + 1] * a) * (64 - b)
          + (lat[k + lw] * (64 - a) + lat[k + lw + 1] * a) * b) / 4096;
  END
  IF (la == 1)
    RETURN ((lat2[k] * (64 - a) + lat2[k + 1] * a) * (64 - b)
          + (lat2[k + lw] * (64 - a) + lat2[k + lw + 1] * a) * b) / 4096;
  END
  RETURN ((lat3[k] * (64 - a) + lat3[k + 1] * a) * (64 - b)
        + (lat3[k + lw] * (64 - a) + lat3[k + lw + 1] * a) * b) / 4096;
END

// Drops goods on the ground at c, or the nearest cell with room
FUNCTION add_pile(c, t, n);
PRIVATE r, i, j, k, cx, cy;
BEGIN
  cx = c % MW; cy = c / MW;
  FOR r = 0 TO 3
    FOR j = cy - r TO cy + r
      FOR i = cx - r TO cx + r
        k = j * MW + i;
        IF (pass[k] AND (pile_n[k] == 0 OR (pile_t[k] == t AND pile_n[k] < 16)))
          IF (pile_t[k] == 0 AND n_pile < 200) plist[n_pile] = k; n_pile++; END
          pile_t[k] = t; pile_n[k] += n;
          paint_tile(k);
          RETURN k;
        END
      END
    END
  END
  RETURN -1;
END

// =====================================================================
// Island builder: runs over many frames so no frame does too much work.
// Its scratch arrays are PRIVATE, so creating them costs its own time.
// =====================================================================
PROCESS builder(next_state);
PRIVATE i, j, c, n, k, h, d, e, acc, head, tail, bd, dx, dy;
        hg[4095];      // island height
        ta[4095];      // tree seeds, then flood fill marks
        tb[4095];      // automaton buffer, then flood fill queue
BEGIN
  state = 4; gen_pct = 0;
  FRAME;
  pathfinder();          // started here: its big arrays cost this slice, not MAIN's
  FRAME;
  rand_seed(seed);
  FOR i = 0 TO 80 lat[i] = rand(0, 99); latf[i] = rand(0, 99); END
  FOR i = 0 TO 288 lat2[i] = rand(0, 99); lat3[i] = rand(0, 99); END
  FOR i = 0 TO 199 hist[i] = 0; END
  FOR c = 0 TO NC - 1
    tile[c] = 0; res[c] = 0; pass[c] = 0; mark[c] = 0; pile_t[c] = 0;
    pile_n[c] = 0; claim[c] = 0; bad[c] = 0;
    IF (c % 512 == 511) FRAME; END
  END
  gen_pct = 10;

  // 1. height = noise + 60 - distance falloff (0 centre, 100 at the edges)
  FOR j = 0 TO MH - 1
    FOR i = 0 TO MW - 1
      h = (noise(0, i, j, 8, 9) * 2 + noise(1, i, j, 4, 17)) / 3;
      dx = i * 2 - 63; dy = j * 2 - 63;
      e = clamp(h + 60 - (dx * dx + dy * dy) * 100 / 3969, 0, 199);
      hg[j * MW + i] = e;
      hist[e]++;
      ta[j * MW + i] = noise(2, i, j, 4, 17);    // stone field, its own noise
    END
    IF (j % 4 == 3) gen_pct = 10 + j * 20 / MH; FRAME; END
  END

  // 2. levels from the histogram: 44% sea, 10% shallows, 7% beach
  acc = 0; w_lv = 0;
  WHILE (acc < NC * 44 / 100) acc += hist[w_lv]; w_lv++; END
  s_lv = w_lv;
  WHILE (acc < NC * 54 / 100) acc += hist[s_lv]; s_lv++; END
  b_lv = s_lv;
  WHILE (acc < NC * 61 / 100) acc += hist[b_lv]; b_lv++; END

  // 3. terrain classes: stone outcrops where the stone noise peaks, tree
  // seeds where the (coarser) forest noise is high
  FOR c = 0 TO NC - 1
    e = hg[c];
    tile[c] = 3;
    IF (e < b_lv) tile[c] = 2; END
    IF (e < s_lv) tile[c] = 1; END
    IF (e < w_lv) tile[c] = 0; END
    IF (tile[c] == 3 AND ta[c] > 74 AND rand(0, 9) < 8) tile[c] = 5; res[c] = rand(2, 4); END
    i = c % MW; j = c / MW;
    IF (i < 2 OR j < 2 OR i > MW - 3 OR j > MH - 3) tile[c] = 0; END
    ta[c] = 0;
    k = latf[(j / 8) * 9 + i / 8];
    IF (tile[c] == 3 AND rand(0, 99) < k - 25) ta[c] = 1; END
    IF (c % 512 == 511) FRAME; END
  END
  gen_pct = 40;

  // 4. cellular automaton: a cell is wooded when 5 of its 8 neighbours
  // are (4 if it already is) - the noise clumps into woods
  FOR k = 0 TO 1
    FOR j = 1 TO MH - 2
      FOR i = 1 TO MW - 2
        c = j * MW + i;
        n = 0;
        FOR d = 0 TO 7 n += ta[c + nb[d]]; END
        tb[c] = (n >= 5 OR (n >= 4 AND ta[c] == 1));
      END
      IF (j % 3 == 0) FRAME; END
    END
    FOR c = 0 TO NC - 1 ta[c] = tb[c]; IF (c % 2048 == 2047) FRAME; END END
    FRAME;
  END
  FOR c = 0 TO NC - 1
    IF (tile[c] == 3)
      IF (ta[c]) tile[c] = 4; ELSE
        IF (rand(0, 99) < 3) tile[c] = 6; res[c] = rand(2, 4); END
      END
    END
    IF (c % 1024 == 1023) FRAME; END
  END
  gen_pct = 55;

  // 5. the landing site: the land cell nearest the centre, cleared 7x7
  bd = 9999; start_c = 32 * MW + 32;
  FOR c = 0 TO NC - 1
    IF (tile[c] >= 2)
      d = abs(c % MW - 32) + abs(c / MW - 32);
      IF (d < bd) bd = d; start_c = c; END
    END
    IF (c % 1024 == 1023) FRAME; END
  END
  FOR j = -3 TO 3
    FOR i = -3 TO 3
      tile[start_c + j * MW + i] = 3; res[start_c + j * MW + i] = 0;
    END
  END
  FRAME;

  // 6. flood fill over land from the landing site: islets sink
  FOR c = 0 TO NC - 1 ta[c] = 0; IF (c % 2048 == 2047) FRAME; END END
  ta[start_c] = 1; tb[0] = start_c; head = 0; tail = 1;
  WHILE (head < tail)
    c = tb[head]; head++;
    FOR d = 0 TO 3
      n = c + nb[d];
      IF (tile[n] >= 2 AND ta[n] == 0) ta[n] = 1; tb[tail] = n; tail++; END
    END
    IF (head % 400 == 0) FRAME; END
  END
  FOR c = 0 TO NC - 1
    IF (tile[c] >= 2 AND ta[c] == 0) tile[c] = 1; res[c] = 0; END
    IF (c % 1024 == 1023) FRAME; END
  END
  gen_pct = 65;

  // 7. walkable cells, bush list, fish in shallows that touch land
  n_bush = 0; n_fish = 0;
  FOR c = 0 TO NC - 1
    pass[c] = (tile[c] == 2 OR tile[c] == 3);
    IF (tile[c] == 6 AND n_bush < 300) blist[n_bush] = c; n_bush++; END
    IF (tile[c] == 1 AND n_fish < 300 AND rand(0, 99) < 30)
      IF (tile[c + 1] >= 2 OR tile[c - 1] >= 2 OR tile[c + MW] >= 2 OR tile[c - MW] >= 2)
        res[c] = rand(1, 3); flist[n_fish] = c; n_fish++;
      END
    END
    IF (c % 1024 == 1023) FRAME; END
  END

  // 8. paint the island, a few rows per frame
  FOR c = 0 TO NC - 1
    paint_tile(c);
    IF (c % 128 == 127) gen_pct = 65 + c * 35 / NC; FRAME; END
  END

  // 9. the landing party: a storage yard with supplies and five settlers
  building(3, start_c % MW - 1, start_c / MW - 2, 1);
  stock_w = 30; stock_s = 10; stock_f = 24;
  FOR k = 0 TO 4
    colonist(cpx(start_c) + k * 10 - 20, cpy(start_c) + 18 + (k % 2) * 8);
  END
  cam_x = clamp(cpx(start_c) - 240, 0, MW * 16 - 480);
  cam_y = clamp(cpy(start_c) - 240, 0, MH * 16 - 480);
  gen_pct = 100;
  state = next_state;
END

// =====================================================================
// PATHFINDER: breadth-first search from the goal outwards, a few hundred
// cells per frame. The goal cells themselves may be solid (a tree, a
// building); the flood starts from all of them. Every settler waiting for
// the same goal shares the search: once the flood reaches its start cell
// its path is read back along the parent links.
// =====================================================================
PROCESS pathfinder();
PRIVATE i, g, gs, c, n, d, k, head, tail, work, left, final, stamp;
        pmark[4095];   // search stamp of every cell
        ppar[4095];    // the cell it was reached from (itself for a goal)
        pq[4095];      // BFS queue
BEGIN
  LOOP
    g = -1;
    FOR i = 0 TO CAP - 1
      IF (c_used[i] AND p_state[i] == 1) g = p_goal[i]; gs = p_gsz[i]; BREAK; END
    END
    IF (g >= 0)
      FOR i = 0 TO CAP - 1
        IF (c_used[i] AND p_state[i] == 1 AND p_goal[i] == g AND p_gsz[i] == gs) p_state[i] = 4; END
      END
      stamp++;
      head = 0; tail = 0;
      FOR k = 0 TO gs * gs - 1                    // one seed, or a 2x2 footprint
        c = g + k % 2 + (k / 2) * MW;
        pmark[c] = stamp; ppar[c] = c; pq[tail] = c; tail++;
      END
      final = 0;
      LOOP
        work = 0;
        WHILE (work < 220 AND head < tail)
          c = pq[head]; head++; work++;
          FOR d = 0 TO 7
            n = c + nb[d];
            IF (pmark[n] != stamp AND pass[n])
              // diagonal steps may not cut the corner of an obstacle
              IF (d < 4 OR (pass[c + nbx[d]] AND pass[c + nby[d] * MW]))
                pmark[n] = stamp; ppar[n] = c;
                pq[tail] = n; tail++;
              END
            END
          END
        END
        IF (head >= tail) final = 1; END
        left = 0;
        FOR i = 0 TO CAP - 1
          IF (c_used[i] AND p_state[i] == 4 AND p_goal[i] == g)
            c = p_start[i];
            IF (pmark[c] == stamp)
              k = 0;
              WHILE (ppar[c] != c AND k < PL)
                c = ppar[c];
                IF (pass[c]) pth[i * PL + k] = c; k++; END
              END
              p_full[i] = (ppar[c] == c);
              p_len[i] = k; p_idx[i] = 0; p_state[i] = 2;
            ELSE
              IF (final) p_state[i] = 3; ELSE left++; END
            END
          END
        END
        IF (left == 0 OR final) BREAK; END
        FRAME;
      END
    END
    FRAME;
  END
END

// =====================================================================
// Settler brain
// =====================================================================

// Lets go of the claimed cell
FUNCTION release(s);
BEGIN
  IF (c_tgt[s] >= 0)
    IF (claim[c_tgt[s]] == s + 1) claim[c_tgt[s]] = 0; END
  END
  c_tgt[s] = -1;
  RETURN 0;
END

// Whatever the settler carries is dropped where it stands
FUNCTION drop_carry(s);
BEGIN
  IF (c_cn[s] > 0)
    IF (c_job[s] == 8 AND c_site[s] >= 0)       // supply run: no longer on its way
      IF (c_carry[s] == 1) b_iw[c_site[s]] -= c_cn[s]; ELSE b_is[c_site[s]] -= c_cn[s]; END
    END
    add_pile(near_free(cell_of(c_x[s], c_y[s])), c_carry[s], c_cn[s]);
  END
  c_cn[s] = 0; c_carry[s] = 0;
  RETURN 0;
END

FUNCTION job_fail(s);
BEGIN
  IF (c_tgt[s] >= 0) bad[c_tgt[s]] = game_t + 25; END
  IF (c_dest[s] >= 0 AND (c_job[s] <= 2 OR c_st[s] == 3))   // storage/house out of reach
    bad[b_ty[c_dest[s]] * MW + b_tx[c_dest[s]]] = game_t + 6;
  END
  IF (c_job[s] == 9 OR c_job[s] == 8)
    IF (c_site[s] >= 0) bad[b_ty[c_site[s]] * MW + b_tx[c_site[s]]] = game_t + 10; END
  END
  release(s); drop_carry(s);
  c_st[s] = 0;
  RETURN 0;
END

// Utility AI: picks the best thing to do right now. Needs first (eat when
// hungry, sleep when tired or at night), then every job category scored
// as priority * 100 - 3 per tile of walking. Nothing to do: stroll.
FUNCTION choose_job(s);
PRIVATE cc, cx, cy, sb, b, i, c, k, sc, bs, bj, bt, bb, bm, fb, dd;
BEGIN
  release(s); drop_carry(s);
  cc = cell_of(c_x[s], c_y[s]); cx = cc % MW; cy = cc / MW;
  sb = nearest_kind(cc, 3);
  c_site[s] = -1;
  IF (stock_f > 0 AND sb >= 0 AND (c_hun[s] >= 60 OR (night AND c_hun[s] >= 30)))
    c_job[s] = 1; c_st[s] = 1; go_bld(s, sb);
    RETURN 0;
  END
  IF (c_rest[s] < 20 OR (night AND c_rest[s] < 90))
    c_job[s] = 2;
    b = nearest_kind(cc, 0);
    IF (b >= 0) c_st[s] = 1; go_bld(s, b); ELSE c_st[s] = 4; c_dest[s] = -1; END
    RETURN 0;
  END

  // each settler already busy in a category makes it less attractive,
  // so the work spreads over the colony instead of everyone piling on
  FOR k = 0 TO 4 cw[k] = prio[k] * 100; END
  FOR i = 0 TO CAP - 1
    IF (c_used[i] AND i != s)
      k = jcat[c_job[i]];
      IF (k >= 0) cw[k] -= 45; END
    END
  END
  bs = -99999; bj = 0; bt = -1; bb = -1; bm = 0;
  // marked trees (wood) and rocks (stone); stale entries leave the list
  i = 0;
  WHILE (i < n_mark)
    c = mlist[i];
    IF (mark[c] != 1 OR (tile[c] != 4 AND tile[c] != 5))
      mark[c] = 0; n_mark--; mlist[i] = mlist[n_mark];
      CONTINUE;
    END
    k = tile[c] - 4;
    IF (prio[k] > 0 AND claim[c] == 0 AND bad[c] <= game_t)
      sc = cw[k] - (abs(c % MW - cx) + abs(c / MW - cy)) * 3;
      IF (sc > bs) bs = sc; bj = 3 + k; bt = c; END
    END
    i++;
  END
  // food: bushes and fish, more urgent when the larder runs low. A
  // starving settler with an empty larder forages whatever the priority.
  IF ((prio[2] > 0 OR (c_hun[s] >= 85 AND stock_f == 0)) AND sb >= 0)
    fb = 0;
    IF (stock_f < pop * 3) fb = 60; END
    IF (stock_f < pop) fb = 250; END
    IF (stock_f > pop * 6) fb = -80; END
    FOR i = 0 TO n_bush - 1
      c = blist[i];
      IF (res[c] > 0 AND claim[c] == 0 AND bad[c] <= game_t)
        sc = cw[2] + fb - (abs(c % MW - cx) + abs(c / MW - cy)) * 3;
        IF (sc > bs) bs = sc; bj = 5; bt = c; END
      END
    END
    FOR i = 0 TO n_fish - 1
      c = flist[i];
      IF (res[c] > 0 AND claim[c] == 0 AND bad[c] <= game_t)
        sc = cw[2] + fb - 10 - (abs(c % MW - cx) + abs(c / MW - cy)) * 3;
        IF (sc > bs) bs = sc; bj = 6; bt = c; END
      END
    END
  END
  // hauling piles to the storage
  IF (sb >= 0)
    i = 0;
    WHILE (i < n_pile)
      c = plist[i];
      IF (pile_n[c] <= 0)
        pile_t[c] = 0; n_pile--; plist[i] = plist[n_pile];
        CONTINUE;
      END
      IF (prio[3] > 0 AND claim[c] == 0 AND bad[c] <= game_t)
        sc = cw[3] - (abs(c % MW - cx) + abs(c / MW - cy)) * 3;
        IF (pile_t[c] == 3 AND stock_f < pop * 2) sc += 80; END
        IF (sc > bs) bs = sc; bj = 7; bt = c; END
      END
      i++;
    END
  END
  // construction sites: bring materials, or build once they are all there
  IF (prio[4] > 0)
    FOR b = 0 TO BCAP - 1
      IF (b_used[b] AND b_done[b] == 0)
        IF (bad[b_ty[b] * MW + b_tx[b]] <= game_t)
          dd = (abs(b_tx[b] - cx) + abs(b_ty[b] - cy)) * 3;
          IF (b_hw[b] >= b_nw[b] AND b_hs[b] >= b_ns[b])
            sc = cw[4] + 10 - dd;
            IF (sc > bs) bs = sc; bj = 9; bb = b; END
          ELSE
            IF (sb >= 0)
              k = 0;
              IF (b_hw[b] + b_iw[b] < b_nw[b] AND stock_w > 0) k = 1; END
              IF (k == 0 AND b_hs[b] + b_is[b] < b_ns[b] AND stock_s > 0) k = 2; END
              IF (k > 0)
                sc = cw[4] - dd;
                IF (sc > bs) bs = sc; bj = 8; bb = b; bm = k; END
              END
            END
          END
        END
      END
    END
  END

  c_job[s] = bj; c_st[s] = 1;
  IF (bj >= 3 AND bj <= 7)
    claim[bt] = s + 1; c_tgt[s] = bt;
    set_goal(s, bt, 1);
    RETURN 0;
  END
  IF (bj == 9) c_site[s] = bb; go_bld(s, bb); RETURN 0; END
  IF (bj == 8) c_site[s] = bb; c_want[s] = bm; go_bld(s, sb); RETURN 0; END
  // nothing to do: a stroll near the storage (or where it stands)
  c_job[s] = 10;
  IF (sb >= 0) cc = (b_ty[sb] + rand(-3, 4)) * MW + b_tx[sb] + rand(-3, 4); END
  c = near_free(clamp(cc + rand(-2, 2) + rand(-2, 2) * MW, MW * 2, NC - MW * 2));
  IF (c < 0) c_st[s] = 0; RETURN 0; END
  set_goal(s, c, 1);
  RETURN 0;
END

// Arrived: is the settler where the job needs it?
FUNCTION at_target(s);
PRIVATE cc;
BEGIN
  cc = cell_of(c_x[s], c_y[s]);
  IF (c_job[s] >= 3 AND c_job[s] <= 7) RETURN near_cell(cc, c_tgt[s]); END
  IF (c_job[s] == 10) RETURN 1; END
  IF (c_dest[s] < 0) RETURN 0; END
  RETURN near_bld(cc, c_dest[s]);
END

FUNCTION work_time(s);
BEGIN
  SWITCH (c_job[s])
    CASE 1 RETURN 1.5;
    CASE 3 RETURN max(4 - mills, 2);
    CASE 4 RETURN 5;
    CASE 5 RETURN 2.5;
    CASE 6 RETURN 4;
    CASE 9 RETURN 4;
    CASE 10 RETURN rand(5, 25) * 0.1;
  END
  RETURN 0.5;
END

// Sends a settler home to the storage with what it carries
FUNCTION carry_home(s, t, n);
PRIVATE sb;
BEGIN
  c_carry[s] = t; c_cn[s] = n;
  sb = nearest_kind(cell_of(c_x[s], c_y[s]), 3);
  IF (sb < 0) drop_carry(s); c_st[s] = 0; RETURN 0; END
  c_st[s] = 3; go_bld(s, sb);
  RETURN 0;
END

// The work timer ran out: apply the result
FUNCTION finish_work(s);
PRIVATE c, n, b;
BEGIN
  c = c_tgt[s];
  c_st[s] = 0;
  SWITCH (c_job[s])
    CASE 1                                         // eat
      IF (stock_f > 0) stock_f--; c_hun[s] = max(c_hun[s] - 65, 0); END
    CASE 3                                         // tree felled: logs
      IF (tile[c] == 4)
        tile[c] = 3; mark[c] = 2; pass[c] = 1;
        add_pile(c, 1, 3 + min(mills, 2));
      END
      release(s);
    CASE 4                                         // a chunk of stone
      IF (tile[c] == 5)
        res[c]--;
        IF (res[c] <= 0) tile[c] = 3; mark[c] = 2; pass[c] = 1; END
        paint_tile(c);
        add_pile(near_free(cell_of(c_x[s], c_y[s])), 2, 2);
      END
      release(s);
    CASE 5                                         // a basket of berries
      release(s);
      IF (tile[c] == 6 AND res[c] > 0)
        n = min(res[c], 3); res[c] -= n; paint_tile(c);
        carry_home(s, 3, n);
      END
    CASE 6                                         // a fish
      release(s);
      IF (res[c] > 0) res[c]--; paint_tile(c); carry_home(s, 3, 2); END
    CASE 7                                         // pick up a pile
      release(s);
      IF (pile_n[c] > 0)
        n = min(pile_n[c], 8);
        pile_n[c] -= n;
        carry_home(s, pile_t[c], n);
        paint_tile(c);
      END
    CASE 8                                         // take materials to a site
      b = c_site[s];
      IF (c_want[s] == 1)
        n = min(min(6, b_nw[b] - b_hw[b] - b_iw[b]), stock_w);
        IF (n > 0) stock_w -= n; b_iw[b] += n; END
      ELSE
        n = min(min(6, b_ns[b] - b_hs[b] - b_is[b]), stock_s);
        IF (n > 0) stock_s -= n; b_is[b] += n; END
      END
      IF (n > 0) c_carry[s] = c_want[s]; c_cn[s] = n; c_st[s] = 3; go_bld(s, b); END
  END
  RETURN 0;
END

// Arrived with goods: into the storage, or onto the construction site
FUNCTION deliver(s);
PRIVATE b;
BEGIN
  b = c_dest[s];
  IF (c_job[s] == 8)
    IF (c_carry[s] == 1) b_hw[b] += c_cn[s]; b_iw[b] -= c_cn[s]; END
    IF (c_carry[s] == 2) b_hs[b] += c_cn[s]; b_is[b] -= c_cn[s]; END
  ELSE
    IF (c_carry[s] == 1) stock_w += c_cn[s]; END
    IF (c_carry[s] == 2) stock_s += c_cn[s]; END
    IF (c_carry[s] == 3) stock_f += c_cn[s]; END
  END
  c_cn[s] = 0; c_carry[s] = 0; c_st[s] = 0;
  RETURN 0;
END

// Separation: the push away from every settler overlapping slot s
FUNCTION separate(s);
PRIVATE i, dx, dy, d, f;
BEGIN
  sep_x = 0; sep_y = 0;
  FOR i = 0 TO CAP - 1
    IF (c_used[i] AND i != s AND c_hide[i] == 0)
      dx = c_x[s] - c_x[i]; dy = c_y[s] - c_y[i];
      IF (abs(dx) < 9 AND abs(dy) < 9)
        d = sqrt(dx * dx + dy * dy);
        IF (d < 9)
          IF (d < 0.5) dx = rand(-10, 10) * 0.1; dy = rand(-10, 10) * 0.1; d = 1; END
          f = (9 - d) / (d + 0.001);
          sep_x = sep_x + dx * f; sep_y = sep_y + dy * f;
        END
      END
    END
  END
  RETURN 0;
END

// =====================================================================
// A settler
// =====================================================================
PROCESS colonist(px, py);
PRIVATE s, i, dt, think, c, wx, wy, d, a, stp, arr, fr, wt, b;
BEGIN
  s = -1;
  FOR i = 0 TO CAP - 1
    IF (c_used[i] == 0) s = i; BREAK; END
  END
  IF (s < 0) RETURN; END
  c_used[s] = 1; pop++; born++;
  c_nm[s] = make_name();
  c_hun[s] = rand(0, 30); c_rest[s] = rand(70, 100); c_hp[s] = 100;
  c_job[s] = 0; c_st[s] = 0; c_tgt[s] = -1; c_dest[s] = -1; c_site[s] = -1;
  c_cn[s] = 0; c_carry[s] = 0; c_hide[s] = 0; p_state[s] = 0;
  x = px; y = py; ctype = c_scroll; z = 0;
  c_x[s] = x; c_y[s] = y;
  graph = g_col[s % 6];
  think = rand(0, 40) * 0.01;
  LOOP
    IF (c_hp[s] <= 0) BREAK; END
    IF (state == 1 AND tscale > 0)
      dt = get_delta() * tscale;
      think -= dt; arr = 0;

      // ---- needs: hunger grows (slowly asleep), rest drains while awake
      IF (c_st[s] == 4)
        c_hun[s] += dt * 0.45;
      ELSE
        // appetites grow a little every day: the colony must keep up
        c_hun[s] += dt * (0.8 + day * 0.04); c_rest[s] = max(c_rest[s] - dt * 0.9, 0);
      END
      IF (c_hun[s] >= 100)                         // starving
        c_hun[s] = 100; c_hp[s] -= dt * 3;
      ELSE
        IF (c_hun[s] < 70) c_hp[s] = min(c_hp[s] + dt * 2, 100); END
      END

      // ---- follow the path, cell centre to cell centre
      IF (p_state[s] == 2)
        IF (p_idx[s] < p_len[s])
          c = pth[s * PL + p_idx[s]];
          wx = cpx(c); wy = cpy(c);
          stp = 44 * dt;
          IF (c_cn[s] > 0) stp = 34 * dt; END
          d = fget_distance(x, y, wx, wy);
          IF (d <= stp)
            x = wx; y = wy; p_idx[s]++;
          ELSE
            a = fget_angle(x, y, wx, wy);
            x = x + get_distx(a, stp); y = y + get_disty(a, stp);
            IF (wx < x - 1) flags = 1; END
            IF (wx > x + 1) flags = 0; END
          END
        ELSE
          IF (p_full[s]) p_state[s] = 0; arr = 1;
          ELSE set_goal(s, p_goal[s], p_gsz[s]); END   // long way: next leg
        END
      END

      // ---- separation, every other frame, never onto water or walls
      fr = 1 - fr;
      IF (fr AND c_hide[s] == 0)
        separate(s);
        IF (sep_x != 0 OR sep_y != 0)
          d = sqrt(sep_x * sep_x + sep_y * sep_y);
          IF (d > 0.8) sep_x = sep_x * 0.8 / (d + 0.001); sep_y = sep_y * 0.8 / (d + 0.001); END
          wx = x + sep_x; wy = y + sep_y;
          IF (pass[cell_of(wx, wy)]) x = wx; y = wy; END
        END
      END

      // ---- what it is doing
      SWITCH (c_st[s])
        CASE 0
          IF (think <= 0) think = 0.3; choose_job(s); END
        CASE 1                                     // walking to the job
          IF (p_state[s] == 3) job_fail(s); END
          IF (arr)
            IF (at_target(s))
              IF (c_job[s] == 2) c_st[s] = 4; c_hide[s] = 1;
              ELSE c_st[s] = 2; wt = work_time(s); END
            ELSE
              job_fail(s);
            END
          END
        CASE 2                                     // working
          wt -= dt;
          IF (c_job[s] == 9)                       // building: progress now
            b = c_site[s];
            IF (b_done[b])
              wt = 0;
            ELSE
              b_prog[b] += dt * 100 / k_work[b_kind[b]];
              IF (b_prog[b] >= 100) b_prog[b] = 100; b_done[b] = 1; END
            END
          END
          IF (c_tgt[s] >= 0)                       // face the work
            IF (cpx(c_tgt[s]) < x) flags = 1; ELSE flags = 0; END
          END
          IF (c_hun[s] >= 95 AND stock_f > 0) wt = 0; END
          IF (wt <= 0) finish_work(s); think = 0; END
        CASE 3                                     // carrying goods
          IF (p_state[s] == 3) job_fail(s); END
          IF (arr)
            IF (near_bld(cell_of(x, y), c_dest[s])) deliver(s); ELSE job_fail(s); END
          END
        CASE 4                                     // asleep
          IF (c_dest[s] >= 0) c_rest[s] += dt * 7; ELSE c_rest[s] += dt * 3.5; END
          IF (c_rest[s] >= 100)
            c_rest[s] = 100;
            IF (night == 0 OR c_hun[s] >= 85) c_st[s] = 0; c_hide[s] = 0; END
          END
      END
    END
    c_x[s] = x; c_y[s] = y;

    // ---- looks: hidden inside a house, lying down outside, job dot
    IF (c_hide[s]) graph = 0; ELSE graph = g_col[s % 6]; END
    angle = 0;
    IF (c_st[s] == 4) angle = 90000; END
    IF (c_st[s] == 2 AND c_job[s] >= 3 AND c_job[s] <= 9)
      y = c_y[s] + (int(game_t * 8) % 2);          // hacking/hammering bob
    END
    IF (c_hide[s] == 0 AND state == 1)
      IF (c_st[s] == 4)
        set_color('#c0b0ff'); text(x + 4, y - 16 - int(game_t * 2) % 3, "z");
      ELSE
        draw_rect(x - 2, y - 13, 4, 3, jcol[c_job[s]]);
      END
      IF (c_cn[s] > 0)                             // what it carries
        IF (c_carry[s] == 1) draw_rect(x - 5, y - 1, 10, 3, '#8a5a2a'); END
        IF (c_carry[s] == 2) draw_rect(x - 3, y - 2, 6, 5, '#a0a0a8'); END
        IF (c_carry[s] == 3) draw_rect(x - 3, y - 2, 6, 5, '#f09030'); END
      END
      IF (c_hp[s] < 100)                           // starving: health bar
        draw_rect(x - 6, y + 9, 12, 2, '#400000');
        draw_rect(x - 6, y + 9, 12 * c_hp[s] / 100, 2, '#ff3030');
      END
      IF (sel == s)
        set_color('#ffffff');
        draw_rect(x - 7, y - 9, 14, 1); draw_rect(x - 7, y + 9, 14, 1);
        draw_rect(x - 7, y - 9, 1, 18); draw_rect(x + 7, y - 9, 1, 19);
      END
    END
    FRAME;
  END
  // death
  IF (state == 1) say(c_nm[s] + " starved to death"); END
  release(s); drop_carry(s);
  IF (sel == s) sel = -1; END
  c_used[s] = 0; p_state[s] = 0; pop--;
END

// =====================================================================
// Buildings: a 2x2 footprint that blocks walking. A site waits for its
// materials and work; a finished farm grows food piles by day.
// =====================================================================
PROCESS building(k, tx, ty, done);
PRIVATE b, i, t, c, ft;
BEGIN
  b = -1;
  FOR i = 0 TO BCAP - 1
    IF (b_used[i] == 0) b = i; BREAK; END
  END
  IF (b < 0) RETURN; END
  b_used[b] = 1; b_kind[b] = k; b_tx[b] = tx; b_ty[b] = ty; b_done[b] = 0;
  b_nw[b] = k_w[k]; b_ns[b] = k_s[k]; b_hw[b] = 0; b_hs[b] = 0;
  b_iw[b] = 0; b_is[b] = 0; b_prog[b] = 0;
  IF (done) b_hw[b] = b_nw[b]; b_hs[b] = b_ns[b]; b_prog[b] = 100; b_done[b] = 1; END
  FOR i = 0 TO 3
    c = (ty + i / 2) * MW + tx + i % 2;
    pass[c] = 0;
  END
  x = tx * 16 + 16; y = ty * 16 + 16; ctype = c_scroll; z = 5;
  graph = g_site;
  t = 0;
  LOOP
    IF (b_done[b])
      IF (graph != g_bld[k])                       // just finished
        graph = g_bld[k];
        IF (k == 0) houses++; beds = min(6 + houses * 4, CAP); END
        IF (k == 2) mills++; END
        IF (done == 0 AND state == 1)
          SWITCH (k)
            CASE 0 say("A house is finished: room for 4 more");
            CASE 1 say("A farm is ready to grow food");
            CASE 2 say("The sawmill runs: more logs per tree");
            CASE 3 say("A new storage yard is open");
          END
        END
      END
      IF (k == 0 AND state == 1)                   // sleepers inside: Zz
        t = 0;
        FOR i = 0 TO CAP - 1
          IF (c_used[i] AND c_hide[i] AND c_dest[i] == b) t++; END
        END
        IF (t > 0) set_color('#d0c0ff'); text(x + 4, y - 22 - int(game_t * 2) % 3, "Zz " + t); END
      END
      IF (k == 1 AND state == 1 AND night == 0)   // farm: a crop every 20 s
        ft += get_delta() * tscale;
        IF (ft >= 20) ft = 0; add_pile(near_free((ty + 2) * MW + tx), 3, 3); END
        draw_rect(x - 14, y + 17, 28 * ft / 20, 2, '#a0e040');
      END
    ELSE
      // construction site: progress bar and the materials still missing
      draw_rect(x - 16, y - 21, 32, 4, '#302010');
      draw_rect(x - 16, y - 21, 32 * b_prog[b] / 100, 4, '#ffa020');
      set_color('#ffffff');
      IF (b_hw[b] < b_nw[b] OR b_hs[b] < b_ns[b])
        text(x - 16, y - 32, "W" + b_hw[b] + "/" + b_nw[b] + " S" + b_hs[b] + "/" + b_ns[b]);
      END
    END
    FRAME;
  END
END

// =====================================================================
// Player input
// =====================================================================

// Can a building go with its top-left corner on tile (tx, ty)?
FUNCTION can_place(tx, ty);
PRIVATE i, c;
BEGIN
  IF (tx < 1 OR ty < 1 OR tx > MW - 3 OR ty > MH - 3) RETURN 0; END
  FOR i = 0 TO 3
    c = (ty + i / 2) * MW + tx + i % 2;
    IF (pass[c] == 0 OR pile_n[c] > 0) RETURN 0; END
  END
  RETURN 1;
END

// Marks (m = 1) or unmarks (m = 0) the trees and rocks in a tile box
FUNCTION mark_box(x0, y0, x1, y1, m);
PRIVATE i, j, c, t;
BEGIN
  IF (x0 > x1) t = x0; x0 = x1; x1 = t; END
  IF (y0 > y1) t = y0; y0 = y1; y1 = t; END
  x0 = clamp(x0, 0, MW - 1); x1 = clamp(x1, 0, MW - 1);
  y0 = clamp(y0, 0, MH - 1); y1 = clamp(y1, 0, MH - 1);
  FOR j = y0 TO y1
    FOR i = x0 TO x1
      c = j * MW + i;
      IF (tile[c] == 4 OR tile[c] == 5)
        IF (m)
          IF (mark[c] == 2) mark[c] = 1; END
          IF (mark[c] == 0 AND n_mark < 400) mark[c] = 1; mlist[n_mark] = c; n_mark++; END
        ELSE
          IF (mark[c] == 1) mark[c] = 2; END
        END
      END
    END
  END
  RETURN 0;
END

// The settler under a map point, -1 none
FUNCTION settler_at(wx, wy);
PRIVATE i, best, bd, d;
BEGIN
  best = -1; bd = 10;
  FOR i = 0 TO CAP - 1
    IF (c_used[i] AND c_hide[i] == 0)
      d = fget_distance(wx, wy, c_x[i], c_y[i]);
      IF (d < bd) bd = d; best = i; END
    END
  END
  RETURN best;
END

FUNCTION place_building(k, tx, ty);
BEGIN
  IF (can_place(tx, ty) == 0) say("Can't build there"); RETURN 0; END
  building(k, tx, ty, 0);
  RETURN 1;
END

FUNCTION handle_mouse();
PRIVATE mx, my, wx, wy, lb, rb, i, tx, ty;
BEGIN
  mx = mouse.x; my = mouse.y;
  wx = mx + cam_x; wy = my + cam_y;
  lb = mouse.left; rb = mouse.right;
  tx = int(wx) / 16; ty = int(wy) / 16;
  // minimap: jump the camera
  IF (lb AND drag == 0 AND mx >= 496 AND mx < 624 AND my >= 4 AND my < 132)
    cam_x = (mx - 496) * 8 - 240; cam_y = (my - 4) * 8 - 240;
  END
  IF (lb AND lprev == 0 AND mx >= 480)
    // build buttons
    IF (mx >= 486 AND my >= 196 AND my < 284)
      i = (my - 196) / 22;
      IF (tool == i + 1) tool = 0; ELSE tool = i + 1; END
    END
    // priority rows: left click raises (5 wraps to 0)
    IF (my >= 314 AND my < 394) i = (my - 314) / 16; prio[i] = (prio[i] + 1) % 6; END
  END
  IF (rb AND rprev == 0 AND mx >= 480 AND my >= 314 AND my < 394)
    i = (my - 314) / 16; prio[i] = (prio[i] + 5) % 6;
  END
  IF (mx < 480)
    IF (tool > 0)
      // placing a building: ghost of the footprint
      tx = int(wx - 8) / 16; ty = int(wy - 8) / 16;
      IF (can_place(tx, ty)) set_color('rgba(80,255,80,0.45)'); ELSE set_color('rgba(255,60,60,0.45)'); END
      draw_rect(tx * 16 - cam_x, ty * 16 - cam_y, 32, 32);
      IF (lb AND lprev == 0)
        IF (place_building(tool - 1, tx, ty) AND key(_shift) == 0) tool = 0; END
      END
      IF (rb AND rprev == 0) tool = 0; END
    ELSE
      // marking: drag a box (left marks, right unmarks); a click selects
      IF ((lb AND lprev == 0) OR (rb AND rprev == 0))
        drag = 1 + rb; ds_x = wx; ds_y = wy;
      END
      IF (drag)
        IF ((drag == 1 AND lb == 0) OR (drag == 2 AND rb == 0))
          IF (abs(wx - ds_x) + abs(wy - ds_y) > 6)
            mark_box(int(ds_x) / 16, int(ds_y) / 16, tx, ty, drag == 1);
          ELSE
            i = settler_at(wx, wy);
            IF (i >= 0 AND drag == 1)
              sel = i;
            ELSE
              IF (drag == 1) sel = -1; END
              mark_box(tx, ty, tx, ty, drag == 1);
            END
          END
          drag = 0;
        ELSE
          IF (abs(wx - ds_x) + abs(wy - ds_y) > 6)   // rubber band
            IF (drag == 1) set_color('#ffe060'); ELSE set_color('#ff6060'); END
            draw_rect(min(ds_x, wx) - cam_x, min(ds_y, wy) - cam_y, abs(wx - ds_x), 1);
            draw_rect(min(ds_x, wx) - cam_x, max(ds_y, wy) - cam_y, abs(wx - ds_x), 1);
            draw_rect(min(ds_x, wx) - cam_x, min(ds_y, wy) - cam_y, 1, abs(wy - ds_y));
            draw_rect(max(ds_x, wx) - cam_x, min(ds_y, wy) - cam_y, 1, abs(wy - ds_y) + 1);
          END
        END
      END
    END
  ELSE
    IF (drag AND lb == 0 AND rb == 0) drag = 0; END
  END
  lprev = lb; rprev = rb;
  RETURN 0;
END

// =====================================================================
// The colony clock: day and night, regrowth, births
// =====================================================================

// Nightfall: everyone gets supper from the storage. Whoever finds the
// larder empty goes to bed hungry.
FUNCTION supper();
PRIVATE i, n;
BEGIN
  n = 0;
  FOR i = 0 TO CAP - 1
    IF (c_used[i])
      IF (stock_f > 0)
        stock_f--; n++; c_hun[i] = max(c_hun[i] - 50, 0);
      ELSE
        c_hun[i] = min(c_hun[i] + 20, 100);
      END
    END
  END
  IF (n < pop) say("Supper: " + (pop - n) + " settler(s) went to bed hungry!");
  ELSE say("Nightfall: supper for " + n + " eaten"); END
  RETURN 0;
END
FUNCTION tick_world(dt);
PRIVATE i, c, n, b;
BEGIN
  game_t += dt;
  day_t += dt;
  IF (day_t >= DAYLEN)                             // dawn of a new day
    day_t -= DAYLEN; day++;
    // births: free beds and a food surplus bring newcomers
    n = 0;
    WHILE (n < 2 AND pop < beds AND stock_f >= pop * 2 + 4)
      b = nearest_kind(start_c, 0);
      IF (b < 0) b = nearest_kind(start_c, 3); END
      IF (b >= 0) c = near_free((b_ty[b] + 2) * MW + b_tx[b]); ELSE c = near_free(start_c); END
      colonist(cpx(c), cpy(c));
      stock_f -= 4; n++;
    END
    IF (n > 0) say("Day " + day + ": " + n + " newcomer(s) joined"); ELSE say("Day " + day + " dawns"); END
  END
  // light: dawn 0-6 s, day, dusk 58-70 s, night until the day ends
  n = night;
  night = (day_t >= 66 OR day_t < 3);
  IF (night AND n == 0) supper(); END
  dark = 0; warm = 0;
  IF (day_t < 6) dark = 55 - day_t * 9; warm = 20 - day_t * 3; END
  IF (day_t >= 58 AND day_t < 70) dark = (day_t - 58) * 55 / 12; warm = 24 - abs(day_t - 63) * 4; END
  IF (day_t >= 70) dark = 55; END
  warm = max(warm, 0);
  // bushes regrow berries and fish come back, a little each second
  IF (int(game_t) != int(game_t - dt))
    FOR i = 0 TO n_bush - 1
      c = blist[i];
      IF (res[c] < 4 AND rand(0, 99) < 1) res[c]++; paint_tile(c); END
    END
    FOR i = 0 TO n_fish - 1
      c = flist[i];
      IF (res[c] < 3 AND rand(0, 999) < 6) res[c]++; paint_tile(c); END
    END
  END
  IF (pop <= 0) state = 3; END
  IF (pop >= WIN_POP) state = 2; END
  RETURN 0;
END

// =====================================================================
// Screen furniture
// =====================================================================
PROCESS panel(g, px, py, pz);
BEGIN
  graph = g; x = px; y = py; z = pz;
  LOOP FRAME; END
END

// Night (dark blue) and dusk (orange) tints over the island view
PROCESS tint(g, kind);
BEGIN
  graph = g; x = 240; y = 240; z = -20;
  LOOP
    IF (kind == 0) alpha = dark; ELSE alpha = warm; END
    FRAME;
  END
END

PROCESS banner();
BEGIN
  x = 240; y = 110; z = -40;
  LOOP
    graph = 0;
    IF (state == 0) graph = g_title; END
    IF (state == 2) graph = g_win; END
    IF (state == 3) graph = g_lose; END
    FRAME;
  END
END

FUNCTION box_text(y0, n);
BEGIN
  draw_rect(30, y0, 420, n * 14 + 16, 'rgba(0,0,0,0.75)');
  RETURN 0;
END

FUNCTION draw_hud();
PRIVATE i, c, px, py, by, s;
BEGIN
  // marked trees and rocks in view: yellow corners
  set_color('#ffe040');
  FOR i = 0 TO n_mark - 1
    c = mlist[i];
    IF (mark[c] == 1)
      px = (c % MW) * 16 - cam_x; py = (c / MW) * 16 - cam_y;
      IF (px > -16 AND px < 480 AND py > -16 AND py < 480)
        draw_rect(px + 1, py + 1, 4, 1); draw_rect(px + 1, py + 1, 1, 4);
        draw_rect(px + 11, py + 14, 4, 1); draw_rect(px + 14, py + 11, 1, 4);
      END
    END
  END
  // minimap: buildings, settlers, camera frame
  FOR i = 0 TO BCAP - 1
    IF (b_used[i])
      IF (b_done[i]) c = '#f0f0f0'; ELSE c = '#ffa020'; END
      draw_rect(496 + b_tx[i] * 2, 4 + b_ty[i] * 2, 4, 4, c);
    END
  END
  FOR i = 0 TO CAP - 1
    IF (c_used[i]) draw_rect(496 + c_x[i] / 8, 4 + c_y[i] / 8, 2, 2, '#ff40ff'); END
  END
  set_color('#ffffff');
  draw_rect(496 + cam_x / 8, 4 + cam_y / 8, 60, 1);
  draw_rect(496 + cam_x / 8, 63 + cam_y / 8, 60, 1);
  draw_rect(496 + cam_x / 8, 4 + cam_y / 8, 1, 60);
  draw_rect(555 + cam_x / 8, 4 + cam_y / 8, 1, 60);

  // time of day and population
  set_color('#f0e0a0');
  IF (night) text(566, 140, "night"); ELSE
    IF (day_t < 30) text(566, 140, "morning"); ELSE text(566, 140, "afternoon"); END
  END
  draw_rect(488, 150, 144, 2, '#302820');
  draw_rect(488, 150, 144 * day_t / DAYLEN, 2, '#f0c040');
  set_color('#c8e0c0');
  text(488, 156, "SETTLERS " + pop + " / " + beds + "  goal " + WIN_POP);

  // build buttons: highlight the chosen tool, grey the unaffordable
  FOR i = 0 TO 3
    by = 196 + i * 22;
    IF (tool == i + 1) draw_rect(487, by + 1, 146, 18, 'rgba(255,220,80,0.35)'); END
    IF (stock_w < k_w[i] OR stock_s < k_s[i]) draw_rect(487, by + 1, 146, 18, 'rgba(0,0,0,0.35)'); END
  END
  // priorities: five pips per job
  FOR i = 0 TO 4
    by = 314 + i * 16;
    FOR c = 0 TO 4
      IF (c < prio[i]) draw_rect(586 + c * 9, by + 1, 7, 7, '#80e060');
      ELSE draw_rect(586 + c * 9, by + 1, 7, 7, '#3a3428'); END
    END
  END
  // tool / selected settler
  set_color('#e0d0b0');
  IF (tool == 0) text(488, 398, "TOOL: mark trees/rocks"); ELSE text(488, 398, "TOOL: place building"); END
  IF (tscale == 3) text(488, 410, "SPEED x3 (Z)"); END
  IF (paused) text(488, 410, "PAUSED (P)"); END
  s = sel;
  IF (s < 0) s = settler_at(mouse.x + cam_x, mouse.y + cam_y); END
  IF (s >= 0 AND mouse.x < 480)
    IF (sel < 0)                                   // hover label
      set_color('#ffffff');
      text(mouse.x + 10, mouse.y - 4, c_nm[s] + ": " + jname[c_job[s]]);
    END
  END
  IF (s >= 0)
    set_color('#ffffff');
    text(488, 424, c_nm[s] + " - " + jname[c_job[s]]);
    set_color('#c0c0c0');
    text(488, 436, "hunger");  text(488, 448, "rest");  text(488, 460, "health");
    draw_rect(532, 437, 90, 5, '#302820'); draw_rect(532, 437, 90 * c_hun[s] / 100, 5, '#f07030');
    draw_rect(532, 449, 90, 5, '#302820'); draw_rect(532, 449, 90 * c_rest[s] / 100, 5, '#8080ff');
    draw_rect(532, 461, 90, 5, '#302820'); draw_rect(532, 461, 90 * c_hp[s] / 100, 5, '#50e050');
  END
  // messages
  IF (msg_t > 0 AND state == 1)
    msg_t -= get_delta();
    draw_rect(0, 462, 480, 18, 'rgba(0,0,0,0.6)');
    set_color('#ffe8a0');
    text(8, 467, msg);
  END
  RETURN 0;
END

// Clears the old game and builds a new island
FUNCTION new_game(next_state);
PRIVATE i;
BEGIN
  signal(TYPE colonist, s_kill); signal(TYPE building, s_kill);
  signal(TYPE builder, s_kill); signal(TYPE pathfinder, s_kill);
  FOR i = 0 TO CAP - 1 c_used[i] = 0; p_state[i] = 0; c_hide[i] = 0; END
  FOR i = 0 TO BCAP - 1 b_used[i] = 0; END
  n_mark = 0; n_pile = 0; pop = 0; born = 0; houses = 0; mills = 0; beds = 6;
  day = 1; day_t = 8; game_t = 0; night = 0; dark = 0; warm = 0;
  sel = -1; tool = 0; drag = 0; msg_t = 0; tscale = 1; paused = 0;
  seed = rand(1, 99999);
  builder(next_state);
  RETURN 0;
END

// =====================================================================
// MAIN
// =====================================================================
PRIVATE spd, i;
BEGIN
  set_mode(640, 480);
  set_fps(60, 0);
  screen_color('#000000');
  init_tables();
  make_graphics();
  define_region(1, 0, 0, 480, 480);
  start_scroll(0, 0, g_map, 0, 1, 0);
  tint(g_dark, 0);
  tint(g_warm, 1);
  panel(g_side, 560, 240, -30);
  panel(g_mini, 560, 68, -32);
  banner();

  // static sidebar texts: written once, OFFSET keeps the numbers live
  set_color('#f0e0a0');
  write(0, 488, 140, 0, "DAY");
  write_int(0, 512, 140, 0, OFFSET day);
  set_color('#d0b080');
  write(0, 488, 168, 0, "WOOD");  write_int(0, 518, 168, 0, OFFSET stock_w);
  write(0, 560, 168, 0, "STONE"); write_int(0, 596, 168, 0, OFFSET stock_s);
  write(0, 488, 180, 0, "FOOD");  write_int(0, 518, 180, 0, OFFSET stock_f);
  set_color('#f0e0c0');
  write(0, 492, 202, 0, "H House     16w 4s");
  write(0, 492, 224, 0, "F Farm      10w");
  write(0, 492, 246, 0, "M Sawmill   14w 8s");
  write(0, 492, 268, 0, "S Storage    8w");
  write(0, 488, 300, 0, "PRIORITY (1-5 / click)");
  set_color('#d0c8b0');
  write(0, 492, 315, 0, "1 Wood");
  write(0, 492, 331, 0, "2 Stone");
  write(0, 492, 347, 0, "3 Food");
  write(0, 492, 363, 0, "4 Haul");
  write(0, 492, 379, 0, "5 Build");

  new_game(0);
  LOOP
    // camera: arrow keys or the mouse at the screen edge
    spd = 400 * get_delta();
    IF (key(_left) OR (mouse.x <= 2 AND mouse.y > 0)) cam_x -= spd; END
    IF (key(_right) OR (mouse.x >= 477 AND mouse.x < 482)) cam_x += spd; END
    IF (key(_up) OR (mouse.y <= 2 AND mouse.x < 480 AND mouse.x > 0)) cam_y -= spd; END
    IF (key(_down) OR (mouse.y >= 477 AND mouse.x < 480)) cam_y += spd; END

    IF (state == 1)
      handle_mouse();
      IF (key_pressed(_h)) tool = 1; END
      IF (key_pressed(_f)) tool = 2; END
      IF (key_pressed(_m)) tool = 3; END
      IF (key_pressed(_s)) tool = 4; END
      IF (key_pressed(_esc) OR key_pressed(_x)) tool = 0; sel = -1; END
      IF (key_pressed(_1)) prio[0] = (prio[0] + 1) % 6; END
      IF (key_pressed(_2)) prio[1] = (prio[1] + 1) % 6; END
      IF (key_pressed(_3)) prio[2] = (prio[2] + 1) % 6; END
      IF (key_pressed(_4)) prio[3] = (prio[3] + 1) % 6; END
      IF (key_pressed(_5)) prio[4] = (prio[4] + 1) % 6; END
      IF (key_pressed(_z)) tscale = 4 - tscale; END       // 1 <-> 3
      IF (key_pressed(_p)) paused = 1 - paused; END
      IF (paused) tscale = 0; ELSE IF (tscale == 0) tscale = 1; END END
      IF (tscale > 0) tick_world(get_delta() * tscale); END
    END
    cam_x = clamp(int(cam_x), 0, MW * 16 - 480);
    cam_y = clamp(int(cam_y), 0, MH * 16 - 480);
    scroll.x0 = cam_x; scroll.y0 = cam_y;
    draw_hud();

    SWITCH (state)
      CASE 0
        box_text(160, 11);
        set_color('#ffffff');
        text(44, 172, "Your five settlers landed on an unknown island.");
        text(44, 186, "They work by themselves: you only give directions.");
        text(44, 204, "Drag a box over trees and rocks to mark them for");
        text(44, 218, "cutting (right-drag unmarks). Place buildings with");
        text(44, 232, "the panel or H/F/M/S. Keys 1-5 or clicks set job");
        text(44, 246, "priorities. Arrows/screen edge scroll. Z: speed x3.");
        set_color('#f0d060');
        text(44, 264, "Grow the colony to " + WIN_POP + " settlers. Houses give beds,");
        text(44, 278, "a food surplus brings newcomers at dawn.");
        set_color('#60ff60');
        text(44, 300, "PRESS SPACE OR ENTER TO START");
        IF (key_pressed(_space) OR key_pressed(_enter)) state = 1; say("Mark some trees: you need wood"); END
      CASE 2, 3
        box_text(170, 4);
        set_color('#ffffff');
        IF (state == 2)
          text(44, 182, "Your colony reached " + pop + " settlers on day " + day + "!");
        ELSE
          text(44, 182, "Everyone is gone. The colony lasted " + day + " days.");
        END
        text(44, 198, "Settlers born or landed: " + born + "   score " + (day * 10 + pop * 25));
        set_color('#60ff60');
        text(44, 218, "SPACE / ENTER: a new island");
        IF (key_pressed(_space) OR key_pressed(_enter)) new_game(1); END
      CASE 4
        box_text(220, 2);
        set_color('#ffffff');
        text(44, 232, "Raising an island... " + gen_pct + "%");
    END
    FRAME;
  END
END
