PROGRAM ghost_squad;

// ---------------------------------------------------------------------
// GHOST SQUAD - Pac-Man turned around.
// This time YOU are the four ghosts, and a computer Pac-Man runs the
// maze eating dots. Steer one ghost at a time (1-4, TAB or SPACE pick
// which one); the other three follow their own personalities:
//   1 BLINKY (red)     chases Pac-Man's tile
//   2 PINKY  (pink)    ambushes four tiles ahead of him
//   3 INKY   (cyan)    patrols the power pills, pounces when he is near
//   4 CLYDE  (orange)  wanders at random
// Catch Pac-Man 3 times to win the round; if he clears the maze first,
// the game is over.
//
// Everything is made by the program: every round builds a new, left-right
// symmetric maze from a lattice of corridors (edges are removed at random
// while every junction keeps two exits and the maze stays connected),
// with side tunnels, a ghost house and four power pills. All graphics
// are drawn with new_graphic + gfx_*, all sounds with sfx / sfx_tone and
// the song sequencer.
//
// The maze is a grid of 27 x 27 tiles of 16 pixels. Movement is tile to
// tile: an actor stands on tile (ax, ay) and slides ap pixels towards the
// next one in direction ad (0 right, 1 down, 2 left, 3 up). nb[] holds,
// for every tile and direction, the tile you reach (-1 = wall), with the
// side tunnels already wrapped round, so no search ever has to check the
// grid's edges.
// ---------------------------------------------------------------------

GLOBAL
  // ---- layout
  MW = 27; MH = 27;          // maze size in tiles
  TS = 16;                   // tile size in pixels
  MOX = 8; MOY = 44;         // top-left corner of the maze on screen
  PX0 = 452;                 // left edge of the side panel
  ENTRY = 283;               // tile above the ghost house door (13, 10)
  DOOR_X = 224;              // pixel centre of column 13 (MOX + 13 * TS + 8)
  EXIT_Y = 212;              // pixel centre of row 10
  HOUSE_Y = 276;             // pixel centre of row 14, inside the house
  CATCHES_TO_WIN = 3;

  // ---- game states
  ST_INTRO = 0; ST_BUILD = 1; ST_READY = 2; ST_PLAY = 3; ST_CAUGHT = 4;
  ST_CLEAR = 5; ST_OVER = 6; ST_EATEN = 7;

  // ---- the maze, one entry per tile (tile = y * MW + x)
  tile[728];                 // 0 corridor, 1 wall, 2 house wall, 3 ghost-only floor, 4 door
  dot[728];                  // 0 nothing, 1 dot, 2 power pill
  nb[2915];                  // tile reached from tile c going d: nb[c * 4 + d], -1 = wall
  hd[728];                   // steps to ENTRY (the eyes follow it home)
  gd[728]; gmark[728];       // danger map: steps from the nearest ghost
  pd[728]; pmark[728];       // Pac-Man's search: steps from him
  fm[728];                   // ... and the first move of the way there
  frmark[728];               // tiles holding a frightened ghost
  pf[728];                   // steps to Pac-Man over the whole maze (Blinky's nose)
  pfq[728];                  // queue of that search
  pfmark[728];               // search number that last reached the tile
  pac_alert = 1;             // 1 when he watches the corridor ahead on this tile
  que[728];                  // BFS queue
  stamp = 0;                 // search number: mark[c] == stamp means "seen now"

  // ---- the lattice the maze is carved from
  NC = 7; NR = 8;            // lattice columns and rows
  cm = 3;                    // index of the centre column (x = 13)
  rh0 = 3; rh1 = 4; rh2 = 5; // rows at y = 10, 14, 18 (above, beside, below the house)
  ncx[8]; nry[8];            // tile x of every lattice column, tile y of every row
  hE[80]; vE[80];            // edge to the right / below node r * NC + c (1 = corridor)
  hreq[80]; vreq[80];        // edges that must stay (the ring round the house)
  tun[8];                    // 1 when lattice row r has side tunnels
  cand[199]; nvis[80]; nq[80];
  pill_c[3];                 // tiles of the four power pills

  dxs[3] = 1, 0, -1, 0;      // directions: right, down, left, up
  dys[3] = 0, 1, 0, -1;

  // ---- actors: 0..3 the ghosts, 4 Pac-Man
  ax[4]; ay[4];              // tile the actor stands on or leaves
  ad[4];                     // direction
  ap[4];                     // pixels travelled towards the next tile
  amv[4];                    // 1 while moving
  apx[4]; apy[4];            // pixel position (centre)
  leftover = 0;              // pixels left over past a tile centre (move_actor)
  gst[3];                    // ghost state: 0 in the house, 1 leaving it,
                             // 2 hunting, 3 eyes going home, 4 eyes entering
  gfr[3];                    // 1 while frightened (blue)
  gwant[3];                  // buffered direction of the player's ghost
  grel[3];                   // seconds until an AI ghost leaves the house
  sel = 0;                   // the ghost you steer
  patrol_k = 0;              // Inky's current patrol target (pill index)

  // ---- game
  state = 0; st_timer = 0.0;
  level = 1; score = 0; hiscore = 0; catches = 0;
  dots_left = 0; dots_total = 0;
  power_t = 0.0; power_dur = 6.0; eat_chain = 0;
  pac_speed = 100.0; ghost_speed = 96.0;
  pac_sight = 12;            // Pac-Man only sees ghosts this many steps away
  pac_blunder = 10;          // percent of decisions taken without looking
  pill_panic = 4;            // he runs for a power pill with a ghost this close
  pac_think_n = 0;           // decisions taken (for the tests)
  catches_total = 0; mazes_built = 0; ghosts_eaten = 0; powers = 0;
  popup_x = 0; popup_y = 0; popup_t = 0.0; popup_s = ""; popup_neg = 0;
  waka_i = 0; siren_fast = 0;
  first_ready = 1;

  // ---- graphics
  bg = 0; g_intro = 0;
  g_ghost[31];               // ghost i, skirt frame f, eye direction d: i * 8 + f * 4 + d
  g_fright[3];               // blue f0, blue f1, white f0, white f1
  g_eyes[3];                 // eyes only, per direction
  g_pac[4];                  // mouth frames, closed to wide open
  g_die[9];                  // Pac-Man caught: the mouth opens all the way
  g_ring = 0; g_pill = 0; g_digit[9]; g_small_pac = 0;
  g_ready = 0; g_caught = 0; g_clear = 0; g_over = 0; g_build = 0;
  gcol_r[3] = 255, 255, 0, 255;
  gcol_g[3] = 0, 184, 255, 184;
  gcol_b[3] = 0, 255, 255, 82;
  gname[3] = 'BLINKY', 'PINKY', 'INKY', 'CLYDE';
  gtrait[3] = 'chases him', 'ambushes ahead', 'guards the pills', 'wanders';

  // ---- sound
  snd_waka[1]; snd_power = 0; snd_eat = 0; snd_caught = 0; snd_hit = 0;
  snd_select = 0; snd_clear = 0; snd_start = 0;
  song_siren = 0; song_siren2 = 0; song_power = 0; song_jingle = 0; song_over = 0;

// =====================================================================
// Small helpers
// =====================================================================

// Pixel centre of tile column / row n
FUNCTION tile_x(n);
BEGIN
  RETURN MOX + n * TS + 8;
END

FUNCTION tile_y(n);
BEGIN
  RETURN MOY + n * TS + 8;
END

// Absolute value of an integer (cheaper to read than abs in hot loops)
FUNCTION iabs(v);
BEGIN
  IF (v < 0) RETURN -v; END
  RETURN v;
END

// Pixel position of actor a from its tile, direction and progress.
// Crossing a side tunnel it comes out on the other edge.
FUNCTION place(a);
PRIVATE px = 0.0; py = 0.0;
BEGIN
  px = MOX + ax[a] * TS + 8 + dxs[ad[a]] * ap[a];
  py = MOY + ay[a] * TS + 8 + dys[ad[a]] * ap[a];
  IF (px < MOX) px += MW * TS; END
  IF (px >= MOX + MW * TS) px -= MW * TS; END
  apx[a] = px;
  apy[a] = py;
  RETURN 0;
END

// Moves actor a dist pixels along its direction. Returns 1 when it
// reaches the next tile centre: it then stands on that tile, and the
// pixels it had left over are in leftover for the next direction.
FUNCTION move_actor(a, dist);
PRIVATE c = 0; n = 0;
BEGIN
  leftover = 0;
  IF (NOT amv[a]) RETURN 0; END
  ap[a] = ap[a] + dist;
  IF (ap[a] < TS) RETURN 0; END
  c = ay[a] * MW + ax[a];
  n = nb[c * 4 + ad[a]];
  leftover = ap[a] - TS;
  IF (leftover > TS - 1) leftover = TS - 1; END
  ap[a] = 0;
  IF (n >= 0)
    ax[a] = n % MW;
    ay[a] = n / MW;
  END
  RETURN 1;
END

// Actor a, standing on a tile centre, sets off in direction nd if that
// way is open (keeping the leftover pixels); otherwise it stops.
FUNCTION take_dir(a, nd);
PRIVATE c = 0;
BEGIN
  c = ay[a] * MW + ax[a];
  IF (nd >= 0)
    IF (nb[c * 4 + nd] >= 0)
      ad[a] = nd;
      amv[a] = 1;
      ap[a] = leftover;
      RETURN 1;
    END
  END
  amv[a] = 0;
  ap[a] = 0;
  RETURN 0;
END

// Turns actor a round in the middle of a corridor: it now leaves the
// tile it was heading for, the other way.
FUNCTION reverse_actor(a);
PRIVATE c = 0; n = 0;
BEGIN
  IF (NOT amv[a]) RETURN 0; END
  c = ay[a] * MW + ax[a];
  n = nb[c * 4 + ad[a]];
  IF (n < 0) RETURN 0; END
  ax[a] = n % MW;
  ay[a] = n / MW;
  ad[a] = (ad[a] + 2) % 4;
  ap[a] = TS - ap[a];
  RETURN 1;
END

// 1 when ghost i can catch Pac-Man
FUNCTION is_danger(i);
BEGIN
  IF (gfr[i] AND power_t > 0.8) RETURN 0; END
  RETURN gst[i] == 2;
END

// =====================================================================
// Maze generation
// =====================================================================

// Corridors meeting at lattice node (c, r); a tunnel counts as one
FUNCTION degree(c, r);
PRIVATE n = 0;
BEGIN
  IF (c > 0) n += hE[r * NC + c - 1]; END
  IF (c < NC - 1) n += hE[r * NC + c]; END
  IF (r > 0) n += vE[(r - 1) * NC + c]; END
  IF (r < NR - 1) n += vE[r * NC + c]; END
  IF (tun[r] AND (c == 0 OR c == NC - 1)) n++; END
  RETURN n;
END

// A node is fine with two or more corridors (no dead ends); the house
// centre is not a node at all
FUNCTION node_ok(c, r);
BEGIN
  IF (c == cm AND r == rh1) RETURN 1; END
  RETURN degree(c, r) >= 2;
END

// 1 when every node can still reach every other one
FUNCTION lattice_connected();
PRIVATE h = 0; t = 0; i = 0; n = 0; c = 0; r = 0; start = 0;
BEGIN
  FOR i = 0 TO NC * NR - 1
    nvis[i] = 0;
  END
  start = rh2 * NC + cm;
  nvis[start] = 1;
  nq[0] = start;
  t = 1;
  WHILE (h < t)
    n = nq[h];
    h++;
    c = n % NC;
    r = n / NC;
    IF (c > 0)
      IF (hE[n - 1] AND NOT nvis[n - 1]) nvis[n - 1] = 1; nq[t] = n - 1; t++; END
    END
    IF (c < NC - 1)
      IF (hE[n] AND NOT nvis[n + 1]) nvis[n + 1] = 1; nq[t] = n + 1; t++; END
    END
    IF (r > 0)
      IF (vE[n - NC] AND NOT nvis[n - NC]) nvis[n - NC] = 1; nq[t] = n - NC; t++; END
    END
    IF (r < NR - 1)
      IF (vE[n] AND NOT nvis[n + NC]) nvis[n + NC] = 1; nq[t] = n + NC; t++; END
    END
  END
  RETURN t == NC * NR - 1;         // all nodes but the house centre
END

// Tries to remove candidate edge e (and its mirror image); puts it back
// when that leaves a dead end or cuts the maze in two
FUNCTION try_remove(e);
PRIVATE idx = 0; r = 0; c = 0; m = 0; ok = 0;
BEGIN
  IF (e >= 100)                    // vertical edge below node idx
    idx = e - 100;
    r = idx / NC;
    c = idx % NC;
    m = r * NC + (NC - 1 - c);
    vE[idx] = 0;
    vE[m] = 0;
    ok = node_ok(c, r) AND node_ok(c, r + 1) AND node_ok(NC - 1 - c, r) AND node_ok(NC - 1 - c, r + 1);
    IF (ok) ok = lattice_connected(); END
    IF (NOT ok) vE[idx] = 1; vE[m] = 1; END
  ELSE                             // horizontal edge right of node e
    r = e / NC;
    c = e % NC;
    m = r * NC + (NC - 2 - c);
    hE[e] = 0;
    hE[m] = 0;
    ok = node_ok(c, r) AND node_ok(c + 1, r) AND node_ok(NC - 1 - c, r) AND node_ok(NC - 2 - c, r);
    IF (ok) ok = lattice_connected(); END
    IF (NOT ok) hE[e] = 1; hE[m] = 1; END
  END
  RETURN ok;
END

// 1 when tile (tx, ty) is open floor for the wall outlines. Outside the
// grid only the tunnel rows are open.
FUNCTION is_open(tx, ty);
PRIVATE t = 0;
BEGIN
  IF (ty < 0 OR ty >= MH) RETURN 0; END
  IF (tx < 0 OR tx >= MW) RETURN tile[ty * MW] == 0; END
  t = tile[ty * MW + tx];
  RETURN t == 0 OR t >= 3;
END

// Draws wall tile (tx, ty) into graphic g: a dark fill, then a neon line
// (with a dim glow) along every side that faces a corridor. Inner
// corners get a small L so the outline stays continuous.
FUNCTION draw_wall(g, tx, ty);
PRIVATE px = 0; py = 0; u = 0; dn = 0; l = 0; r = 0; ul = 0; ur = 0; dl = 0; dr = 0;
        p = 0; a = 0; w = 0; cr = 0; cg = 0; cb = 0; xa = 0; xb = 0; ya = 0; yb = 0;
BEGIN
  px = MOX + tx * TS;
  py = MOY + ty * TS;
  u = is_open(tx, ty - 1);
  dn = is_open(tx, ty + 1);
  l = is_open(tx - 1, ty);
  r = is_open(tx + 1, ty);
  ul = NOT u AND NOT l AND is_open(tx - 1, ty - 1);
  ur = NOT u AND NOT r AND is_open(tx + 1, ty - 1);
  dl = NOT dn AND NOT l AND is_open(tx - 1, ty + 1);
  dr = NOT dn AND NOT r AND is_open(tx + 1, ty + 1);

  // fill inside the outline
  xa = px; xb = px + TS; ya = py; yb = py + TS;
  IF (l) xa = px + 6; END
  IF (r) xb = px + TS - 6; END
  IF (u) ya = py + 6; END
  IF (dn) yb = py + TS - 6; END
  gfx_rect(g, xa, ya, xb - xa, yb - ya, 8, 8, 40);
  IF (ul) gfx_rect(g, px, py, 5, 5, 0, 0, 0); END
  IF (ur) gfx_rect(g, px + TS - 5, py, 5, 5, 0, 0, 0); END
  IF (dl) gfx_rect(g, px, py + TS - 5, 5, 5, 0, 0, 0); END
  IF (dr) gfx_rect(g, px + TS - 5, py + TS - 5, 5, 5, 0, 0, 0); END

  // pass 0: a wide dim glow, pass 1: the bright line on top of it
  FOR p = 0 TO 1
    IF (p == 0)
      a = 3; w = 4; cr = 16; cg = 20; cb = 110;
    ELSE
      a = 4; w = 2; cr = 50; cg = 70; cb = 255;
    END
    xa = px; xb = px + TS; ya = py; yb = py + TS;
    IF (l) xa = px + a; END
    IF (r) xb = px + TS - a; END
    IF (u) ya = py + a; END
    IF (dn) yb = py + TS - a; END
    IF (u) gfx_rect(g, xa, py + a, xb - xa, w, cr, cg, cb); END
    IF (dn) gfx_rect(g, xa, py + TS - a - w, xb - xa, w, cr, cg, cb); END
    IF (l) gfx_rect(g, px + a, ya, w, yb - ya, cr, cg, cb); END
    IF (r) gfx_rect(g, px + TS - a - w, ya, w, yb - ya, cr, cg, cb); END
    IF (ul)
      gfx_rect(g, px, py + a, a + w, w, cr, cg, cb);
      gfx_rect(g, px + a, py, w, a + w, cr, cg, cb);
    END
    IF (ur)
      gfx_rect(g, px + TS - a - w, py + a, a + w, w, cr, cg, cb);
      gfx_rect(g, px + TS - a - w, py, w, a + w, cr, cg, cb);
    END
    IF (dl)
      gfx_rect(g, px, py + TS - a - w, a + w, w, cr, cg, cb);
      gfx_rect(g, px + a, py + TS - a - w, w, a + w, cr, cg, cb);
    END
    IF (dr)
      gfx_rect(g, px + TS - a - w, py + TS - a - w, a + w, w, cr, cg, cb);
      gfx_rect(g, px + TS - a - w, py + TS - a - w, w, a + w, cr, cg, cb);
    END
  END
  RETURN 0;
END

// The static part of the side panel and the top line, drawn into the
// background graphic g
FUNCTION draw_panel(g);
PRIVATE i = 0; y0 = 0;
BEGIN
  gfx_rect(g, PX0 - 6, 4, 190, 472, 10, 10, 30);
  gfx_rect_outline(g, PX0 - 6, 4, 190, 472, 50, 70, 255);
  gfx_text(g, PX0 + 6, 12, 'GHOST SQUAD', 255, 60, 60, 20);
  gfx_text(g, PX0 + 4, 44, 'SCORE', 180, 190, 255, 11);
  gfx_text(g, PX0 + 110, 44, 'ROUND', 180, 190, 255, 11);
  gfx_text(g, PX0 + 4, 96, 'PAC-MAN', 180, 190, 255, 11);
  gfx_text(g, PX0 + 110, 96, 'DOTS', 180, 190, 255, 11);
  gfx_text(g, PX0 + 4, 150, 'YOUR SQUAD', 180, 190, 255, 11);
  FOR i = 0 TO 3
    y0 = 168 + i * 50;
    gfx_rect(g, PX0, y0, 176, 44, 16, 16, 44);
    gfx_text(g, PX0 + 34, y0 + 3, '' + (i + 1) + ' ' + gname[i], gcol_r[i], gcol_g[i], gcol_b[i], 13);
    gfx_text(g, PX0 + 34, y0 + 18, gtrait[i], 150, 150, 190, 10);
  END
  gfx_text(g, PX0 + 4, 374, 'ARROWS   move your ghost', 200, 200, 220, 10);
  gfx_text(g, PX0 + 4, 388, '1-4      pick a ghost', 200, 200, 220, 10);
  gfx_text(g, PX0 + 4, 402, 'TAB/SPC  next ghost', 200, 200, 220, 10);
  gfx_text(g, PX0 + 4, 416, 'N        new maze', 200, 200, 220, 10);
  gfx_text(g, PX0 + 4, 446, 'Catch him ' + CATCHES_TO_WIN + ' times before', 255, 184, 151, 10);
  gfx_text(g, PX0 + 4, 459, 'he eats every dot!', 255, 184, 151, 10);
  gfx_text(g, MOX + 4, 10, 'YOU ARE THE GHOSTS', 255, 255, 255, 14);
  gfx_text(g, MOX + 4, 27, 'Pac-Man is the computer. Hunt him down!', 150, 160, 210, 12);
  RETURN 0;
END

// Builds a round's maze over several frames, so that no frame does too
// much work, then paints it into the background graphic and starts the
// round.
PROCESS builder();
PRIVATE i = 0; j = 0; r = 0; c = 0; d = 0; n = 0; tmp = 0; ncand = 0; work = 0;
        tx = 0; ty = 0; x0 = 0; y0 = 0; b = 0; h = 0; t = 0; old = 0;
BEGIN
  // 1. The lattice: tile positions of its columns and rows. Column 13
  // and rows 10, 14, 18 are fixed: the ghost house sits between them.
  ncx[0] = 1; ncx[1] = 4; ncx[2] = 8; ncx[3] = 13;
  IF (rand(0, 1)) ncx[1] = 5; END
  FOR i = 0 TO 2
    ncx[6 - i] = 26 - ncx[i];
  END
  NC = 7;
  cm = 3;
  IF (rand(0, 3) == 0)
    nry[0] = 1; nry[1] = 5; nry[2] = 10;
    NR = 7;
    rh0 = 2;
  ELSE
    nry[0] = 1; nry[1] = 4; nry[2] = 7; nry[3] = 10;
    NR = 8;
    rh0 = 3;
  END
  rh1 = rh0 + 1;
  rh2 = rh0 + 2;
  nry[rh1] = 14;
  nry[rh2] = 18;
  nry[rh2 + 1] = 21;
  IF (rand(0, 1)) nry[rh2 + 1] = 22; END
  nry[rh2 + 2] = 25;

  // 2. Start from the full lattice, minus the house centre
  FOR i = 0 TO 80
    hE[i] = 0; vE[i] = 0; hreq[i] = 0; vreq[i] = 0;
  END
  FOR r = 0 TO NR - 1
    FOR c = 0 TO NC - 1
      IF (c < NC - 1) hE[r * NC + c] = 1; END
      IF (r < NR - 1) vE[r * NC + c] = 1; END
    END
    tun[r] = 0;
  END
  hE[rh1 * NC + cm - 1] = 0;
  hE[rh1 * NC + cm] = 0;
  vE[rh0 * NC + cm] = 0;
  vE[rh1 * NC + cm] = 0;
  // the corridor ring round the house always stays
  hreq[rh0 * NC + cm - 1] = 1; hreq[rh0 * NC + cm] = 1;
  hreq[rh2 * NC + cm - 1] = 1; hreq[rh2 * NC + cm] = 1;
  vreq[rh0 * NC + cm - 1] = 1; vreq[rh1 * NC + cm - 1] = 1;
  vreq[rh0 * NC + cm + 1] = 1; vreq[rh1 * NC + cm + 1] = 1;
  // tunnels: always beside the house, sometimes one more pair
  tun[rh1] = 1;
  IF (rand(0, 2) == 0) tun[1] = 1; END
  IF (rand(0, 2) == 0) tun[NR - 2] = 1; END
  FRAME;

  // 3. Remove edges of the left half (and their mirror images) in a
  // random order, each with some chance, as long as the maze stays good
  ncand = 0;
  FOR r = 0 TO NR - 1
    FOR c = 0 TO cm - 1
      IF (hE[r * NC + c] AND NOT hreq[r * NC + c])
        cand[ncand] = r * NC + c;
        ncand++;
      END
    END
    IF (r < NR - 1)
      FOR c = 0 TO cm
        IF (vE[r * NC + c] AND NOT vreq[r * NC + c])
          cand[ncand] = 100 + r * NC + c;
          ncand++;
        END
      END
    END
  END
  FOR i = 0 TO ncand - 2
    j = rand(i, ncand - 1);
    tmp = cand[i]; cand[i] = cand[j]; cand[j] = tmp;
  END
  FOR i = 0 TO ncand - 1
    IF (rand(0, 99) < 60)
      try_remove(cand[i]);
    END
    work++;
    IF (work >= 8) work = 0; FRAME; END
  END

  // 4. Tiles: walls everywhere, then the corridors, tunnels and house
  FOR i = 0 TO 728
    tile[i] = 1;
    dot[i] = 0;
  END
  FOR r = 0 TO NR - 1
    FOR c = 0 TO NC - 1
      IF (NOT (c == cm AND r == rh1))
        tile[nry[r] * MW + ncx[c]] = 0;
        IF (c < NC - 1)
          IF (hE[r * NC + c])
            FOR tx = ncx[c] TO ncx[c + 1]
              tile[nry[r] * MW + tx] = 0;
            END
          END
        END
        IF (r < NR - 1)
          IF (vE[r * NC + c])
            FOR ty = nry[r] TO nry[r + 1]
              tile[ty * MW + ncx[c]] = 0;
            END
          END
        END
      END
    END
    IF (tun[r])
      FOR tx = 0 TO ncx[0]
        tile[nry[r] * MW + tx] = 0;
        tile[nry[r] * MW + MW - 1 - tx] = 0;
      END
    END
  END
  FOR ty = 12 TO 16
    FOR tx = 10 TO 16
      tile[ty * MW + tx] = 2;
    END
  END
  FOR ty = 13 TO 15
    FOR tx = 11 TO 15
      tile[ty * MW + tx] = 3;
    END
  END
  tile[11 * MW + 13] = 3;        // the way from the door up to ENTRY
  tile[12 * MW + 13] = 4;        // the door
  FRAME;

  // 5. Neighbour table (tunnels wrap round), a few rows per frame
  FOR ty = 0 TO MH - 1
    FOR tx = 0 TO MW - 1
      c = ty * MW + tx;
      b = c * 4;
      FOR d = 0 TO 3
        nb[b + d] = -1;
        IF (tile[c] == 0)
          x0 = tx + dxs[d];
          y0 = ty + dys[d];
          IF (x0 < 0) x0 = MW - 1; END
          IF (x0 >= MW) x0 = 0; END
          IF (y0 >= 0 AND y0 < MH)
            IF (tile[y0 * MW + x0] == 0) nb[b + d] = y0 * MW + x0; END
          END
        END
      END
    END
    IF (ty % 5 == 4) FRAME; END
  END

  // 6. Distance of every tile to the house entrance (the eyes' way home)
  FOR i = 0 TO 728
    hd[i] = 999;
  END
  hd[ENTRY] = 0;
  que[0] = ENTRY;
  h = 0;
  t = 1;
  WHILE (h < t)
    c = que[h];
    h++;
    FOR d = 0 TO 3
      n = nb[c * 4 + d];
      IF (n >= 0)
        IF (hd[n] > hd[c] + 1)
          hd[n] = hd[c] + 1;
          que[t] = n;
          t++;
        END
      END
    END
  END
  FRAME;

  // 7. Dots on every corridor but the tunnels and the ring round the
  // house; power pills near the four corners
  dots_left = 0;
  FOR c = 0 TO 728
    IF (tile[c] == 0)
      tx = c % MW;
      ty = c / MW;
      IF (tx >= ncx[0] AND tx <= ncx[NC - 1])
        IF (NOT (tx >= 8 AND tx <= 18 AND ty >= 10 AND ty <= 18))
          dot[c] = 1;
          dots_left++;
        END
      END
    END
  END
  pill_c[0] = nry[1] * MW + ncx[0];
  pill_c[1] = nry[1] * MW + ncx[NC - 1];
  pill_c[2] = nry[NR - 2] * MW + ncx[0];
  pill_c[3] = nry[NR - 2] * MW + ncx[NC - 1];
  FOR i = 0 TO 3
    IF (dot[pill_c[i]] == 0) dots_left++; END
    dot[pill_c[i]] = 2;
  END
  dots_total = dots_left;
  FRAME;

  // 8. Paint the background: walls (a couple of rows per frame), the
  // door, the dots and the panel
  old = bg;
  bg = new_graphic(640, 480);
  gfx_fill(bg, 0, 0, 0);
  FOR ty = 0 TO MH - 1
    FOR tx = 0 TO MW - 1
      IF (tile[ty * MW + tx] == 1 OR tile[ty * MW + tx] == 2)
        draw_wall(bg, tx, ty);
      END
    END
    FRAME;
  END
  gfx_rect(bg, MOX + 13 * TS - 2, MOY + 12 * TS + 6, TS + 4, 4, 255, 184, 222);
  FOR c = 0 TO 728
    IF (dot[c] == 1)
      gfx_rect(bg, MOX + (c % MW) * TS + 6, MOY + (c / MW) * TS + 6, 4, 4, 255, 184, 151);
    END
  END
  FRAME;
  draw_panel(bg);
  FRAME;
  put_screen(0, bg);
  IF (old) free_graphic(old); END

  mazes_built++;
  catches = 0;
  siren_fast = 0;
  start_round();
END

// =====================================================================
// Pac-Man's brain
// =====================================================================

// Decides where Pac-Man goes from the tile he stands on. Two searches:
// first the danger map (steps from the nearest hunting ghost), then a
// breadth-first search from Pac-Man that only walks through tiles he
// reaches well before any ghost. In it he looks for the nearest dot,
// the nearest power pill, a frightened ghost to eat, and the safest
// tile to run to. Returns a direction, -1 to stay.
FUNCTION pac_think();
PRIVATE c0 = 0; st = 0; h = 0; t = 0; c = 0; n = 0; k = 0; b = 0; i = 0; gc = 0;
        dd = 0; g = 0; sc = 0; threat = 0; best_dot = -1; best_pill = -1; best_fr = -1;
        best_flee = -1; flee_sc = -9999; target = -1; bestk = -1; bestg = -1; greedy = 0;
        save_pills = 0;
BEGIN
  pac_think_n++;
  c0 = ay[4] * MW + ax[4];
  stamp++;
  st = stamp;
  // now and then he gets greedy and forgets about the ghosts (less
  // often in later rounds)
  greedy = rand(0, 99) < pac_blunder;

  // danger map, from every hunting ghost's tile (and the one it enters)
  t = 0;
  FOR i = 0 TO 3
    IF (is_danger(i) AND NOT greedy)
      gc = ay[i] * MW + ax[i];
      IF (gmark[gc] != st) gmark[gc] = st; gd[gc] = 0; que[t] = gc; t++; END
      IF (amv[i] AND ap[i] > 5)
        n = nb[gc * 4 + ad[i]];
        IF (n >= 0)
          IF (gmark[n] != st) gmark[n] = st; gd[n] = 0; que[t] = n; t++; END
        END
      END
    END
    IF (gst[i] == 1 AND NOT gfr[i] AND NOT greedy)   // about to leave the house
      IF (gmark[ENTRY] != st) gmark[ENTRY] = st; gd[ENTRY] = 1; que[t] = ENTRY; t++; END
    END
    IF (gst[i] == 2 AND gfr[i] AND power_t > 1.5)
      frmark[ay[i] * MW + ax[i]] = st;
    END
  END
  h = 0;
  WHILE (h < t)
    c = que[h];
    h++;
    IF (gd[c] < pac_sight)
      b = c * 4;
      FOR k = 0 TO 3
        n = nb[b + k];
        IF (n >= 0)
          IF (gmark[n] != st)
            gmark[n] = st;
            gd[n] = gd[c] + 1;
            que[t] = n;
            t++;
          END
        END
      END
    END
  END
  threat = 99;
  IF (gmark[c0] == st) threat = gd[c0]; END
  // with no ghost close he keeps the power pills for later: he does not
  // walk over them
  save_pills = threat > pill_panic AND power_t <= 0;

  // Pac-Man's search through the safe tiles
  pmark[c0] = st;
  pd[c0] = 0;
  que[0] = c0;
  h = 0;
  t = 1;
  WHILE (h < t)
    c = que[h];
    h++;
    b = c * 4;
    dd = pd[c] + 1;
    IF (dd > 26) BREAK; END                     // far enough: plans stay local
    FOR k = 0 TO 3
      n = nb[b + k];
      IF (n >= 0)
        IF (pmark[n] != st)
          g = 99;
          IF (gmark[n] == st) g = gd[n]; END
          IF (dd < g)                            // he gets there first
            pmark[n] = st;
            pd[n] = dd;
            IF (c == c0) fm[n] = k; ELSE fm[n] = fm[c]; END
            IF (dot[n] != 2 OR NOT save_pills)
              que[t] = n;
              t++;
            END
            IF (dot[n] == 1 AND best_dot < 0) best_dot = n; END
            IF (dot[n] == 2 AND best_pill < 0) best_pill = n; END
            IF (frmark[n] == st AND best_fr < 0) best_fr = n; END
            sc = g * 2 - dd;
            IF (sc > flee_sc) flee_sc = sc; best_flee = n; END
          END
        END
      END
    END
    // no ghost anywhere near and a dot found: that's enough
    IF (threat > pac_sight AND best_dot >= 0 AND best_fr < 0) BREAK; END
  END

  // choose
  IF (best_fr >= 0)
    IF (pd[best_fr] <= 10) target = best_fr; END
  END
  IF (target < 0 AND threat <= pill_panic AND best_pill >= 0 AND power_t <= 0) target = best_pill; END
  IF (target < 0 AND best_dot >= 0)
    // a ghost close by and the dot lies towards it: run instead
    IF (threat <= 3 AND best_flee >= 0) target = best_flee; ELSE target = best_dot; END
  END
  IF (target < 0 AND best_pill >= 0) target = best_pill; END
  IF (target < 0 AND best_flee >= 0) target = best_flee; END
  IF (target >= 0) RETURN fm[target]; END

  // cornered: step to the neighbour furthest from the ghosts
  b = c0 * 4;
  FOR k = 0 TO 3
    n = nb[b + k];
    IF (n >= 0)
      g = 99;
      IF (gmark[n] == st) g = gd[n]; END
      IF (g > bestg) bestg = g; bestk = k; END
    END
  END
  RETURN bestk;
END

// Halfway along a corridor, Pac-Man turns back if a hunting ghost is
// coming at him from the front (and none is right behind him).
FUNCTION pac_check_reverse();
PRIVATE c = 0; nxt = 0; i = 0; gc = 0; gn = 0; ahead = 0; behind = 0;
BEGIN
  IF (NOT pac_alert) RETURN 0; END
  c = ay[4] * MW + ax[4];
  nxt = nb[c * 4 + ad[4]];
  IF (nxt < 0) RETURN 0; END
  FOR i = 0 TO 3
    IF (is_danger(i))
      gc = ay[i] * MW + ax[i];
      gn = -1;
      IF (amv[i]) gn = nb[gc * 4 + ad[i]]; END
      IF (gc == nxt) ahead = 1; END
      IF (gc == c OR gn == c) behind = 1; END
    END
  END
  IF (ahead AND NOT behind)
    reverse_actor(4);
    RETURN 1;
  END
  RETURN 0;
END

// Pac-Man arrives on tile c: eats what is there
FUNCTION pac_eat(c);
PRIVATE i = 0;
BEGIN
  IF (dot[c] == 0) RETURN 0; END
  IF (dot[c] == 1)
    // erase the dot from the background and waka
    gfx_rect(bg, MOX + (c % MW) * TS + 6, MOY + (c / MW) * TS + 6, 4, 4, 0, 0, 0);
    play_sound(snd_waka[waka_i], 55, 94 + rand(0, 12), (apx[4] - 224) / 3);
    waka_i = 1 - waka_i;
  ELSE
    // power pill: every ghost that is not already eyes turns blue
    power_t = power_dur;
    eat_chain = 0;
    powers++;
    FOR i = 0 TO 3
      IF (gst[i] <= 2)
        gfr[i] = 1;
        IF (gst[i] == 2 AND i != sel) reverse_actor(i); END
      END
    END
    play_sound(snd_power, 80);
    song_play(song_power);
  END
  dot[c] = 0;
  dots_left--;
  IF (dots_left * 2 < dots_total AND NOT siren_fast AND power_t <= 0)
    siren_fast = 1;
    song_play(song_siren2);
  END
  RETURN 1;
END

PROCESS pacman();
PRIVATE nd = 0; anim = 0.0; fr = 0; wait = 0; k = 0;
BEGIN
  z = -6;
  graph = g_pac[0];
  LOOP
    IF (state == ST_PLAY)
      IF (move_actor(4, pac_speed * get_delta()))
        pac_eat(ay[4] * MW + ax[4]);
        pac_alert = rand(0, 99) < 45 + level * 10;
        nd = pac_think();
        IF (NOT take_dir(4, nd))
          take_dir(4, ad[4]);        // keep going if that is possible
        END
      ELSE
        IF (amv[4])
          pac_check_reverse();
        ELSE
          // standing still: think again every few frames
          wait--;
          IF (wait <= 0)
            leftover = 0;
            nd = pac_think();
            take_dir(4, nd);
            wait = 6;
          END
        END
      END
      IF (amv[4]) anim += get_delta() * 18; END
    END
    place(4);
    x = apx[4];
    y = apy[4];
    angle = 0;
    IF (ad[4] == 1) angle = -90000; END
    IF (ad[4] == 2) angle = 180000; END
    IF (ad[4] == 3) angle = 90000; END
    alpha = 100;
    IF (state == ST_CAUGHT)
      // the famous deflating death, after a short freeze
      k = int((st_timer - 0.5) * 8);
      IF (k < 0)
        graph = g_pac[2];
      ELSE
        IF (k > 9) graph = 0; ELSE graph = g_die[k]; END
        angle = 90000;
      END
    ELSE
      IF (state == ST_EATEN OR state == ST_BUILD OR state == ST_INTRO OR state == ST_CLEAR)
        graph = 0;
      ELSE
        IF (state == ST_READY)
          graph = g_pac[0];
        ELSE
          fr = int(anim) % 8;
          IF (fr > 4) fr = 8 - fr; END
          graph = g_pac[fr];
        END
      END
    END
    FRAME;
  END
END

// =====================================================================
// The ghosts
// =====================================================================

// Direction an AI ghost takes at a junction: never back the way it came
// (unless it is a dead end); frightened ghosts and Clyde choose at
// random, the others head for their target tile the classic way (the
// exit that is closest to it in a straight line).
FUNCTION ghost_ai(i);
PRIVATE c = 0; back = 0; k = 0; n = 0; best = 0; bd = 0; d2 = 0; tx = 0; ty = 0;
        cnt = 0; opts[3]; man = 0; tries = 0;
BEGIN
  c = ay[i] * MW + ax[i];
  back = (ad[i] + 2) % 4;
  cnt = 0;
  FOR k = 0 TO 3
    IF (k != back AND nb[c * 4 + k] >= 0)
      opts[cnt] = k;
      cnt++;
    END
  END
  IF (cnt == 0) RETURN back; END
  IF (cnt == 1) RETURN opts[0]; END
  man = iabs(ax[i] - ax[4]) + iabs(ay[i] - ay[4]);
  IF (gfr[i]) RETURN opts[rand(0, cnt - 1)]; END
  IF (i == 3 AND man > 4) RETURN opts[rand(0, cnt - 1)]; END
  IF (i == 0 OR i == 3)
    // Blinky (and Clyde when he is close) follow the real shortest way
    best = opts[0];
    bd = 9999;
    FOR k = 0 TO cnt - 1
      n = nb[c * 4 + opts[k]];
      IF (pfmark[n] > 0 AND pf[n] < bd) bd = pf[n]; best = opts[k]; END
    END
    RETURN best;
  END

  tx = ax[4];
  ty = ay[4];
  IF (i == 1)                                  // Pinky: four tiles ahead of him
    tx = ax[4] + dxs[ad[4]] * 4;
    ty = ay[4] + dys[ad[4]] * 4;
    IF (man <= 3) tx = ax[4]; ty = ay[4]; END
  END
  IF (i == 2 AND man > 6)                      // Inky: guard the pills in turn
    tries = 0;
    WHILE (tries < 4 AND dot[pill_c[patrol_k]] != 2)
      patrol_k = (patrol_k + 1) % 4;
      tries++;
    END
    IF (tries >= 4)                            // no pills left: the corners
      tx = ncx[(patrol_k % 2) * (NC - 1)];
      ty = nry[(patrol_k / 2) * (NR - 1)];
    ELSE
      tx = pill_c[patrol_k] % MW;
      ty = pill_c[patrol_k] / MW;
    END
    IF (iabs(ax[i] - tx) + iabs(ay[i] - ty) <= 2) patrol_k = (patrol_k + 1) % 4; END
  END

  best = opts[0];
  bd = 999999;
  FOR k = 0 TO cnt - 1
    n = nb[c * 4 + opts[k]];
    d2 = (n % MW - tx) * (n % MW - tx) + (n / MW - ty) * (n / MW - ty);
    IF (d2 < bd) bd = d2; best = opts[k]; END
  END
  RETURN best;
END

// Direction the eyes take: downhill on the distance to the house
FUNCTION eyes_dir(i);
PRIVATE c = 0; k = 0; n = 0; best = -1; bd = 9999;
BEGIN
  c = ay[i] * MW + ax[i];
  FOR k = 0 TO 3
    n = nb[c * 4 + k];
    IF (n >= 0)
      IF (hd[n] < bd) bd = hd[n]; best = k; END
    END
  END
  RETURN best;
END

// Decision of ghost i standing on a tile centre
FUNCTION ghost_decide(i);
PRIVATE c = 0;
BEGIN
  IF (gst[i] == 3)
    c = ay[i] * MW + ax[i];
    IF (c == ENTRY)
      gst[i] = 4;
      amv[i] = 0;
      ap[i] = 0;
      apx[i] = DOOR_X;
      apy[i] = EXIT_Y;
      RETURN 0;
    END
    take_dir(i, eyes_dir(i));
    RETURN 0;
  END
  IF (i == sel)
    // your ghost: the buffered turn if it is open, else straight on
    IF (NOT take_dir(i, gwant[i]))
      IF (amv[i] OR leftover > 0)
        take_dir(i, ad[i]);
      END
    END
    RETURN 0;
  END
  take_dir(i, ghost_ai(i));
  RETURN 0;
END

// One frame of ghost i
FUNCTION ghost_update(i);
PRIVATE spd = 0.0; dt = 0.0; c = 0;
BEGIN
  dt = get_delta();
  IF (gst[i] == 0)                             // waiting in the house
    grel[i] = grel[i] - dt;
    IF (grel[i] <= 0 OR (i == sel AND gwant[i] >= 0)) gst[i] = 1; END
    RETURN 0;
  END
  IF (gst[i] == 1)                             // leaving: to the door, then up
    IF (apx[i] < DOOR_X - 1)
      apx[i] = apx[i] + 80 * dt;
    ELSE
      IF (apx[i] > DOOR_X + 1)
        apx[i] = apx[i] - 80 * dt;
      ELSE
        apx[i] = DOOR_X;
        apy[i] = apy[i] - 80 * dt;
        IF (apy[i] <= EXIT_Y)
          gst[i] = 2;
          ax[i] = 13; ay[i] = 10; ap[i] = 0; amv[i] = 0;
          ad[i] = 2;
          IF (rand(0, 1)) ad[i] = 0; END
          leftover = 0;
          ghost_decide(i);
          place(i);
        END
      END
    END
    RETURN 0;
  END
  IF (gst[i] == 4)                             // eyes sinking into the house
    apy[i] = apy[i] + 110 * dt;
    IF (apy[i] >= HOUSE_Y)
      apy[i] = HOUSE_Y;
      gfr[i] = 0;
      gst[i] = 1;
    END
    RETURN 0;
  END

  // hunting (2) or eyes (3): tile movement
  IF (gst[i] == 3)
    spd = 190;
  ELSE
    spd = ghost_speed;
    IF (i == sel) spd = pac_speed + 12; END   // yours is faster
    IF (gfr[i]) spd = 58; END
    IF (ax[i] < ncx[0] OR ax[i] > ncx[NC - 1]) spd = spd * 0.6; END   // tunnels are slow
  END
  IF (i == sel AND gst[i] == 2 AND amv[i] AND gwant[i] == (ad[i] + 2) % 4)
    reverse_actor(i);                          // you can turn back any time
  END
  IF (move_actor(i, spd * dt))
    ghost_decide(i);
  ELSE
    IF (NOT amv[i])
      leftover = 0;
      ghost_decide(i);
    END
  END
  place(i);
  RETURN 0;
END

PROCESS ghost(i);
PRIVATE fr = 0; ed = 0; t = 0.0; blink = 0;
BEGIN
  z = -2 - i;
  LOOP
    IF (state == ST_PLAY) ghost_update(i); END
    t += get_delta();
    fr = int(t * 8) % 2;
    ed = ad[i];
    IF (gst[i] == 0)                           // bobbing in the house
      apy[i] = HOUSE_Y + sin(int(t * 400000) + i * 90000) * 4;
      ed = 3;
      IF (sin(int(t * 400000) + i * 90000) > 0) ed = 1; END
    END
    IF (gst[i] == 1 OR gst[i] == 4) ed = 3; IF (gst[i] == 4) ed = 1; END END
    x = apx[i];
    y = apy[i];
    IF (gst[i] >= 3)
      graph = g_eyes[ed];
    ELSE
      IF (gfr[i])
        blink = 0;
        IF (power_t < 2.0 AND int(power_t * 6) % 2 == 0) blink = 2; END
        graph = g_fright[blink + fr];
      ELSE
        graph = g_ghost[i * 8 + fr * 4 + ed];
      END
    END
    IF (state == ST_BUILD OR state == ST_INTRO OR (state == ST_CAUGHT AND st_timer > 0.5))
      graph = 0;
    END
    FRAME;
  END
END

// Keeps pf[] (steps from every tile to Pac-Man) up to date: a full
// breadth-first search each time he reaches a new tile. It runs in its
// own process so its work does not add to Pac-Man's.
PROCESS tracker();
PRIVATE last = -1; c0 = 0; h = 0; t = 0; c = 0; n = 0; b = 0; k = 0; mk = 0;
BEGIN
  LOOP
    c0 = ay[4] * MW + ax[4];
    IF (c0 != last)
      last = c0;
      FRAME;                     // not in the frame Pac-Man does his own thinking
      mk++;
      pfmark[c0] = mk;
      pf[c0] = 0;
      pfq[0] = c0;
      h = 0;
      t = 1;
      WHILE (h < t)
        c = pfq[h];
        h++;
        b = c * 4;
        FOR k = 0 TO 3
          n = nb[b + k];
          IF (n >= 0)
            IF (pfmark[n] != mk)
              pfmark[n] = mk;
              pf[n] = pf[c] + 1;
              pfq[t] = n;
              t++;
            END
          END
        END
      END
    END
    FRAME;
  END
END

// Ring under the ghost you steer
PROCESS selector();
PRIVATE t = 0.0;
BEGIN
  graph = g_ring;
  z = 5;
  LOOP
    t += get_delta();
    x = apx[sel];
    y = apy[sel];
    size = 100 + sin(int(t * 540000)) * 12;
    graph = g_ring;
    IF (state == ST_BUILD OR state == ST_INTRO OR state == ST_CAUGHT) graph = 0; END
    FRAME;
  END
END

// A blinking power pill on tile c
PROCESS pill(c);
PRIVATE t = 0.0;
BEGIN
  graph = g_pill;
  x = tile_x(c % MW);
  y = tile_y(c / MW);
  z = 10;
  WHILE (dot[c] == 2)
    t += get_delta();
    alpha = 100;
    IF (state == ST_PLAY AND int(t * 4) % 2 == 1) alpha = 0; END
    FRAME;
  END
END

// =====================================================================
// Panel sprites
// =====================================================================

// One digit of a number shown on the panel: kind 0 score, 1 round,
// 2 dots left; place is 1, 10, 100...
PROCESS digit(x, y, kind, place);
PRIVATE v = 0;
BEGIN
  z = -20;
  LOOP
    v = score;
    IF (kind == 1) v = level; END
    IF (kind == 2) v = dots_left; END
    graph = g_digit[(v / place) % 10];
    FRAME;
  END
END

// Ghost i's portrait in the squad list
PROCESS icon(i);
PRIVATE t = 0.0; fr = 0;
BEGIN
  x = PX0 + 16;
  y = 190 + i * 50;
  z = -20;
  LOOP
    t += get_delta();
    fr = int(t * 6) % 2;
    IF (gst[i] >= 3)
      graph = g_eyes[0];
    ELSE
      IF (gfr[i]) graph = g_fright[fr]; ELSE graph = g_ghost[i * 8 + fr * 4]; END
    END
    FRAME;
  END
END

// Pac-Man's remaining lives (k = 0..2): the lost ones fade out
PROCESS life_icon(k);
BEGIN
  graph = g_small_pac;
  x = PX0 + 14 + k * 22;
  y = 122;
  z = -20;
  LOOP
    alpha = 100;
    IF (k >= CATCHES_TO_WIN - catches) alpha = 18; END
    FRAME;
  END
END

// A banner graphic shown in the middle of the maze
PROCESS banner();
BEGIN
  x = MOX + 13 * TS + 8;
  y = MOY + 20 * TS + 8;
  z = -30;
  LOOP
    graph = 0;
    IF (state == ST_READY) graph = g_ready; END
    IF (state == ST_CAUGHT AND st_timer > 0.3) graph = g_caught; END
    IF (state == ST_CLEAR) graph = g_clear; END
    IF (state == ST_OVER) graph = g_over; y = MOY + 13 * TS + 8; ELSE y = MOY + 20 * TS + 8; END
    IF (state == ST_BUILD) graph = g_build; END
    FRAME;
  END
END

// Pac-Man and the ghosts running across the title screen
PROCESS parade(k);
PRIVATE t = 0.0; fr = 0; dir = 1; base = 0.0;
BEGIN
  y = 432;
  z = -5;
  LOOP
    t += get_delta();
    // they run right, then Pac-Man turns round, blue ghosts flee left
    dir = 1;
    IF (int(t / 7) % 2 == 1) dir = -1; END
    base = (t % 7) * 110;
    IF (dir > 0) x = -60 + base; ELSE x = 700 - base; END
    IF (k == 4)
      fr = int(t * 18) % 8;
      IF (fr > 4) fr = 8 - fr; END
      graph = g_pac[fr];
      angle = 0;
      IF (dir < 0) angle = 180000; END
      IF (dir > 0) x += 150; ELSE x -= 150; END
    ELSE
      fr = int(t * 8) % 2;
      IF (dir > 0)
        graph = g_ghost[k * 8 + fr * 4];
        x += 110 - k * 30;
      ELSE
        graph = g_fright[fr];
        x -= 20 + k * 30;
        x += 60;
      END
    END
    IF (state != ST_INTRO) BREAK; END
    FRAME;
  END
END

// =====================================================================
// Graphics
// =====================================================================

// Pac-Man with his mouth open hdeg degrees each side of "right", drawn
// pixel by pixel (a pixel is in the mouth when it lies on the right
// side of the mouth's upper edge)
FUNCTION make_pac(hdeg, rad);
PRIVATE gr = 0; px = 0; py = 0; dx = 0; dy = 0; ady = 0; sh = 0.0; ch = 0.0; d2 = 0; sz = 0; r2 = 0;
BEGIN
  sz = rad * 2 + 2;
  gr = new_graphic(sz, sz);
  gfx_fill_rgba(gr, 0, 0, 0, 0);
  sh = sin(hdeg * 1000);
  ch = cos(hdeg * 1000);
  r2 = rad * rad * 4;
  FOR py = 0 TO sz - 1
    dy = py * 2 + 1 - sz;
    ady = iabs(dy);
    FOR px = 0 TO sz - 1
      dx = px * 2 + 1 - sz;
      d2 = dx * dx + dy * dy;
      IF (d2 <= r2)
        IF (hdeg <= 0 OR dx * sh - ady * ch <= 0)
          IF (d2 > r2 - rad * 6)
            gfx_pixel(gr, px, py, 230, 190, 0);    // darker rim
          ELSE
            gfx_pixel(gr, px, py, 255, 232, 0);
          END
        END
      END
    END
  END
  RETURN gr;
END

// A ghost 24 x 24: body colour (r, g, b), skirt frame fr, eyes looking
// towards ed. kind 0 normal, 1 frightened face, 2 only the eyes.
FUNCTION make_ghost(r, g, b, fr, ed, kind);
PRIVATE gr = 0; i = 0; hgt = 0; ex = 0; fx = 0; fy = 0; mr = 0; mg = 0; mb = 0;
BEGIN
  gr = new_graphic(24, 24);
  gfx_fill_rgba(gr, 0, 0, 0, 0);
  IF (kind != 2)
    gfx_circle(gr, 12, 11, 10, r, g, b);
    gfx_rect(gr, 2, 11, 21, 9, r, g, b);
    FOR i = 2 TO 22                              // wavy skirt
      hgt = iabs((i + fr * 3) % 6 - 3) + 1;
      gfx_rect(gr, i, 20, 1, hgt, r, g, b);
    END
  END
  IF (kind == 1)
    // frightened: small eyes and a wobbly mouth
    mr = 255; mg = 184; mb = 151;
    IF (r > 200) mr = 255; mg = 0; mb = 0; END
    gfx_rect(gr, 8, 8, 3, 3, mr, mg, mb);
    gfx_rect(gr, 14, 8, 3, 3, mr, mg, mb);
    FOR i = 4 TO 19
      gfx_pixel(gr, i, 15 + (i / 2) % 2, mr, mg, mb);
    END
    RETURN gr;
  END
  fx = dxs[ed];
  fy = dys[ed];
  FOR i = 0 TO 1
    ex = 8 + i * 8 + fx;
    gfx_circle(gr, ex, 9 + fy, 3, 255, 255, 255);
    gfx_circle(gr, ex, 11 + fy, 3, 255, 255, 255);
    gfx_rect(gr, ex + fx - 1, 9 + fy * 2, 3, 3, 33, 33, 200);
  END
  RETURN gr;
END

// A banner: dark box with a neon border and a line of big text
FUNCTION make_banner(w, s, r, g, b);
PRIVATE gr = 0;
BEGIN
  gr = new_graphic(w, 30);
  gfx_fill_rgba(gr, 0, 0, 20, 88);
  gfx_rect_outline(gr, 0, 0, w, 30, 50, 70, 255);
  gfx_text(gr, 10, 6, s, r, g, b, 18);
  RETURN gr;
END

// The title screen, painted once
FUNCTION make_intro();
PRIVATE gr = 0; i = 0; y0 = 0;
BEGIN
  gr = new_graphic(640, 480);
  gfx_fill(gr, 0, 0, 0);
  gfx_rect_outline(gr, 20, 16, 600, 448, 50, 70, 255);
  gfx_rect_outline(gr, 24, 20, 592, 440, 16, 20, 110);
  gfx_text(gr, 150, 40, 'GHOST', 255, 40, 40, 58);
  gfx_text(gr, 350, 40, 'SQUAD', 255, 184, 255, 58);
  gfx_text(gr, 150, 112, 'Pac-Man, the other way round.', 255, 232, 0, 18);
  gfx_text(gr, 70, 150, 'This time the computer plays Pac-Man, and YOU are the', 220, 220, 240, 14);
  gfx_text(gr, 70, 168, 'four ghosts. He eats dots, runs from you, and goes for', 220, 220, 240, 14);
  gfx_text(gr, 70, 186, 'the power pills when you get close: then you turn blue', 220, 220, 240, 14);
  gfx_text(gr, 70, 204, 'and it is your turn to run.', 220, 220, 240, 14);
  gfx_text(gr, 70, 232, 'Catch him 3 times before he clears the maze.', 255, 184, 151, 14);
  gfx_text(gr, 70, 250, 'Every round is a brand new maze.', 255, 184, 151, 14);
  FOR i = 0 TO 3
    y0 = 284 + i * 22;
    gfx_text(gr, 120, y0, '' + (i + 1) + '  ' + gname[i], gcol_r[i], gcol_g[i], gcol_b[i], 15);
    gfx_text(gr, 250, y0, gtrait[i] + ' when you let go', 170, 170, 200, 13);
  END
  gfx_text(gr, 70, 380, 'ARROWS move your ghost   1-4 / TAB / SPACE switch ghost', 200, 200, 220, 12);
  gfx_text(gr, 190, 402, 'PRESS SPACE OR ENTER TO START', 255, 255, 255, 15);
  RETURN gr;
END

// =====================================================================
// Sound
// =====================================================================

FUNCTION make_sounds();
BEGIN
  snd_waka[0] = sfx_tone(wave_triangle, 230, 470, 70, 50);
  snd_waka[1] = sfx_tone(wave_triangle, 470, 230, 70, 50);
  snd_power = sfx(sfx_powerup, 4);
  snd_eat = sfx_tone(wave_square, 160, 1500, 260, 40);
  snd_caught = sfx_tone(wave_square, 1100, 80, 1200, 42);
  snd_hit = sfx(sfx_hit, 2);
  snd_select = sfx_tone(wave_sine, 660, 990, 60, 35);
  snd_clear = sfx(sfx_coin, 7);
  snd_start = sfx(sfx_blip, 1);

  // the siren: a sine sweeping up and down, over a slow saw and pad line
  song_siren = song_new(150);
  song_track(song_siren, inst_sine,
    "C5 C#5 D5 D#5 E5 F5 F#5 G5 G#5 A5 G#5 G5 F#5 F5 E5 D#5 D5 C#5", 16);
  song_track(song_siren, inst_saw,
    "A2 - - - - - - - - - - - - - - - - - F2 - - - - - - - - - - - - - - - - -", 12);
  song_track(song_siren, inst_pad,
    "A3 - - - - - - - - - - - - - - - - - C4 - - - - - - - - - - - - - - - - -", 14);
  // faster siren once half the dots are gone
  song_siren2 = song_new(190);
  song_track(song_siren2, inst_sine,
    "D5 D#5 E5 F5 F#5 G5 G#5 A5 A#5 B5 A#5 A5 G#5 G5 F#5 F5 E5 D#5", 16);
  song_track(song_siren2, inst_saw,
    "A2 - - - - - - - - - - - - - - - - - G2 - - - - - - - - - - - - - - - - -", 12);
  song_track(song_siren2, inst_pad,
    "E4 - - - - - - - - - - - - - - - - - D4 - - - - - - - - - - - - - - - - -", 14);
  // blue ghosts: a fast warble
  song_power = song_new(200);
  song_track(song_power, inst_square, "G5 C6 G5 C6 A5 D6 A5 D6", 14);
  song_track(song_power, inst_bass, "C3 . C3 . D3 . D3 .", 22);
  // intro jingle, played once
  song_jingle = song_new(150);
  song_track(song_jingle, inst_square,
    "E5 . B5 . G5 . E5 . B5 G5 - - E5 - - - | F5 . C6 . A5 . F5 . C6 A5 - - F5 - - - |" +
    "E5 . B5 . G5 . E5 . B5 G5 - - E5 - - - | G5 A5 B5 . A5 B5 C6 . B5 C6 D6 . E6 - - - ", 40);
  song_track(song_jingle, inst_bass,
    "E3 - . E3 B3 - . B3 E3 - . E3 B3 - . B3 | F3 - . F3 C4 - . C4 F3 - . F3 C4 - . C4 |" +
    "E3 - . E3 B3 - . B3 E3 - . E3 B3 - . B3 | G3 - . G3 A3 - . A3 B3 - . B3 E3 - - - ", 60);
  // game over
  song_over = song_new(110);
  song_track(song_over, inst_pad, "E4 - D4 - C4 - B3 - A3 - - - - - - -", 40);
  song_track(song_over, inst_bass, "A2 - - - G2 - - - F2 - - - E2 - - -", 50);
  RETURN 0;
END

// =====================================================================
// Game flow
// =====================================================================

// Everybody back to the start: Pac-Man below the house, Blinky above
// it, the others inside
FUNCTION reset_actors();
PRIVATE i = 0;
BEGIN
  ax[4] = 13; ay[4] = 18; ad[4] = 2; ap[4] = 0; amv[4] = 0;
  place(4);
  ax[0] = 13; ay[0] = 10; ad[0] = 2; ap[0] = 0; amv[0] = 0;
  gst[0] = 2;
  place(0);
  FOR i = 1 TO 3
    gst[i] = 0;
    ax[i] = 13; ay[i] = 14; ad[i] = 3; ap[i] = 0; amv[i] = 0;
    apx[i] = tile_x(9 + i * 2);
    apy[i] = HOUSE_Y;
  END
  grel[1] = 1.0;
  grel[2] = 4.0;
  grel[3] = 7.0;
  FOR i = 0 TO 3
    gfr[i] = 0;
    gwant[i] = -1;
  END
  power_t = 0;
  patrol_k = 0;
  RETURN 0;
END

// A maze is ready: set the speeds, spawn the actors, say READY
FUNCTION start_round();
PRIVATE i = 0;
BEGIN
  pac_speed = 84 + level * 4;
  IF (pac_speed > 124) pac_speed = 124; END
  ghost_speed = 80 + level * 4;            // the AI ghosts: a bit slower than him
  IF (ghost_speed > 116) ghost_speed = 116; END
  pac_sight = 6 + level * 2;
  IF (pac_sight > 22) pac_sight = 22; END
  pill_panic = 3 + level;
  IF (pill_panic > 8) pill_panic = 8; END
  pac_blunder = 14 - level * 2;
  IF (pac_blunder < 3) pac_blunder = 3; END
  power_dur = 5.5 - level * 0.5;
  IF (power_dur < 3) power_dur = 3; END
  reset_actors();
  pacman();
  FOR i = 0 TO 3
    ghost(i);
    pill(pill_c[i]);
  END
  selector();
  tracker();
  first_ready = 1;
  state = ST_READY;
  st_timer = 0;
  song_play(song_jingle, 0);
  RETURN 0;
END

// Removes the round's actors (before a new maze)
FUNCTION clear_round();
BEGIN
  signal(TYPE pacman, s_kill);
  signal(TYPE ghost, s_kill);
  signal(TYPE pill, s_kill);
  signal(TYPE selector, s_kill);
  signal(TYPE tracker, s_kill);
  signal(TYPE builder, s_kill);
  RETURN 0;
END

FUNCTION new_maze();
BEGIN
  clear_round();
  state = ST_BUILD;
  st_timer = 0;
  builder();
  RETURN 0;
END

// Starts a new game from the title screen
FUNCTION new_game();
PRIVATE i = 0;
BEGIN
  signal(TYPE parade, s_kill);
  level = 1;
  score = 0;
  song_stop();
  play_sound(snd_start, 70);
  FOR i = 0 TO 5
    digit(PX0 + 4 + i * 12, 70, 0, pow(10, 5 - i));
  END
  FOR i = 0 TO 1
    digit(PX0 + 116 + i * 12, 70, 1, pow(10, 1 - i));
  END
  FOR i = 0 TO 2
    digit(PX0 + 116 + i * 12, 122, 2, pow(10, 2 - i));
  END
  FOR i = 0 TO 3
    icon(i);
  END
  FOR i = 0 TO 2
    life_icon(i);
  END
  banner();
  new_maze();
  RETURN 0;
END

FUNCTION go_intro();
PRIVATE i = 0;
BEGIN
  clear_round();
  signal(TYPE digit, s_kill);
  signal(TYPE icon, s_kill);
  signal(TYPE life_icon, s_kill);
  signal(TYPE banner, s_kill);
  put_screen(0, g_intro);
  state = ST_INTRO;
  st_timer = 0;
  FOR i = 0 TO 4
    parade(i);
  END
  song_play(song_jingle, 0);
  RETURN 0;
END

// Checks Pac-Man against every ghost
FUNCTION check_contacts();
PRIVATE i = 0; dx = 0.0; dy = 0.0;
BEGIN
  FOR i = 0 TO 3
    IF (gst[i] == 2)
      dx = apx[i] - apx[4];
      dy = apy[i] - apy[4];
      IF (dx < 0) dx = -dx; END
      IF (dy < 0) dy = -dy; END
      IF (dx + dy < 12)
        IF (gfr[i])
          // Pac-Man eats a blue ghost: it goes home as a pair of eyes
          gst[i] = 3;
          gfr[i] = 0;
          eat_chain++;
          ghosts_eaten++;
          popup_s = '-' + (100 * pow(2, eat_chain));
          popup_neg = 1;
          score = score - 100 * pow(2, eat_chain);
          IF (score < 0) score = 0; END
          popup_x = apx[i] - 12;
          popup_y = apy[i] - 4;
          popup_t = 0.9;
          play_sound(snd_eat, 80);
          state = ST_EATEN;
          st_timer = 0;
          RETURN 0;
        ELSE
          // caught!
          catches++;
          catches_total++;
          score = score + 500 * level;
          IF (score > hiscore) hiscore = score; END
          popup_s = '+' + (500 * level);
          popup_neg = 0;
          popup_x = apx[4] - 16;
          popup_y = apy[4] - 24;
          popup_t = 2.0;
          state = ST_CAUGHT;
          st_timer = 0;
          song_stop();
          play_sound(snd_hit, 90);
          play_sound(snd_caught, 80);
          RETURN 0;
        END
      END
    END
  END
  RETURN 0;
END

// =====================================================================
// MAIN
// =====================================================================

PRIVATE i = 0; k = 0; y0 = 0; st_txt = ""; bonus = 0;
BEGIN
  set_mode(640, 480);
  set_fps(60, 0);
  screen_color('#000000');

  // graphics: a few per frame (Pac-Man's are drawn pixel by pixel)
  FOR i = 0 TO 4
    g_pac[i] = make_pac(i * 12, 11);
    FRAME;
  END
  FOR i = 0 TO 9
    g_die[i] = make_pac(60 + i * 13, 11 - i / 3);
    IF (i % 2 == 1) FRAME; END
  END
  g_small_pac = make_pac(35, 8);
  FOR i = 0 TO 3
    FOR k = 0 TO 7
      g_ghost[i * 8 + k] = make_ghost(gcol_r[i], gcol_g[i], gcol_b[i], k / 4, k % 4, 0);
    END
  END
  g_fright[0] = make_ghost(33, 33, 255, 0, 0, 1);
  g_fright[1] = make_ghost(33, 33, 255, 1, 0, 1);
  g_fright[2] = make_ghost(230, 230, 255, 0, 0, 1);
  g_fright[3] = make_ghost(230, 230, 255, 1, 0, 1);
  FOR k = 0 TO 3
    g_eyes[k] = make_ghost(0, 0, 0, 0, k, 2);
  END
  g_ring = new_graphic(34, 34);
  gfx_fill_rgba(g_ring, 0, 0, 0, 0);
  gfx_circle_outline(g_ring, 17, 17, 15, 255, 255, 255);
  gfx_circle_outline(g_ring, 17, 17, 14, 255, 255, 140);
  gfx_circle_outline(g_ring, 17, 17, 16, 120, 120, 60);
  g_pill = new_graphic(14, 14);
  gfx_fill_rgba(g_pill, 0, 0, 0, 0);
  gfx_circle(g_pill, 7, 7, 6, 255, 184, 151);
  FOR i = 0 TO 9
    g_digit[i] = new_graphic(12, 18);
    gfx_fill_rgba(g_digit[i], 0, 0, 0, 0);
    gfx_text(g_digit[i], 0, 0, '' + i, 255, 255, 255, 19);
  END
  g_ready = make_banner(104, 'READY!', 255, 232, 0);
  g_caught = make_banner(124, 'CAUGHT!', 255, 80, 80);
  g_clear = make_banner(200, 'ROUND CLEAR!', 120, 255, 140);
  g_build = make_banner(200, 'NEW MAZE...', 120, 180, 255);
  g_over = 0;
  g_intro = make_intro();
  FRAME;
  make_sounds();
  go_intro();

  LOOP
    st_timer += get_delta();

    IF (state == ST_INTRO)
      IF (key_pressed(_space) OR key_pressed(_enter))
        new_game();
      END
    END

    IF (state >= ST_READY AND state != ST_OVER)
      // pick a ghost: 1-4, TAB or SPACE for the next one
      k = -1;
      IF (key_pressed(_1)) k = 0; END
      IF (key_pressed(_2)) k = 1; END
      IF (key_pressed(_3)) k = 2; END
      IF (key_pressed(_4)) k = 3; END
      IF (key_pressed(_tab) OR key_pressed(_space)) k = (sel + 1) % 4; END
      IF (k >= 0 AND k != sel)
        sel = k;
        gwant[sel] = -1;
        IF (gst[sel] == 2 AND amv[sel]) gwant[sel] = ad[sel]; END
        play_sound(snd_select, 50);
      END
      // arrows: the buffered turn of your ghost
      IF (key(_right)) gwant[sel] = 0; END
      IF (key(_down)) gwant[sel] = 1; END
      IF (key(_left)) gwant[sel] = 2; END
      IF (key(_up)) gwant[sel] = 3; END
      IF (key_pressed(_n) AND state != ST_BUILD)
        new_maze();
      END
    END

    IF (state == ST_READY)
      IF (st_timer > 2.0 AND (st_timer > 4.2 OR NOT first_ready))
        state = ST_PLAY;
        st_timer = 0;
        first_ready = 0;
        IF (siren_fast) song_play(song_siren2); ELSE song_play(song_siren); END
      END
    END

    IF (state == ST_PLAY)
      check_contacts();
      IF (state == ST_PLAY AND power_t > 0)
        power_t = power_t - get_delta();
        IF (power_t <= 0)
          power_t = 0;
          FOR i = 0 TO 3
            gfr[i] = 0;
          END
          IF (siren_fast) song_play(song_siren2); ELSE song_play(song_siren); END
        END
      END
      IF (dots_left <= 0)
        // he did it: game over
        state = ST_OVER;
        st_timer = 0;
        power_t = 0;
        FOR i = 0 TO 3
          gfr[i] = 0;
        END
        IF (score > hiscore) hiscore = score; END
        IF (g_over) free_graphic(g_over); END
        g_over = new_graphic(330, 110);
        gfx_fill_rgba(g_over, 0, 0, 20, 92);
        gfx_rect_outline(g_over, 0, 0, 330, 110, 50, 70, 255);
        gfx_text(g_over, 20, 10, 'PAC-MAN CLEARED THE MAZE', 255, 232, 0, 17);
        gfx_text(g_over, 20, 40, 'GAME OVER   score ' + score, 255, 255, 255, 15);
        gfx_text(g_over, 20, 62, 'rounds won ' + (level - 1) + '   best ' + hiscore, 180, 190, 255, 13);
        gfx_text(g_over, 20, 86, 'SPACE / ENTER: title', 255, 184, 151, 13);
        song_play(song_over, 0);
      END
    END

    IF (state == ST_EATEN AND st_timer > 0.6)
      state = ST_PLAY;
      st_timer = 0;
    END

    IF (state == ST_CAUGHT AND st_timer > 2.4)
      IF (catches >= CATCHES_TO_WIN)
        state = ST_CLEAR;
        st_timer = 0;
        bonus = dots_left * 10;
        score = score + bonus;
        IF (score > hiscore) hiscore = score; END
        popup_s = 'BONUS +' + bonus;
        popup_neg = 0;
        popup_x = MOX + 13 * TS - 30;
        popup_y = MOY + 22 * TS;
        popup_t = 2.5;
        play_sound(snd_clear, 80);
        song_play(song_jingle, 0);
      ELSE
        reset_actors();
        state = ST_READY;
        st_timer = 0;
      END
    END

    IF (state == ST_CLEAR AND st_timer > 2.8)
      level++;
      new_maze();
    END

    IF (state == ST_OVER AND st_timer > 1.0)
      IF (key_pressed(_space) OR key_pressed(_enter))
        go_intro();
      END
    END

    // ---- per-frame drawing: ghost numbers, the squad list, popups
    IF (state >= ST_READY)
      FOR i = 0 TO 3
        IF (state != ST_CAUGHT AND gst[i] != 0)
          set_color('#ffffff');
          IF (i != sel) set_color('#8890b0'); END
          text(apx[i] - 2, apy[i] - 22, '' + (i + 1));
        END
        // status in the panel
        y0 = 168 + i * 50;
        st_txt = 'hunting';
        IF (gst[i] == 0) st_txt = 'in the house'; END
        IF (gst[i] == 1) st_txt = 'coming out'; END
        IF (gst[i] >= 3) st_txt = 'eyes, going home'; END
        IF (gst[i] <= 2 AND gfr[i]) st_txt = 'SCARED - run!'; END
        set_color('#8088b0');
        IF (gfr[i] AND gst[i] <= 2) set_color('#7090ff'); END
        text(PX0 + 34, y0 + 32, st_txt);
      END
      // highlight of the ghost you steer
      y0 = 168 + sel * 50;
      draw_rect(PX0 - 2, y0 - 2, 180, 2, '#ffffa0');
      draw_rect(PX0 - 2, y0 + 44, 180, 2, '#ffffa0');
      draw_rect(PX0 - 2, y0 - 2, 2, 48, '#ffffa0');
      draw_rect(PX0 + 176, y0 - 2, 2, 48, '#ffffa0');
      set_color('#ffffa0');
      text(PX0 + 152, y0 + 32, 'YOU');
      // dots bar and power timer
      draw_rect(PX0 + 110, 142, 66, 4, '#202040');
      IF (dots_total > 0)
        draw_rect(PX0 + 110, 142, dots_left * 66 / dots_total, 4, '#ffb897');
      END
      IF (power_t > 0)
        set_color('#8fa0ff');
        text(PX0 + 4, 139, 'POWER');
        draw_rect(PX0 + 38, 142, int(power_t * 60 / power_dur), 4, '#4060ff');
      END
    END
    IF (popup_t > 0)
      popup_t = popup_t - get_delta();
      set_color('#ffffff');
      IF (popup_neg) set_color('#80a0ff'); END
      text(popup_x, popup_y, popup_s);
    END
    FRAME;
  END
END
