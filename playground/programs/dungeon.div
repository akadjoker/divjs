PROGRAM dungeon;

// DEEP DELVE - a small turn-based roguelike.
// Every floor is generated: random non-overlapping rooms joined by
// L-shaped corridors, a key, the stairs (sealed until you hold the key),
// potions, gold and monsters that get tougher the deeper you go.
// The world only acts after the player does. The map is one graphic that
// is repainted (gfx_rect) only when a turn changes it, never per frame.

// ---- the level: 40 x 26 tiles of 16 pixels (one cell = row * 40 + col)
GLOBAL tmap[1039];    // 0 wall, 1 floor, 2 stairs
GLOBAL tseen[1039];   // 1 once the player has seen the tile (fog memory)
GLOBAL tvis[1039];    // 1 while the tile is in the field of view
GLOBAL titem[1039];   // 0 nothing, 1 key, 2 potion, 3 gold

// rooms of the current floor (top-left corner and size, in tiles)
GLOBAL rx[11]; ry[11]; rw[11]; rh[11]; rooms = 0;

// monsters: position, hit points, kind, attack, chase target, hit flash
GLOBAL mx[15]; my[15]; mhp[15]; mmax[15]; mkind[15]; matk[15];
GLOBAL mawake[15]; mtx[15]; mty[15]; mhit[15]; mcount = 0;

// the player
GLOBAL px = 0; py = 0; hp = 20; maxhp = 20; atk = 3; lvl = 1; xp = 0;
GLOBAL depth = 1; gold = 0; has_key = 0; kills = 0; phit = 0;

// game state: 0 title, 1 playing, 2 dead. dirty = map needs repainting
GLOBAL state = 0; dirty = 0; turns = 0;
GLOBAL msg0 = ""; msg1 = ""; msg2 = "";   // message log, msg2 newest

// generated graphics
GLOBAL g_map; g_hero; g_mon[3]; g_key; g_potion; g_gold; g_title; g_dead;

// ---------------------------------------------------------------- sprites
// Each sprite is drawn by a function taking a target graphic and an
// offset, so the title screen can reuse them for its legend.
FUNCTION draw_hero(g, ox, oy);
BEGIN
  gfx_rect(g, ox + 5, oy + 7, 6, 6, 60, 120, 230);     // tunic
  gfx_circle(g, ox + 8, oy + 4, 3, 250, 210, 160);     // head
  gfx_rect(g, ox + 5, oy + 13, 2, 3, 70, 60, 50);      // legs
  gfx_rect(g, ox + 9, oy + 13, 2, 3, 70, 60, 50);
  gfx_line(g, ox + 12, oy + 2, ox + 12, oy + 11, 220, 230, 240);  // sword
  gfx_rect(g, ox + 11, oy + 9, 3, 1, 200, 160, 60);
  gfx_rect(g, ox + 2, oy + 7, 3, 5, 160, 110, 50);     // shield
  RETURN 0;
END

FUNCTION draw_monster(g, ox, oy, kind);
PRIVATE r, gr, b, rad;
BEGIN
  SWITCH (kind)
    CASE 0 r = 150; gr = 110; b = 80;  rad = 4;   // rat
    CASE 1 r = 80;  gr = 190; b = 70;  rad = 5;   // goblin
    CASE 2 r = 200; gr = 80;  b = 50;  rad = 6;   // orc
    DEFAULT r = 170; gr = 90; b = 230; rad = 7;   // wraith
  END
  gfx_circle(g, ox + 8, oy + 9, rad, r, gr, b);
  gfx_circle(g, ox + 8, oy + 8, rad - 2, r + 40, gr + 40, b + 20);
  gfx_rect(g, ox + 5, oy + 7, 2, 2, 255, 240, 60);     // eyes
  gfx_rect(g, ox + 9, oy + 7, 2, 2, 255, 240, 60);
  IF (kind == 0) gfx_line(g, ox + 12, oy + 12, ox + 15, oy + 15, 200, 150, 150); END  // tail
  IF (kind >= 2) gfx_rect(g, ox + 6, oy + 11, 4, 1, 40, 10, 10); END                 // mouth
  RETURN 0;
END

FUNCTION draw_item(g, ox, oy, kind);
BEGIN
  IF (kind == 1)   // key
    gfx_circle_outline(g, ox + 5, oy + 8, 3, 255, 220, 60);
    gfx_rect(g, ox + 8, oy + 8, 7, 2, 255, 220, 60);
    gfx_rect(g, ox + 12, oy + 10, 2, 3, 255, 220, 60);
  END
  IF (kind == 2)   // potion
    gfx_circle(g, ox + 8, oy + 10, 5, 230, 50, 80);
    gfx_rect(g, ox + 7, oy + 2, 3, 4, 200, 200, 220);
    gfx_pixel(g, ox + 6, oy + 8, 255, 200, 210);
  END
  IF (kind == 3)   // gold
    gfx_circle(g, ox + 6, oy + 10, 4, 220, 170, 30);
    gfx_circle(g, ox + 10, oy + 9, 4, 250, 210, 60);
    gfx_pixel(g, ox + 10, oy + 8, 255, 255, 180);
  END
  RETURN 0;
END

FUNCTION make_graphics();
PRIVATE i;
BEGIN
  g_map = new_graphic(640, 416);
  g_hero = new_graphic(16, 16);   draw_hero(g_hero, 0, 0);
  FOR i = 0 TO 3
    g_mon[i] = new_graphic(16, 16); draw_monster(g_mon[i], 0, 0, i);
  END
  g_key = new_graphic(16, 16);    draw_item(g_key, 0, 0, 1);
  g_potion = new_graphic(16, 16); draw_item(g_potion, 0, 0, 2);
  g_gold = new_graphic(16, 16);   draw_item(g_gold, 0, 0, 3);

  // Title screen: big text plus a legend drawn with the same functions
  g_title = new_graphic(640, 480);
  gfx_fill(g_title, 10, 9, 16);
  FOR i = 0 TO 199   // speckled stone
    gfx_rect(g_title, rand(0, 639), rand(0, 479), 2, 2, 30, 26, 36);
  END
  gfx_text(g_title, 170, 70, "DEEP DELVE", 255, 200, 90, 48);
  gfx_text(g_title, 190, 130, "a tiny turn-based roguelike", 170, 160, 190, 16);
  draw_hero(g_title, 200, 190);     gfx_text(g_title, 230, 191, "you", 220, 220, 230, 14);
  draw_item(g_title, 200, 215, 1);  gfx_text(g_title, 230, 216, "key - opens the stairs", 220, 220, 230, 14);
  gfx_rect(g_title, 200, 240, 15, 15, 90, 80, 50);
  FOR i = 0 TO 3 gfx_rect(g_title, 202, 242 + i * 3, 11, 1, 230, 200, 120); END
  gfx_text(g_title, 230, 241, "stairs - go deeper", 220, 220, 230, 14);
  draw_item(g_title, 200, 265, 2);  gfx_text(g_title, 230, 266, "potion - heals", 220, 220, 230, 14);
  draw_item(g_title, 200, 290, 3);  gfx_text(g_title, 230, 291, "gold", 220, 220, 230, 14);
  FOR i = 0 TO 3 draw_monster(g_title, 200 + i * 20, 315, i); END
  gfx_text(g_title, 290, 316, "monsters - bump to attack", 220, 220, 230, 14);
  gfx_text(g_title, 130, 370, "ARROWS / WASD move one tile    SPACE wait", 150, 200, 255, 14);
  gfx_text(g_title, 200, 410, "press SPACE to descend", 255, 255, 255, 18);

  // Death screen: a translucent veil with the headline; stats are text()
  g_dead = new_graphic(640, 480);
  gfx_fill_rgba(g_dead, 0, 0, 0, 78);
  gfx_text(g_dead, 200, 140, "YOU DIED", 230, 60, 60, 48);
  gfx_text(g_dead, 205, 330, "press SPACE for a new run", 255, 255, 255, 18);
  RETURN 0;
END

// ---------------------------------------------------------------- messages
FUNCTION say(s);
BEGIN
  msg0 = msg1; msg1 = msg2; msg2 = s;
  RETURN 0;
END

FUNCTION mname(kind);
BEGIN
  SWITCH (kind)
    CASE 0 RETURN "rat";
    CASE 1 RETURN "goblin";
    CASE 2 RETURN "orc";
  END
  RETURN "wraith";
END

// ---------------------------------------------------------------- generation
// Carve horizontal / vertical corridor runs (the two legs of an L).
FUNCTION hcorr(x1, x2, yy);
PRIVATE t;
BEGIN
  IF (x1 > x2) t = x1; x1 = x2; x2 = t; END   // walk left to right
  WHILE (x1 <= x2) IF (tmap[yy * 40 + x1] == 0) tmap[yy * 40 + x1] = 1; END x1++; END
  RETURN 0;
END

FUNCTION vcorr(y1, y2, xx);
PRIVATE t;
BEGIN
  IF (y1 > y2) t = y1; y1 = y2; y2 = t; END
  WHILE (y1 <= y2) IF (tmap[y1 * 40 + xx] == 0) tmap[y1 * 40 + xx] = 1; END y1++; END
  RETURN 0;
END

// A free floor cell inside room r (no item, not the player), or -1.
FUNCTION free_cell(r);
PRIVATE t, cx, cy, idx;
BEGIN
  FOR t = 1 TO 30
    cx = rx[r] + rand(0, rw[r] - 1); cy = ry[r] + rand(0, rh[r] - 1);
    idx = cy * 40 + cx;
    IF (tmap[idx] == 1 AND titem[idx] == 0 AND mon_at(cx, cy) < 0 AND NOT (cx == px AND cy == py))
      RETURN idx;
    END
  END
  RETURN -1;
END

FUNCTION add_monster(r);
PRIVATE idx, kind, maxk;
BEGIN
  idx = free_cell(r);
  IF (idx < 0 OR mcount > 15) RETURN 0; END
  maxk = (depth + 1) / 2;                 // deeper floors unlock tougher kinds
  IF (maxk > 3) maxk = 3; END
  kind = rand(0, maxk);
  IF (depth >= 6 AND kind == 0) kind = rand(1, 3); END
  mx[mcount] = idx % 40; my[mcount] = idx / 40;
  mkind[mcount] = kind;
  SWITCH (kind)
    CASE 0 mhp[mcount] = 3;  matk[mcount] = 1;
    CASE 1 mhp[mcount] = 6;  matk[mcount] = 2;
    CASE 2 mhp[mcount] = 10; matk[mcount] = 3;
    DEFAULT mhp[mcount] = 14; matk[mcount] = 5;
  END
  mhp[mcount] += (depth - 1) * 2;          // scale with depth
  matk[mcount] += (depth - 1) / 3;
  mmax[mcount] = mhp[mcount];
  mawake[mcount] = 0; mhit[mcount] = 0;
  mob(mcount);
  mcount++;
  RETURN 1;
END

FUNCTION add_item(r, kind);
PRIVATE idx;
BEGIN
  idx = free_cell(r);
  IF (idx < 0) RETURN 0; END
  titem[idx] = kind; pickup(idx, kind);
  RETURN 1;
END

FUNCTION new_floor();
PRIVATE i, j, w, h, ax, ay, ok, tries, n;
BEGIN
  signal(TYPE mob, s_kill);
  signal(TYPE pickup, s_kill);
  mcount = 0;
  REPEAT
    FOR i = 0 TO 1039 tmap[i] = 0; tseen[i] = 0; tvis[i] = 0; titem[i] = 0; END
    rooms = 0; tries = 0;
    WHILE (rooms < 10 AND tries < 70)
      tries++;
      w = rand(4, 9); h = rand(3, 6);
      ax = rand(1, 38 - w); ay = rand(1, 24 - h);
      ok = 1; i = 0;
      WHILE (i < rooms AND ok)   // keep a one-tile wall between rooms
        IF (ax <= rx[i] + rw[i] AND rx[i] <= ax + w AND ay <= ry[i] + rh[i] AND ry[i] <= ay + h) ok = 0; END
        i++;
      END
      IF (ok)
        FOR j = ay TO ay + h - 1 FOR i = ax TO ax + w - 1 tmap[j * 40 + i] = 1; END END
        rx[rooms] = ax; ry[rooms] = ay; rw[rooms] = w; rh[rooms] = h;
        IF (rooms > 0)   // L-shaped corridor from the previous room's centre
          i = rx[rooms - 1] + rw[rooms - 1] / 2; j = ry[rooms - 1] + rh[rooms - 1] / 2;
          IF (rand(0, 1))
            hcorr(i, ax + w / 2, j); vcorr(j, ay + h / 2, ax + w / 2);
          ELSE
            vcorr(j, ay + h / 2, i); hcorr(i, ax + w / 2, ay + h / 2);
          END
        END
        rooms++;
      END
    END
  UNTIL (rooms >= 5);

  // player in the first room, stairs in the last, key somewhere between
  px = rx[0] + rw[0] / 2; py = ry[0] + rh[0] / 2;
  tmap[(ry[rooms - 1] + rh[rooms - 1] / 2) * 40 + rx[rooms - 1] + rw[rooms - 1] / 2] = 2;
  i = 0;   // the key must exist: retry in other rooms until it is placed
  WHILE (add_item(rand(1, rooms - 1), 1) == 0 AND i < 50) i++; END
  n = rand(1, 2); FOR i = 1 TO n add_item(rand(1, rooms - 1), 2); END
  n = rand(2, 4); FOR i = 1 TO n add_item(rand(0, rooms - 1), 3); END
  n = 3 + depth; IF (n > 14) n = 14; END
  FOR i = 1 TO n add_monster(rand(1, rooms - 1)); END
  has_key = 0;
  RETURN 0;
END

// ---------------------------------------------------------------- field of view
// Bresenham walk from (x0,y0) to (x1,y1): 0 if a wall is in between.
FUNCTION los(x0, y0, x1, y1);
PRIVATE dx, dy, sx, sy, err, e2;
BEGIN
  dx = abs(x1 - x0); dy = -abs(y1 - y0);
  sx = sign(x1 - x0); sy = sign(y1 - y0);
  err = dx + dy;
  LOOP
    IF (x0 == x1 AND y0 == y1) RETURN 1; END
    e2 = err * 2;
    IF (e2 >= dy) err += dy; x0 += sx; END
    IF (e2 <= dx) err += dx; y0 += sy; END
    IF (x0 == x1 AND y0 == y1) RETURN 1; END
    IF (tmap[y0 * 40 + x0] == 0) RETURN 0; END
  END
END

// Tiles within radius 7 and in line of sight become visible (and seen).
FUNCTION compute_fov();
PRIVATE i, j, x0, x1, y0, y1, idx;
BEGIN
  FOR i = 0 TO 1039 tvis[i] = 0; END
  x0 = clamp(px - 7, 0, 39); x1 = clamp(px + 7, 0, 39);
  y0 = clamp(py - 7, 0, 25); y1 = clamp(py + 7, 0, 25);
  FOR j = y0 TO y1
    FOR i = x0 TO x1
      IF ((i - px) * (i - px) + (j - py) * (j - py) <= 52)
        IF (los(px, py, i, j)) idx = j * 40 + i; tvis[idx] = 1; tseen[idx] = 1; END
      END
    END
  END
  dirty = 1;
  RETURN 0;
END

// Repaint the whole map graphic: lit tiles fade with distance (torch),
// remembered tiles are dim, unknown tiles stay black.
FUNCTION redraw_map();
PRIVATE i, j, idx, t, sx, sy, f, d;
BEGIN
  gfx_fill(g_map, 0, 0, 0);
  idx = 0;
  FOR j = 0 TO 25
    FOR i = 0 TO 39
      IF (tseen[idx])
        t = tmap[idx]; sx = i * 16; sy = j * 16;
        IF (tvis[idx])
          d = (i - px) * (i - px) + (j - py) * (j - py);
          f = 100 - d;                        // 100 near the hero, ~50 at the edge
          IF (t == 0)
            gfx_rect(g_map, sx, sy, 16, 16, 96 * f / 100, 80 * f / 100, 64 * f / 100);
            gfx_rect(g_map, sx, sy, 16, 3, 140 * f / 100, 118 * f / 100, 92 * f / 100);
          ELSE
            gfx_rect(g_map, sx, sy, 15, 15, 92 * f / 100, 84 * f / 100, 108 * f / 100);
          END
        ELSE
          IF (t == 0) gfx_rect(g_map, sx, sy, 16, 16, 34, 30, 30);
          ELSE gfx_rect(g_map, sx, sy, 15, 15, 24, 24, 34); END
        END
        IF (t == 2)   // stairs: steps drawn over the floor
          gfx_rect(g_map, sx + 1, sy + 1, 13, 13, 90, 80, 50);
          FOR f = 0 TO 3 gfx_rect(g_map, sx + 2, sy + 2 + f * 3, 11 - f * 2, 1, 230, 200, 120); END
        END
      END
      idx++;
    END
  END
  RETURN 0;
END

// ---------------------------------------------------------------- turns
// Index of the living monster on tile (tx,ty), or -1.
FUNCTION mon_at(tx, ty);
PRIVATE i;
BEGIN
  i = 0;
  WHILE (i < mcount)
    IF (mhp[i] > 0 AND mx[i] == tx AND my[i] == ty) RETURN i; END
    i++;
  END
  RETURN -1;
END

FUNCTION can_enter(tx, ty);
BEGIN
  IF (tmap[ty * 40 + tx] == 0 OR (tx == px AND ty == py) OR mon_at(tx, ty) >= 0) RETURN 0; END
  RETURN 1;
END

// Greedy step toward (tx,ty): try the longer axis first, then the other.
FUNCTION step_toward(i, tx, ty);
PRIVATE dx, dy;
BEGIN
  dx = sign(tx - mx[i]); dy = sign(ty - my[i]);
  IF (abs(tx - mx[i]) >= abs(ty - my[i]))
    IF (dx != 0 AND can_enter(mx[i] + dx, my[i])) mx[i] += dx; RETURN 1; END
    IF (dy != 0 AND can_enter(mx[i], my[i] + dy)) my[i] += dy; RETURN 1; END
  ELSE
    IF (dy != 0 AND can_enter(mx[i], my[i] + dy)) my[i] += dy; RETURN 1; END
    IF (dx != 0 AND can_enter(mx[i] + dx, my[i])) mx[i] += dx; RETURN 1; END
  END
  RETURN 0;
END

FUNCTION monsters_act();
PRIVATE i, dmg;
BEGIN
  i = 0;
  WHILE (i < mcount AND hp > 0)
    IF (mhp[i] > 0)
      IF (tvis[my[i] * 40 + mx[i]])      // it sees you: remember where you are
        mawake[i] = 1; mtx[i] = px; mty[i] = py;
      END
      IF (mawake[i])
        IF (abs(px - mx[i]) + abs(py - my[i]) == 1)
          dmg = matk[i] + rand(0, 1);
          hp -= dmg; phit = 10;
          say("The " + mname(mkind[i]) + " hits you for " + dmg + ".");
          IF (hp <= 0) say("You were slain by a " + mname(mkind[i]) + " on depth " + depth + "."); END
        ELSE
          IF (step_toward(i, mtx[i], mty[i]) == 0 AND mx[i] == mtx[i] AND my[i] == mty[i])
            mawake[i] = 0;               // lost track of you
          END
        END
      END
    END
    i++;
  END
  RETURN 0;
END

FUNCTION attack(i);
PRIVATE dmg;
BEGIN
  dmg = atk + rand(0, 2);
  mhp[i] -= dmg; mhit[i] = 10; mawake[i] = 1; mtx[i] = px; mty[i] = py;
  IF (mhp[i] > 0)
    say("You hit the " + mname(mkind[i]) + " for " + dmg + ".");
  ELSE
    kills++; xp += mkind[i] + 1 + depth / 2;
    say("You slay the " + mname(mkind[i]) + "!");
    IF (xp >= lvl * 6)                   // level up
      xp -= lvl * 6; lvl++; maxhp += 5; atk++; hp = clamp(hp + 8, 0, maxhp);
      say("You feel stronger! Level " + lvl + ".");
    END
  END
  RETURN 0;
END

// One player turn: dx,dy is the move (0,0 waits). Returns 1 if a turn passed.
FUNCTION player_turn(dx, dy);
PRIVATE tx, ty, idx, m, amt;
BEGIN
  tx = px + dx; ty = py + dy; idx = ty * 40 + tx;
  m = mon_at(tx, ty);
  IF (m >= 0 AND (dx != 0 OR dy != 0))
    attack(m);
  ELSE
    IF (tmap[idx] == 0) RETURN 0; END      // bumping a wall costs nothing
    px = tx; py = ty;
    SWITCH (titem[idx])
      CASE 1 has_key = 1; say("You pick up the key. Find the stairs!");
      CASE 2 amt = 10 + depth; hp = clamp(hp + amt, 0, maxhp); say("You drink a potion (+" + amt + " HP).");
      CASE 3 amt = rand(5, 10) * depth; gold += amt; say("You find " + amt + " gold.");
    END
    titem[idx] = 0;
    IF (tmap[idx] == 2 AND (dx != 0 OR dy != 0))
      IF (has_key)
        depth++; hp = clamp(hp + 4, 0, maxhp);
        new_floor();
        say("You descend to depth " + depth + ".");
        RETURN 2;                          // new floor: FOV is done next frame
      END
      say("The stairs are sealed. You need the key.");
    END
  END
  turns++;
  monsters_act();
  compute_fov();
  RETURN 1;
END

// ---------------------------------------------------------------- processes
PROCESS map_view();
BEGIN
  graph = g_map; x = 320; y = 208; z = 100;
  LOOP
    IF (dirty) dirty = 0; redraw_map(); END   // repaint only after a change
    FRAME;
  END
END

PROCESS hero();
PRIVATE tx, ty;
BEGIN
  graph = g_hero; x = px * 16 + 8; y = py * 16 + 8;
  LOOP
    tx = px * 16 + 8; ty = py * 16 + 8;     // glide to the logical tile
    IF (abs(tx - x) > 16 OR abs(ty - y) > 16) x = tx; y = ty; END
    IF (abs(tx - x) <= 2) x = tx; ELSE x += (tx - x) / 2; END
    IF (abs(ty - y) <= 2) y = ty; ELSE y += (ty - y) / 2; END
    IF (phit > 0) phit--; green = 90; blue = 90; ELSE green = 255; blue = 255; END
    FRAME;
  END
END

PROCESS mob(i);
PRIVATE tx, ty;
BEGIN
  x = mx[i] * 16 + 8; y = my[i] * 16 + 8;
  LOOP
    IF (mhp[i] <= 0 AND mhit[i] <= 0) BREAK; END
    tx = mx[i] * 16 + 8; ty = my[i] * 16 + 8;
    IF (abs(tx - x) <= 2) x = tx; ELSE x += (tx - x) / 2; END
    IF (abs(ty - y) <= 2) y = ty; ELSE y += (ty - y) / 2; END
    IF (tvis[my[i] * 40 + mx[i]]) graph = g_mon[mkind[i]]; ELSE graph = 0; END
    IF (mhit[i] > 0)                  // flash red when hit, fade out on death
      mhit[i]--; green = 60; blue = 60;
      IF (mhp[i] <= 0) alpha = mhit[i] * 10; END
    ELSE
      green = 255; blue = 255;
    END
    IF (graph AND mhp[i] > 0 AND mhp[i] < mmax[i])   // small health bar
      draw_rect(x - 7, y - 11, 14, 2, '#400');
      draw_rect(x - 7, y - 11, 14 * mhp[i] / mmax[i], 2, '#e33');
    END
    FRAME;
  END
END

PROCESS pickup(idx, kind);
BEGIN
  x = (idx % 40) * 16 + 8; y = (idx / 40) * 16 + 8; z = 10;
  LOOP
    IF (titem[idx] == 0) BREAK; END
    IF (tseen[idx])        // items are remembered in the fog, dimmed
      SWITCH (kind) CASE 1 graph = g_key; CASE 2 graph = g_potion; DEFAULT graph = g_gold; END
      IF (tvis[idx]) alpha = 100; ELSE alpha = 40; END
    ELSE
      graph = 0;
    END
    FRAME;
  END
END

// ---------------------------------------------------------------- main
PROCESS start_run();
BEGIN
  hp = 20; maxhp = 20; atk = 3; lvl = 1; xp = 0; depth = 1; gold = 0;
  kills = 0; turns = 0; phit = 0;
  msg0 = ""; msg1 = ""; msg2 = "";
  new_floor();
  say("Depth 1. Find the key, then the stairs down.");
  FRAME;
  compute_fov();
END

PRIVATE dx, dy, r, hpcol;
BEGIN
  set_mode(640, 480);
  set_fps(60, 0);
  screen_color('#000');
  make_graphics();
  map_view();
  graph = g_title; x = 320; y = 240; z = -100;

  LOOP
    SWITCH (state)
      CASE 0   // title
        IF (key_pressed(_space) OR key_pressed(_enter))
          state = 1; graph = 0;
          start_run(); hero();
        END
      CASE 1   // playing: one tile per key press, then the world acts
        dx = 0; dy = 0;
        IF (key_pressed(_left) OR key_pressed(_a)) dx = -1; END
        IF (key_pressed(_right) OR key_pressed(_d)) dx = 1; END
        IF (key_pressed(_up) OR key_pressed(_w)) dy = -1; END
        IF (key_pressed(_down) OR key_pressed(_s)) dy = 1; END
        IF (dx != 0) dy = 0; END
        IF (dx != 0 OR dy != 0 OR key_pressed(_space))
          r = player_turn(dx, dy);
          IF (r == 2) FRAME; compute_fov(); END
          IF (hp <= 0) hp = 0; state = 2; graph = g_dead; END
        END
      CASE 2   // dead
        IF (key_pressed(_space))
          state = 1; graph = 0;
          start_run();
        END
    END

    IF (state >= 1)   // HUD, drawn every frame with text()
      draw_rect(0, 416, 640, 64, '#0d0f16');
      draw_rect(0, 416, 640, 1, '#2a2e3c');
      draw_rect(8, 422, 100, 8, '#3a1216');
      hpcol = '#d33'; IF (hp * 3 > maxhp) hpcol = '#e8a33a'; END
      IF (hp * 3 > maxhp * 2) hpcol = '#4c4'; END
      draw_rect(8, 422, 100 * hp / maxhp, 8, hpcol);
      set_color('#fff');
      text(114, 422, "HP " + hp + "/" + maxhp);
      set_color('#cfd6e6');
      text(200, 422, "ATK " + atk + "  LVL " + lvl + " (" + xp + "/" + lvl * 6 + ")");
      set_color('#ffcf5a');
      text(360, 422, "DEPTH " + depth + "   GOLD " + gold);
      IF (has_key) set_color('#ffe066'); text(540, 422, "[KEY]"); ELSE set_color('#555a66'); text(540, 422, "no key"); END
      set_color('#6b7080'); text(8, 438, msg0);
      set_color('#a0a6b8'); text(8, 450, msg1);
      set_color('#ffffff'); text(8, 462, msg2);
    END
    IF (state == 2)
      set_color('#ffcf5a');
      text(248, 220, "Reached depth " + depth);
      set_color('#cfd6e6');
      text(248, 240, "Level " + lvl + ", " + kills + " kills");
      text(248, 256, gold + " gold, " + turns + " turns");
    END
    FRAME;
  END
END
