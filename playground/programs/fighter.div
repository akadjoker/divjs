   -40, 0,  88,   0,-10,   60, 20,  120, 10,   30, 60,   10, 10, 0,  // 27 on the floor
     0, 0,   0,  50, 25,    5,  5,    5,  5,    3,  0,   -3,  0, 0,  // 28 bow
     0, 0,   0,   0,  0,   12, 10,   -8, 10,    6,  0,   -6,  0, 0,  // 29 at ease
     0, 0,   0,  -3, -5,    5, 10,  150,  5,    6,  0,   -6,  0, 0,  // 30 (unused)
     0, 0,   0,   5,  0,   95,  5,   90,  0,    8,  0,   -8,  0, 0,  // 31 (unused)
     0, 0,   0,  -5,-12,   20,110,  170,  5,   10,  0,  -10,  0, 0,  // 32 victory
     0, 0,   0,  -5,  0,   60, 70,  200, 30,   30, 25,  -25,  5, 0,  // 33 (unused)
     6, 0,   0,  35, 10,   20, 60,   80,  0,   45, 55,  -30, 10, 0,  // 34 (unused)
     0, 0,   0,   0,  0,   50, 80,   90,  0,   28, 24,  -18,  0, 0,  // 35 (unused)
     0, 0,   0,  18, -8,   85, 95,   72, 95,   95,105,   25,115, 0,  // 36 crouch block
     4, 0,   0,   5,  0,   97,  0,   30,120,   30, 26,  -20,  2, 0,  // 37 jab
     8, 0,   0,  10, -3,   40,100,  100,  0,   40, 35,  -30,  0, 0,  // 38 straight
     6, 0,   0, -12,-10,   20, 60,  148, 20,   70, 80,  -15,  5, 0,  // 39 uppercut
     4, 0,   0,  18, -4,  105,  0,   60,110,   95,105,   25,115, 0,  // 40 crouch jab
     8, 0,   0,   8, -8,   30, 90,  132, 30,   95,105,   25,115, 0,  // 41 crouch uppercut
     4, 0,   0,  20,  0,   80, 90,   60,100,   72,  0,   25,115, 0,  // 42 crouch short kick
     0, 0,   0,  10,  0,   80,  0,   40,110,   80,120,   40,110, 0,  // 43 jump punch
     0, 0,   0, -15,  5,  100, 60,   30,100,   55,  0,   60,120, 0,  // 44 jump kick
     8, 0,   0,  12,  5,  100,  0,   96,  0,   45, 35,  -32,  0, 0,  // 45 fireball push
    -4, 0,   0,  -5, -5,  -20,100,  -30,100,   35, 30,  -25,  5, 0,  // 46 fireball chamber
     0,20,   0,  -5,  0,   60, 30,  -40, 20,   92,  0,  -10, 60, 0,  // 47 spin kick, front
     0,20,   0,  -5,  0,  -40, 20,   60, 30,  -85,  0,  -10, 60, 1,  // 48 spin kick, back
     6, 0,   0, -12,  5,  110, 40,   90, 60,  110,140,  -20,  0, 0,  // 49 knee
     0, 0,  50,   0, 10,   30, 20,  -10, 30,   90,  0,   10, 40, 0,  // 50 flash kick
     0, 0,   0,   0,  0,   92,  0,  -88,  0,   30, 20,  -30, 10, 0,  // 51 lariat A
     0, 0,   0,   0,  0,  -88,  0,   92,  0,   30, 20,  -30, 10, 1,  // 52 lariat B
    10, 0,   0,  20,  5,   95, 25,  100, 20,   40, 35,  -30,  0, 0,  // 53 grab
    -4, 0,   0, -25,-10,  200, 10,  195, 10,   30, 30,  -30,  5, 0,  // 54 lift overhead
     6, 0,   0,  25, 25,  -30, 30,  -20, 40,   45, 35,  -30,  0, 0,  // 55 fire breath
