PROGRAM fighter;

// ---------------------------------------------------------------------
// STREET DUEL - a one-on-one versus fighting game in the style of Street
// Fighter II, with a touch of Pit-Fighter (a warehouse pit where the
// cheering crowd throws bottles, crates and food into the ring).
//
// * Articulated fighters (the skeleton of karate.div): 14 joints placed
//   by forward kinematics from a pose table, blended with smoothstep,
//   drawn as rotated capsule sprites. Every character has its own limb
//   lengths, thickness, scale, colours, speed, weight and move set.
// * Hits are tested against the real body: the striking fist, foot or
//   knee against the defender's head, torso and legs (hurtboxes follow
//   the pose, so a high punch whiffs over a crouching fighter).
// * Frame data per move (startup / active / recovery keys), hitstun and
//   blockstun, chip damage, pushback, hit stop, juggles, combo counter,
//   stun meter (dizzy), super meter, throws, motion inputs read from a
//   48-frame input buffer relative to the facing direction.
// * 99-second rounds, best of three, arcade ladder with rising CPU
//   difficulty and a final boss; two-player versus.
// * No asset files: stages, fighters, portraits and texts are drawn in
//   code at start-up (spread over frames).
// ---------------------------------------------------------------------

GLOBAL
  // --- World -----------------------------------------------------------
  SW = 1100;                  // stage width (the camera scrolls over it)
  GY = 376;                   // ground line on screen
  GRAV = 0.52;                // gravity (pixels per frame per frame)
  NP = 14;                    // values per pose
  NM = 58;                    // number of moves
  MAXSEP = 540;               // fighters can not be further apart
  L_FT = 11; L_NECK = 13;

  // --- Fighter states --------------------------------------------------
  ST_FREE = 0; ST_PREJ = 1; ST_AIR = 2; ST_LAND = 3; ST_ATK = 4; ST_AATK = 5;
  ST_HIT = 6; ST_BLOCK = 7; ST_FALL = 8; ST_DOWN = 9; ST_GETUP = 10;
  ST_THROWN = 11; ST_DIZZY = 12; ST_KO = 13; ST_POSE = 14;

  // --- Pose library ------------------------------------------------------
  // Per pose: dx, lift, rot, lean, head, shoulderA, elbowA, shoulderB,
  // elbowB, hipA, kneeA, hipB, kneeB, turn. Degrees, for a fighter facing
  // right: 0 = down, 90 = forward, 180 = up. A = lead (far) side, B = rear
  // (near) side. rot turns the whole body; lift raises it; turn > 0.5
  // shows the back. Poses 0-35 come from karate.div.
  pose[881] =
     0, 0,   0,   5,  0,   50, 80,   15,120,   28, 24,  -18,  0, 0,  // 0 stance
     0, 0,   0,   8,  3,   53, 76,   18,116,   30, 28,  -19,  2, 0,  // 1 stance (breathe)
     0, 0,   0,   5,  0,   48, 82,   18,118,   36, 12,  -26, 22, 0,  // 2 walk 1
     0, 0,   0,   5,  0,   52, 78,   12,122,   10, 30,   -8,  4, 0,  // 3 walk 2
     0, 0,   0,  18, -8,   55, 85,   25,115,   95,105,   25,115, 0,  // 4 crouch
    -2, 0,   0,  -3, -5,   72, 95,   60, 95,   30, 22,  -22,  4, 0,  // 5 block
     0, 0,   0,  14,  6,   38,  5,   25,115,   36, 30,  -26,  4, 0,  // 6 (unused)
    -3, 0,   0,   0,  0,   60, 70,   -5,135,   28, 24,  -18,  0, 0,  // 7 punch chamber
    14, 0,   0,  12, -5,   20,110,  124,  0,   50, 45,  -35,  0, 0,  // 8 lunge punch
     0, 0,   0,  -8,  0,   55, 80,   20,115,   95,125,   -5,  8, 0,  // 9 kick chamber
     6, 0,   0, -15,  5,   50, 90,   20,120,   88,  0,   -4,  6, 0,  // 10 front kick
    10, 0,   0, -24, 12,   95, 60,  -25, 50,  128,  0,   -8,  4, 0,  // 11 high kick
    10, 0,   0,   2,  0,   50, 80,   20,120,   55,  0,  -12, 22, 0,  // 12 low kick
     6, 0,   0,  25,-10,   70, 30,   40, 60,   78,  0,   95, 95, 0,  // 13 low sweep kick
    16, 0,   0, -25, 10,   60, 90,   10,100,   95,  0,   20,115, 0,  // 14 flying kick
     0, 0,   0,   5,  0,   80, 80,   40,110,   70,120,   35,110, 0,  // 15 jump (tucked)
     0, 0,   0, -10,  0,   55, 80,   20,115,   -5,  8,   85,125, 0,  // 16 roundhouse chamber
    10, 0,   0, -28, 15,  100, 30,  -30, 40,  -10,  4,  120,  8, 1,  // 17 roundhouse
    -4, 0,   0, -20, 10,   45, 95,   30,100,    0,  6,   75,130, 1,  // 18 back kick chamber
     6, 0,   0, -50, 25,   40,100,   80, 80,    5,  8,   92,  0, 1,  // 19 back kick
     8, 0,   0,  25,-10,   40,100,   95,  0,   95,105,   25,115, 0,  // 20 crouch punch
     0, 0,-120,  30, 10,  100,100,  100,100,  130,150,  120,150, 0,  // 21 roll forward 1
     0, 0,-240,  30, 10,  100,100,  100,100,  130,150,  120,150, 0,  // 22 roll forward 2
     0, 0, 120,  30, 10,  100,100,  100,100,  130,150,  120,150, 0,  // 23 roll back 1
     0, 0, 240,  30, 10,  100,100,  100,100,  130,150,  120,150, 0,  // 24 roll back 2
    -8, 0,   8, -25,-25,  100, 20,   60, 30,   35, 10,  -25, 25, 0,  // 25 hit to the head
