  ch_end[4] = "KENJI LEAVES THE PIT AND WALKS ON, LOOKING FOR THE NEXT FIGHT.",
    "LENA TAKES THE BELT BACK TO HER GYM IN BANGKOK.", "BRUTUS BUYS THE WAREHOUSE. THE PIT IS HIS NOW.",
    "ZALA RETURNS TO THE MOUNTAIN, AT PEACE.", "THE SHADOW RULES THE STREETS.";
