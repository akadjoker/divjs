  ch_fa[4] = 21, 20, 22, 33, 22;               // forearm
  ch_tor[4] = 40, 38, 47, 40, 43;              // torso
  ch_thk[4] = 100, 86, 145, 80, 112;           // limb thickness %
  ch_hp[4] = 1000, 900, 1200, 950, 1300;
  ch_pow[4] = 100, 88, 124, 94, 115;           // damage dealt %
  ch_def[4] = 100, 108, 84, 104, 90;           // damage taken %
  ch_tempo[4] = 100, 84, 118, 106, 94;         // animation length %
  ch_walk[4] = 2.3, 3.0, 1.6, 1.9, 2.4;
  ch_jvx[4] = 3.3, 3.9, 2.6, 3.0, 3.4;
