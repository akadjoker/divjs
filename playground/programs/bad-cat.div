PROGRAM bad_cat;

// BAD CAT - you are a cat, and the shelves are full of things that belong
// on the floor. Run, jump from furniture to furniture and paw cups,
// plates, vases, plants, books and the goldfish bowl over the edge while
// the owner is not looking. Everything that can fall is a rigid body of
// the engine's physics (phys_*): a hard landing (phys_impact) breaks it
// into shards and makes mess. Enough mess wrecks the room: next level, a
// new room, more things on the shelves and a more alert owner.
//
// The owner comes in now and then. First footsteps and a shadow under the
// door, a second later the door opens: be hiding (under the table, behind
// the sofa) or sitting innocently by then - and not next to something
// that is falling or breaking - or you get a strike. Three strikes and
// you spend the night out on the balcony.
//
// The cat is not a physics body: a scripted platformer character (coyote
// time, jump buffer, variable jump height, one-way furniture tops) feels
// better, and it moves things with phys_velocity / phys_impulse.
// Everything is drawn in code, and every sound and both songs are made by
// the engine (sfx, sfx_tone, song_new, song_track).

GLOBAL
  // ---- screen and room geometry
  SW = 640; SH = 480;
  FLOOR = 440;                 // the floor's surface
  DOOR_X1 = 568; DOOR_X2 = 626; DOOR_TOP = 250;
  // furniture kinds
  K_TABLE = 0; K_SOFA = 1; K_BOOKCASE = 2; K_COUNTER = 3; K_SHELF = 4;
  // object kinds
  O_CUP = 0; O_PLATE = 1; O_VASE = 2; O_PLANT = 3; O_BOOK = 4; O_BOWL = 5; O_GLASS = 6;

  // ---- cat movement (pixels per frame)
  RUN = 3.4; ACC_G = 0.6; ACC_A = 0.38;
  GRAV = 0.55; GRAV_CUT = 1.35; GRAV_APEX = 0.32; MAXFALL = 11;
  JUMP_V = 11.6; COYOTE = 7; BUFFER = 7;

  // ---- game state
  state = 0;          // 0 title, 1 playing, 2 room wrecked, 3 balcony (game over)
  level = 1; score = 0; mess = 0; target = 0; total_value = 0;
  strikes = 0; frame_no = 0; clear_t = 0; over_t = 0; restart = 0;
  banner_t = 0; banner_s = ""; banner_c = "#ffffff"; banner_w = 0;

  // ---- layout (made by gen_layout)
  nf = 0; f_kind[7]; f_x[7]; f_w[7]; f_top[7];
  npl = 0; pl_x1[23]; pl_x2[23]; pl_y[23]; pl_f[23]; pl_hide[23];
  n_ht = 0; ht_x1[3]; ht_x2[3];             // under-table hiding zones
  sofa_x1 = -1; sofa_x2 = -1;                // soft cushions: nothing breaks there
  win_x = 0; win_y = 0; win_w = 0; win_h = 0; night = 0;
  n_it = 0; it_k[39]; it_x[39]; it_y[39]; it_v[39];
  order[3];
  pal = 0;

  // ---- the cat, as the others see it
  cat_x = 300; cat_y = 440; cat_vx = 0.0; cat_mode = 0;  // mode 0 free, 1 sitting, 2 hidden
  cat_face = 1;
  // ---- the swipe (the objects read it)
  sw_serial = 0; sw_on = 0; sw_x1 = 0; sw_x2 = 0; sw_y1 = 0; sw_y2 = 0; sw_dir = 1;

  // ---- the owner
  own_st = 0; own_look = 0; red_t = -999;   // last frame something fell/broke next to the cat
  n_shards = 0;
  high_seen = 0;       // last frame something breakable was still up high
  all_down = 0;        // 1: the room ended because nothing was left up high

  // ---- statistics (read by the tests, shown on the balcony)
  st_broken = 0; st_thuds = 0; st_swipes = 0; st_visits = 0; st_strikes = 0;
  st_safe = 0; st_rooms = 0; st_maximp = 0; st_fish = 0; n_obj = 0; bodies = 0;

  // ---- graphics
  g_room = 0; g_balcony = 0; g_cat[9]; g_owner[2]; g_qm = 0; g_door = 0; g_door_open = 0;
  g_cup[2]; g_plate = 0; g_vase[2]; g_plant = 0; g_book[5]; g_bowl = 0; g_glass = 0;
  g_shard[7]; g_fish = 0; g_puddle = 0; g_soil = 0;
  g_title = 0; g_clear = 0; g_over = 0; g_panel = 0;
  lvl_g[15]; n_lvl_g = 0;                   // this room's furniture graphics

  // ---- sounds
  s_meow_a[3]; s_meow_b[3]; s_crash[3]; s_hit[3]; s_glass[2]; s_tink = 0; s_splash = 0;
  s_thud = 0; s_whoosh = 0; s_jump = 0; s_land = 0; s_step = 0; s_creak = 0; s_creak2 = 0;
  s_huh = 0; s_huh2 = 0; s_buzz = 0; s_good = 0; s_clear = 0; s_over = 0; s_flop = 0; s_yum = 0;
  song_main = 0; song_owner = 0;

// =====================================================================
// Drawing helpers
// =====================================================================

// Filled ellipse, one row at a time (a / b of whole numbers truncates, so
// the square root is scaled by a divisor with a fraction).
FUNCTION ell(g, cx, cy, rx, ry, r, gg, b);
PRIVATE dy, half;
BEGIN
  FOR dy = -ry TO ry
    half = rx * sqrt(ry * ry - dy * dy) / (ry + 0.0001);
    gfx_rect(g, cx - half, cy + dy, half * 2 + 1, 1, r, gg, b);
  END
  RETURN 0;
END

// Filled triangle: lines from the first corner to points along the
// opposite side.
FUNCTION tri(g, x1, y1, x2, y2, x3, y3, r, gg, b);
PRIVATE i, n;
BEGIN
  n = abs(x3 - x2) + abs(y3 - y2) + 1;
  n = n * 2;
  FOR i = 0 TO n
    gfx_line(g, x1, y1, x2 + (x3 - x2) * i / (n + 0.0001), y2 + (y3 - y2) * i / (n + 0.0001), r, gg, b);
  END
  RETURN 0;
END

// Rectangle with rounded corners.
FUNCTION rrect(g, x, y, w, h, rad, r, gg, b);
BEGIN
  gfx_rect(g, x + rad, y, w - rad * 2, h, r, gg, b);
  gfx_rect(g, x, y + rad, w, h - rad * 2, r, gg, b);
  gfx_circle(g, x + rad, y + rad, rad, r, gg, b);
  gfx_circle(g, x + w - rad - 1, y + rad, rad, r, gg, b);
  gfx_circle(g, x + rad, y + h - rad - 1, rad, r, gg, b);
  gfx_circle(g, x + w - rad - 1, y + h - rad - 1, rad, r, gg, b);
  RETURN 0;
END

// Big text with a dark shadow, on its own graphic.
FUNCTION big_text(w, h, s, r, gg, b, sz);
PRIVATE g;
BEGIN
  g = new_graphic(w, h);
  gfx_text(g, 3, 3, s, 40, 20, 20, sz);
  gfx_text(g, 0, 0, s, r, gg, b, sz);
  RETURN g;
END

// A graphic made for the current room, freed when the room changes.
FUNCTION lvl_graphic(w, h);
PRIVATE g;
BEGIN
  g = new_graphic(w, h);
  IF (n_lvl_g < 16) lvl_g[n_lvl_g] = g; n_lvl_g++; END
  RETURN g;
END

// =====================================================================
// The cat (48x34, drawn facing right; control point at its feet)
// =====================================================================

FUNCTION cat_head(g, hx, hy, r, gg, b);
BEGIN
  tri(g, hx - 7, hy - 3, hx - 5, hy - 12, hx - 1, hy - 6, r, gg, b);      // ears
  tri(g, hx + 1, hy - 6, hx + 5, hy - 12, hx + 7, hy - 2, r, gg, b);
  tri(g, hx - 5, hy - 5, hx - 4, hy - 9, hx - 2, hy - 6, 240, 150, 150);
  tri(g, hx + 2, hy - 6, hx + 4, hy - 9, hx + 5, hy - 4, 240, 150, 150);
  gfx_circle(g, hx, hy, 8, r, gg, b);
  RETURN 0;
END

// Side-view cat. pose: 0 stand, 1 run a, 2 run b, 3 jump, 4 swipe
FUNCTION cat_side(pose);
PRIVATE g, t, tx, ty, lg, i;
BEGIN
  g = new_graphic(48, 34);
  // tail: a curve of dots, up for most poses, streaming back when jumping
  FOR t = 0 TO 10
    IF (pose == 3) tx = 10 - t; ty = 20 - t / 3;
    ELSE tx = 10 - t * 0.6; ty = 21 - t * 1.6 + t * t * 0.05; END
    gfx_circle(g, tx, ty, 2, 225, 135, 50);
  END
  // legs (back pair, front pair); the feet reach row 33
  lg = 225;
  IF (pose == 0 OR pose == 4)
    gfx_rect(g, 13, 25, 4, 9, 215, 125, 45); gfx_rect(g, 18, 25, 4, 9, lg, 135, 50);
    gfx_rect(g, 28, 25, 4, 9, 215, 125, 45); gfx_rect(g, 32, 25, 4, 9, lg, 135, 50);
  END
  IF (pose == 1)
    gfx_line(g, 15, 25, 9, 33, 215, 125, 45); gfx_line(g, 16, 25, 10, 33, 215, 125, 45);
    gfx_line(g, 19, 25, 22, 33, 225, 135, 50); gfx_line(g, 20, 25, 23, 33, 225, 135, 50);
    gfx_line(g, 30, 25, 26, 33, 215, 125, 45); gfx_line(g, 31, 25, 27, 33, 215, 125, 45);
    gfx_line(g, 33, 25, 38, 33, 225, 135, 50); gfx_line(g, 34, 25, 39, 33, 225, 135, 50);
  END
  IF (pose == 2)
    gfx_rect(g, 15, 25, 3, 9, 215, 125, 45); gfx_rect(g, 19, 25, 3, 8, 225, 135, 50);
    gfx_rect(g, 27, 25, 3, 8, 215, 125, 45); gfx_rect(g, 31, 25, 3, 9, 225, 135, 50);
  END
  IF (pose == 3)
    FOR i = 0 TO 1
      gfx_line(g, 14 + i, 25, 4 + i, 30, 215, 125, 45);
      gfx_line(g, 18 + i, 25, 8 + i, 31, 225, 135, 50);
      gfx_line(g, 31 + i, 23, 42 + i, 27, 215, 125, 45);
      gfx_line(g, 33 + i, 24, 44 + i, 29, 225, 135, 50);
    END
  END
  // body, belly, stripes
  ell(g, 23, 21, 13, 7, 235, 150, 60);
  ell(g, 24, 25, 9, 3, 250, 222, 185);
  FOR t = 0 TO 2
    gfx_line(g, 15 + t * 5, 14, 14 + t * 5, 19, 200, 110, 40);
    gfx_line(g, 16 + t * 5, 14, 15 + t * 5, 19, 200, 110, 40);
  END
  // head
  cat_head(g, 36, 13, 235, 150, 60);
  ell(g, 39, 17, 4, 3, 250, 222, 185);
  gfx_line(g, 32, 6, 34, 9, 200, 110, 40);
  gfx_circle(g, 39, 12, 2, 110, 200, 90);                  // eye
  gfx_line(g, 39, 11, 39, 13, 20, 20, 20);
  gfx_pixel(g, 44, 15, 240, 120, 130);                     // nose
  gfx_line(g, 42, 17, 47, 16, 250, 250, 250);              // whiskers
  gfx_line(g, 42, 18, 47, 20, 250, 250, 250);
  IF (pose == 4)                                           // the swiping paw
    FOR i = 0 TO 2
      gfx_line(g, 31, 18 + i, 44, 10 + i, 225, 135, 50);
    END
    gfx_circle(g, 45, 10, 3, 250, 222, 185);
    gfx_line(g, 46, 2, 47, 8, 255, 255, 255);              // swoosh marks
    gfx_line(g, 47, 13, 46, 20, 255, 255, 255);
  END
  set_point(0, g, 0, 24, 33);
  RETURN g;
END

// Front-view sitting cat: the innocent face. mood 0 innocent, 1 blink, 2 sad
FUNCTION cat_sit(mood);
PRIVATE g;
BEGIN
  g = new_graphic(48, 34);
  ell(g, 30, 31, 12, 2, 220, 130, 45);                     // tail around the feet
  ell(g, 24, 24, 10, 9, 235, 150, 60);
  ell(g, 24, 26, 5, 6, 250, 222, 185);
  gfx_rect(g, 18, 29, 4, 5, 250, 222, 185);                // front paws
  gfx_rect(g, 26, 29, 4, 5, 250, 222, 185);
  IF (mood == 2)                                           // ears down
    tri(g, 17, 5, 11, 9, 18, 11, 235, 150, 60);
    tri(g, 31, 5, 37, 9, 30, 11, 235, 150, 60);
  ELSE
    tri(g, 15, 7, 16, -1, 22, 4, 235, 150, 60);
    tri(g, 26, 4, 32, -1, 33, 7, 235, 150, 60);
    tri(g, 17, 5, 17, 1, 20, 4, 240, 150, 150);
    tri(g, 28, 4, 31, 1, 31, 5, 240, 150, 150);
  END
  gfx_circle(g, 24, 11, 9, 235, 150, 60);
  gfx_line(g, 22, 3, 22, 6, 200, 110, 40);
  gfx_line(g, 26, 3, 26, 6, 200, 110, 40);
  ell(g, 24, 15, 5, 3, 250, 222, 185);
  IF (mood == 0)                                           // huge shiny eyes
    gfx_circle(g, 20, 10, 3, 20, 20, 30);
    gfx_circle(g, 28, 10, 3, 20, 20, 30);
    gfx_pixel(g, 19, 9, 255, 255, 255); gfx_pixel(g, 18, 10, 255, 255, 255);
    gfx_pixel(g, 27, 9, 255, 255, 255); gfx_pixel(g, 26, 10, 255, 255, 255);
  END
  IF (mood == 1)
    gfx_line(g, 18, 10, 22, 11, 20, 20, 30);
    gfx_line(g, 26, 11, 30, 10, 20, 20, 30);
  END
  IF (mood == 2)
    gfx_line(g, 18, 11, 22, 10, 20, 20, 30);
    gfx_line(g, 26, 10, 30, 11, 20, 20, 30);
    gfx_rect(g, 17, 13, 1, 3, 120, 170, 255);              // a tear
  END
  gfx_pixel(g, 24, 14, 240, 120, 130);
  gfx_line(g, 22, 16, 23, 17, 90, 50, 30);                 // the little "w" mouth
  gfx_line(g, 24, 16, 25, 17, 90, 50, 30);
  gfx_line(g, 23, 17, 24, 16, 90, 50, 30);
  gfx_line(g, 25, 17, 26, 16, 90, 50, 30);
  gfx_pixel(g, 17, 14, 250, 140, 140); gfx_pixel(g, 31, 14, 250, 140, 140);
  gfx_line(g, 29, 15, 36, 14, 250, 250, 250);
  gfx_line(g, 19, 15, 12, 14, 250, 250, 250);
  set_point(0, g, 0, 24, 33);
  RETURN g;
END

// Crouching, ears flat, peeking: hiding.
FUNCTION cat_crouch();
PRIVATE g, t;
BEGIN
  g = new_graphic(48, 34);
  gfx_line(g, 2, 32, 12, 31, 225, 135, 50);
  gfx_line(g, 2, 33, 12, 32, 225, 135, 50);
  ell(g, 22, 28, 14, 5, 235, 150, 60);
  FOR t = 0 TO 2 gfx_line(g, 14 + t * 5, 24, 13 + t * 5, 27, 200, 110, 40); END
  tri(g, 30, 22, 29, 15, 35, 19, 235, 150, 60);
  tri(g, 38, 19, 43, 16, 42, 23, 235, 150, 60);
  gfx_circle(g, 37, 25, 7, 235, 150, 60);
  ell(g, 40, 28, 4, 2, 250, 222, 185);
  gfx_circle(g, 36, 23, 2, 255, 255, 255);
  gfx_circle(g, 41, 23, 2, 255, 255, 255);
  gfx_pixel(g, 37, 23, 20, 20, 20); gfx_pixel(g, 42, 23, 20, 20, 20);
  set_point(0, g, 0, 24, 33);
  RETURN g;
END

// =====================================================================
// The owner (70x200, control point at the feet) and the door
// =====================================================================

FUNCTION owner_graphic(angry);
PRIVATE g, i;
BEGIN
  g = new_graphic(70, 200);
  gfx_rect(g, 17, 190, 16, 9, 60, 45, 40);                 // shoes
  gfx_rect(g, 37, 190, 16, 9, 60, 45, 40);
  gfx_rect(g, 20, 118, 13, 74, 70, 95, 150);               // jeans
  gfx_rect(g, 37, 118, 13, 74, 70, 95, 150);
  gfx_rect(g, 20, 118, 30, 12, 70, 95, 150);
  rrect(g, 13, 56, 44, 70, 8, 190, 90, 90);                // jumper
  FOR i = 0 TO 5 gfx_line(g, 16, 64 + i * 10, 53, 64 + i * 10, 170, 75, 78); END
  IF (angry)                                               // hands on the hips
    FOR i = 0 TO 7
      gfx_line(g, 14 + i / 2, 62 + i, 2 + i / 2, 92, 190, 90, 90);
      gfx_line(g, 56 - i / 2, 62 + i, 68 - i / 2, 92, 190, 90, 90);
      gfx_line(g, 2 + i / 2, 92, 16, 110 - i, 190, 90, 90);
      gfx_line(g, 68 - i / 2, 92, 54, 110 - i, 190, 90, 90);
    END
  ELSE
    gfx_rect(g, 5, 60, 10, 52, 190, 90, 90);
    gfx_rect(g, 55, 60, 10, 46, 190, 90, 90);
    gfx_circle(g, 10, 114, 5, 240, 200, 170);
    gfx_circle(g, 60, 108, 5, 240, 200, 170);
    gfx_rect(g, 56, 94, 12, 13, 250, 250, 245);            // a mug of tea
    gfx_rect(g, 56, 94, 12, 3, 150, 90, 60);
  END
  gfx_rect(g, 30, 48, 10, 10, 240, 200, 170);              // neck
  gfx_circle(g, 35, 28, 18, 110, 70, 45);                  // hair
  ell(g, 35, 36, 14, 14, 240, 200, 170);                   // face
  gfx_rect(g, 20, 14, 30, 8, 110, 70, 45);                 // fringe
  gfx_circle(g, 21, 38, 2, 250, 170, 160);
  gfx_circle(g, 49, 38, 2, 250, 170, 160);
  IF (angry)
    gfx_circle(g, 29, 33, 3, 255, 255, 255); gfx_circle(g, 41, 33, 3, 255, 255, 255);
    gfx_circle(g, 29, 33, 1, 20, 20, 20); gfx_circle(g, 41, 33, 1, 20, 20, 20);
    gfx_line(g, 24, 26, 32, 29, 60, 40, 30); gfx_line(g, 46, 26, 38, 29, 60, 40, 30);
    ell(g, 35, 44, 4, 4, 120, 40, 40);
  ELSE
    gfx_line(g, 26, 33, 31, 33, 40, 30, 30);                // sleepy eyes
    gfx_line(g, 39, 33, 44, 33, 40, 30, 30);
    gfx_line(g, 31, 43, 39, 43, 170, 90, 80);
  END
  set_point(0, g, 0, 35, 199);
  RETURN g;
END

FUNCTION make_graphics();
PRIVATE i, g;
BEGIN
  g_cat[0] = cat_side(0); g_cat[1] = cat_side(1); g_cat[2] = cat_side(2);
  g_cat[3] = cat_side(3); g_cat[4] = cat_side(4);
  g_cat[5] = cat_sit(0); g_cat[6] = cat_sit(1); g_cat[7] = cat_crouch(); g_cat[8] = cat_sit(2);
  FRAME;
  g_owner[0] = owner_graphic(0);
  g_owner[1] = owner_graphic(1);
  g_qm = new_graphic(64, 44);
  gfx_text(g_qm, 3, 3, "?!", 60, 20, 20, 38);
  gfx_text(g_qm, 0, 0, "?!", 255, 220, 60, 38);

  // the door: closed (wooden panels) and open (seen edge-on)
  g_door = new_graphic(58, 186);
  gfx_fill(g_door, 150, 100, 62);
  gfx_rect_outline(g_door, 7, 10, 44, 70, 120, 78, 46);
  gfx_rect_outline(g_door, 7, 96, 44, 80, 120, 78, 46);
  gfx_rect_outline(g_door, 0, 0, 58, 186, 100, 64, 38);
  gfx_circle(g_door, 48, 96, 3, 230, 190, 80);
  g_door_open = new_graphic(58, 186);
  gfx_fill_rgba(g_door_open, 0, 0, 0, 0);
  gfx_rect(g_door_open, 50, 0, 8, 186, 120, 78, 46);
  gfx_rect(g_door_open, 50, 0, 2, 186, 160, 110, 70);
  FRAME;

  // things to break
  g_cup[0] = new_graphic(17, 12);
  gfx_circle_outline(g_cup[0], 13, 5, 3, 250, 250, 245);
  gfx_rect(g_cup[0], 0, 0, 12, 12, 250, 250, 245);
  gfx_rect(g_cup[0], 0, 3, 12, 3, 220, 90, 90);
  set_point(0, g_cup[0], 0, 6, 6);
  g_cup[1] = new_graphic(17, 12);
  gfx_circle_outline(g_cup[1], 13, 5, 3, 110, 170, 220);
  gfx_rect(g_cup[1], 0, 0, 12, 12, 110, 170, 220);
  gfx_rect(g_cup[1], 1, 1, 10, 2, 90, 60, 40);             // coffee
  set_point(0, g_cup[1], 0, 6, 6);
  g_plate = new_graphic(26, 4);
  gfx_fill(g_plate, 245, 245, 240);
  gfx_rect(g_plate, 0, 3, 26, 1, 120, 150, 210);
  gfx_rect(g_plate, 0, 0, 26, 1, 200, 205, 215);
  // vases: blue, and mustard with a stripe
  FOR i = 0 TO 1
    g = new_graphic(14, 28);
    IF (i == 0)
      ell(g, 7, 17, 6, 9, 70, 110, 190); gfx_rect(g, 4, 0, 6, 10, 70, 110, 190);
      gfx_rect(g, 3, 0, 8, 2, 50, 85, 160); gfx_line(g, 4, 13, 4, 20, 150, 180, 240);
    ELSE
      ell(g, 7, 18, 6, 9, 225, 180, 70); gfx_rect(g, 4, 0, 6, 12, 225, 180, 70);
      gfx_rect(g, 1, 17, 12, 3, 180, 90, 60); gfx_rect(g, 3, 0, 8, 2, 190, 150, 50);
    END
    g_vase[i] = g;
  END
  // a potted plant: the body is the pot (18x16), the leaves stick out
  g_plant = new_graphic(34, 42);
  FOR i = 0 TO 6
    ell(g_plant, 17 + get_distx(40000 + i * 16000, 11), 16 + get_disty(40000 + i * 16000, 9), 5, 3, 70 + i * 8, 150 + i * 6, 70);
  END
  gfx_line(g_plant, 17, 26, 17, 12, 60, 120, 50);
  tri(g_plant, 8, 26, 26, 26, 17, 41, 200, 105, 60);
  gfx_rect(g_plant, 9, 26, 17, 16, 200, 105, 60);
  gfx_rect(g_plant, 7, 26, 21, 4, 175, 88, 50);
  set_point(0, g_plant, 0, 17, 34);
  FOR i = 0 TO 4
    g = new_graphic(8, 26);
    SWITCH (i)
      CASE 0 gfx_fill(g, 170, 60, 60);
      CASE 1 gfx_fill(g, 60, 110, 150);
      CASE 2 gfx_fill(g, 90, 140, 80);
      CASE 3 gfx_fill(g, 220, 180, 90);
      CASE 4 gfx_fill(g, 130, 90, 140);
    END
    gfx_rect(g, 0, 4, 8, 2, 240, 220, 150);
    gfx_rect(g, 0, 20, 8, 2, 240, 220, 150);
    gfx_rect(g, 2, 9, 4, 7, 245, 235, 210);
    g_book[i] = g;
  END
  // the goldfish bowl
  g_bowl = new_graphic(28, 28);
  gfx_circle(g_bowl, 14, 14, 13, 150, 200, 225);
  gfx_circle(g_bowl, 14, 15, 11, 90, 160, 220);
  gfx_rect(g_bowl, 3, 3, 22, 6, 200, 230, 245);
  gfx_rect(g_bowl, 7, 1, 14, 3, 170, 215, 235);
  ell(g_bowl, 13, 16, 4, 3, 250, 140, 40);
  tri(g_bowl, 17, 16, 21, 12, 21, 20, 250, 120, 30);
  gfx_pixel(g_bowl, 11, 15, 20, 20, 20);
  gfx_circle(g_bowl, 8, 8, 2, 240, 250, 255);
  g_glass = new_graphic(8, 16);
  gfx_fill_rgba(g_glass, 190, 225, 245, 70);
  gfx_rect(g_glass, 0, 6, 8, 10, 170, 40, 70);             // red wine
  gfx_rect(g_glass, 1, 1, 1, 12, 240, 250, 255);
  FRAME;

  // shards: ceramic, blue, mustard, terracotta, leaf, glass, water
  FOR i = 0 TO 6
    g = new_graphic(6, 5);
    SWITCH (i)
      CASE 0 tri(g, 0, 4, 5, 4, 2, 0, 245, 245, 240);
      CASE 1 tri(g, 0, 4, 5, 3, 3, 0, 70, 110, 190);
      CASE 2 tri(g, 0, 3, 5, 4, 1, 0, 225, 180, 70);
      CASE 3 tri(g, 0, 4, 5, 4, 3, 0, 200, 105, 60);
      CASE 4 ell(g, 3, 2, 3, 2, 80, 160, 70);
      CASE 5 tri(g, 0, 4, 5, 2, 2, 0, 200, 235, 250);
      CASE 6 gfx_circle(g, 3, 2, 2, 110, 170, 240);
    END
    g_shard[i] = g;
  END
  g_fish = new_graphic(14, 8);
  ell(g_fish, 6, 4, 5, 3, 250, 140, 40);
  tri(g_fish, 10, 4, 13, 0, 13, 7, 250, 120, 30);
  gfx_pixel(g_fish, 4, 3, 20, 20, 20);
  g_puddle = new_graphic(60, 6);
  ell(g_puddle, 30, 3, 29, 2, 120, 180, 230);
  gfx_line(g_puddle, 14, 2, 30, 2, 190, 225, 250);
  g_soil = new_graphic(30, 6);
  ell(g_soil, 15, 4, 14, 2, 110, 75, 45);
  ell(g_soil, 12, 3, 6, 2, 130, 90, 55);

  g_title = big_text(360, 80, "BAD CAT", 255, 170, 70, 72);
  g_clear = big_text(420, 50, "ROOM WRECKED!", 255, 220, 90, 44);
  g_over = big_text(560, 44, "OUT ON THE BALCONY!", 190, 210, 255, 38);
  g_panel = new_graphic(440, 250);
  gfx_fill_rgba(g_panel, 40, 28, 30, 85);
  gfx_rect_outline(g_panel, 0, 0, 440, 250, 250, 190, 120);
  gfx_rect_outline(g_panel, 3, 3, 434, 244, 150, 100, 70);
  g_room = new_graphic(640, 480);
  g_balcony = new_graphic(640, 480);
  RETURN 0;
END

// =====================================================================
// Sound: every effect is made by the engine, no files
// =====================================================================

FUNCTION make_sounds();
PRIVATE i;
BEGIN
  // meows: a rising "me" and a falling (or rising) "ow"
  s_meow_a[0] = sfx_tone(wave_saw, 430, 780, 110, 22); s_meow_b[0] = sfx_tone(wave_saw, 780, 610, 230, 22);
  s_meow_a[1] = sfx_tone(wave_saw, 520, 700, 90, 22);  s_meow_b[1] = sfx_tone(wave_saw, 700, 360, 340, 22);
  s_meow_a[2] = sfx_tone(wave_saw, 380, 560, 70, 20);  s_meow_b[2] = sfx_tone(wave_saw, 560, 620, 70, 20);
  s_meow_a[3] = sfx_tone(wave_saw, 620, 1050, 80, 22); s_meow_b[3] = sfx_tone(wave_saw, 1050, 720, 220, 22);
  FOR i = 0 TO 3
    s_crash[i] = sfx(sfx_explosion, 10 + i);
    s_hit[i] = sfx(sfx_hit, 20 + i);
  END
  FOR i = 0 TO 2 s_glass[i] = sfx_tone(wave_noise, 5200 - i * 900, 1400, 260, 40); END
  s_tink = sfx_tone(wave_sine, 2400, 3200, 90, 30);
  s_splash = sfx_tone(wave_noise, 900, 200, 420, 55);
  s_thud = sfx(sfx_hit, 5);
  s_whoosh = sfx_tone(wave_noise, 2200, 600, 110, 22);
  s_jump = sfx_tone(wave_triangle, 300, 540, 90, 18);
  s_land = sfx_tone(wave_sine, 150, 90, 50, 22);
  s_step = sfx_tone(wave_sine, 120, 55, 110, 70);
  s_creak = sfx_tone(wave_saw, 150, 250, 480, 16);
  s_creak2 = sfx_tone(wave_saw, 250, 170, 380, 14);
  s_huh = sfx_tone(wave_square, 220, 440, 190, 30);
  s_huh2 = sfx_tone(wave_square, 440, 330, 240, 30);
  s_buzz = sfx(sfx_hit, 9);
  s_good = sfx_tone(wave_sine, 520, 680, 200, 30);
  s_clear = sfx(sfx_powerup, 1);
  s_over = sfx_tone(wave_triangle, 420, 110, 900, 45);
  s_flop = sfx_tone(wave_sine, 900, 500, 50, 20);
  s_yum = sfx(sfx_coin, 2);
  RETURN 0;
END

// A sneaky jazzy loop (walking pluck bass, pad chords, a Pink Panther-ish
// tiptoe line, brushes) and the "innocent whistling" song for when the
// owner is in the room.
FUNCTION make_songs();
BEGIN
  song_main = song_new(108);
  song_track(song_main, inst_pluck,
    "D3 . . . F3 . . D3 A3 . . . C4 . A3 . | G2 . . . B2 . . G2 D3 . . . F3 . D3 . |" +
    "C3 . . . E3 . . C3 G3 . . . B3 . G3 . | A2 . . . C#3 . . A2 E3 . . . G3 . E3 . ", 75);
  song_track(song_main, inst_pad,
    "F4 - - - - - - - - - - - - - - - | B3 - - - - - - - - - - - - - - - |" +
    "E4 - - - - - - - - - - - - - - - | C#4 - - - - - - - - - - - - - - - ", 22);
  song_track(song_main, inst_pad,
    "C5 - - - - - - - - - - - - - - - | F4 - - - - - - - - - - - - - - - |" +
    "B4 - - - - - - - - - - - - - - - | G4 - - - - - - - - - - - - - - - ", 18);
  song_track(song_main, inst_triangle,
    ". . D4 E4 F4 . . . A4 . . G#4 A4 . . . | . . G4 A4 B4 . . . D5 . . C#5 D5 . . . |" +
    ". . E4 F#4 G4 . . . B4 . . A#4 B4 . . . | . . C#5 . E5 . . . G4 . A4 . . . . . ", 26);
  song_track(song_main, inst_drums, "k . h . s . h h k . h . s . h . ", 30);

  song_owner = song_new(96);
  song_track(song_owner, inst_sine,
    "C5 - - E5 G5 - - - E5 - C5 - D5 - - - | E5 - - G5 C6 - - - B5 - G5 - A5 - - - |" +
    "G5 - - E5 F5 - - - D5 - B4 - C5 - - - | . . . . . . . . . . . . . . . . ", 40);
  song_track(song_owner, inst_bass,
    "C3 . . . G3 . . . C3 . . . G3 . . . | A2 . . . E3 . . . F3 . . . G3 . . . ", 50);
  song_track(song_owner, inst_pad,
    "E4 - - - - - - - - - - - - - - - | C4 - - - - - - - D4 - - - - - - - ", 18);
  song_track(song_owner, inst_drums, "k . . . h . . . k . . . h . . h ", 22);
  RETURN 0;
END

PROCESS meow(k, pitch);
PRIVATE t, n, hy;
BEGIN
  play_sound(s_meow_a[k], 80, pitch, 0);
  n = 6; IF (k == 2) n = 4; END
  FRAME(n * 100);
  play_sound(s_meow_b[k], 80, pitch, 0);
  // a little speech line over the cat
  FOR t = 0 TO 34
    set_color('#fff4d8');
    hy = cat_y - 48 - t / 4;
    IF (state == 3) hy = cat_y - 90 - t / 4; END
    IF (k == 0) text(cat_x - 15, hy, "meow!"); END
    IF (k == 1) text(cat_x - 18, hy, "mrrow.."); END
    IF (k == 2) text(cat_x - 12, hy, "mrrp"); END
    IF (k == 3) text(cat_x - 18, hy, "MEOW?!"); END
    FRAME;
  END
END

// =====================================================================
// Room generation
// =====================================================================

FUNCTION add_pl(x1, x2, py, f, hide);
BEGIN
  IF (npl < 24)
    pl_x1[npl] = x1; pl_x2[npl] = x2; pl_y[npl] = py; pl_f[npl] = f; pl_hide[npl] = hide;
    npl++;
  END
  RETURN 0;
END

FUNCTION add_furniture(k, fx, fw, top);
BEGIN
  f_kind[nf] = k; f_x[nf] = fx; f_w[nf] = fw; f_top[nf] = top;
  nf++;
  RETURN nf - 1;
END

// A wall shelf, unless it would cover the window or crowd another shelf
// or the top of a piece of furniture.
FUNCTION try_shelf(sx, w, sy);
PRIVATE i, f;
BEGIN
  IF (sy < 110 OR nf >= 8) RETURN 0; END
  sx = clamp(sx, 10, 552 - w);
  IF (sx + w > win_x - 8 AND sx < win_x + win_w + 8 AND sy > win_y - 12 AND sy < win_y + win_h + 36) RETURN 0; END
  FOR i = 0 TO npl - 1
    IF (sx + w > pl_x1[i] - 10 AND sx < pl_x2[i] + 10 AND abs(sy - pl_y[i]) < 50) RETURN 0; END
  END
  f = add_furniture(K_SHELF, sx, w, sy);
  add_pl(sx, sx + w, sy, f, 0);
  RETURN 1;
END

FUNCTION gen_layout();
PRIVATE i, j, k, t, w[3], sum, free, cur, g, n0, fi, sx;
BEGIN
  nf = 0; npl = 0; n_ht = 0; sofa_x1 = -1; sofa_x2 = -1;
  add_pl(4, 636, FLOOR, -1, 0);                  // platform 0: the floor
  // the four big pieces, in a random order, with random widths and gaps
  FOR i = 0 TO 3 order[i] = i; END
  i = 3;
  WHILE (i >= 1)
    j = rand(0, i); t = order[i]; order[i] = order[j]; order[j] = t;
    i--;
  END
  w[K_TABLE] = rand(120, 150); w[K_SOFA] = rand(140, 165);
  w[K_BOOKCASE] = rand(78, 92); w[K_COUNTER] = rand(100, 130);
  sum = w[0] + w[1] + w[2] + w[3];
  free = 540 - sum;
  cur = 14;
  FOR i = 0 TO 3
    k = order[i];
    g = rand(0, free / (4 - i));
    cur += g; free -= g;
    IF (k == K_TABLE)
      fi = add_furniture(k, cur, w[k], 356);
      add_pl(cur + 2, cur + w[k] - 2, 356, fi, 0);
      ht_x1[n_ht] = cur + 14; ht_x2[n_ht] = cur + w[k] - 14; n_ht++;
    END
    IF (k == K_SOFA)
      fi = add_furniture(k, cur, w[k], 352);
      add_pl(cur + 18, cur + w[k] - 18, 396, fi, 0);
      add_pl(cur + 8, cur + w[k] - 8, 352, fi, 1);
      sofa_x1 = cur; sofa_x2 = cur + w[k];
    END
    IF (k == K_BOOKCASE)
      fi = add_furniture(k, cur, w[k], 236);
      add_pl(cur + 2, cur + w[k] - 2, 236, fi, 0);
      add_pl(cur + 8, cur + w[k] - 8, 300, fi, 0);
      add_pl(cur + 8, cur + w[k] - 8, 368, fi, 0);
    END
    IF (k == K_COUNTER)
      fi = add_furniture(k, cur, w[k], 346);
      add_pl(cur, cur + w[k], 346, fi, 0);
    END
    cur += w[k];
  END
  // the window, somewhere on the upper wall
  win_w = 96 + rand(0, 3) * 8; win_h = 110;
  win_x = rand(40, 540 - win_w); win_y = rand(56, 76);
  night = rand(0, 2) == 0;
  // wall shelves above the low furniture, within a jump of its top
  FOR i = 0 TO 3
    k = f_kind[i];
    IF (k != K_BOOKCASE OR rand(0, 1) == 0)
      t = rand(70, 110);
      try_shelf(f_x[i] + f_w[i] / 2 + rand(-30, 30) - t / 2, t, f_top[i] - rand(80, 94));
    END
  END
  // higher shelves above the first ones, more of them in later rooms
  n0 = nf;
  FOR i = 4 TO n0 - 1
    IF (f_top[i] > 200 AND rand(0, 99) < 30 + level * 12)
      t = rand(64, 96);
      sx = f_x[i] + f_w[i] / 2 + rand(-45, 45) - t / 2;
      try_shelf(sx, t, f_top[i] - rand(78, 90));
    END
  END
  RETURN 0;
END

// Plans one object (kind k, variant v) resting on platform p at x.
FUNCTION plan(k, v, px, p);
PRIVATE h;
BEGIN
  IF (n_it >= 40) RETURN 0; END
  h = 11;
  IF (k == O_PLATE) h = 4; END
  IF (k == O_VASE) h = 28; END
  IF (k == O_PLANT) h = 16; END
  IF (k == O_BOOK) h = 26; END
  IF (k == O_BOWL) h = 26; END
  IF (k == O_GLASS) h = 16; END
  it_k[n_it] = k; it_v[n_it] = v; it_x[n_it] = px; it_y[n_it] = pl_y[p] - h / 2 - 0.5;
  n_it++;
  RETURN 1;
END

// Width an object takes on a shelf.
FUNCTION obj_width(k);
BEGIN
  IF (k == O_CUP) RETURN 17; END
  IF (k == O_PLATE) RETURN 26; END
  IF (k == O_VASE) RETURN 14; END
  IF (k == O_PLANT) RETURN 22; END
  IF (k == O_BOWL) RETURN 28; END
  IF (k == O_GLASS) RETURN 8; END
  RETURN 9;
END

// Chooses what stands on a platform of furniture kind fk.
FUNCTION pick_kind(fk, py);
PRIVATE r;
BEGIN
  r = rand(0, 99);
  IF (fk == K_BOOKCASE AND py > 250)
    IF (r < 75) RETURN O_BOOK; END
    IF (r < 88) RETURN O_VASE; END
    RETURN O_GLASS;
  END
  IF (fk == K_COUNTER)
    IF (r < 35) RETURN O_PLATE; END
    IF (r < 70) RETURN O_CUP; END
    IF (r < 90) RETURN O_GLASS; END
    RETURN O_VASE;
  END
  IF (fk == K_TABLE)
    IF (r < 35) RETURN O_CUP; END
    IF (r < 55) RETURN O_VASE; END
    IF (r < 72) RETURN O_PLANT; END
    IF (r < 88) RETURN O_GLASS; END
    RETURN O_PLATE;
  END
  // wall shelves and the top of the bookcase
  IF (r < 30) RETURN O_VASE; END
  IF (r < 52) RETURN O_PLANT; END
  IF (r < 70) RETURN O_CUP; END
  IF (r < 82) RETURN O_GLASS; END
  RETURN O_BOOK;
END

FUNCTION gen_objects();
PRIVATE p, fk, px, k, wd, n, j, want, bp, bx, tries, placed, r;
BEGIN
  n_it = 0;
  // the goldfish bowl first: on a table, a counter or a wall shelf
  bp = -1;
  FOR tries = 0 TO 20
    p = rand(1, npl - 1);
    fk = f_kind[pl_f[p]];
    IF (fk == K_TABLE OR fk == K_COUNTER OR fk == K_SHELF)
      bp = p; BREAK;
    END
  END
  IF (bp >= 0)
    bx = pl_x1[bp] + rand(18, pl_x2[bp] - pl_x1[bp] - 18);
    plan(O_BOWL, 0, bx, bp);
  END
  // fill every top with things, a gap here and there...
  FOR p = 1 TO npl - 1
    fk = f_kind[pl_f[p]];
    IF (fk == K_SOFA) CONTINUE; END           // cushions: nothing breaks there
    px = pl_x1[p] + rand(4, 12);
    LOOP
      k = pick_kind(fk, pl_y[p]);
      wd = obj_width(k);
      n = 1;
      IF (k == O_BOOK) n = rand(2, 5); END
      IF (px + wd * n + 2 > pl_x2[p] - 2) BREAK; END
      IF (p == bp AND px + wd * n + 4 > bx - 14 AND px < bx + 16)
        px = bx + 18;                          // step over the bowl
        CONTINUE;
      END
      placed = 0;
      IF (rand(0, 99) < 85)
        FOR j = 0 TO n - 1
          IF (k == O_PLATE) plan(O_PLATE, 3, px + 13, p);      // v 3: a stack of three
          ELSE plan(k, rand(0, 4), px + wd / 2 + j * wd, p); END
        END
        placed = 1;
      END
      IF (placed) px += wd * n + rand(6, 16); ELSE px += rand(12, 26); END
    END
  END
  // ...then keep as many as this room gets: more in every room
  want = clamp(10 + level * 3, 10, 34);
  WHILE (n_it > want)
    r = rand(1, n_it - 1);                     // never the bowl (0)
    n_it--;
    it_k[r] = it_k[n_it]; it_v[r] = it_v[n_it]; it_x[r] = it_x[n_it]; it_y[r] = it_y[n_it];
  END
  RETURN 0;
END

// Paints the wall, window, pictures, door frame and floor.
FUNCTION paint_room();
PRIVATE i, j, wr, wg, wb, c, px, py, k, ok, n, qx, qy;
BEGIN
  pal = (level - 1) % 5;
  SWITCH (pal)
    CASE 0 wr = 238; wg = 218; wb = 180;
    CASE 1 wr = 200; wg = 222; wb = 204;
    CASE 2 wr = 242; wg = 204; wb = 192;
    CASE 3 wr = 208; wg = 214; wb = 238;
    CASE 4 wr = 234; wg = 222; wb = 166;
  END
  gfx_fill(g_room, wr, wg, wb);
  // wallpaper: stripes and little diamonds
  FOR i = 0 TO 20
    gfx_rect(g_room, i * 32 + 14, 0, 4, FLOOR, wr - 14, wg - 14, wb - 14);
  END
  FOR j = 0 TO 13
    FOR i = 0 TO 19
      gfx_circle(g_room, i * 32 + (j % 2) * 16, 20 + j * 30, 2, wr + 10, wg + 12, wb + 14);
    END
  END
  gfx_rect(g_room, 0, 0, 640, 8, wr - 40, wg - 45, wb - 50);         // cornice
  gfx_rect(g_room, 0, 8, 640, 2, 255, 250, 240);
  gfx_rect(g_room, 0, 318, 640, 6, wr - 50, wg - 55, wb - 60);       // chair rail
  gfx_rect(g_room, 0, 324, 640, FLOOR - 324, wr - 24, wg - 28, wb - 30);
  FOR i = 0 TO 31 gfx_rect(g_room, i * 20, 324, 1, FLOOR - 324, wr - 40, wg - 44, wb - 46); END
  FRAME;
  // the window: sky, a sun or the moon and stars, curtains
  IF (night)
    gfx_rect(g_room, win_x, win_y, win_w, win_h, 40, 50, 100);
    FOR i = 0 TO 12 gfx_pixel(g_room, win_x + 6 + (i * 37) % (win_w - 12), win_y + 6 + (i * 23) % 60, 255, 255, 220); END
    gfx_circle(g_room, win_x + win_w - 26, win_y + 26, 12, 250, 245, 200);
    gfx_circle(g_room, win_x + win_w - 21, win_y + 22, 11, 40, 50, 100);
  ELSE
    FOR i = 0 TO win_h - 1
      gfx_rect(g_room, win_x, win_y + i, win_w, 1, 140 + i / 2, 200 + i / 5, 245);
    END
    gfx_circle(g_room, win_x + 26, win_y + 28, 12, 255, 230, 120);
  END
  // a roofline outside
  gfx_rect(g_room, win_x, win_y + win_h - 30, win_w, 30, 110 - night * 50, 90 - night * 40, 110 - night * 30);
  FOR i = 0 TO win_w / 20
    gfx_rect(g_room, win_x + i * 20 + 4, win_y + win_h - 24, 8, 10, 255, 220 - night * 20, 120 - night * 40);
  END
  gfx_rect_outline(g_room, win_x - 4, win_y - 4, win_w + 8, win_h + 8, 250, 250, 245);
  gfx_rect_outline(g_room, win_x - 3, win_y - 3, win_w + 6, win_h + 6, 250, 250, 245);
  gfx_rect(g_room, win_x + win_w / 2 - 2, win_y, 4, win_h, 250, 250, 245);
  gfx_rect(g_room, win_x, win_y + win_h / 2 - 2, win_w, 4, 250, 250, 245);
  gfx_rect(g_room, win_x - 10, win_y + win_h + 4, win_w + 20, 6, 240, 235, 225);
  gfx_rect(g_room, win_x - 20, win_y - 14, win_w + 40, 4, 120, 90, 60);  // curtain rod
  FOR i = 0 TO 5
    gfx_rect(g_room, win_x - 18 + i * 4, win_y - 10, 4, win_h + 30, 200 - (i % 2) * 20, 90, 90);
    gfx_rect(g_room, win_x + win_w - 6 + i * 4, win_y - 10, 4, win_h + 30, 200 - (i % 2) * 20, 90, 90);
  END
  FRAME;
  // one or two pictures where the wall is free
  n = 0; qx = -999; qy = -999;
  FOR k = 0 TO 16
    px = rand(20, 500); py = rand(40, 150);
    ok = 1;
    IF (abs(px - qx) < 64 AND abs(py - qy) < 74) ok = 0; END
    IF (px + 44 > win_x - 30 AND px < win_x + win_w + 30) ok = 0; END
    FOR i = 1 TO npl - 1
      IF (px + 44 > pl_x1[i] - 6 AND px < pl_x2[i] + 6 AND py + 54 > pl_y[i] - 40 AND py < pl_y[i] + 14) ok = 0; END
    END
    IF (ok)
      gfx_rect(g_room, px, py, 44, 54, 150, 110, 60);
      gfx_rect(g_room, px + 4, py + 4, 36, 46, 230, 225, 200);
      IF (n == 0)                     // a portrait of a fish
        ell(g_room, px + 20, py + 26, 10, 6, 250, 140, 40);
        tri(g_room, px + 29, py + 26, px + 36, py + 19, px + 36, py + 33, 250, 120, 30);
        gfx_pixel(g_room, px + 15, py + 24, 20, 20, 20);
      ELSE                            // hills
        gfx_rect(g_room, px + 4, py + 32, 36, 18, 110, 170, 100);
        gfx_circle(g_room, px + 30, py + 16, 5, 250, 200, 80);
      END
      n++; qx = px; qy = py;
      IF (n >= 2) BREAK; END
    END
  END
  // the doorway: a dim hallway, the frame
  gfx_rect(g_room, DOOR_X1, DOOR_TOP, DOOR_X2 - DOOR_X1, FLOOR - DOOR_TOP, 70, 58, 66);
  gfx_rect(g_room, DOOR_X1, FLOOR - 40, DOOR_X2 - DOOR_X1, 40, 90, 74, 70);
  gfx_rect(g_room, DOOR_X1 - 8, DOOR_TOP - 8, 8, FLOOR - DOOR_TOP + 8, 245, 240, 230);
  gfx_rect(g_room, DOOR_X2, DOOR_TOP - 8, 8, FLOOR - DOOR_TOP + 8, 245, 240, 230);
  gfx_rect(g_room, DOOR_X1 - 8, DOOR_TOP - 8, DOOR_X2 - DOOR_X1 + 16, 8, 245, 240, 230);
  // skirting board and the wooden floor
  gfx_rect(g_room, 0, FLOOR - 8, DOOR_X1 - 8, 8, 250, 246, 236);
  gfx_rect(g_room, DOOR_X2 + 8, FLOOR - 8, 640, 8, 250, 246, 236);
  FOR j = 0 TO 4
    c = (j % 2) * 10;
    gfx_rect(g_room, 0, FLOOR + j * 8, 640, 8, 170 - c, 115 - c, 70 - c);
    gfx_rect(g_room, 0, FLOOR + j * 8, 640, 1, 140, 92, 55);
    FOR i = 0 TO 5
      gfx_rect(g_room, (i * 127 + j * 53) % 640, FLOOR + j * 8, 1, 8, 140, 92, 55);
    END
  END
  // a rug
  px = rand(40, 360);
  gfx_rect(g_room, px, FLOOR + 30, 200, 8, 170, 80, 80);
  FOR i = 0 TO 24 gfx_rect(g_room, px + i * 8 + 2, FLOOR + 32, 4, 4, 240, 200, 120); END
  put_screen(0, g_room);
  RETURN 0;
END

// =====================================================================
// Furniture: graphics and one-way tops (static physics edges)
// =====================================================================

PROCESS room();
BEGIN
  x = 0; y = 0;
  phys_material(1, 0.7, 0.08);
  phys_edge(0, FLOOR, 640, FLOOR);
  phys_edge(3, -400, 3, FLOOR);
  phys_edge(637, -400, 637, FLOOR);
  LOOP FRAME; END
END

PROCESS furniture(fi);
PRIVATE k, fx, fw, top, gh, g, i, j, c, cr, cg, cb;
BEGIN
  k = f_kind[fi]; fx = f_x[fi]; fw = f_w[fi]; top = f_top[fi];
  z = 20;
  gh = FLOOR - top;
  IF (k == K_SHELF) gh = 22; END
  g = lvl_graphic(fw, gh);
  IF (k == K_TABLE)
    // a wooden top, a gingham tablecloth down to the knees, legs below
    gfx_rect(g, 6, 0, 8, gh, 120, 76, 42);
    gfx_rect(g, fw - 14, 0, 8, gh, 120, 76, 42);
    FOR j = 0 TO 6
      FOR i = 0 TO fw / 8
        c = (i + j) % 2;
        IF (c) gfx_rect(g, i * 8, j * 8, 8, 8, 215, 80, 80);
        ELSE gfx_rect(g, i * 8, j * 8, 8, 8, 250, 235, 225); END
      END
    END
    FOR i = 0 TO fw / 8
      gfx_circle(g, i * 8 + 4, 56, 4, 215, 80, 80);
    END
    gfx_rect(g, 0, 0, fw, 3, 190, 60, 60);
  END
  IF (k == K_SOFA)
    SWITCH (rand(0, 3))
      CASE 0 cr = 70; cg = 135; cb = 140;
      CASE 1 cr = 190; cg = 110; cb = 90;
      CASE 2 cr = 120; cg = 150; cb = 90;
      CASE 3 cr = 150; cg = 100; cb = 150;
    END
    rrect(g, 6, 0, fw - 12, 60, 10, cr - 20, cg - 20, cb - 20);          // back
    FOR i = 0 TO 2
      rrect(g, 12 + i * (fw - 24) / 3, 6, (fw - 24) / 3 - 2, 44, 8, cr, cg, cb);
    END
    rrect(g, 14, 42, fw - 28, 22, 6, cr + 20, cg + 20, cb + 20);         // seat cushions
    gfx_line(g, fw / 2, 44, fw / 2, 62, cr - 10, cg - 10, cb - 10);
    gfx_rect(g, 4, 60, fw - 8, 18, cr - 30, cg - 30, cb - 30);            // base
    rrect(g, 0, 22, 20, 58, 9, cr - 10, cg - 10, cb - 10);               // arms
    rrect(g, fw - 20, 22, 20, 58, 9, cr - 10, cg - 10, cb - 10);
    gfx_rect(g, 10, 78, 6, gh - 78, 90, 60, 40);
    gfx_rect(g, fw - 16, 78, 6, gh - 78, 90, 60, 40);
  END
  IF (k == K_BOOKCASE)
    gfx_fill(g, 150, 100, 60);
    gfx_rect(g, 6, 6, fw - 12, gh - 12, 95, 62, 38);
    gfx_rect(g, 0, 0, fw, 5, 175, 120, 75);
    gfx_rect(g, 4, 300 - top, fw - 8, 5, 170, 115, 70);
    gfx_rect(g, 4, 368 - top, fw - 8, 5, 170, 115, 70);
    gfx_rect(g, 6, 6, fw - 12, 2, 70, 45, 28);
    gfx_rect(g, 6, 305 - top, fw - 12, 2, 70, 45, 28);
    gfx_rect(g, 6, 373 - top, fw - 12, 2, 70, 45, 28);
    // a drawer at the bottom
    gfx_rect(g, 8, gh - 26, fw - 16, 18, 165, 112, 68);
    gfx_rect(g, fw / 2 - 6, gh - 19, 12, 3, 230, 190, 80);
  END
  IF (k == K_COUNTER)
    gfx_fill(g, 240, 236, 222);
    gfx_rect(g, 0, 0, fw, 9, 190, 196, 204);                             // worktop
    gfx_rect(g, 0, 7, fw, 2, 150, 156, 164);
    gfx_rect(g, 4, 14, fw - 8, 16, 225, 220, 205);                       // drawers
    gfx_rect(g, 4, 34, fw / 2 - 6, gh - 40, 150, 185, 175);              // doors
    gfx_rect(g, fw / 2 + 2, 34, fw / 2 - 6, gh - 40, 150, 185, 175);
    gfx_rect(g, fw / 2 - 8, 60, 3, 14, 110, 110, 110);
    gfx_rect(g, fw / 2 + 5, 60, 3, 14, 110, 110, 110);
    gfx_rect(g, fw / 2 - 8, 20, 16, 3, 110, 110, 110);
    gfx_rect(g, 0, gh - 5, fw, 5, 90, 80, 70);
  END
  IF (k == K_SHELF)
    gfx_rect(g, 0, 0, fw, 7, 175, 125, 80);
    gfx_rect(g, 0, 6, fw, 2, 120, 80, 50);
    tri(g, 8, 8, 20, 8, 8, 21, 110, 110, 120);
    tri(g, fw - 9, 8, fw - 21, 8, fw - 9, 21, 110, 110, 120);
  END
  graph = g;
  x = fx + fw / 2; y = top + gh / 2;
  // physics: one edge per top this piece owns (relative to x, y)
  IF (k == K_SOFA) phys_material(1, 0.9, 0.3); ELSE phys_material(1, 0.6, 0.08); END
  FOR i = 1 TO npl - 1
    IF (pl_f[i] == fi)
      phys_edge(pl_x1[i] - x, pl_y[i] - y, pl_x2[i] - x, pl_y[i] - y);
    END
  END
  LOOP FRAME; END
END

// =====================================================================
// Things that break
// =====================================================================

PROCESS obj(x, y, kind, v);
PRIVATE hw, hh, val, thr, age, imp, sp, dx, last_sw, i, n, sc, thudded, ms;
BEGIN
  z = 10;
  n_obj++;
  // body size, value and how hard a hit breaks it (px/s of impact)
  IF (kind == O_CUP)   graph = g_cup[v % 2]; hw = 6; hh = 6; val = 60;  thr = 170; phys_material(1.0, 0.6, 0.15); END
  IF (kind == O_PLATE) graph = g_plate; hw = 13; hh = 2; val = 40;      thr = 160; phys_material(1.2, 0.5, 0.1); END
  IF (kind == O_VASE)  graph = g_vase[v % 2]; hw = 7; hh = 14; val = 150; thr = 160; phys_material(0.9, 0.6, 0.1); END
  IF (kind == O_PLANT) graph = g_plant; hw = 9; hh = 8; val = 120;      thr = 190; phys_material(1.5, 0.7, 0.05); END
  IF (kind == O_BOOK)  graph = g_book[v % 5]; hw = 4; hh = 13; val = 25; thr = 140; phys_material(0.8, 0.8, 0.05); END
  IF (kind == O_BOWL)  graph = g_bowl; hw = 13; hh = 13; val = 400;     thr = 160; phys_material(1.2, 0.4, 0.2); END
  IF (kind == O_GLASS) graph = g_glass; hw = 4; hh = 8; val = 80;       thr = 150; phys_material(0.8, 0.5, 0.15); END
  IF (kind == O_BOWL) phys_circle(13); ELSE phys_box(hw * 2, hh * 2); END
  total_value += val;
  last_sw = -1;
  LOOP
    age++;
    imp = phys_impact();
    sp = abs(phys_vx()) + abs(phys_vy());
    IF (imp > st_maximp AND age > 30) st_maximp = imp; END

    // the cat walking into it pushes it along
    IF (cat_mode == 0 AND abs(cat_vx) > 0.6)
      dx = x - cat_x;
      IF (abs(dx) < hw + 12 AND dx * cat_vx > 0 AND cat_y > y - hh - 2 AND cat_y - 26 < y + hh)
        phys_velocity(cat_vx * 66, phys_vy());
      END
    END
    // a swipe: a kick up and away, the same for heavy and light things
    IF (sw_on AND last_sw != sw_serial)
      IF (x + hw > sw_x1 AND x - hw < sw_x2 AND y + hh > sw_y1 AND y - hh < sw_y2)
        last_sw = sw_serial;
        ms = phys_mass();
        phys_impulse(ms * (sw_dir * rand(250, 320) - phys_vx()), ms * (-rand(120, 190) - phys_vy()));
        phys_spin(-sw_dir * rand(100000, 300000));
        play_sound(s_hit[rand(0, 3)], 30, 180, (x - 320) / 4);
      END
    END
    // moving fast next to the cat: that looks bad if the owner is watching
    IF (y < FLOOR - 30 AND NOT (x > sofa_x1 AND x < sofa_x2 AND y > 370)) high_seen = frame_no; END
    IF (age > 30 AND sp > 140 AND abs(x - cat_x) < 120 AND abs(y - (cat_y - 14)) < 130)
      red_t = frame_no;
    END
    IF (age > 30 AND imp > thr)
      IF (kind == O_BOOK)
        IF (NOT thudded AND y > FLOOR - 40)
          thudded = 1; st_thuds++;
          play_sound(s_thud, 70, 70 + rand(0, 30), (x - 320) / 4);
          mess += val; score += val;
          popup(x, y - 20, "+" + val, "#fff4c0");
          IF (abs(x - cat_x) < 150) red_t = frame_no; END
        END
      ELSE
        // cushions are soft: nothing breaks on the sofa
        IF (NOT (x > sofa_x1 AND x < sofa_x2 AND y < 404)) BREAK; END
        play_sound(s_land, 40, 100, 0);
      END
    END
    IF (y > 520) n_obj--; RETURN; END
    FRAME;
  END

  // broken!
  n_obj--; st_broken++;
  mess += val; score += val;
  IF (abs(x - cat_x) < 160) red_t = frame_no; END
  n = 6; sc = 0;
  IF (kind == O_CUP) sc = 0; IF (v % 2) sc = 1; END END
  IF (kind == O_PLATE) n = 4; END
  IF (kind == O_VASE) n = 9; sc = 1 + v % 2; END
  IF (kind == O_PLANT) n = 8; sc = 3; END
  IF (kind == O_BOWL) n = 10; sc = 5; END
  IF (kind == O_GLASS) sc = 5; END
  FOR i = 1 TO n
    IF (n_shards < 150)
      shard(x + rand(-hw, hw), y, phys_vx() * 0.2 + rand(-170, 170), -rand(80, 300), g_shard[sc]);
    END
  END
  IF (kind == O_PLANT)
    FOR i = 1 TO 5 IF (n_shards < 150) shard(x, y - 6, rand(-120, 120), -rand(120, 280), g_shard[4]); END END
    spill(x, g_soil);
  END
  IF (kind == O_BOWL)
    FOR i = 1 TO 10 IF (n_shards < 150) shard(x, y - 4, rand(-200, 200), -rand(150, 360), g_shard[6]); END END
    spill(x, g_puddle);
    fish(x, y - 8);
    play_sound(s_splash, 90, 100, (x - 320) / 4);
    play_sound(s_crash[rand(0, 3)], 60, 100, (x - 320) / 4);
    popup(x, y - 24, "+" + val + " GOLDFISH!", "#ffd060");
  ELSE
    popup(x, y - 20, "+" + val, "#ffffff");
  END
  // crash and tinkle, a little different every time
  IF (kind == O_VASE OR kind == O_PLANT) play_sound(s_crash[rand(0, 3)], 45, 120 + rand(0, 40), (x - 320) / 4); END
  play_sound(s_hit[rand(0, 3)], 70, 90 + rand(0, 40), (x - 320) / 4);
  play_sound(s_glass[rand(0, 2)], 60, 90 + rand(0, 30), (x - 320) / 4);
  IF (kind == O_GLASS OR kind == O_CUP OR kind == O_PLATE) play_sound(s_tink, 40, 90 + rand(0, 30), (x - 320) / 4); END
END

// Cheap flying pieces: no physics body, just gravity, a bounce, a fade.
PROCESS shard(x, y, vx, vy, graph);
PRIVATE t, spin;
BEGIN
  z = -4; n_shards++;
  spin = rand(-25000, 25000);
  FOR t = 0 TO 50
    vy += 14; x += vx * 0.0167; y += vy * 0.0167; angle += spin;
    IF (y > FLOOR - 1 AND vy > 0) y = FLOOR - 1; vy = -vy * 0.3; vx = vx * 0.6; spin = spin / 2; END
    IF (t > 34) alpha = 100 - (t - 34) * 6; END
    FRAME;
  END
  n_shards--;
END

// Soil or water on the floor, until the room changes.
PROCESS spill(x, graph);
BEGIN
  y = FLOOR + 1; z = 15; size = 30;
  WHILE (size < 100) size += 10; FRAME; END
  LOOP FRAME; END
END

// The goldfish flops about on the floor; the cat may eat it.
PROCESS fish(x, y);
PRIVATE vy, vx, t;
BEGIN
  graph = g_fish; z = -2; vy = -4;
  LOOP
    t++;
    vy += 0.4; y += vy; x += vx;
    IF (y > FLOOR - 4)
      y = FLOOR - 4; vy = -rand(2, 5); vx = rand(-2, 2) * 0.5;
      play_sound(s_flop, 40, 80 + rand(0, 40), 0);
    END
    x = clamp(x, 10, 630);
    angle += 30000; IF (vy > 0) flags = 1; ELSE flags = 0; END
    IF (abs(cat_x - x) < 16 AND abs(cat_y - y) < 24 AND cat_mode == 0 AND t > 30)
      mess += 50; score += 50; st_fish++;
      play_sound(s_yum, 60, 100, 0);
      popup(x, y - 20, "+50 YUM", "#a0ffa0");
      meow(0, 110);
      BREAK;
    END
    FRAME;
  END
END

PROCESS popup(x, y, s, col);
PRIVATE t;
BEGIN
  x = clamp(x, 24, 590);
  FOR t = 0 TO 55
    y -= 0.6;
    set_color(col);
    text(x - 14, y, s);
    FRAME;
  END
END

// =====================================================================
// The cat
// =====================================================================

PROCESS cat();
PRIVATE vx = 0.0; vy = 0.0; on = 0; coy = 0; buf = 0; drop_p = -1; drop_t = 0;
  swipe_t = 0; swipe_cd = 0; anim = 0; mode = 0; oldy = 0.0; i = 0; best = 0; bi = 0;
  lft, rgt, jp, jh, sp, dn, st, g, blink = 0;
BEGIN
  x = 300; y = FLOOR; on = 0; z = 0;
  graph = g_cat[0]; cat_face = 1;
  LOOP
    // ---- input (none on the title screen or the balcony)
    lft = 0; rgt = 0; jp = 0; jh = 0; sp = 0; dn = 0; st = 0;
    IF (state == 1 OR state == 2)
      lft = key(_left) OR key(_a);
      rgt = key(_right) OR key(_d);
      jp = key_pressed(_up) OR key_pressed(_w) OR key_pressed(_z) OR key_pressed(_space);
      jh = key(_up) OR key(_w) OR key(_z) OR key(_space);
      sp = key_pressed(_x) OR key_pressed(_j);
      dn = key(_down) OR key(_s);
      st = key(_c) OR key(_k);
    END
    IF (jp) buf = BUFFER; END

    // ---- sitting and hiding (only while standing on something)
    IF (mode == 0 AND on >= 0 AND swipe_t == 0)
      IF (dn)
        IF (on == 0)
          mode = 1;                                    // floor: sit innocently...
          FOR i = 0 TO n_ht - 1
            IF (x > ht_x1[i] AND x < ht_x2[i]) mode = 2; END   // ...or hide under the table
          END
        ELSE
          IF (pl_hide[on])
            mode = 3; y = pl_y[on] + 12;               // duck behind the sofa's back
          ELSE
            drop_p = on; drop_t = 12; on = -1; vy = 1; // drop through the furniture top
          END
        END
      END
      IF (st AND mode == 0) mode = 1; END
      IF (mode != 0) vx = 0; END
    END
    IF (mode != 0)
      IF ((mode == 1 AND NOT (dn OR st)) OR (mode >= 2 AND NOT dn) OR jp OR state == 3)
        IF (mode == 3) y = pl_y[on]; END
        mode = 0;
      END
    END

    IF (mode == 0)
      // ---- run: accelerate towards the wanted speed
      i = (rgt - lft) * RUN;
      IF (on >= 0) vx += clamp(i - vx, -ACC_G, ACC_G);
      ELSE vx += clamp(i - vx, -ACC_A, ACC_A); END
      IF (rgt AND NOT lft) cat_face = 1; END
      IF (lft AND NOT rgt) cat_face = -1; END

      // ---- jump: buffered press, coyote time after leaving an edge
      IF (buf > 0 AND coy > 0)
        vy = -JUMP_V; on = -1; coy = 0; buf = 0;
        play_sound(s_jump, 40, 90 + rand(0, 20), (x - 320) / 4);
      END
      // variable height: letting go early pulls the cat down harder
      IF (vy < 0 AND NOT jh) vy += GRAV_CUT;
      ELSE IF (abs(vy) < 1.2 AND jh AND on < 0) vy += GRAV_APEX;
      ELSE vy += GRAV; END END
      IF (vy > MAXFALL) vy = MAXFALL; END

      // ---- swipe
      IF (sp AND swipe_cd <= 0)
        swipe_t = 14; swipe_cd = 18; sw_serial++; st_swipes++;
        play_sound(s_whoosh, 60, 90 + rand(0, 30), (x - 320) / 4);
        IF (rand(0, 3) == 0) meow(2, 90 + rand(0, 30)); END
      END

      x += vx;
      IF (x < 14) x = 14; vx = 0; END
      IF (x > 626) x = 626; vx = 0; END
      oldy = y;
      IF (on >= 0)
        // walked off the edge? then a few frames of coyote time
        IF (x < pl_x1[on] - 6 OR x > pl_x2[on] + 6)
          on = -1; coy = COYOTE;
        ELSE
          y = pl_y[on]; vy = 0; coy = COYOTE;
        END
      END
      IF (on < 0)
        y += vy;
        IF (coy > 0) coy--; END
        // one-way tops: land when falling through one from above
        IF (vy >= 0)
          best = 99999; bi = -1;
          FOR i = 0 TO npl - 1
            IF (pl_y[i] >= oldy - 0.01 AND pl_y[i] <= y AND x >= pl_x1[i] - 6 AND x <= pl_x2[i] + 6)
              IF (NOT (i == drop_p AND drop_t > 0) AND pl_y[i] < best) best = pl_y[i]; bi = i; END
            END
          END
          IF (bi >= 0)
            on = bi; y = pl_y[bi]; coy = COYOTE;
            IF (vy > 4) play_sound(s_land, 40, 100, (x - 320) / 4); END
            vy = 0;
          END
        END
      END
      IF (drop_t > 0) drop_t--; END
      IF (buf > 0) buf--; END
    END
    IF (swipe_cd > 0) swipe_cd--; END

    // ---- the swipe's reach (the objects look at it)
    sw_on = 0;
    IF (swipe_t > 0)
      swipe_t--;
      IF (swipe_t >= 4 AND swipe_t <= 12)
        sw_on = 1; sw_dir = cat_face;
        IF (cat_face > 0) sw_x1 = x - 4; sw_x2 = x + 40;
        ELSE sw_x1 = x - 40; sw_x2 = x + 4; END
        sw_y1 = y - 44; sw_y2 = y + 2;
      END
    END

    // ---- look
    anim++;
    IF (blink > 0) blink--; ELSE IF (rand(0, 150) == 0) blink = 8; END END
    z = 0;
    IF (mode == 1)
      IF (blink > 0) g = g_cat[6]; ELSE g = g_cat[5]; END
    ELSE IF (mode >= 2)
      g = g_cat[7]; z = 30;                            // behind the table cloth / sofa
    ELSE IF (swipe_t > 0)
      g = g_cat[4];
    ELSE IF (on < 0)
      g = g_cat[3];
    ELSE IF (abs(vx) > 0.5)
      g = g_cat[1 + (anim / 6) % 2];
    ELSE
      g = g_cat[0];
    END END END END END
    IF (state == 3) g = g_cat[8]; x = 330; y = 402; size = 200; z = 0; END
    graph = g;
    flags = cat_face < 0 AND mode != 1 AND state != 3;
    IF (state != 3) size = 100; END
    cat_x = x; cat_y = y; cat_vx = vx;
    cat_mode = 0;
    IF (mode == 1) cat_mode = 1; END
    IF (mode >= 2) cat_mode = 2; END
    FRAME;
  END
END

// =====================================================================
// The owner and the door
// =====================================================================

PROCESS door();
BEGIN
  x = (DOOR_X1 + DOOR_X2) / 2; y = DOOR_TOP + 93; z = 25;
  LOOP
    IF (own_st >= 2) graph = g_door_open; ELSE graph = g_door; END
    FRAME;
  END
END

// Gap before the next visit: shorter in later rooms.
FUNCTION visit_gap();
BEGIN
  RETURN clamp(rand(420, 640) - (level - 1) * 55, 200, 700);
END

PROCESS owner();
PRIVATE t, warn, look, caught, qx, i, a, fake, says, says_t, reason;
BEGIN
  x = (DOOR_X1 + DOOR_X2) / 2 + 2; y = FLOOR; z = 22;
  graph = 0; own_st = 0; own_look = 0;
  t = rand(360, 480);
  LOOP
    says_t--;
    // ---- away: wait (not while the room is being wrecked or on the title)
    IF (own_st == 0)
      graph = 0;
      IF (state == 1) t--; END
      IF (t <= 0)
        own_st = 1;
        warn = clamp(72 - (level - 1) * 7, 40, 72);
        IF (fake) warn = 34; fake = 0; END
        t = warn;
      END
    END
    // ---- coming: footsteps, light under the door, then a shadow
    IF (own_st == 1)
      t--;
      i = warn - t;
      IF (i % 16 == 1) play_sound(s_step, 40 + i, 90 + rand(0, 20), 90); END
      IF (t == 12) play_sound(s_creak, 60, 100, 90); END
      set_color('#ffe9a8');
      draw_rect(DOOR_X1, FLOOR - 4, DOOR_X2 - DOOR_X1, 4);
      a = i * 100 / warn;
      set_color('#3a2830');
      draw_rect(DOOR_X1 + 30 - a / 5, FLOOR - 4, 6, 4);        // feet
      draw_rect(DOOR_X1 + 40 - a / 5, FLOOR - 4, 6, 4);
      // a long shadow spreading out on the floor
      FOR qx = 0 TO 5
        set_color('rgba(40,20,30,' + (a * 0.0055 - qx * 0.05) + ')');
        draw_rect(DOOR_X1 - a * 0.9 + qx * 14, FLOOR + 1 + qx * 2, 40 + a * 0.6 - qx * 8, 3);
      END
      set_color('#5a4040');
      text(DOOR_X1 - 34, DOOR_TOP - 22, "*creak*");
      IF (t <= 0)
        own_st = 2; t = 0; caught = 0; st_visits++;
        look = 110 + level * 18;
        song_play(song_owner);
        play_sound(s_creak2, 60, 100, 90);
      END
    END
    // ---- in the doorway, looking around
    IF (own_st == 2)
      t++;
      graph = g_owner[0];
      own_look = t > 8;
      IF (own_look AND state == 1)
        IF (cat_mode == 2)
          reason = 0;                                 // cannot see the cat at all
        ELSE IF (frame_no - red_t < 40)
          reason = 1;                                 // caught next to the mess
        ELSE IF (cat_mode == 1)
          reason = 0;                                 // "what a good kitty"
        ELSE
          reason = 2;                                 // up to something
        END END END
        IF (reason > 0)
          caught = 1; strikes++; st_strikes++;
          own_st = 4; t = 0;
          play_sound(s_huh, 90, 100, 90);
          play_sound(s_buzz, 60, 70, 0);
          meow(3, 100);
          IF (reason == 1) banner("CAUGHT RED-PAWED!  STRIKE " + strikes, 27, "#ff8070");
          ELSE banner("THAT DOES NOT LOOK INNOCENT!  STRIKE " + strikes, 37, "#ff8070"); END
        END
      END
      IF (own_st == 2 AND t > look)
        own_st = 3; t = 0; st_safe++;
        IF (cat_mode == 2) says = "Hm? Where's the cat...";
        ELSE says = "Aww. Good kitty."; END
        says_t = 70;
        play_sound(s_good, 60, 100, 90);
      END
      set_color('#ffffff');
      IF (t > 8 AND t < 60) text(x - 150, DOOR_TOP - 22, "What's going on in here..?"); END
    END
    // ---- caught: "?!" over the head
    IF (own_st == 4)
      t++;
      graph = g_owner[1];
      IF (t == 14) play_sound(s_huh2, 90, 100, 90); END
      IF (t < 70)
        draw_qm(x - 30, DOOR_TOP - 40 - (t < 8) * (8 - t) * 3);
      ELSE
        own_st = 3; t = 0; says = "BAD CAT!"; says_t = 60;
      END
    END
    // ---- leaving: the door closes, the music changes back
    IF (own_st == 3)
      t++;
      graph = g_owner[0];
      IF (t > 45)
        graph = 0; own_st = 0; own_look = 0;
        song_play(song_main);
        play_sound(s_creak2, 50, 120, 90);
        t = visit_gap();
        // later owners pretend to leave and come straight back
        IF (level >= 3 AND rand(0, 99) < 20 + level * 5) fake = 1; t = rand(60, 110); END
      END
    END
    IF (says_t > 0)
      set_color('#fffbe8');
      draw_rect(x - 160, DOOR_TOP - 34, 150, 16, '#00000080');
      text(x - 154, DOOR_TOP - 30, says);
    END
    IF (state == 3) graph = 0; END
    FRAME;
  END
END

// The "?!" over the owner.
PROCESS qmark(x, y);
BEGIN
  graph = g_qm; z = -30;
  FRAME;
END

FUNCTION draw_qm(px, py);
BEGIN
  qmark(px + 32, py + 22);
  RETURN 0;
END

// A line of big news in the middle of the screen for a while.
FUNCTION banner(s, n, c);
BEGIN
  banner_s = s; banner_w = n; banner_c = c; banner_t = 120;
  RETURN 0;
END

// =====================================================================
// Screens
// =====================================================================

PROCESS sprite(x, y, graph, z);
BEGIN
  LOOP FRAME; END
END

// Everything of the current room goes away.
FUNCTION clear_room();
PRIVATE i;
BEGIN
  signal(TYPE obj, s_kill); signal(TYPE shard, s_kill); signal(TYPE spill, s_kill);
  signal(TYPE fish, s_kill); signal(TYPE popup, s_kill); signal(TYPE furniture, s_kill);
  signal(TYPE room, s_kill); signal(TYPE cat, s_kill); signal(TYPE owner, s_kill);
  signal(TYPE door, s_kill); signal(TYPE meow, s_kill); signal(TYPE sprite, s_kill);
  signal(TYPE qmark, s_kill);
  FRAME;
  FOR i = 0 TO n_lvl_g - 1 free_graphic(lvl_g[i]); END
  n_lvl_g = 0; n_shards = 0; n_obj = 0;
  RETURN 0;
END

FUNCTION build_level();
PRIVATE i, k, fr;
BEGIN
  clear_room();
  gen_layout();
  paint_room();
  room();
  FOR i = 0 TO nf - 1 furniture(i); END
  FRAME;
  total_value = 0;
  gen_objects();
  FOR i = 0 TO n_it - 1
    IF (it_k[i] == O_PLATE)
      FOR k = 0 TO 2 obj(it_x[i], it_y[i] - k * 4.5, O_PLATE, 0); END
    ELSE
      obj(it_x[i], it_y[i], it_k[i], it_v[i]);
    END
  END
  // mess needed: about half of what is there, more in later rooms
  fr = clamp(48 + level * 4, 50, 70);
  target = (total_value * fr / 100) / 10 * 10;
  mess = 0; red_t = -999; own_st = 0; banner_t = 0; high_seen = frame_no; all_down = 0;
  door(); owner(); cat();
  st_rooms++;
  RETURN 0;
END

// The balcony: night, rain and a sad cat.
FUNCTION paint_balcony();
PRIVATE i, h;
BEGIN
  FOR i = 0 TO 479
    gfx_rect(g_balcony, 0, i, 640, 1, 20 + i / 12, 24 + i / 12, 50 + i / 8);
  END
  FOR i = 0 TO 15
    h = 60 + (i * 71) % 140;
    gfx_rect(g_balcony, i * 42, 360 - h, 38, h + 40, 30, 34, 56);
    gfx_rect(g_balcony, i * 42 + 8, 370 - h, 6, 8, 230, 200, 110);
    gfx_rect(g_balcony, i * 42 + 22, 390 - h, 6, 8, 230, 200, 110);
  END
  gfx_circle(g_balcony, 540, 70, 26, 230, 230, 210);
  gfx_rect(g_balcony, 0, 400, 640, 80, 90, 90, 100);                   // the balcony floor
  gfx_rect(g_balcony, 0, 330, 640, 6, 60, 60, 70);                     // railing
  FOR i = 0 TO 32 gfx_rect(g_balcony, i * 20, 330, 4, 70, 60, 60, 70); END
  // the glass door, and the warm room behind it
  gfx_rect(g_balcony, 50, 160, 170, 240, 120, 110, 110);
  gfx_rect(g_balcony, 58, 168, 72, 232, 250, 214, 150);
  gfx_rect(g_balcony, 140, 168, 72, 232, 250, 214, 150);
  gfx_rect(g_balcony, 58, 330, 154, 70, 230, 180, 120);               // the floor in there
  rrect(g_balcony, 70, 300, 60, 40, 8, 190, 110, 90);                  // the sofa
  gfx_rect(g_balcony, 180, 230, 4, 100, 120, 90, 70);                  // a lamp
  tri(g_balcony, 182, 206, 168, 232, 196, 232, 255, 240, 190);
  FOR i = 0 TO 3
    gfx_line(g_balcony, 70 + i * 6, 190, 90 + i * 6, 170, 255, 240, 210);
    gfx_line(g_balcony, 152 + i * 6, 190, 172 + i * 6, 170, 255, 240, 210);
  END
  gfx_circle(g_balcony, 124, 290, 4, 200, 170, 60);                    // door handle
  put_screen(0, g_balcony);
  RETURN 0;
END

FUNCTION draw_hud();
PRIVATE bw, i, c;
BEGIN
  draw_rect(0, 0, 640, 22, '#2a1c1ccc');
  set_color('#ffe0b0');
  text(8, 7, "ROOM " + level);
  text(70, 7, "SCORE " + score);
  // the mess bar
  text(170, 7, "MESS");
  draw_rect(200, 5, 200, 12, '#4a3a38');
  bw = 0;
  IF (target > 0) bw = clamp(mess * 200 / target, 0, 200); END
  draw_rect(200, 5, bw, 12, '#e8904a');
  set_color('#ffffff');
  text(270, 7, "" + mess + " / " + target);
  // strikes
  set_color('#ffe0b0');
  text(470, 7, "STRIKES");
  FOR i = 0 TO 2
    c = '#5a4a48';
    IF (strikes > i) c = '#ff5040'; END
    draw_rect(520 + i * 16, 5, 12, 12, c);
  END
  IF (banner_t > 0)
    banner_t--;
    draw_rect(0, 196, 640, 26, '#000000a0');
    set_color(banner_c);
    text(320 - banner_w * 3, 205, banner_s);
  END
  RETURN 0;
END

// =====================================================================
// Main
// =====================================================================

PRIVATE i, t, k, blink;
BEGIN
  set_mode(640, 480);
  set_fps(60, 0);
  screen_color('#2a1c1c');
  make_graphics();
  make_sounds();
  make_songs();

  LOOP
    // ---- title: the first room behind a panel
    state = 0; level = 1; score = 0; strikes = 0;
    build_level();
    sprite(320, 250, g_panel, -50);
    sprite(320, 170, g_title, -51);
    song_play(song_main);
    t = 0;
    LOOP
      t++;
      set_color('#ffe8c8');
      text(210, 220, "Knock everything off the shelves.");
      text(186, 236, "Don't let the owner catch you at it.");
      set_color('#c8b8a8');
      text(140, 262, "LEFT/RIGHT run    UP/Z/SPACE jump (hold: higher)");
      text(140, 276, "X swipe           C sit innocently");
      text(140, 290, "DOWN  hide under the table / behind the sofa,");
      text(140, 304, "      sit on the floor, drop through furniture");
      IF ((t / 30) % 2 == 0) set_color('#ffd070'); text(250, 336, "PRESS ENTER TO START"); END
      IF (key_pressed(_enter) OR key_pressed(_space) OR key_pressed(_x)) BREAK; END
      FRAME;
    END
    signal(TYPE sprite, s_kill);
    state = 1;
    meow(0, 100);

    // ---- playing
    LOOP
      frame_no++;
      bodies = phys_bodies();
      IF (state == 1 OR state == 2) draw_hud(); END
      // everything is down already (some landed whole): the room counts as wrecked
      IF (state == 1 AND mess < target AND frame_no - high_seen > 150)
        target = mess; all_down = 1;
      END
      IF (state == 1 AND mess >= target AND (target > 0 OR all_down))
        state = 2; clear_t = 0; banner_t = 0;
        play_sound(s_clear, 70, 100, 0);
        meow(0, 120);
        sprite(320, 170, g_clear, -50);
      END
      IF (state == 2)
        clear_t++;
        set_color('#ffffff');
        draw_rect(170, 206, 300, 40 + all_down * 16, '#2a1c1cb0');
        text(236, 214, "Mess made here: " + mess);
        text(206, 230, "You get moved to another room...");
        IF (all_down) set_color('#ffd070'); text(210, 246, "(nothing left up there to knock down)"); END
        IF (clear_t > 200 OR (clear_t > 60 AND key_pressed(_enter)))
          level++;
          build_level();
          state = 1;
        END
      END
      IF (state == 1 AND strikes >= 3)
        over_t++;
        IF (over_t > 90)
          state = 3; over_t = 0;
          clear_room();
          paint_balcony();
          song_stop();
          play_sound(s_over, 70, 100, 0);
          sprite(320, 120, g_over, -50);
          cat();
          meow(1, 80);
          t = 0;
        END
      ELSE
        over_t = 0;
      END
      IF (state == 3)
        t++;
        cat_x = 320;
        // rain
        set_color('#9ab0e0');
        FOR k = 0 TO 40
          draw_rect((k * 97 + t * 3) % 640, (k * 53 + t * 9) % 480, 1, 8);
        END
        set_color('#ffffff');
        text(250, 170, "3 strikes. The door stays shut.");
        text(250, 190, "Mess made: " + score + "   Rooms: " + level);
        text(250, 206, "Things broken: " + st_broken);
        IF ((t / 30) % 2 == 0) set_color('#ffd070'); text(250, 250, "PRESS ENTER TO TRY AGAIN"); END
        IF (t == 180) meow(1, 70); END
        IF (key_pressed(_enter) AND t > 30) BREAK; END
      END
      FRAME;
    END
    // back to the title with a fresh start
    signal(TYPE sprite, s_kill);
  END
END
