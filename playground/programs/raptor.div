PROGRAM raptor;

// STORMWING - a procedural vertical shoot'em up in the spirit of Raptor:
// Call of the Shadows. Nothing is loaded, everything is generated:
//
// * Terrain: every level gets a fresh value-noise lattice, a palette
//   (temperate, desert, arctic), a river, a winding main road and a few
//   cross roads. The ground is painted into a ring of five 480x256 chunk
//   graphics: a chunk that scrolls off the bottom jumps above the screen
//   and is repainted there, two rows of 4-pixel cells per frame, long
//   before it becomes visible. Ground targets (buildings, tanks on the
//   road, gun bunkers, gunboats, fuel depots) are spawned with each chunk
//   and leave craters painted into it when destroyed.
// * Enemy waves come from a small grammar: FORMATION (line, vee, trail,
//   pincer, ring, swarm, heavy) x ENEMY TYPE x FLIGHT PATH (down, swoop
//   along a Bezier curve, orbit, kamikaze dive, hover). Deeper levels pick
//   harder formations, more planes and faster bullets.
// * Each level ends with a boss built from parts: a symmetric hull drawn
//   from a random profile, turret pairs and an armoured core. Phase 1 the
//   turrets fire, phase 2 the core opens and spirals, phase 3 it rages.
// * Bullets, player shots and particles live in fixed pools drawn by one
//   manager process each; everything that can be shot registers in a
//   target table, so hit tests are plain box checks against a short list.
// * Sound, made by the engine as well (sfx, sfx_tone, song_*): guns with
//   a little pitch variation, spread shots, missile launches and lock-on
//   beeps, the laser's hum, explosions by size, hits and armour pings,
//   power-ups, the mega bomb, alarms (low shield, boss warning) and the
//   shop. Music: a chiptune for the title, the flight, the boss and the
//   shop, jingles for a cleared sector and game over. M: music on/off.

GLOBAL
  PFW = 480; PFH = 600;          // playfield size (the panel is on the right)

  // ---- game state
  state = 0;         // 0 title, 1 building, 2 playing, 3 level clear, 4 shop, 5 game over
  lvl = 1; score = 0; hiscore = 0; money = 0; lives = 3; game_over = 0;
  shield = 100.0; shield_max = 100;
  gun_lv = 1; bombs = 2; spec = 0; own_s = 0; own_m = 0; own_l = 0;
  god = 0;           // test hook: 1 = the player takes no damage
  p_inv = 0; player_alive = 0; plx = 240.0; ply = 520.0; laser_on = 0; bomb_flash = 0;
  kills = 0; gkills = 0; picks = 0; forms_seen = 0; wave_i = 0; n_waves = 0; n_air = 0;
  msg_id = 0; msg_t = 0; shop_sel = 0;
  shake = 0.0; shx = 0; shy = 0;

  // ---- scrolling terrain
  scroll_y = 0.0; scroll_spd = 0.8; level_len = 4608; terr_gen = 0;
  LC = 16; LR = 200; lat[3199];  // noise lattice, one value every 32 px
  biome = 0; sea_lvl = 500; land_bias = 0; isl_f = 180; isl_amp = 150; isl_ph = 0;
  river_on = 1; r_x0 = 240; r_f = 70; r_amp = 120; r_ph = 0; r_ph2 = 0;
  o_f = 60; o_ph = 0;
  hr_y[7]; n_hr = 0;             // world y of the cross roads
  bc_r[6]; bc_g[6]; bc_b[6];     // colours of the 7 height bands
  g_chunk[4]; ch_k[4]; ch_done[4];

  // ---- targets: enemies, ground objects and boss parts that can be hit
  t_on[63]; t_x[63]; t_y[63]; t_w[63]; t_h[63]; t_hp[63]; t_flash[63];
  t_air[63];         // 0 ground, 1 plane (rams the player), 2 boss part
  t_arm[63];         // 1 = armoured: absorbs shots without damage
  act[63]; n_act = 0;

  // ---- pools (x, y, velocity, kind...)
  pb_on[95]; pb_x[95]; pb_y[95]; pb_vx[95]; pb_vy[95]; pb_k[95]; pb_dmg[95]; pb_ang[95]; pb_t[95];
  eb_on[239]; eb_x[239]; eb_y[239]; eb_vx[239]; eb_vy[239]; eb_k[239]; n_eb = 0;
  fx_on[159]; fx_x[159]; fx_y[159]; fx_vx[159]; fx_vy[159]; fx_life[159]; fx_max[159]; fx_k[159]; fx_s[159];
  pb_cur = 0; eb_cur = 0; fx_cur = 0;

  // ---- wave script, expanded from the formation grammar per level
  w_at[31]; w_form[31]; w_kind[31]; w_path[31]; w_n[31]; w_side[31];

  // ---- boss
  boss_on = 0; boss_x = 240.0; boss_y = -200.0; boss_phase = 0; boss_hp = 0; boss_max = 1;
  bt_x[5]; bt_y[5]; bt_slot[5]; n_bt = 0; core_slot = -1; core_dy = 0; boss_bh = 100; boss_bw = 200;
  bp[4];

  // ---- graphics
  g_player[2]; g_enemy[4]; g_ground[4]; g_build[2]; g_pick[6];
  g_bturret = 0; g_bwreck = 0; g_core_c = 0; g_core_o = 0; g_panel = 0; g_logo = 0; g_dim = 0; g_boss = 0;

  // ---- sound: ids made once, a private random generator for the pitch
  // variations (the game's rand() sequence stays untouched), times of the
  // last sounds of each kind (rate limits) and the music wanted now
  sn_gun[1]; sn_spread = 0; sn_missile = 0; sn_lock = 0; sn_laser = 0; sn_boom[2]; sn_efire[1];
  sn_ting = 0; sn_hit = 0; sn_phit = 0; sn_alarm = 0; sn_siren = 0; sn_mega = 0; sn_mega2 = 0; sn_die2 = 0;
  sn_pgun = 0; sn_pweap = 0; sn_pbomb = 0; sn_pshield = 0; sn_pcash = 0;
  sn_blip = 0; sn_buy = 0; sn_deny = 0; sn_launch = 0; sn_switch = 0;
  sn_r = 2024; sn_tick = 0; sn_gi = 0; sn_boom_t[2]; sn_efire_t = -99; sn_hit_t = -99; sn_ting_t = -99;
  sn_phit_t = -99; sn_lock_t = -99;
  sn_music = 1; sn_want = 0; sn_cur = -1; sn_loop = 1;
  song_title = 0; song_fly = 0; song_boss = 0; song_shop = 0; song_clear = 0; song_over = 0;

// ==== Small helpers ====
FUNCTION fmin(a, b); BEGIN IF (a < b) RETURN a; END RETURN b; END
FUNCTION fmax(a, b); BEGIN IF (a > b) RETURN a; END RETURN b; END

FUNCTION set_band(i, r, g, b);
BEGIN
  bc_r[i] = r; bc_g[i] = g; bc_b[i] = b;
  RETURN 0;
END

// Value noise: bilinear (smoothstepped) interpolation of the lattice.
FUNCTION latv(px, py);
PRIVATE c0, r0, r1, fx, fy, a, b;
BEGIN
  c0 = px / 32; fx = px % 32; fx = fx * fx * (96 - 2 * fx) / 1024;
  r0 = (py / 32) % LR; r1 = (r0 + 1) % LR; fy = py % 32; fy = fy * fy * (96 - 2 * fy) / 1024;
  r0 = r0 * LC + c0; r1 = r1 * LC + c0;
  a = lat[r0] + (lat[r0 + 1] - lat[r0]) * fx / 32;
  b = lat[r1] + (lat[r1 + 1] - lat[r1]) * fx / 32;
  RETURN a + (b - a) * fy / 32;
END

// Elevation above the sea at world point (wx, wy); wy grows as we fly on.
// Two octaves of noise (32 px detail, 192 px landmasses) plus a trend: open sea at the start of the level,
// then long bands of coast and islands.
FUNCTION hgt(wx, wy);
PRIVATE h, b;
BEGIN
  h = (latv(wx, wy) + latv(wx / 6 + 256, wy / 6 + 3200) * 3) / 4;
  b = land_bias + sin(wy * isl_f + isl_ph) * isl_amp;
  IF (wy < 900) b = b - 420 * (900 - wy) / 900; END
  RETURN h + b - sea_lvl;
END

FUNCTION band_of(d);
BEGIN
  IF (d < -110) RETURN 0; END
  IF (d < -45) RETURN 1; END
  IF (d < 0) RETURN 2; END
  IF (d < 22) RETURN 3; END
  IF (d < 160) RETURN 4; END
  IF (d < 330) RETURN 5; END
  RETURN 6;
END

FUNCTION river_x(wy);
BEGIN
  RETURN r_x0 + sin(wy * r_f + r_ph) * r_amp + sin(wy * r_f * 3 + r_ph2) * 25;
END

FUNCTION road_x(wy);
BEGIN
  RETURN 240 + sin(wy * o_f + o_ph) * 150;
END

// ==== Sound ====

// A random number for sound variations only (a small LCG of our own).
FUNCTION srnd(a, b);
BEGIN
  sn_r = (sn_r * 1103 + 4271) % 65521;
  RETURN a + sn_r % (b - a + 1);
END

// Pan for a playfield x: -70 at the left edge, 70 at the right.
FUNCTION sn_pan(px);
BEGIN
  RETURN clamp(int(px - 240) / 3, -70, 70);
END

FUNCTION make_sounds();
BEGIN
  sn_gun[0] = sfx_tone(wave_square, 1300, 650, 60, 26);
  sn_gun[1] = sfx_tone(wave_noise, 5200, 1600, 55, 24);
  sn_spread = sfx_tone(wave_saw, 1100, 480, 90, 22);
  sn_missile = sfx_tone(wave_noise, 700, 2600, 320, 32);
  sn_lock = sfx_tone(wave_square, 1760, 1760, 45, 22);
  sn_laser = sfx_tone(wave_saw, 150, 178, 190, 22);
  sn_boom[0] = sfx(sfx_explosion, 2);            // small, medium, large
  sn_boom[1] = sfx(sfx_explosion, 13);
  sn_boom[2] = sfx(sfx_explosion, 27);
  sn_efire[0] = sfx_tone(wave_square, 720, 340, 70, 18);
  sn_efire[1] = sfx_tone(wave_saw, 420, 190, 110, 20);
  sn_ting = sfx_tone(wave_triangle, 2600, 2000, 70, 30);
  sn_hit = sfx(sfx_hit, 5);
  sn_phit = sfx(sfx_hit, 19);
  sn_alarm = sfx_tone(wave_square, 1000, 1000, 90, 24);
  sn_siren = sfx_tone(wave_square, 380, 900, 420, 28);
  sn_mega = sfx_tone(wave_noise, 320, 30, 1500, 80);
  sn_mega2 = sfx_tone(wave_sine, 120, 30, 1200, 70);
  sn_die2 = sfx_tone(wave_saw, 900, 60, 1000, 28);
  sn_pgun = sfx(sfx_powerup, 1);
  sn_pweap = sfx(sfx_powerup, 6);
  sn_pbomb = sfx_tone(wave_triangle, 150, 620, 260, 55);
  sn_pshield = sfx_tone(wave_sine, 300, 1300, 380, 50);
  sn_pcash = sfx(sfx_coin, 2);
  sn_blip = sfx(sfx_blip, 2);
  sn_switch = sfx(sfx_blip, 9);
  sn_buy = sfx(sfx_coin, 7);
  sn_deny = sfx_tone(wave_square, 140, 110, 200, 34);
  sn_launch = sfx_tone(wave_noise, 300, 2200, 700, 40);
  sn_boom_t[0] = -99; sn_boom_t[1] = -99; sn_boom_t[2] = -99;
  RETURN 0;
END

FUNCTION make_songs();
BEGIN
  // Title: a heroic tune in D
  song_title = song_new(128);
  song_track(song_title, inst_square,
    "D5 - - A4 - - D5 - E5 - F#5 - E5 - D5 - | C#5 - - A4 - - C#5 - E5 - - - A4 - - - |" +
    "B4 - - G4 - - B4 - D5 - G5 - F#5 - E5 - | F#5 - - D5 - - A4 - D5 - - - - - . . ", 34);
  song_track(song_title, inst_bass,
    "D4 . D5 . D4 . D5 . D4 . D5 . D4 . D5 . | A3 . A4 . A3 . A4 . A3 . A4 . A3 . A4 . |" +
    "G3 . G4 . G3 . G4 . G3 . G4 . G3 . G4 . | D4 . D5 . D4 . D5 . A3 . A4 . A3 . A4 . ", 50);
  song_track(song_title, inst_pad,
    "D4 - - - - - - - - - - - - - - - | A3 - - - - - - - - - - - - - - - |" +
    "G3 - - - - - - - - - - - - - - - | D4 - - - - - - - A3 - - - - - - - ", 20);
  song_track(song_title, inst_drums, "k . h . s . h . k . k . s . h h ", 36);
  // Flight: a driving tune in D minor
  song_fly = song_new(150);
  song_track(song_fly, inst_square,
    "D5 . D5 F5 . D5 G5 . F5 . D5 . C5 . A4 . | D5 . D5 F5 . D5 A5 . G5 . F5 . E5 . C5 . |" +
    "Bb4 . Bb4 D5 . Bb4 F5 . E5 . D5 . C5 . A4 . | A4 . C#5 . E5 . G5 . A5 - - - . . . . ", 26);
  song_track(song_fly, inst_bass,
    "D4 . D4 D5 . D4 D4 D5 D4 . D4 D5 . D4 D5 . | D4 . D4 D5 . D4 D4 D5 D4 . D4 D5 . D4 D5 . |" +
    "Bb3 . Bb3 Bb4 . Bb3 Bb3 Bb4 Bb3 . Bb3 Bb4 . Bb3 Bb4 . | A3 . A3 A4 . A3 A3 A4 A3 . A3 A4 . A3 A4 . ", 48);
  song_track(song_fly, inst_drums, "k . h . s . h k k . h . s . h h ", 38);
  // Boss: fast, chromatic, menacing
  song_boss = song_new(164);
  song_track(song_boss, inst_saw,
    "E5 . F5 . E5 . Eb5 . E5 . . . B4 . C5 . | E5 . F5 . E5 . Eb5 . E5 . G5 . F5 . Eb5 . |" +
    "C5 . Db5 . C5 . B4 . C5 . . . G4 . Ab4 . | B4 . C5 . D5 . Eb5 . E5 - - - . . . . ", 20);
  song_track(song_boss, inst_bass,
    "E4 E4 E5 E4 E4 E4 E5 E4 E4 E4 E5 E4 F4 F4 F5 F4 | E4 E4 E5 E4 E4 E4 E5 E4 E4 E4 E5 E4 F4 F4 F5 F4 |" +
    "C4 C4 C5 C4 C4 C4 C5 C4 C4 C4 C5 C4 Db4 Db4 Db5 Db4 | B3 B3 B4 B3 B3 B3 B4 B3 B3 B3 B4 B3 B3 B3 B4 B3 ", 50);
  song_track(song_boss, inst_drums, "k h k h s h k h k h k h s h s s ", 40);
  // Shop: relaxed
  song_shop = song_new(96);
  song_track(song_shop, inst_pluck,
    "C5 . E5 . G5 . E5 . A5 . G5 . E5 . D5 . | F5 . A5 . C6 . A5 . G5 . E5 . D5 . . . ", 30);
  song_track(song_shop, inst_bass,
    "C4 . . . G3 . . . A3 . . . E3 . . . | F3 . . . C4 . . . G3 . . . G3 . . . ", 45);
  song_track(song_shop, inst_pad,
    "C4 - - - - - - - A3 - - - - - - - | F3 - - - - - - - G3 - - - - - - - ", 16);
  song_track(song_shop, inst_drums, "k . . h . . s . . h k . s . h . ", 22);
  // Jingles, played once
  song_clear = song_new(140);
  song_track(song_clear, inst_square, "C5 . E5 . G5 . C6 - - - G5 . C6 - - - - - - - . . . . ", 42);
  song_track(song_clear, inst_bass, "C4 - - - - - - - G3 - - - C4 - - - - - - - . . . . ", 55);
  song_track(song_clear, inst_drums, "k . . . s . . . k . k . s . . . k . . . . . . . ", 40);
  song_over = song_new(90);
  song_track(song_over, inst_square, "D5 - C5 - A4 - F4 - E4 - - - D4 - - - - - - - . . . . ", 38);
  song_track(song_over, inst_bass, "D4 - - - Bb3 - - - A3 - - - D3 - - - - - - - . . . . ", 55);
  song_track(song_over, inst_drums, "k . . . . . . . k . . . s . . . k . . . . . . . ", 36);
  music_volume(40);
  RETURN 0;
END

FUNCTION want_song(sng, lp);
BEGIN
  sn_want = sng; sn_loop = lp;
  RETURN 0;
END

// Picks the music for the moment, loops the laser's hum and the low
// shield alarm, and toggles the music with M. A jingle (loop 0) plays
// even with the music off.
PROCESS snd_director();
BEGIN
  LOOP
    sn_tick = sn_tick + 1;
    IF (state == 0) want_song(song_title, 1); END
    IF (state == 1 OR state == 2)
      IF (boss_on == 1) want_song(song_boss, 1); ELSE want_song(song_fly, 1); END
    END
    IF (state == 3) want_song(song_clear, 0); END
    IF (state == 4) want_song(song_shop, 1); END
    IF (state == 5) want_song(song_over, 0); END
    IF (key_pressed(_m)) sn_music = 1 - sn_music; sn_cur = -1; END
    IF (sn_want != sn_cur)
      IF (sn_want AND (sn_music OR sn_loop == 0)) song_play(sn_want, sn_loop); ELSE song_stop(); END
      sn_cur = sn_want;
    END
    IF (laser_on AND player_alive AND sn_tick % 9 == 0) play_sound(sn_laser, 45, srnd(92, 108), sn_pan(plx)); END
    IF (state == 2 AND player_alive AND shield * 4 < shield_max AND sn_tick % 50 == 0)
      sn_arp(sn_alarm, 40, 7, 100, 100, 0, 0);
    END
    FRAME;
  END
END

// Up to four notes of sound snd (pitch percent, 0 none), gap frames apart.
PROCESS sn_arp(snd, vol, gap, a, b, c, d);
PRIVATE k = 0; p = 0;
BEGIN
  FROM k = 0 TO 3;
    p = a;
    IF (k == 1) p = b; END
    IF (k == 2) p = c; END
    IF (k == 3) p = d; END
    IF (p > 0) play_sound(snd, vol, p, 0); END
    FRAME(gap * 100);
  END
END

// A sound at most every `gap` frames: returns 1 when it may play now.
FUNCTION sn_ready(t, gap);
BEGIN
  RETURN sn_tick - t >= gap;
END

// ==== Generated graphics. Planes face right (angle 0) like every DIV sprite. ====

// A plane seen from above in a w x h graphic. span1/span2 are the half
// spans of the upper and lower wing (a banking plane shows one shorter).
FUNCTION draw_plane(w, h, span1, span2, r, g, b, style);
PRIVATE gr, cy, j, x0, x1, tx, n;
BEGIN
  gr = blank(w, h); cy = h / 2;
  // main wings: filled by lines from the root chord to the swept tips
  x0 = w * 30 / 100; x1 = w * 62 / 100; n = x1 - x0;
  FROM j = 0 TO n;
    tx = x0 - w * 10 / 100 + j * 45 / 100;
    gfx_line(gr, x0 + j, cy, tx, cy - span1, r, g, b);
    gfx_line(gr, x0 + j, cy, tx, cy + span2, r * 7 / 10, g * 7 / 10, b * 7 / 10);
  END
  // tail planes
  FROM j = 0 TO w * 14 / 100;
    tx = w * 2 / 100 + j * 5 / 10;
    gfx_line(gr, w * 5 / 100 + j, cy, tx, cy - span1 * 4 / 10, r, g, b);
    gfx_line(gr, w * 5 / 100 + j, cy, tx, cy + span2 * 4 / 10, r * 7 / 10, g * 7 / 10, b * 7 / 10);
  END
  // fuselage and nose
  gfx_rect(gr, w * 4 / 100, cy - 2, w * 78 / 100, 5, r * 8 / 10 + 30, g * 8 / 10 + 30, b * 8 / 10 + 30);
  gfx_line(gr, w * 82 / 100, cy - 2, w - 1, cy, r, g, b);
  gfx_line(gr, w * 82 / 100, cy + 2, w - 1, cy, r, g, b);
  gfx_line(gr, w * 82 / 100, cy, w - 1, cy, r, g, b);
  gfx_rect(gr, 0, cy - 1, w * 5 / 100 + 2, 3, 255, 170, 60);        // exhaust
  gfx_circle(gr, w * 66 / 100, cy, 2 + w / 40, 150, 220, 255);      // canopy
  gfx_circle(gr, w * 67 / 100, cy - 1, 1, 240, 250, 255);
  IF (style == 1)       // twin engines under the wings
    gfx_rect(gr, x0, cy - span1 / 2 - 3, w * 30 / 100, 6, 60, 60, 66);
    gfx_rect(gr, x0, cy + span2 / 2 - 3, w * 30 / 100, 6, 60, 60, 66);
    gfx_rect(gr, x0 - 3, cy - span1 / 2 - 1, 3, 3, 255, 150, 50);
    gfx_rect(gr, x0 - 3, cy + span2 / 2 - 1, 3, 3, 255, 150, 50);
  END
  IF (style == 2)       // warning stripes
    gfx_rect(gr, x0 + 2, cy - span1 + 4, 3, span1 + span2 - 8, 250, 220, 60);
  END
  IF (style == 3)       // four engines of a bomber
    FROM j = 1 TO 2;
      gfx_rect(gr, x0 + 4, cy - span1 * j / 3 - 3, w * 22 / 100, 6, 50, 50, 56);
      gfx_rect(gr, x0 + 4, cy + span2 * j / 3 - 3, w * 22 / 100, 6, 50, 50, 56);
    END
  END
  gfx_circle(gr, x0 + n / 3, cy - span1 * 6 / 10, 2, 255, 255, 255);  // insignia
  gfx_circle(gr, x0 + n / 3, cy + span2 * 6 / 10, 2, 255, 255, 255);
  RETURN gr;
END

// An empty (transparent) graphic to draw on
FUNCTION blank(w, h);
PRIVATE gr;
BEGIN
  gr = new_graphic(w, h); gfx_fill_rgba(gr, 0, 0, 0, 0);
  RETURN gr;
END

FUNCTION pick_graphic(letter, r, g, b);
PRIVATE gr;
BEGIN
  gr = blank(24, 24);
  gfx_circle(gr, 12, 12, 11, r / 3, g / 3, b / 3); gfx_circle(gr, 12, 12, 9, r, g, b);
  gfx_circle(gr, 12, 12, 7, r * 6 / 10, g * 6 / 10, b * 6 / 10);
  gfx_text(gr, 8, 5, letter, 255, 255, 255, 14);
  RETURN gr;
END

FUNCTION make_graphics();
PRIVATE gr, j, a;
BEGIN
  // player: level, banking left, banking right (steel blue)
  g_player[0] = draw_plane(40, 40, 18, 18, 120, 150, 190, 0);
  g_player[1] = draw_plane(40, 40, 13, 18, 120, 150, 190, 0);
  g_player[2] = draw_plane(40, 40, 18, 13, 120, 150, 190, 0);
  g_enemy[0] = draw_plane(30, 28, 12, 12, 170, 70, 60, 0);     // dart fighter
  g_enemy[1] = draw_plane(48, 46, 21, 21, 90, 110, 70, 1);     // gunship
  g_enemy[3] = draw_plane(26, 22, 9, 9, 200, 60, 40, 2);       // kamikaze
  g_enemy[4] = draw_plane(70, 72, 34, 34, 80, 80, 100, 3);     // bomber
  // spinner: a saucer with blades (it rotates as it flies)
  gr = blank(34, 34); g_enemy[2] = gr;
  FROM j = 0 TO 3;
    a = j * 90000 + 20000;
    gfx_line(gr, 17, 17, 17 + get_distx(a, 16), 17 + get_disty(a, 16), 200, 200, 90);
    gfx_line(gr, 18, 17, 18 + get_distx(a, 16), 17 + get_disty(a, 16), 200, 200, 90);
  END
  gfx_circle(gr, 17, 17, 11, 70, 50, 110); gfx_circle(gr, 17, 17, 9, 140, 90, 200);
  gfx_circle(gr, 17, 17, 4, 255, 120, 220); gfx_circle(gr, 16, 16, 1, 255, 240, 255);
  // buildings: three roof colours with a drop shadow
  FROM j = 0 TO 2;
    gr = blank(34, 30); g_build[j] = gr;
    gfx_rect(gr, 5, 5, 28, 24, 20, 20, 20); gfx_rect(gr, 1, 1, 28, 24, 90 + j * 40, 70 + j * 10, 60 + j * 30);
    gfx_rect(gr, 1, 12, 28, 2, 50, 40, 40); gfx_rect(gr, 4, 4, 8, 5, 170, 170, 160);
    gfx_rect_outline(gr, 1, 1, 28, 24, 40, 30, 30);
  END
  g_ground[0] = g_build[0];
  // tank: tracks, hull, turret, gun to the right
  gr = blank(28, 22); g_ground[1] = gr;
  gfx_rect(gr, 1, 1, 24, 5, 40, 40, 36); gfx_rect(gr, 1, 16, 24, 5, 40, 40, 36);
  gfx_rect(gr, 3, 4, 20, 14, 90, 100, 60); gfx_circle(gr, 12, 11, 5, 70, 80, 45);
  gfx_rect(gr, 14, 10, 13, 3, 30, 30, 30);
  // bunker turret: dome and barrel (the concrete pad is painted into the ground)
  gr = blank(30, 30); g_ground[2] = gr;
  gfx_rect(gr, 15, 12, 15, 6, 40, 40, 44); gfx_circle(gr, 13, 15, 9, 60, 64, 70);
  gfx_circle(gr, 13, 15, 7, 120, 124, 120); gfx_circle(gr, 11, 13, 2, 200, 200, 190);
  // gunboat facing right
  gr = blank(44, 18); g_ground[3] = gr;
  gfx_rect(gr, 1, 3, 32, 12, 90, 90, 100);
  FROM j = 0 TO 9; gfx_line(gr, 33, 3 + j / 2, 43, 9, 90, 90, 100); gfx_line(gr, 33, 14 - j / 2, 43, 9, 90, 90, 100); END
  gfx_rect(gr, 8, 6, 12, 6, 160, 160, 150);
  gfx_circle(gr, 28, 9, 3, 60, 60, 60); gfx_rect(gr, 29, 8, 8, 2, 30, 30, 30);
  // fuel depot: two tanks
  gr = blank(34, 34); g_ground[4] = gr;
  gfx_circle(gr, 12, 13, 10, 30, 30, 30); gfx_circle(gr, 11, 12, 9, 200, 200, 190); gfx_circle(gr, 9, 10, 3, 250, 250, 240);
  gfx_circle(gr, 24, 24, 8, 30, 30, 30); gfx_circle(gr, 23, 23, 7, 210, 90, 60); gfx_circle(gr, 22, 21, 2, 250, 180, 150);

  // boss parts: turret (faces right), wreck, closed and open core
  gr = blank(30, 30); g_bturret = gr;
  gfx_rect(gr, 14, 11, 16, 3, 30, 30, 34); gfx_rect(gr, 14, 16, 16, 3, 30, 30, 34);
  gfx_circle(gr, 14, 15, 10, 40, 40, 46); gfx_circle(gr, 14, 15, 8, 150, 60, 50); gfx_circle(gr, 12, 13, 3, 240, 150, 120);
  gr = blank(30, 30); g_bwreck = gr;
  gfx_circle(gr, 15, 15, 10, 30, 26, 24); gfx_circle(gr, 13, 16, 5, 70, 40, 30);
  gr = blank(40, 40); g_core_c = gr;
  gfx_circle(gr, 20, 20, 18, 40, 40, 46); gfx_circle(gr, 20, 20, 15, 110, 110, 120);
  gfx_line(gr, 6, 6, 34, 34, 50, 50, 56); gfx_line(gr, 6, 34, 34, 6, 50, 50, 56); gfx_rect(gr, 4, 19, 32, 2, 50, 50, 56);
  gr = blank(40, 40); g_core_o = gr;
  gfx_circle(gr, 20, 20, 18, 40, 40, 46); gfx_circle(gr, 20, 20, 15, 160, 20, 30);
  gfx_circle(gr, 20, 20, 10, 240, 60, 60); gfx_circle(gr, 20, 20, 5, 255, 220, 120);

  // power-ups: P gun, S spread, M missiles, L laser, B bomb, E energy, $ cash
  g_pick[0] = pick_graphic("P", 230, 200, 40); g_pick[1] = pick_graphic("S", 60, 200, 90);
  g_pick[2] = pick_graphic("M", 230, 110, 40); g_pick[3] = pick_graphic("L", 80, 150, 255);
  g_pick[4] = pick_graphic("B", 220, 50, 50);  g_pick[5] = pick_graphic("E", 60, 210, 230);
  g_pick[6] = pick_graphic("$", 90, 170, 60);

  // side panel: brushed metal with riveted frames
  g_panel = new_graphic(160, 600);
  gfx_fill(g_panel, 34, 38, 46);
  FROM j = 0 TO 59; gfx_rect(g_panel, 0, j * 10, 160, 1, 40, 44, 52); END
  gfx_rect(g_panel, 0, 0, 3, 600, 90, 96, 110);
  FROM j = 0 TO 5;
    gfx_rect_outline(g_panel, 8, 8 + j * 98, 144, 90, 70, 76, 90);
    gfx_circle(g_panel, 12, 12 + j * 98, 1, 120, 126, 140); gfx_circle(g_panel, 147, 12 + j * 98, 1, 120, 126, 140);
  END

  // title logo and game-over plate, translucent (write() texts go over them)
  g_logo = new_graphic(440, 340);
  gfx_fill_rgba(g_logo, 5, 10, 20, 62); gfx_rect_outline(g_logo, 0, 0, 440, 340, 250, 190, 60);
  gfx_text(g_logo, 14, 24, "STORMWING", 20, 20, 30, 64); gfx_text(g_logo, 10, 20, "STORMWING", 250, 190, 60, 64);
  gfx_text(g_logo, 60, 98, "a procedural raid over hostile shores", 220, 230, 240, 14);
  g_dim = new_graphic(360, 110);
  gfx_fill_rgba(g_dim, 5, 10, 20, 70); gfx_rect_outline(g_dim, 0, 0, 360, 110, 255, 96, 80);
  RETURN 0;
END

// The boss is drawn nose down (it never rotates). The hull follows a random
// profile of five half widths, with swept wings, panels and engine glow;
// turret pairs sit on the wings and the core in the belly.
FUNCTION make_boss();
PRIVATE bw, bh, cx, yy, hw, hw2, seg, fr, wy0, wy1, wr, j, px, py, pw, ph2, r, g, b, np, tx, ty;
BEGIN
  bw = 220 + rand(0, 4) * 20; bh = 130 + rand(0, 30);
  boss_bw = bw; boss_bh = bh;
  IF (g_boss) free_graphic(g_boss); END
  g_boss = blank(bw, bh);
  cx = bw / 2;
  r = rand(70, 120); g = rand(70, 110); b = rand(80, 130);
  bp[0] = rand(18, 30); bp[1] = rand(32, 50); bp[2] = rand(40, 58); bp[3] = rand(28, 44); bp[4] = rand(8, 16);
  wy0 = bh * 28 / 100; wy1 = bh * 56 / 100; wr = bw / 2 - 4;
  FROM yy = 0 TO bh - 1;
    seg = yy * 400 / bh; fr = seg % 100; seg = seg / 100;
    hw = bp[seg] + (bp[seg + 1] - bp[seg]) * fr / 100;
    IF (yy >= wy0 AND yy <= wy1)
      hw2 = wr - (yy - wy0) * wr * 4 / 10 / (wy1 - wy0);
      gfx_rect(g_boss, cx - hw2, yy, hw2 * 2, 1, r * 7 / 10, g * 7 / 10, b * 7 / 10);
      gfx_rect(g_boss, cx - hw2, yy, 3, 1, 230, 60, 50);          // wing tip lights
      gfx_rect(g_boss, cx + hw2 - 3, yy, 3, 1, 230, 60, 50);
    END
    gfx_rect(g_boss, cx - hw, yy, hw * 2, 1, r + yy / 4, g + yy / 4, b + yy / 4);
    gfx_rect(g_boss, cx - hw, yy, 2, 1, 30, 30, 36);
    gfx_rect(g_boss, cx + hw - 2, yy, 2, 1, 30, 30, 36);
  END
  // symmetric armour panels
  FROM j = 1 TO 16;
    px = rand(4, 60); py = rand(8, bh - 12); pw = rand(4, 14); ph2 = rand(3, 9);
    gfx_rect(g_boss, cx - px - pw, py, pw, ph2, r * 6 / 10, g * 6 / 10, b * 6 / 10);
    gfx_rect(g_boss, cx + px, py, pw, ph2, r * 6 / 10, g * 6 / 10, b * 6 / 10);
  END
  gfx_rect(g_boss, cx - 1, 4, 2, bh - 8, 40, 40, 46);              // spine
  FROM j = 0 TO 2;                                                 // engines at the rear
    gfx_rect(g_boss, cx - 30 + j * 25, 0, 10, 7, 255, 150 + j * 30, 60);
  END
  // turret pairs spread along the wings
  n_bt = fmin(2 + lvl / 2 * 2, 6);
  np = n_bt / 2;
  FROM j = 0 TO np - 1;
    tx = 38 + j * (wr - 60) / np + rand(0, 6);
    ty = (wy0 + wy1) / 2 + (j % 2) * 8 - 4;
    bt_x[j * 2] = -tx; bt_y[j * 2] = ty - bh / 2;
    bt_x[j * 2 + 1] = tx; bt_y[j * 2 + 1] = ty - bh / 2;
    gfx_circle(g_boss, cx - tx, ty, 13, 30, 30, 34);
    gfx_circle(g_boss, cx + tx, ty, 13, 30, 30, 34);
  END
  core_dy = bh * 68 / 100 - bh / 2;
  gfx_circle(g_boss, cx, bh / 2 + core_dy, 21, 30, 30, 34);
  RETURN 0;
END

// ==== Pools: enemy bullets, player shots, particles ====
FUNCTION eshot(px, py, a, spd, k);
PRIVATE j, i;
BEGIN
  FROM j = 0 TO 47;                  // look a little ahead of the cursor only
    i = (eb_cur + j) % 240;
    IF (eb_on[i] == 0)
      eb_on[i] = 1; eb_x[i] = px; eb_y[i] = py; eb_k[i] = k;
      eb_vx[i] = get_distx(a, spd); eb_vy[i] = get_disty(a, spd);
      eb_cur = i + 1;
      IF (sn_ready(sn_efire_t, 8))
        sn_efire_t = sn_tick;
        play_sound(sn_efire[k % 2], 32, srnd(90, 115), sn_pan(px));
      END
      RETURN i;
    END
  END
  RETURN -1;
END

// n bullets fanned around angle a, `gap` apart
FUNCTION fan(px, py, a, n, gap, spd, k);
PRIVATE j;
BEGIN
  FROM j = 0 TO n - 1; eshot(px, py, a + (j * 2 - n + 1) * gap / 2, spd, k); END
  RETURN 0;
END

FUNCTION ring_shot(px, py, n, a0, spd, k);
PRIVATE j;
BEGIN
  FROM j = 0 TO n - 1; eshot(px, py, a0 + j * 360000 / n, spd, k); END
  RETURN 0;
END

FUNCTION pshot(px, py, a, spd, k, dmg);
PRIVATE j, i;
BEGIN
  FROM j = 0 TO 31;
    i = (pb_cur + j) % 96;
    IF (pb_on[i] == 0)
      pb_on[i] = 1; pb_x[i] = px; pb_y[i] = py; pb_k[i] = k; pb_dmg[i] = dmg;
      pb_ang[i] = a; pb_t[i] = 0;
      pb_vx[i] = get_distx(a, spd); pb_vy[i] = get_disty(a, spd);
      pb_cur = i + 1;
      RETURN i;
    END
  END
  RETURN -1;
END

FUNCTION fx_add(k, px, py, vx, vy, life, s);
PRIVATE j, i;
BEGIN
  FROM j = 0 TO 31;                  // pool full: the particle is simply dropped
    i = (fx_cur + j) % 160;
    IF (fx_on[i] == 0)
      fx_on[i] = 1; fx_k[i] = k; fx_x[i] = px; fx_y[i] = py; fx_vx[i] = vx; fx_vy[i] = vy;
      fx_life[i] = life; fx_max[i] = life; fx_s[i] = s;
      fx_cur = i + 1;
      RETURN i;
    END
  END
  RETURN -1;
END

// sz 1 small, 2 medium, 3 large (shakes the screen)
FUNCTION explode(px, py, sz);
PRIVATE j, a, sp;
BEGIN
  FROM j = 1 TO sz * 3;
    fx_add(1, px + rand(-sz * 6, sz * 6), py + rand(-sz * 6, sz * 6), rand(-10, 10) * 0.05,
           rand(-10, 10) * 0.05 + 0.4, rand(18, 28) + sz * 5, rand(6, 9) + sz * 4);
  END
  FROM j = 1 TO sz * 4;
    a = rand(0, 359999); sp = rand(20, 40 + sz * 15) * 0.1;
    fx_add(0, px, py, get_distx(a, sp), get_disty(a, sp), rand(14, 30), 2);
  END
  FROM j = 1 TO sz;
    fx_add(2, px + rand(-8, 8), py + rand(-8, 8), 0, scroll_spd, rand(50, 80), rand(8, 12) + sz * 3);
  END
  IF (sz >= 2) fx_add(3, px, py, 0, 0, 12, 14 + sz * 14); END
  IF (sz >= 3 AND shake < 9) shake = 9; END
  IF (sn_ready(sn_boom_t[sz - 1], 3))            // one of each size every few frames
    sn_boom_t[sz - 1] = sn_tick;
    play_sound(sn_boom[sz - 1], 40 + sz * 20, 170 - sz * 35 + srnd(-10, 10), sn_pan(px));
  END
  RETURN 0;
END

FUNCTION spark(px, py);
BEGIN
  fx_add(0, px, py, rand(-15, 15) * 0.1, rand(-25, 5) * 0.1, rand(6, 12), 2);
  RETURN 0;
END

// ==== Target table ====
FUNCTION t_alloc(px, py, w, h, hp, air, arm);
PRIVATE s;
BEGIN
  FROM s = 0 TO 63;
    IF (t_on[s] == 0)
      t_on[s] = 1; t_x[s] = px; t_y[s] = py; t_w[s] = w; t_h[s] = h; t_hp[s] = hp;
      t_flash[s] = 0; t_air[s] = air; t_arm[s] = arm;
      RETURN s;
    END
  END
  RETURN -1;
END

FUNCTION hurt(d);
BEGIN
  IF (p_inv > 0 OR god OR player_alive == 0) RETURN 0; END
  shield = shield - d; shake = fmax(shake, 3);
  IF (sn_ready(sn_phit_t, 6)) sn_phit_t = sn_tick; play_sound(sn_phit, 75, srnd(70, 85), sn_pan(plx)); END
  RETURN 1;
END

// A random power-up at px,py (weighted toward what the player lacks).
FUNCTION drop(px, py);
PRIVATE r, k;
BEGIN
  r = rand(0, 99); k = 6;
  IF (r < 86) k = 5; END             // E shield 16%
  IF (r < 70) k = 4; END             // B bomb 12%
  IF (r < 58) k = 3; END             // L, M, S 12% each
  IF (r < 46) k = 2; END
  IF (r < 34) k = 1; END
  IF (r < 22 AND gun_lv < 5) k = 0; END   // P gun upgrade 22%; the rest is $ cash
  pickup(k, px, py);
  RETURN 0;
END

FUNCTION say(id);
BEGIN
  msg_id = id; msg_t = 150;
  // the sound of each event
  IF (id == 0) play_sound(sn_launch, 60, 100, 0); END
  IF (id == 1) play_sound(sn_pgun, 70, 100, 0); END
  IF (id >= 2 AND id <= 4) play_sound(sn_pweap, 70, 90 + id * 10, 0); END
  IF (id == 5) play_sound(sn_pbomb, 70, 100, 0); END
  IF (id == 6) play_sound(sn_pshield, 70, 100, 0); END
  IF (id == 7) sn_arp(sn_pcash, 60, 5, 100, 150, 0, 0); END
  IF (id == 8) sn_arp(sn_siren, 55, 28, 100, 100, 100, 0); END     // boss warning
  IF (id == 9) sn_arp(sn_alarm, 50, 6, 100, 126, 150, 0); END
  IF (id == 10) sn_arp(sn_siren, 55, 16, 120, 120, 120, 120); END
  IF (id == 12) play_sound(sn_die2, 60, 100, 0); END
  IF (id == 13) play_sound(sn_mega, 100, 100, 0); play_sound(sn_mega2, 90, 100, 0); END
  RETURN 0;
END

FUNCTION msg_text(id);
BEGIN
  SWITCH (id)
    CASE 1 RETURN "MAIN GUN UPGRADED";
    CASE 2 RETURN "SPREAD SHOT";
    CASE 3 RETURN "HOMING MISSILES";
    CASE 4 RETURN "PLASMA LASER";
    CASE 5 RETURN "MEGA BOMB +1";
    CASE 6 RETURN "SHIELD RECHARGED";
    CASE 7 RETURN "CASH BONUS +2500";
    CASE 8 RETURN "WARNING - LARGE TARGET APPROACHING";
    CASE 9 RETURN "CORE EXPOSED!";
    CASE 10 RETURN "BOSS ENRAGED!";
    CASE 11 RETURN "SECTOR CLEAR - BONUS PAID";
    CASE 12 RETURN "SHIP LOST";
    CASE 13 RETURN "MEGA BOMB!";
  END
  RETURN "SECTOR " + lvl + " - GET READY";
END

FUNCTION wname(s);
BEGIN
  IF (s == 0) RETURN "NONE"; END
  RETURN msg_text(s + 1);
END

FUNCTION owns(s);
BEGIN
  IF (s == 1) RETURN own_s; END
  IF (s == 2) RETURN own_m; END
  IF (s == 3) RETURN own_l; END
  RETURN 0;
END

// ==== Terrain: level parameters and the ring of chunk painters ====
FUNCTION setup_level(n);
PRIVATE i, wy;
BEGIN
  biome = (n - 1) % 3;
  IF (biome == 0)        // temperate
    set_band(0, 20, 50, 110); set_band(1, 30, 80, 150); set_band(2, 60, 130, 180);
    set_band(3, 210, 195, 130); set_band(4, 80, 140, 62); set_band(5, 44, 100, 48); set_band(6, 120, 118, 100);
    land_bias = 30;
  END
  IF (biome == 1)        // desert
    set_band(0, 15, 70, 100); set_band(1, 25, 110, 140); set_band(2, 70, 170, 170);
    set_band(3, 232, 214, 156); set_band(4, 212, 170, 105); set_band(5, 186, 136, 80); set_band(6, 140, 95, 62);
    land_bias = 90;
  END
  IF (biome == 2)        // arctic
    set_band(0, 12, 28, 58); set_band(1, 32, 58, 92); set_band(2, 96, 128, 150);
    set_band(3, 150, 150, 156); set_band(4, 214, 224, 234); set_band(5, 176, 190, 204); set_band(6, 120, 125, 136);
    land_bias = 0;
  END
  land_bias = land_bias + rand(-30, 30);
  isl_f = rand(150, 230); isl_amp = rand(110, 190); isl_ph = rand(0, 359999);
  river_on = 1; IF (biome == 1) river_on = rand(0, 1); END
  r_x0 = rand(150, 330); r_f = rand(55, 95); r_amp = rand(70, 130); r_ph = rand(0, 359999); r_ph2 = rand(0, 359999);
  o_f = rand(45, 75); o_ph = rand(0, 359999);
  level_len = fmin(4096 + n * 512, 6144);
  n_hr = 0; wy = 1100 + rand(0, 300);
  WHILE (wy < level_len + 1500 AND n_hr < 8)
    hr_y[n_hr] = wy - wy % 4 + 2; n_hr = n_hr + 1;
    wy = wy + rand(700, 1200);
  END
  FROM i = 0 TO 3199; lat[i] = rand(0, 1000); END
  scroll_y = 0; terr_gen = terr_gen + 1;
  RETURN 0;
END

// One row of 4x4 cells: height band colour with a little jitter, the river cut in.
FUNCTION paint_row(gr, k, cr);
PRIVATE wy, cx, wx, d, band, j, rx, dr;
BEGIN
  wy = k * 256 + 253 - cr * 4;
  rx = -999; IF (river_on) rx = river_x(wy); END
  FROM cx = 0 TO 119;
    wx = cx * 4 + 2;
    d = hgt(wx, wy) + rand(-8, 8);
    band = band_of(d);
    IF (band >= 3)
      dr = abs(wx - rx);
      IF (dr < 11) band = 1; ELSE IF (dr < 15) band = 2; END END
    END
    j = rand(-7, 7);
    gfx_rect(gr, cx * 4, cr * 4, 4, 4, bc_r[band] + j, bc_g[band] + j, bc_b[band] + j);
  END
  RETURN 0;
END

// Scattered details: whitecaps, trees, dunes, rocks, fields.
FUNCTION decorate(gr, k);
PRIVATE j, px, py, wy, band, c;
BEGIN
  FROM j = 1 TO 170;
    px = rand(2, 477); py = rand(2, 253); wy = k * 256 + 255 - py;
    band = band_of(hgt(px, wy));
    IF (band <= 1 AND rand(0, 2) == 0)
      gfx_line(gr, px, py, px + rand(3, 7), py, bc_r[2], bc_g[2], bc_b[2]);
    END
    IF (band == 4 AND rand(0, 5) == 0 AND biome == 0)     // fields
      c = rand(0, 1) * 40;
      gfx_rect(gr, px, py, rand(12, 26), rand(10, 20), 150 + c, 150 + c / 2, 70);
    END
    IF (band == 5 OR (band == 4 AND rand(0, 3) == 0))
      IF (biome == 1)
        gfx_line(gr, px - 6, py, px + 6, py - 2, 150, 105, 60);            // dune ridge
      ELSE
        c = rand(0, 2);
        gfx_circle(gr, px + 1, py + 1, 3 + c, 20, 40, 25);                 // shadow
        gfx_circle(gr, px, py, 2 + c, bc_r[5] - 20, bc_g[5] - 25, bc_b[5] - 20);
        gfx_circle(gr, px - 1, py - 1, 1, bc_r[5] + 30, bc_g[5] + 30, bc_b[5] + 20);
      END
    END
    IF (band == 6)
      gfx_circle(gr, px, py, rand(2, 4), bc_r[6] + 40, bc_g[6] + 40, bc_b[6] + 40);
    END
  END
  RETURN 0;
END

// The main road (2-pixel strips following road_x, bridges over the river)
// and the cross roads of this chunk.
FUNCTION roads(gr, k);
PRIVATE r, wy, rx, cx, wx, j, row, onr;
BEGIN
  FROM r = 0 TO 127;
    wy = k * 256 + 255 - r * 2;
    rx = int(road_x(wy));
    IF (hgt(rx, wy) >= 2)
      onr = 0; IF (river_on) IF (abs(rx - river_x(wy)) < 17) onr = 1; END END
      IF (onr) gfx_rect(gr, rx - 9, r * 2, 18, 2, 110, 80, 50);
      ELSE gfx_rect(gr, rx - 8, r * 2, 16, 2, 150, 145, 130); END
      gfx_rect(gr, rx - 6, r * 2, 12, 2, 70, 70, 74);
      IF ((wy / 8) % 2 == 0) gfx_rect(gr, rx - 1, r * 2, 2, 2, 220, 210, 120); END
    END
  END
  FOR (j = 0; j < n_hr; j = j + 1)
    IF (hr_y[j] >= k * 256 + 8 AND hr_y[j] < k * 256 + 248)
      row = 255 - (hr_y[j] - k * 256);
      FROM cx = 0 TO 119;
        wx = cx * 4 + 2;
        IF (hgt(wx, hr_y[j]) >= 2)
          gfx_rect(gr, cx * 4, row - 6, 4, 12, 150, 145, 130);
          gfx_rect(gr, cx * 4, row - 5, 4, 10, 70, 70, 74);
          IF (cx % 3 == 0) gfx_rect(gr, cx * 4, row, 4, 1, 220, 210, 120); END
        END
      END
    END
  END
  RETURN 0;
END

// Ground targets for chunk k: gunboats at sea, towns, tanks and depots
// along the road, bunkers inland.
FUNCTION populate(slot, k);
PRIVATE j, n, px, wy, d, rx, r;
BEGIN
  IF (k < 2 OR state > 2) RETURN 0; END
  n = fmin(3 + lvl, 9);
  FROM j = 1 TO n;
    px = rand(24, 456); wy = k * 256 + rand(10, 246);
    d = hgt(px, wy);
    rx = road_x(wy);
    r = rand(0, 99);
    IF (d < -70)
      IF (r < 20) gobj(3, slot, k, px, wy); END
    ELSE
      IF (d >= 6 AND (river_on == 0 OR abs(px - river_x(wy)) > 22))
        IF (abs(px - rx) < 70 AND hgt(int(rx), wy) >= 2)
          IF (r < 30) gobj(1, slot, k, rx, wy);
          ELSE
            IF (abs(px - rx) < 22) px = rx + 30 * sign(px - rx + 0.1); END
            IF (r < 80) gobj(0, slot, k, px, wy); ELSE gobj(4, slot, k, px, wy); END
          END
        ELSE
          IF (r < 45) gobj(2, slot, k, px, wy);
          ELSE IF (r < 65) gobj(0, slot, k, px, wy); ELSE IF (r < 75) gobj(4, slot, k, px, wy); END END
          END
        END
      END
    END
  END
  RETURN 0;
END

// Chunk slot s shows world chunk k (256 px of world each). The five slots
// form a ring: the slot that scrolls off the bottom takes chunk k+5 and
// repaints it above the screen, two cell rows per frame.
PROCESS chunk(slot);
PRIVATE k = -1; gen = -1; row = 0; base = 0; want = 0;
BEGIN
  graph = g_chunk[slot]; z = 1000;
  LOOP
    base = int(scroll_y) / 256;
    want = base + (slot - base % 5 + 5) % 5;
    IF (want != k OR gen != terr_gen)
      k = want; gen = terr_gen; row = 0; ch_k[slot] = -1; ch_done[slot] = -1;
    END
    IF (row < 64)
      paint_row(graph, k, row); paint_row(graph, k, row + 1);
      row = row + 2;
    ELSE
      IF (row == 64) decorate(graph, k); row = 65;
      ELSE IF (row == 65) roads(graph, k); row = 66;
      ELSE IF (row == 66)
        ch_k[slot] = k; ch_done[slot] = gen; row = 67;
        populate(slot, k);
      END END END
    END
    x = 240 + shx; y = PFH - (k * 256 + 128 - scroll_y) + shy;
    FRAME;
  END
END

// Paints a crater (or rubble) into the terrain where a ground target died.
FUNCTION crater(slot, k, gwx, gwy, r);
PRIVATE ly, gr, j;
BEGIN
  IF (ch_k[slot] != k) RETURN 0; END
  gr = g_chunk[slot]; ly = 255 - (gwy - k * 256);
  gfx_circle(gr, gwx, ly, r, 58, 46, 34);
  gfx_circle(gr, gwx, ly, r * 7 / 10, 36, 30, 24);
  FROM j = 1 TO 6; gfx_circle(gr, gwx + rand(-r, r), ly + rand(-r, r), rand(1, 3), 25, 22, 20); END
  RETURN 0;
END

// ==== Ground targets: 0 building, 1 tank, 2 bunker, 3 gunboat, 4 fuel depot ====
PROCESS gobj(kind, slot, k, gwx, gwy);
PRIVATE ts = -1; gen = 0; lx = 0.0; ly = 0.0; ft = 0; hp = 0; val = 0; vx = 0.0; ox = 0.0; hw = 12;
BEGIN
  gen = terr_gen; z = 600; ft = rand(60, 180);
  SWITCH (kind)
    CASE 0 graph = g_build[rand(0, 2)]; hp = 6; val = 150; hw = 14;
    CASE 1 graph = g_ground[1]; hp = 8; val = 250; hw = 12; angle = -90000;
    CASE 2 graph = g_ground[2]; hp = 10; val = 300; hw = 12;
      IF (ch_k[slot] == k)   // concrete pad painted into the ground
        gfx_circle(g_chunk[slot], gwx, 255 - (gwy - k * 256), 15, 110, 110, 104);
        gfx_circle(g_chunk[slot], gwx, 255 - (gwy - k * 256), 12, 140, 140, 132);
      END
    CASE 3 graph = g_ground[3]; hp = 12; val = 350; hw = 16; vx = 0.4; IF (rand(0, 1)) vx = -0.4; END
    CASE 4 graph = g_ground[4]; hp = 5; val = 500; hw = 15;
  END
  hp = hp * (8 + lvl * 2) / 10;
  LOOP
    IF (terr_gen != gen) BREAK; END
    IF (kind == 1 AND hgt(int(road_x(gwy - 1)), int(gwy) - 1) >= 2)     // tanks drive down the road
      ox = gwx; gwy = gwy - 0.45; gwx = road_x(gwy);
      angle = fget_angle(0, 0, gwx - ox, 0.45);
    END
    IF (kind == 3)                                     // boats patrol, turning at the shore
      IF (gwx + vx * 40 < 20 OR gwx + vx * 40 > 460 OR hgt(int(gwx + vx * 40), int(gwy)) > -40) vx = -vx; END
      gwx = gwx + vx;
      IF (vx > 0) angle = 0; ELSE angle = 180000; END
    END
    lx = gwx; ly = PFH - (gwy - scroll_y);
    IF (ly > PFH + 40) BREAK; END
    IF (ts < 0 AND ly > -20) ts = t_alloc(lx, ly, hw, hw, hp, 0, 0); END
    IF (ts >= 0)
      t_x[ts] = lx; t_y[ts] = ly;
      IF (t_hp[ts] <= 0)
        IF (kind == 4) explode(lx, ly, 3); ELSE explode(lx, ly, 2); END
        IF (kind != 3) crater(slot, k, int(gwx), int(gwy), 10 + (kind == 4) * 6); END
        score = score + val; money = money + val; gkills = gkills + 1;
        IF (rand(0, 99) < 12) drop(lx, ly); END
        BREAK;
      END
      IF (t_flash[ts] > 0) red = 255; green = 120; blue = 120; ELSE red = 255; green = 255; blue = 255; END
      IF (kind == 2) angle = fget_angle(lx, ly, plx, ply); END
      IF (state == 2 AND player_alive AND ly > 20 AND ly < PFH - 150 AND kind >= 1 AND kind <= 3)
        ft = ft - 1;
        IF (ft <= 0)
          IF (kind == 3) fan(lx, ly, fget_angle(lx, ly, plx, ply), 3, 14000, 2.2 + lvl * 0.3, 1);
          ELSE eshot(lx, ly, fget_angle(lx, ly, plx, ply), 2.4 + lvl * 0.3, 0); END
          ft = rand(90, 170) - lvl * 10;
        END
      END
    END
    x = lx + shx; y = ly + shy;
    FRAME;
  END
  IF (ts >= 0) t_on[ts] = 0; END
END

// =====================================================================
// Air enemies. kind: 0 dart, 1 gunship, 2 spinner, 3 kamikaze, 4 bomber.
// pth: 0 down (sway), 1 swoop (Bezier), 2 orbit, 3 dive, 4 hover.
// =====================================================================
PROCESS enemy(kind, pth, sx, sy, delay, p1);
PRIVATE ts = -1; t = 0; lx = -100.0; ly = -100.0; ox = 0.0; oy = 0.0; u = 0.0; hp = 0; val = 0;
        ft = 0; spd = 0.0; ang = 0; ccy = 0.0; hw = 12; bs = 0.0; sp_a = 0; burst = 0; p0x = 0; p2x = 0; big = 1;
BEGIN
  n_air = n_air + 1;
  WHILE (delay > 0) delay = delay - 1; FRAME; END
  z = 0; graph = g_enemy[kind];
  SWITCH (kind)
    CASE 0 hp = 3; val = 100; hw = 13;
    CASE 1 hp = 16; val = 400; hw = 20; big = 2;
    CASE 2 hp = 7; val = 150; hw = 14;
    CASE 3 hp = 2; val = 80; hw = 11;
    CASE 4 hp = 50; val = 1200; hw = 30; big = 3;
  END
  hp = hp * (10 + (lvl - 1) * 4) / 10;
  bs = fmin(2.4 + lvl * 0.35, 5.5);
  ft = rand(40, 120);
  ts = t_alloc(lx, ly, hw, hw, hp, 1, 0);
  IF (pth == 1) p0x = -40; p2x = 520; IF (p1) p0x = 520; p2x = -40; END END
  WHILE (ts >= 0)
    t = t + 1; ox = lx; oy = ly;
    SWITCH (pth)
      CASE 0 lx = sx + sin(t * 1400 + p1 * 60000) * 22; ly = sy + t * (1.5 + lvl * 0.1);
      CASE 1 u = t / (260 + 0.001);
        lx = (1 - u) * (1 - u) * p0x + 2 * u * (1 - u) * 240 + u * u * p2x;
        ly = (1 - u) * (1 - u) * sy + 2 * u * (1 - u) * 640 + u * u * sy;
        IF (u > 1) BREAK; END
      CASE 2 ccy = fmin(-60 + t * 1.6, 180); IF (t > 480) ccy = 180 + (t - 480) * 2.5; END
        lx = sx + get_distx(p1 + t * 1800, 80); ly = ccy + get_disty(p1 + t * 1800, 80);
      CASE 3
        IF (t < 45) lx = sx; ly = -30 + t * 2.6;
        ELSE
          IF (t == 45) ang = fget_angle(lx, ly, plx, ply); spd = 1.5; END
          IF (t < 80) ang = lerp_angle(ang, fget_angle(lx, ly, plx, ply), 0.08); END
          spd = fmin(spd + 0.18, 8.5);
          lx = lx + get_distx(ang, spd); ly = ly + get_disty(ang, spd);
        END
      CASE 4 ly = fmin(-40 + t * 1.2, p1); lx = sx + sin(t * 700) * 110 * fmin(t / (120 + 0.001), 1);
        IF (t > 620) ly = p1 + (t - 620) * 1.4; END
    END
    IF (kind == 2) angle = angle + 9000;
    ELSE IF (pth == 4) angle = -90000;
    ELSE IF (abs(lx - ox) + abs(ly - oy) > 0.1) angle = fget_angle(ox, oy, lx, ly); END END
    END
    t_x[ts] = lx; t_y[ts] = ly;
    IF (t_hp[ts] <= 0)
      explode(lx, ly, big);
      score = score + val; money = money + val; kills = kills + 1;
      IF (kind == 1 OR kind == 4 OR rand(0, 99) < 9) drop(lx, ly); END
      BREAK;
    END
    IF (t > 60 AND (ly > PFH + 50 OR ly < -140 OR lx < -90 OR lx > PFW + 90)) BREAK; END
    IF (t_flash[ts] > 0) red = 255; green = 110; blue = 110; ELSE red = 255; green = 255; blue = 255; END
    // firing patterns
    IF (state == 2 AND player_alive AND ly > 10 AND ly < PFH - 130 AND lx > 10 AND lx < PFW - 10)
      ft = ft - 1;
      IF (ft <= 0)
        SWITCH (kind)
          CASE 0 eshot(lx, ly, fget_angle(lx, ly, plx, ply), bs, 0); ft = rand(110, 200) - lvl * 10;
          CASE 1 fan(lx, ly + 10, fget_angle(lx, ly, plx, ply), 3 + (lvl > 1) * 2, 12000, bs * 0.9, 1);
            ft = 100 - lvl * 8;
          CASE 2 sp_a = sp_a + 27000; eshot(lx, ly, sp_a, bs * 0.7, 2); eshot(lx, ly, sp_a + 180000, bs * 0.7, 2);
            burst = burst + 1; ft = 7; IF (burst % 10 == 0) ft = 90; END
          CASE 3 ft = 999;
          CASE 4 burst = burst + 1;
            IF (burst % 2 == 1) ring_shot(lx, ly, 12 + lvl * 2, rand(0, 30000), bs * 0.75, 1);
            ELSE fan(lx, ly + 20, fget_angle(lx, ly, plx, ply), 3, 6000, bs, 0); END
            ft = 70;
        END
      END
    END
    x = lx + shx; y = ly + shy;
    FRAME;
  END
  IF (ts >= 0) t_on[ts] = 0; END
  n_air = n_air - 1;
END

// Expands wave i of the script into enemy processes.
FUNCTION spawn_wave(i);
PRIVATE form, kind, n, j, o, cx, m;
BEGIN
  form = w_form[i]; kind = w_kind[i]; n = w_n[i];
  m = pow(2, form);                          // remember which formations flew
  IF ((forms_seen / m) % 2 == 0) forms_seen = forms_seen + m; END
  SWITCH (form)
    CASE 0   // LINE abreast
      FROM j = 0 TO n - 1;
        IF (kind == 1) enemy(1, 4, 60 + j * 360 / (n - 1), 0, j * 20, 110 + rand(0, 40));
        ELSE enemy(kind, 0, 60 + j * 360 / (n - 1), -30, 0, j); END
      END
    CASE 1   // VEE: the leader is lowest, the wings trail behind
      FROM j = 0 TO n - 1;
        o = j - n / 2;
        enemy(kind, 0, 240 + o * 42, -30 - abs(o) * 34, 0, 0);
      END
    CASE 2   // TRAIL: one after another along a swoop
      FROM j = 0 TO n - 1; enemy(kind, 1, 0, 50 + rand(0, 60), j * 16, w_side[i]); END
    CASE 3   // PINCER: two mirrored trails
      FROM j = 0 TO n - 1; enemy(kind, 1, 0, 70, j * 18, 0); enemy(kind, 1, 0, 70, j * 18, 1); END
    CASE 4   // RING of circlers around one centre
      cx = rand(150, 330);
      FROM j = 0 TO n - 1; enemy(2, 2, cx, 0, 0, j * 360000 / n); END
    CASE 5   // SWARM of kamikazes
      FROM j = 0 TO n - 1; enemy(3, 3, rand(40, 440), -30, j * 22, 0); END
    CASE 6   // HEAVY with an escort
      enemy(kind, 4, rand(170, 310), 0, 0, 120);
      IF (n > 1) enemy(kind, 4, rand(120, 360), 0, 90, 200); END
      enemy(0, 0, 160, -60, 30, 0); enemy(0, 0, 320, -60, 30, 0);
  END
  RETURN 0;
END

// The formation grammar: WAVE -> FORMATION KIND PATH COUNT. Weights move
// toward heavier formations as the level number grows.
FUNCTION make_waves(n);
PRIVATE i, r, f;
BEGIN
  n_waves = fmin(12 + n * 2, 30);
  FROM i = 0 TO n_waves - 1;
    w_at[i] = 300 + i * (level_len - 800) / n_waves;
    r = rand(0, 99) + fmin(n - 1, 4) * 6;
    IF (r < 18) f = 0; ELSE IF (r < 34) f = 1; ELSE IF (r < 50) f = 2; ELSE IF (r < 62) f = 3;
    ELSE IF (r < 76) f = 4; ELSE IF (r < 90) f = 5; ELSE f = 6; END END END END END END
    IF (i < 2) f = i; END                    // start gently: a line, then a vee
    w_form[i] = f; w_side[i] = rand(0, 1); w_kind[i] = 0;
    SWITCH (f)
      CASE 0 w_n[i] = fmin(4 + n, 7); IF (n > 1 AND rand(0, 3) == 0) w_kind[i] = 1; w_n[i] = 3; END
      CASE 1 w_n[i] = fmin(5 + n, 9);
      CASE 2 w_n[i] = fmin(4 + n, 8); IF (n > 1 AND rand(0, 2) == 0) w_kind[i] = 3; END
      CASE 3 w_n[i] = fmin(3 + n / 2, 5);
      CASE 4 w_n[i] = fmin(4 + n / 2, 7); w_kind[i] = 2;
      CASE 5 w_n[i] = fmin(4 + n, 9); w_kind[i] = 3;
      CASE 6 w_kind[i] = 1; IF (n > 1) w_kind[i] = 4; END w_n[i] = 1 + (n > 2);
    END
  END
  RETURN 0;
END

// ==== Boss and its parts ====
PROCESS bturret(i);
PRIVATE ts = -1; lx = 0.0; ly = 0.0; ft = 0; shots = 0;
BEGIN
  graph = g_bturret; z = 40; ft = 60 + i * 15;
  ts = t_alloc(0, -200, 13, 13, 60 + lvl * 20, 2, 0);
  bt_slot[i] = ts;
  WHILE (boss_on == 1)
    lx = boss_x + bt_x[i]; ly = boss_y + bt_y[i];
    IF (ts >= 0)
      t_x[ts] = lx; t_y[ts] = ly;
      angle = fget_angle(lx, ly, plx, ply);
      IF (t_flash[ts] > 0) red = 255; green = 120; blue = 120; ELSE red = 255; green = 255; blue = 255; END
      IF (boss_phase == 1 AND ly > 20 AND player_alive)
        ft = ft - 1;
        IF (ft <= 0)
          shots = shots + 1;
          IF (shots % 3 == 0) fan(lx, ly, angle, 3, 11000, 2.6 + lvl * 0.3, 1); ft = 70 - lvl * 5;
          ELSE eshot(lx, ly, angle, 3.2 + lvl * 0.3, 0); ft = 14; END
        END
      END
      IF (t_hp[ts] <= 0)
        explode(lx, ly, 2); score = score + 1000; money = money + 1000;
        t_on[ts] = 0; ts = -1; bt_slot[i] = -1; graph = g_bwreck; angle = 0;
        red = 255; green = 255; blue = 255;
        IF (shake < 5) shake = 5; END
      END
    END
    x = lx + shx; y = ly + shy;
    FRAME;
  END
  IF (ts >= 0) t_on[ts] = 0; END
END

PROCESS bcore();
PRIVATE ts = -1; lx = 0.0; ly = 0.0; ft = 0; sa = 0; n = 0;
BEGIN
  graph = g_core_c; z = 40;
  ts = t_alloc(0, -200, 17, 17, 300 + lvl * 100, 2, 1);
  core_slot = ts;
  WHILE (boss_on == 1 AND ts >= 0)
    lx = boss_x; ly = boss_y + core_dy;
    t_x[ts] = lx; t_y[ts] = ly;
    IF (boss_phase >= 2)
      graph = g_core_o; t_arm[ts] = 0;
      size = 100 + sin(n * 9000) * 8;
      IF (t_flash[ts] > 0) red = 255; green = 180; blue = 180; ELSE red = 255; green = 255; blue = 255; END
      IF (player_alive AND boss_phase < 4)
        n = n + 1;
        IF (boss_phase == 2)          // double spiral, aimed fans
          IF (n % 6 == 0) sa = sa + 13000; ring_shot(lx, ly, 2, sa, 2.6 + lvl * 0.2, 2); END
          IF (n % 100 == 0) fan(lx, ly, fget_angle(lx, ly, plx, ply), 5, 9000, 3.2, 1); END
        ELSE                          // enraged: three arms and rings
          IF (n % 5 == 0) sa = sa - 11000; ring_shot(lx, ly, 3, sa, 3 + lvl * 0.2, 2); END
          IF (n % 70 == 0) ring_shot(lx, ly, 18, rand(0, 20000), 2.4, 1); END
          IF (n % 45 == 0) fan(lx, ly, fget_angle(lx, ly, plx, ply), 3, 5000, 4.2, 0); END
        END
      END
    END
    x = lx + shx; y = ly + shy;
    FRAME;
  END
  IF (ts >= 0) t_on[ts] = 0; END
END

PROCESS boss();
PRIVATE t = 0; lx = 240.0; ly = -200.0; j = 0; alive = 0; hp = 0; amp = 0; dt = 0;
BEGIN
  make_boss();
  graph = g_boss; z = 50; ly = -boss_bh; boss_on = 1; boss_phase = 1;
  boss_x = lx; boss_y = ly; core_slot = -1;
  FROM j = 0 TO n_bt - 1; bturret(j); END
  bcore();
  FRAME;
  boss_max = (60 + lvl * 20) * n_bt + 300 + lvl * 100;
  LOOP
    t = t + 1;
    amp = fmin(40 + boss_phase * 20, (PFW - boss_bw) / 2 + 30);
    IF (ly < 130) ly = ly + 0.8; ELSE ly = 130 + sin(t * 900) * 14; END
    lx = 240 + sin(t * 500) * amp * fmin(t / (400 + 0.001), 1);
    boss_x = lx; boss_y = ly;
    // health = what is left of every part
    alive = 0; hp = 0;
    FROM j = 0 TO n_bt - 1; IF (bt_slot[j] >= 0) alive = alive + 1; hp = hp + fmax(t_hp[bt_slot[j]], 0); END END
    IF (core_slot >= 0) hp = hp + fmax(t_hp[core_slot], 0); END
    boss_hp = hp;
    IF (boss_phase == 1 AND alive == 0) boss_phase = 2; say(9); END
    IF (boss_phase == 2 AND t_hp[core_slot] < (300 + lvl * 100) / 2) boss_phase = 3; say(10); END
    // the nose cannon joins in phase 1 and 3
    IF (boss_phase != 2 AND t % 150 == 0 AND player_alive AND ly > 60)
      fan(lx, ly + boss_bh / 2 - 8, -90000, 5, 14000, 2.8, 1);
    END
    IF (boss_phase == 3 AND t % 240 == 0) enemy(3, 3, rand(40, 440), -30, 0, 0); enemy(3, 3, rand(40, 440), -30, 20, 0); END
    IF (t_hp[core_slot] <= 0) BREAK; END
    x = lx + shx; y = ly + shy;
    FRAME;
  END
  // death: a chain of explosions over the hull, then the big one
  boss_phase = 4;
  t_arm[core_slot] = 1;              // the core frees its own slot when boss_on changes
  FROM dt = 1 TO 130;
    IF (dt % 6 == 0) explode(lx + rand(-boss_bw / 3, boss_bw / 3), ly + rand(-boss_bh / 3, boss_bh / 3), 2); shake = 5; END
    alpha = 100 - dt / 2;
    x = lx + shx; y = ly + shy;
    FRAME;
  END
  FROM j = 1 TO 5; explode(lx + rand(-60, 60), ly + rand(-40, 40), 3); END
  shake = 14; bomb_flash = 20;
  play_sound(sn_mega, 90, 80, 0); play_sound(sn_mega2, 80, 80, 0);
  score = score + 5000 * lvl; money = money + 5000 * lvl;
  boss_on = 2;
END

// ==== Player ====
PROCESS player();
PRIVATE fire_t = 0; spec_t = 0; dead_t = 0; s = 0; dx = 0; dy = 0; tick = 0; sp = 4.2;
BEGIN
  z = -20; graph = g_player[0]; angle = 90000;
  plx = 240; ply = 520; p_inv = 150; player_alive = 1;
  LOOP
    tick = tick + 1;
    laser_on = 0;
    IF (player_alive)
      dx = key(_right) + key(_d) - key(_left) - key(_a);
      dy = key(_down) + key(_s) - key(_up) - key(_w);
      dx = clamp(dx, -1, 1); dy = clamp(dy, -1, 1);
      plx = clamp(plx + dx * sp, 20, PFW - 20); ply = clamp(ply + dy * sp, 40, PFH - 24);
      graph = g_player[0];
      IF (dx < 0) graph = g_player[1]; END
      IF (dx > 0) graph = g_player[2]; END
      // weapons
      fire_t = fire_t - 1; spec_t = spec_t - 1;
      IF (key(_z) OR key(_space) OR key(_control))
        IF (fire_t <= 0)
          fire_t = 6; IF (gun_lv >= 2) fire_t = 5; END
          pshot(plx - 6, ply - 16, 90000, 12, 0, 1); pshot(plx + 6, ply - 16, 90000, 12, 0, 1);
          IF (gun_lv >= 3) pshot(plx, ply - 20, 90000, 12, 0, 1); END
          IF (gun_lv >= 4) pshot(plx - 14, ply - 8, 94000, 12, 0, 1); pshot(plx + 14, ply - 8, 86000, 12, 0, 1); END
          IF (gun_lv >= 5) pshot(plx - 16, ply - 6, 104000, 11, 0, 1); pshot(plx + 16, ply - 6, 76000, 11, 0, 1); END
          sn_gi = 1 - sn_gi;                          // two gun sounds in turn, pitch varied
          play_sound(sn_gun[sn_gi], 34, srnd(90, 112) + gun_lv * 3, sn_pan(plx));
        END
        IF (spec == 1 AND spec_t <= 0)
          FROM s = -1 TO 1 STEP 2;
            pshot(plx, ply - 12, 90000 + s * 10000, 10, 1, 1);
            pshot(plx, ply - 12, 90000 + s * 22000, 10, 1, 1);
          END
          play_sound(sn_spread, 34, srnd(95, 110), sn_pan(plx));
          spec_t = 13;
        END
        IF (spec == 2 AND spec_t <= 0)
          pshot(plx - 14, ply, 125000, 3, 2, 4); pshot(plx + 14, ply, 55000, 3, 2, 4);
          play_sound(sn_missile, 50, srnd(90, 110), sn_pan(plx));
          spec_t = 34;
        END
        IF (spec == 3) laser_on = 1; END
      END
      IF ((key_pressed(_x) OR key_pressed(_b)) AND bombs > 0 AND state == 2)
        bombs = bombs - 1; bomb_flash = 24; shake = 12; say(13);
        FROM s = 0 TO 239; eb_on[s] = 0; END
        FROM s = 0 TO 63; IF (t_on[s] AND t_arm[s] == 0) t_hp[s] = t_hp[s] - 30; t_flash[s] = 6; END END
      END
      IF (key_pressed(_c))                     // cycle through owned special weapons
        FROM s = 1 TO 3;
          spec = spec % 3 + 1;
          IF (owns(spec)) BREAK; END
        END
        IF (owns(spec) == 0) spec = 0; END
        play_sound(sn_switch, 45, 100 + spec * 12, 0);
      END
      // ramming planes
      FROM s = 0 TO 63;
        IF (t_on[s] AND t_air[s] == 1)
          IF (abs(t_x[s] - plx) < t_w[s] + 10 AND abs(t_y[s] - ply) < t_h[s] + 10)
            IF (hurt(22)) t_hp[s] = t_hp[s] - 20; END
          END
        END
      END
      IF (tick % 3 == 0) fx_add(1, plx + rand(-2, 2), ply + 20, 0, 1.5, 8, 4); END   // exhaust
      IF (shield <= 0)
        explode(plx, ply, 3); explode(plx, ply - 10, 2);
        player_alive = 0; lives = lives - 1; dead_t = 110; graph = 0; say(12);
      END
      IF (p_inv > 0)
        p_inv = p_inv - 1;
        IF ((p_inv / 5) % 2 == 0) alpha = 100; ELSE alpha = 35; END
      ELSE alpha = 100; END
    ELSE
      dead_t = dead_t - 1;
      IF (dead_t <= 0)
        IF (lives > 0)
          shield = shield_max; plx = 240; ply = 540; p_inv = 150; player_alive = 1; graph = g_player[0];
        ELSE
          game_over = 1;
        END
      END
    END
    x = plx + shx; y = ply + shy;
    FRAME;
  END
END

// Power-up: P gun, S spread, M missiles, L laser, B bomb, E shield, $ cash
PROCESS pickup(kind, px, py);
PRIVATE t = 0; lx = 0.0; ly = 0.0;
BEGIN
  graph = g_pick[kind]; z = -5; lx = px; ly = py;
  LOOP
    t = t + 1; ly = ly + 0.9; lx = clamp(lx + sin(t * 3000) * 0.7, 14, PFW - 14);
    IF (ly > PFH + 20) BREAK; END
    IF (player_alive AND abs(lx - plx) < 22 AND abs(ly - ply) < 22)
      picks = picks + 1;
      SWITCH (kind)
        CASE 0 IF (gun_lv < 5) gun_lv = gun_lv + 1; END say(1);
        CASE 1 own_s = 1; spec = 1; say(2);
        CASE 2 own_m = 1; spec = 2; say(3);
        CASE 3 own_l = 1; spec = 3; say(4);
        CASE 4 bombs = fmin(bombs + 1, 9); say(5);
        CASE 5 shield = fmin(shield + 40, shield_max); say(6);
        CASE 6 money = money + 2500; say(7);
      END
      fx_add(3, lx, ly, 0, 0, 10, 26);
      BREAK;
    END
    size = 100 + sin(t * 8000) * 12;
    x = lx + shx; y = ly + shy;
    FRAME;
  END
END

// ==== Managers: player shots (and laser), enemy bullets, particles ====
PROCESS pshots();
PRIVATE i, j, s, hit, arm, best, bd, d, q;
BEGIN
  LOOP
    n_act = 0;
    FROM s = 0 TO 63;
      IF (t_on[s])
        act[n_act] = s; n_act = n_act + 1;
        IF (t_flash[s] > 0) t_flash[s] = t_flash[s] - 1; END
      END
    END
    // plasma laser: a beam that burns everything above the ship
    IF (laser_on AND player_alive)
      q = ply - 20;
      FOR (j = 0; j < n_act; j = j + 1)
        s = act[j];
        IF (t_y[s] < ply AND abs(t_x[s] - plx) < t_w[s] + 5 AND t_y[s] > -10)
          IF (t_arm[s] == 0) t_hp[s] = t_hp[s] - (0.3 + gun_lv * 0.06); t_flash[s] = 2; END
          IF (rand(0, 5) == 0) spark(plx + rand(-4, 4), t_y[s] + t_h[s]); END
        END
      END
      draw_rect(plx - 4 + shx, shy, 8, q, 'rgba(90,160,255,0.45)');
      draw_rect(plx - 2 + shx, shy, 4, q, 'rgba(180,220,255,0.8)');
      draw_rect(plx - 1 + shx, shy, 2, q, '#ffffff');
    END
    FROM i = 0 TO 95;
      IF (pb_on[i])
        IF (pb_k[i] == 2)                // homing missile
          pb_t[i] = pb_t[i] + 1;
          best = -1; bd = 99999;
          FOR (j = 0; j < n_act; j = j + 1)
            s = act[j];
            IF (t_arm[s] == 0 AND t_y[s] > 0)
              d = abs(t_x[s] - pb_x[i]) + abs(t_y[s] - pb_y[i]);
              IF (d < bd) bd = d; best = s; END
            END
          END
          IF (best >= 0 AND pb_t[i] == 9 AND sn_ready(sn_lock_t, 8))   // lock-on beep
            sn_lock_t = sn_tick; sn_arp(sn_lock, 30, 4, 100, 150, 0, 0);
          END
          IF (best >= 0 AND pb_t[i] > 8)
            pb_ang[i] = lerp_angle(pb_ang[i], fget_angle(pb_x[i], pb_y[i], t_x[best], t_y[best]), 0.14);
          ELSE IF (pb_t[i] > 8) pb_ang[i] = lerp_angle(pb_ang[i], 90000, 0.1); END END
          d = fmin(3 + pb_t[i] * 0.25, 8);
          pb_vx[i] = get_distx(pb_ang[i], d); pb_vy[i] = get_disty(pb_ang[i], d);
          IF (pb_t[i] % 3 == 0) fx_add(2, pb_x[i], pb_y[i], 0, scroll_spd, 22, 4); END
          IF (pb_t[i] > 150) pb_on[i] = 0; END
        END
        pb_x[i] = pb_x[i] + pb_vx[i]; pb_y[i] = pb_y[i] + pb_vy[i];
        IF (pb_y[i] < -10 OR pb_y[i] > PFH + 10 OR pb_x[i] < -10 OR pb_x[i] > PFW + 4)
          pb_on[i] = 0;
        ELSE
          hit = -1; arm = -1;
          FOR (j = 0; j < n_act; j = j + 1)
            s = act[j];
            IF (abs(pb_x[i] - t_x[s]) < t_w[s] AND abs(pb_y[i] - t_y[s]) < t_h[s])
              IF (t_arm[s]) arm = s; ELSE hit = s; BREAK; END
            END
          END
          IF (hit >= 0)
            t_hp[hit] = t_hp[hit] - pb_dmg[i]; t_flash[hit] = 3;
            spark(pb_x[i], pb_y[i]); pb_on[i] = 0;
            IF (sn_ready(sn_hit_t, 6)) sn_hit_t = sn_tick; play_sound(sn_hit, 26, srnd(110, 140), sn_pan(pb_x[i])); END
            IF (pb_k[i] == 2) explode(pb_x[i], pb_y[i], 1); END
          ELSE
            IF (arm >= 0)
              spark(pb_x[i], pb_y[i]); pb_on[i] = 0;
              IF (sn_ready(sn_ting_t, 5)) sn_ting_t = sn_tick; play_sound(sn_ting, 30, srnd(90, 115), sn_pan(pb_x[i])); END
            END
          END
          IF (pb_on[i])
            SWITCH (pb_k[i])
              CASE 0 draw_rect(pb_x[i] - 1 + shx, pb_y[i] - 6 + shy, 3, 11, '#fff6a0');
              CASE 1 set_color('#70ff90'); circle(pb_x[i] + shx, pb_y[i] + shy, 3);
              CASE 2 draw_rect(pb_x[i] - 2 + shx, pb_y[i] - 2 + shy, 4, 4, '#ffffff');
                set_color('rgba(255,150,40,0.8)'); circle(pb_x[i] - pb_vx[i] + shx, pb_y[i] - pb_vy[i] + shy, 2);
            END
          END
        END
      END
    END
    FRAME;
  END
END

PROCESS eshots();
PRIVATE i, bx, by;
BEGIN
  LOOP
    n_eb = 0;
    FROM i = 0 TO 239;
      IF (eb_on[i])
        eb_x[i] = eb_x[i] + eb_vx[i]; eb_y[i] = eb_y[i] + eb_vy[i];
        bx = eb_x[i]; by = eb_y[i];
        IF (by < -20 OR by > PFH + 10 OR bx < -10 OR bx > PFW)
          eb_on[i] = 0;
        ELSE
          n_eb = n_eb + 1;
          IF (abs(bx - plx) < 7 AND abs(by - ply) < 10 AND player_alive AND p_inv == 0)
            IF (hurt(6 + lvl)) spark(bx, by); eb_on[i] = 0; END
          END
          bx = bx + shx; by = by + shy;
          SWITCH (eb_k[i])
            CASE 0 set_color('#ff4030'); circle(bx, by, 4); set_color('#ffe0c0'); circle(bx, by, 2);
            CASE 1 set_color('#ff9a20'); circle(bx, by, 5); set_color('#fff0a0'); circle(bx, by, 2.5);
            CASE 2 set_color('#c050ff'); circle(bx, by, 4); set_color('#f8d8ff'); circle(bx, by, 2);
          END
        END
      END
    END
    FRAME;
  END
END

PROCESS fxman();
PRIVATE i, q, r, px, py;
BEGIN
  LOOP
    FROM i = 0 TO 159;
      IF (fx_on[i])
        fx_life[i] = fx_life[i] - 1;
        IF (fx_life[i] <= 0)
          fx_on[i] = 0;
        ELSE
          fx_x[i] = fx_x[i] + fx_vx[i]; fx_y[i] = fx_y[i] + fx_vy[i];
          q = fx_life[i] / (fx_max[i] + 0.001);
          px = fx_x[i] + shx; py = fx_y[i] + shy;
          IF (px < PFW - 4)
            SWITCH (fx_k[i])
              CASE 0 fx_vx[i] = fx_vx[i] * 0.94; fx_vy[i] = fx_vy[i] * 0.94;
                draw_rect(px - 1, py - 1, 2, 2, "rgba(255,230,150," + q + ")");
              CASE 1 r = fx_s[i] * (0.5 + (1 - q) * 0.7);
                set_color("rgba(255," + int(70 + q * 180) + ",40," + q + ")"); circle(px, py, r);
                IF (q > 0.5) set_color("rgba(255,250,210," + (q - 0.5) * 2 + ")"); circle(px, py, r * 0.5); END
              CASE 2 set_color("rgba(70,70,70," + q * 0.45 + ")"); circle(px, py, fx_s[i] * (1.3 - q * 0.6));
              CASE 3 set_color("rgba(255,255,220," + q * 0.55 + ")"); circle(px, py, fx_s[i] * (1.4 - q));
            END
          END
        END
      END
    END
    FRAME;
  END
END

// ==== HUD: panel sprite, persistent labels, bars and live texts ====
PROCESS panel();
BEGIN
  graph = g_panel; x = 560; y = 300; z = -1000;
  LOOP FRAME; END
END

// A still plate (title logo, game over backdrop) under the write() texts
PROCESS plate(gr, px, py);
BEGIN
  graph = gr; x = px; y = py; z = -900;
  LOOP FRAME; END
END

PROCESS hud();
PRIVATE j, c, last_msg = 0; mt = 0;
BEGIN
  set_color('#e8ecf4');
  write(0, 560, 22, 4, "S T O R M W I N G");
  write(0, 500, 48, 3, "SCORE");    write_int(0, 620, 48, 5, OFFSET score);
  write(0, 500, 64, 3, "HI-SCORE"); write_int(0, 620, 64, 5, OFFSET hiscore);
  write(0, 500, 80, 3, "CASH $");   write_int(0, 620, 80, 5, OFFSET money);
  write(0, 500, 116, 3, "SECTOR");  write_int(0, 620, 116, 5, OFFSET lvl);
  write(0, 500, 132, 3, "SHIPS");   write_int(0, 620, 132, 5, OFFSET lives);
  write(0, 500, 148, 3, "BOMBS");   write_int(0, 620, 148, 5, OFFSET bombs);
  write(0, 500, 204, 3, "SHIELD");
  write(0, 500, 302, 3, "MAIN GUN");
  write(0, 500, 346, 3, "SPECIAL");
  write(0, 560, 500, 4, "ARROWS/WASD  fly");
  write(0, 560, 516, 4, "Z/SPACE  fire");
  write(0, 560, 532, 4, "X/B  mega bomb");
  write(0, 560, 548, 4, "C  switch special");
  write(0, 560, 564, 4, "M  music on/off");
  LOOP
    IF (score > hiscore) hiscore = score; END
    // shield bar
    draw_rect(498, 216, 124, 12, '#101418');
    c = '#40e070'; IF (shield * 3 < shield_max * 2) c = '#e0c040'; END IF (shield * 3 < shield_max) c = '#ff4040'; END
    draw_rect(500, 218, fmax(shield, 0) * 120 / shield_max, 8, c);
    // gun level pips
    FROM j = 1 TO 5;
      IF (j <= gun_lv) c = '#ffd040'; ELSE c = '#404650'; END
      draw_rect(500 + (j - 1) * 24, 316, 20, 8, c);
    END
    set_color('#ffffff'); text(500, 362, wname(spec));
    FROM j = 1 TO 3;
      IF (owns(j)) IF (spec == j) c = '#ffd040'; ELSE c = '#8090a0'; END ELSE c = '#303640'; END
      draw_rect(500 + (j - 1) * 40, 378, 34, 14, c);
    END
    set_color('#101010'); text(512, 381, "S"); text(552, 381, "M"); text(592, 381, "L");
    // boss health bar across the top of the playfield
    IF (boss_on == 1)
      draw_rect(40, 10, 400, 12, '#200808');
      draw_rect(42, 12, fmax(boss_hp, 0) * 396 / boss_max, 8, '#ff3030');
      set_color('#ffffff'); text(44, 26, "BOSS  PHASE " + boss_phase);
    END
    // screen flash of a mega bomb
    IF (bomb_flash > 0)
      draw_rect(0, 0, PFW, PFH, "rgba(255,255,230," + bomb_flash * 0.03 + ")");
      bomb_flash = bomb_flash - 1;
    END
    // centred message: written once when it changes, removed when it expires
    IF (msg_t > 0 AND msg_id != last_msg)
      IF (mt) delete_text(mt); END
      set_color('#ffe070'); mt = write(0, 240, 250, 4, msg_text(msg_id)); last_msg = msg_id;
    END
    IF (msg_t > 0) msg_t = msg_t - 1; END
    IF (msg_t <= 0 AND mt) delete_text(mt); mt = 0; last_msg = 0; END
    FRAME;
  END
END

// ==== Game flow ====

// Removes everything of a level in play and empties the pools.
FUNCTION clear_play();
PRIVATE i;
BEGIN
  signal(TYPE enemy, s_kill); signal(TYPE gobj, s_kill); signal(TYPE pickup, s_kill);
  signal(TYPE boss, s_kill); signal(TYPE bturret, s_kill); signal(TYPE bcore, s_kill);
  signal(TYPE player, s_kill);
  FROM i = 0 TO 63; t_on[i] = 0; END
  FROM i = 0 TO 95; pb_on[i] = 0; END
  FROM i = 0 TO 239; eb_on[i] = 0; END
  n_air = 0; boss_on = 0; boss_phase = 0; laser_on = 0; player_alive = 0; msg_t = 0;
  RETURN 0;
END

FUNCTION do_shake();
BEGIN
  IF (shake > 0.5)
    shx = rand(-int(shake), int(shake)); shy = rand(-int(shake), int(shake));
    shake = shake * 0.88;
  ELSE shake = 0; shx = 0; shy = 0; END
  RETURN 0;
END

FUNCTION chunks_ready();
PRIVATE i;
BEGIN
  FROM i = 0 TO 4; IF (ch_done[i] != terr_gen) RETURN 0; END END
  RETURN 1;
END

// The shop between sectors, drawn every frame with text()
FUNCTION shop_price(i);
BEGIN
  SWITCH (i)
    CASE 0 IF (gun_lv >= 5) RETURN -1; END RETURN 3000 * gun_lv;
    CASE 1 IF (own_s) RETURN -1; END RETURN 6000;
    CASE 2 IF (own_m) RETURN -1; END RETURN 9000;
    CASE 3 IF (own_l) RETURN -1; END RETURN 12000;
    CASE 4 IF (bombs >= 9) RETURN -1; END RETURN 1500;
    CASE 5 IF (shield >= shield_max) RETURN -1; END RETURN 1000;
    CASE 6 IF (shield_max >= 200) RETURN -1; END RETURN 5000;
  END
  RETURN 0;
END

FUNCTION shop_name(i);
BEGIN
  SWITCH (i)
    CASE 0 RETURN "MAIN GUN UPGRADE";
    CASE 1 RETURN "SPREAD SHOT";
    CASE 2 RETURN "HOMING MISSILES";
    CASE 3 RETURN "PLASMA LASER";
    CASE 4 RETURN "MEGA BOMB";
    CASE 5 RETURN "SHIELD REPAIR";
    CASE 6 RETURN "SHIELD CAPACITY +25";
  END
  RETURN "LAUNCH INTO SECTOR " + (lvl + 1);
END

FUNCTION shop_buy(i);
PRIVATE p;
BEGIN
  p = shop_price(i);
  IF (p < 0 OR money < p) RETURN 0; END
  money = money - p;
  SWITCH (i)
    CASE 0 gun_lv = gun_lv + 1;
    CASE 1 own_s = 1; spec = 1;
    CASE 2 own_m = 1; spec = 2;
    CASE 3 own_l = 1; spec = 3;
    CASE 4 bombs = bombs + 1;
    CASE 5 shield = shield_max;
    CASE 6 shield_max = shield_max + 25; shield = shield + 25;
  END
  RETURN 1;
END

FUNCTION draw_shop();
PRIVATE i, p, c;
BEGIN
  draw_rect(30, 90, 420, 420, 'rgba(8,12,20,0.88)');
  draw_rect(30, 90, 420, 2, '#ffd040'); draw_rect(30, 508, 420, 2, '#ffd040');
  set_color('#ffd040'); text(60, 110, "SUPPLY DEPOT - SECTOR " + lvl + " CLEARED");
  set_color('#c0c8d8'); text(60, 130, "CASH $" + money + "      UP/DOWN choose   Z/ENTER buy");
  FROM i = 0 TO 7;
    IF (i == shop_sel) draw_rect(50, 168 + i * 36, 380, 28, 'rgba(255,208,64,0.25)'); END
    p = shop_price(i);
    c = '#ffffff';
    IF (i < 7 AND (p < 0 OR p > money)) c = '#707884'; END
    set_color(c); text(64, 178 + i * 36, shop_name(i));
    IF (i < 7)
      IF (p < 0) text(340, 178 + i * 36, "SOLD OUT"); ELSE text(340, 178 + i * 36, "$" + p); END
    END
  END
  RETURN 0;
END

PRIVATE i = 0; t1 = 0; t2 = 0; t3 = 0; wait = 0;
BEGIN
  set_mode(640, 600);
  set_fps(60, 0);
  screen_color('#000000');
  make_graphics();
  make_sounds(); make_songs();
  FRAME;
  FROM i = 0 TO 4; g_chunk[i] = new_graphic(480, 256); chunk(i); END
  panel(); pshots(); eshots(); fxman(); hud(); snd_director();

  LOOP
    // ---- title: the first sector scrolls by behind the logo
    state = 0; lvl = 1;
    setup_level(1); scroll_spd = 0.7;
    plate(g_logo, 240, 250);
    set_color('#ffffff');
    t1 = write(0, 240, 330, 4, "Z/SPACE fire   X bomb   C switch weapon");
    t2 = write(0, 240, 350, 4, "Shoot planes, tanks, bunkers and boats for cash");
    t3 = write(0, 240, 400, 4, "press ENTER or SPACE to take off");
    REPEAT scroll_y = scroll_y + scroll_spd; do_shake(); FRAME; UNTIL (key_pressed(_enter) OR key_pressed(_space))
    delete_text(t1); delete_text(t2); delete_text(t3);
    signal(TYPE plate, s_kill);
    play_sound(sn_buy, 60, 100, 0);

    // ---- a new game
    score = 0; money = 0; lives = 3; shield_max = 100; shield = 100; gun_lv = 1; bombs = 2;
    spec = 0; own_s = 0; own_m = 0; own_l = 0; lvl = 1; game_over = 0; kills = 0; gkills = 0;
    LOOP
      clear_play();
      state = 1;
      setup_level(lvl); make_waves(lvl); scroll_spd = 0.8;
      WHILE (chunks_ready() == 0) FRAME; END
      state = 2; wave_i = 0;
      player(); say(0);
      WHILE (state == 2 AND game_over == 0)
        scroll_y = scroll_y + scroll_spd;
        IF (wave_i < n_waves)
          IF (scroll_y >= w_at[wave_i] AND n_air < 26) spawn_wave(wave_i); wave_i = wave_i + 1; END
        END
        IF (boss_on == 0 AND scroll_y >= level_len) say(8); boss(); END
        IF (boss_on == 2) state = 3; END
        do_shake();
        FRAME;
      END
      IF (game_over) BREAK; END
      // ---- sector clear: fly on for a moment, then the shop
      money = money + 2000 * lvl; say(11);
      FROM wait = 1 TO 200; scroll_y = scroll_y + scroll_spd; do_shake(); FRAME; END
      clear_play();
      state = 4; shop_sel = 0;
      LOOP
        IF (key_pressed(_up)) shop_sel = (shop_sel + 7) % 8; play_sound(sn_blip, 40, 100, 0); END
        IF (key_pressed(_down)) shop_sel = (shop_sel + 1) % 8; play_sound(sn_blip, 40, 90, 0); END
        IF (key_pressed(_z) OR key_pressed(_enter) OR key_pressed(_space))
          IF (shop_sel == 7) BREAK; END
          IF (shop_buy(shop_sel)) sn_arp(sn_buy, 60, 5, 100, 150, 0, 0);
          ELSE play_sound(sn_deny, 60, 100, 0); END
        END
        draw_shop();
        FRAME;
      END
      lvl = lvl + 1;
    END

    // ---- game over
    state = 5;
    plate(g_dim, 240, 270);
    set_color('#ff6050');
    t1 = write(0, 240, 250, 4, "G A M E   O V E R");
    set_color('#ffffff');
    t2 = write(0, 240, 280, 4, "FINAL SCORE " + score + "   SECTOR " + lvl);
    t3 = write(0, 240, 300, 4, "press ENTER to return to base");
    FROM wait = 1 TO 60; scroll_y = scroll_y + 0.5; do_shake(); FRAME; END
    REPEAT scroll_y = scroll_y + 0.5; do_shake(); FRAME; UNTIL (key_pressed(_enter) OR key_pressed(_space))
    delete_text(t1); delete_text(t2); delete_text(t3);
    signal(TYPE plate, s_kill);
    clear_play();
  END
END
