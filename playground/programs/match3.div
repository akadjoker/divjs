PROGRAM match3;

// SUGAR SWAP - a match-3 puzzle in the style of Candy Crush.
// Swap two neighbouring candies (click one then the other, or drag) to
// line up 3 or more of a colour. Matched candies pop, the ones above fall
// and new ones drop in; every cascade raises the score multiplier.
// 4 in a line makes a striped candy (clears a row or a column), an L or T
// makes a wrapped candy (a 3x3 blast, twice) and 5 in a line makes a
// colour bomb. Swapping two specials together fires a combo.
//
// Every level is generated from its number (rand_seed): the board shape
// with holes, jelly, ice and spreading chocolate, the goal (score, clear
// the jelly or collect a colour), the move limit and the star thresholds.
//
// The board is plain arrays (index = row * 9 + column). Each cell has one
// small process that shows whatever candy sits there, shifted by a visual
// offset that falls or slides back to zero, so moving a candy only means
// copying numbers and setting an offset. Candy sprites are rendered pixel
// by pixel at start-up; particles, beams and score popups live in pools.

GLOBAL
  CS = 48; BX = 16; BY = 24;          // cell size and board corner
  // ---- the board
  cell[80];      // 1 playable cell, 0 hole
  col[80];       // candy colour 0-5, 6 colour bomb, -1 none
  spc[80];       // 0 plain, 1 striped (row), 2 striped (column), 3 wrapped,
                 // 4 colour bomb, 5 wrapped that already blew once
  jel[80];       // jelly layers under the cell
  blk[80];       // blocker in the cell: 1-2 ice layers, 3 chocolate
  ox[80]; oy[80]; vy[80]; mv[80];     // visual offset, fall speed, 1/2 = sliding
  // ---- clear pass work arrays
  mk[80];        // 0 no, 1 matched, 2 blasted, 3 wrapped that stays (armed)
  hl[80]; vl[80]; comp[80]; hit[80]; lst[80];
  q[99]; qh = 0; qt = 0;              // queue of cells whose special must fire
  ns_at[39]; ns_col[39]; ns_spc[39]; n_ns = 0;   // specials this pass creates
  sv_col[80]; sv_spc[80]; src[80];    // reshuffle
  // ---- level
  level = 1; max_level = 1; best[199]; map_page = 0;
  ncol = 5; gtype = 0; gcol = 0; gleft = 0; target = 0; s1 = 0; s2 = 0; s3 = 0;
  moves = 0; score = 0; n_jelly = 0; n_choc = 0; choc_hit = 0; choc_wait = 0;
  mult = 1; bonus = 0; won = 0; stars = 0;
  // ---- screens and play phases
  state = 0;     // 0 baking candies, 1 level map, 2 playing, 3 result
  phase = 5;     // 0 idle, 1 swap, 2 swap back, 3 pop, 4 fall,
                 // 5 looking for moves, 6 reshuffle, 7 level over
  pt = 0.0; sw_a = 0; sw_b = 0;
  sel = -1; drag = -1; dx0 = 0; dy0 = 0; lprev = 0;
  idle_t = 0.0; hint_a = -1; hint_b = -1; best_v = 0; n_moves = 0; fm_row = 0;
  shuffling = 0; shuf_n = 0;
  recheck = 0;   // set to 1 by tools/tests after editing the board: look for moves again
  n_shuffles = 0; n_passes = 0;
  // statistics (read by the tests): biggest pop of the move, last combo,
  // specials made and fired, second wrapped blasts
  max_pop = 0; last_combo = 0; made_s = 0; made_w = 0; made_b = 0;
  fired_s = 0; fired_w = 0; fired_b = 0; n_wrap2 = 0; max_mult = 0; n_bounce = 0;
  // ---- graphics and palette
  g_cand[23]; g_bomb = 0; g_bg = 0; g_map = 0; g_hud = 0; g_res = 0; g_pop[9];
  cr[5]; cg[5]; cb[5]; css[8];
  baked = 0;
  // ---- effect pools
  pa_next = 0; pa_t[159]; pa_l[159]; pa_x[159]; pa_y[159]; pa_vx[159]; pa_vy[159]; pa_c[159]; pa_s[159]; pa_g[159];
  bm_t[7]; bm_d[7]; bm_p[7];
  rg_t[7]; rg_x[7]; rg_y[7]; rg_r[7];
  pp_t[9]; pp_x[9]; pp_y[9];

// =====================================================================
// Small helpers
// =====================================================================

FUNCTION imin(a, b); BEGIN IF (a < b) RETURN a; END RETURN b; END
FUNCTION imax(a, b); BEGIN IF (a > b) RETURN a; END RETURN b; END
FUNCTION cx_of(i); BEGIN RETURN BX + (i % 9) * CS + 24; END
FUNCTION cy_of(i); BEGIN RETURN BY + (i / 9) * CS + 24; END
FUNCTION movable(i); BEGIN RETURN (cell[i] AND blk[i] == 0 AND col[i] >= 0); END
FUNCTION adjacent(a, b);
BEGIN
  RETURN ((a / 9 == b / 9 AND abs(a - b) == 1) OR abs(a - b) == 9);
END
// Neighbour of cell i in direction d (0 left, 1 right, 2 up, 3 down), -1 off the board
FUNCTION nbr(i, d);
BEGIN
  IF (d == 0 AND i % 9 > 0) RETURN i - 1; END
  IF (d == 1 AND i % 9 < 8) RETURN i + 1; END
  IF (d == 2 AND i >= 9) RETURN i - 9; END
  IF (d == 3 AND i < 72) RETURN i + 9; END
  RETURN -1;
END
FUNCTION ndig(n);                     // characters needed to print n
PRIVATE d;
BEGIN
  d = 1;
  WHILE (n >= 10) n = n / 10; d++; END
  RETURN d;
END

// Text with a drop shadow on a generated graphic (monospace: 0.6 * size wide)
FUNCTION gtext(gr, px, py, s, r, g, b, sz);
BEGIN
  gfx_text(gr, px + 2, py + 2, s, 20, 10, 30, sz);
  gfx_text(gr, px, py, s, r, g, b, sz);
  RETURN 0;
END
FUNCTION ctext(gr, cx, py, s, n, r, g, b, sz);   // centred, n characters
BEGIN
  RETURN gtext(gr, cx - n * sz * 3 / 10, py, s, r, g, b, sz);
END

// A filled five-pointed star: a centre disc and five triangles, each
// filled with lines from its tip to points along its base
FUNCTION star(gr, cx, cy, rad, r, g, b);
PRIVATE k, a, tx, ty, x1, y1, x2, y2, n, j, ir;
BEGIN
  ir = rad * 0.45;
  gfx_circle(gr, cx, cy, ir, r, g, b);
  n = imax(3, rad / 2);
  FOR k = 0 TO 4
    a = 90000 + k * 72000;
    tx = cx + get_distx(a, rad); ty = cy + get_disty(a, rad);
    x1 = cx + get_distx(a - 36000, ir); y1 = cy + get_disty(a - 36000, ir);
    x2 = cx + get_distx(a + 36000, ir); y2 = cy + get_disty(a + 36000, ir);
    FOR j = 0 TO n
      gfx_line(gr, tx, ty, x1 + (x2 - x1) * j / n, y1 + (y2 - y1) * j / n, r, g, b);
    END
  END
  RETURN 0;
END

// =====================================================================
// Candy sprites: every pixel is shaded from a shape "distance" (0 at the
// centre, 1 on the edge), a light from the upper left and a highlight.
// =====================================================================

FUNCTION shape_d(k, px, py);
PRIVATE ax, ay, d;
BEGIN
  ax = abs(px); ay = abs(py);
  SWITCH (k)
    CASE 0 RETURN sqrt(px * px * 0.78 + py * py * 1.5);         // red bean
    CASE 1                                                      // orange lozenge
      d = ax * 0.87 + ay * 0.5;
      IF (ay > d) d = ay; END
      RETURN d * 1.05;
    CASE 2 RETURN (ax + ay) * 0.86;                             // yellow diamond
    CASE 3 RETURN sqrt(sqrt(px * px * px * px + py * py * py * py)) * 1.08;   // green square
    CASE 4 RETURN sqrt(px * px + py * py);                      // blue ball
  END
  d = sqrt(px * px + py * py);                                  // purple flower
  RETURN d / (0.84 + 0.16 * cos(atan2(py, px) * 5));
END

// One pixel of candy t (kind t / 6: 0 plain, 1 row stripes, 2 column
// stripes, 3 wrapped; t 24 is the colour bomb)
FUNCTION candy_px(gr, t, px, py);
PRIVATE kind, k, fx, fy, d, r, g, b, lt, s, sx, sy, m, ax;
BEGIN
  kind = t / 6; k = t % 6;
  IF (t == 24) kind = 4; k = 4; END
  fx = (px - 19.5) * 0.0588; fy = (py - 19.5) * 0.0588;
  IF (kind == 3)
    d = shape_d(k, fx * 1.32, fy * 1.32);
    IF (d > 1)                                  // wrapper tabs left and right
      ax = abs(fx);
      IF (ax > 0.7 AND ax < 1.12 AND abs(fy) < (ax - 0.5) * 0.9)
        lt = 1.25 - ax * 0.4 - fy * 0.3;
        gfx_pixel(gr, px, py, (cr[k] + 60) * lt, (cg[k] + 60) * lt, (cb[k] + 60) * lt);
      END
      RETURN 0;
    END
  ELSE
    IF (kind == 4) d = sqrt(fx * fx + fy * fy) * 1.05; ELSE d = shape_d(k, fx, fy); END
    IF (d > 1) RETURN 0; END
  END
  IF (kind == 4) r = 110; g = 62; b = 35; ELSE r = cr[k]; g = cg[k]; b = cb[k]; END
  m = 0;                                        // white stripes / swirls
  IF (kind == 1 AND (py / 5) % 2 == 0) m = 0.72; END
  IF (kind == 2 AND (px / 5) % 2 == 0) m = 0.72; END
  IF (kind == 3 AND ((px + py) / 6) % 2 == 0) m = 0.35; END
  r += (255 - r) * m; g += (255 - g) * m; b += (255 - b) * m;
  IF (kind == 4 AND ((px / 2) * 7 + (py / 2) * 13) % 11 == 0)   // sprinkles
    s = (px + py) % 6; r = cr[s] + 20; g = cg[s] + 20; b = cb[s] + 20;
  END
  lt = 0.6 + 0.42 * (1 - d * d) - (fx + fy) * 0.22;
  IF (d > 0.88) lt = lt * 0.62; END             // dark rim
  r = r * lt; g = g * lt; b = b * lt;
  sx = fx + 0.36; sy = fy + 0.42;               // glossy highlight
  s = 1 - (sx * sx + sy * sy * 2.4) * 11;
  IF (s > 0)
    s = s * 0.9;
    r += (255 - r) * s; g += (255 - g) * s; b += (255 - b) * s;
  END
  IF (d > 0.7 AND fx + fy > 0.75) r += 30; g += 30; b += 30; END   // rim light
  gfx_pixel(gr, px, py, r, g, b);
  RETURN 0;
END

// One baker process per sprite, 5 rows a frame: the per-tick instruction
// budget is per process, so the 25 sprites bake side by side
PROCESS baker(t);
PRIVATE gr, px, py;
BEGIN
  gr = new_graphic(40, 40); gfx_fill_rgba(gr, 0, 0, 0, 0);
  IF (t == 24) g_bomb = gr; ELSE g_cand[t] = gr; END
  FOR py = 0 TO 39
    FOR px = 0 TO 39 candy_px(gr, t, px, py); END
    IF (py % 5 == 4) FRAME; END
  END
  baked++;
END

// =====================================================================
// Board background: backdrop, panel, cells with jelly, ice, chocolate
// =====================================================================

FUNCTION paint_cell(i);
PRIVATE px, py, t, k;
BEGIN
  IF (cell[i] == 0) RETURN 0; END
  px = BX + (i % 9) * CS; py = BY + (i / 9) * CS;
  t = ((i % 9) + (i / 9)) % 2;
  gfx_rect(g_bg, px, py, CS, CS, 58 + t * 12, 66 + t * 12, 118 + t * 14);
  IF (jel[i] > 0)                                // jelly: pink, darker when double
    k = jel[i] * 40;
    gfx_rect(g_bg, px + 2, py + 2, 44, 44, 250 - k, 150 - k * 2, 210 - k / 2);
    gfx_rect(g_bg, px + 5, py + 5, 38, 38, 255 - k, 175 - k * 2, 225 - k / 2);
    gfx_rect(g_bg, px + 7, py + 7, 12, 4, 255, 230, 245);
  END
  IF (blk[i] == 1 OR blk[i] == 2)                // ice block, cracked look for 1 layer
    gfx_rect(g_bg, px + 2, py + 2, 44, 44, 150, 200, 235);
    gfx_rect(g_bg, px + 4, py + 4, 40, 40, 200, 235, 250);
    gfx_line(g_bg, px + 8, py + 30, px + 20, py + 8, 255, 255, 255);
    gfx_line(g_bg, px + 14, py + 38, px + 34, py + 10, 255, 255, 255);
    IF (blk[i] == 2)
      gfx_rect_outline(g_bg, px + 6, py + 6, 36, 36, 120, 170, 220);
      gfx_rect_outline(g_bg, px + 9, py + 9, 30, 30, 120, 170, 220);
    ELSE
      gfx_line(g_bg, px + 24, py + 24, px + 40, py + 30, 110, 150, 190);
      gfx_line(g_bg, px + 24, py + 24, px + 30, py + 42, 110, 150, 190);
    END
  END
  IF (blk[i] == 3)                               // chocolate squares
    gfx_rect(g_bg, px + 2, py + 2, 44, 44, 70, 38, 20);
    FOR k = 0 TO 3
      gfx_rect(g_bg, px + 4 + (k % 2) * 21, py + 4 + (k / 2) * 21, 19, 19, 120, 70, 38);
      gfx_rect(g_bg, px + 5 + (k % 2) * 21, py + 5 + (k / 2) * 21, 14, 3, 160, 100, 60);
    END
  END
  RETURN 0;
END

FUNCTION backdrop(gr, th);
PRIVATE yy, t, i;
BEGIN
  FOR yy = 0 TO 119
    t = yy * 0.0084;
    SWITCH (th)
      CASE 0 gfx_rect(gr, 0, yy * 4, 640, 4, 250 - t * 120, 150 - t * 90, 200 - t * 60);
      CASE 1 gfx_rect(gr, 0, yy * 4, 640, 4, 110 - t * 60, 200 - t * 110, 240 - t * 90);
      CASE 2 gfx_rect(gr, 0, yy * 4, 640, 4, 250 - t * 90, 200 - t * 110, 120 - t * 60);
      CASE 3 gfx_rect(gr, 0, yy * 4, 640, 4, 170 - t * 90, 120 - t * 70, 230 - t * 100);
    END
  END
  FOR i = 0 TO 59                                // sugar sprinkles
    gfx_circle(gr, rand(0, 640), rand(0, 480), rand(1, 3), 255, 235, 250);
  END
  RETURN 0;
END

FUNCTION paint_board();
PRIVATE i;
BEGIN
  rand_seed(level * 31 + 5);
  backdrop(g_bg, level % 4);
  rand_seed();
  gfx_rect(g_bg, 454, 18, 182, 444, 70, 30, 80);   // side panel
  gfx_rect(g_bg, 458, 22, 174, 436, 120, 60, 140);
  gfx_rect(g_bg, 460, 24, 170, 432, 60, 30, 80);
  FOR i = 0 TO 80                                  // dark frame around the cells
    IF (cell[i]) gfx_rect(g_bg, BX + (i % 9) * CS - 4, BY + (i / 9) * CS - 4, CS + 8, CS + 8, 40, 30, 70); END
  END
  FOR i = 0 TO 80 paint_cell(i); END
  RETURN 0;
END

// =====================================================================
// Effects: particles, beams, rings and popups, all pooled
// =====================================================================

// The pool is a ring: a new particle takes the oldest slot (O(1))
FUNCTION particle(px, py, vx, vy, life, c, sz, grav);
PRIVATE i;
BEGIN
  i = pa_next; pa_next = (pa_next + 1) % 160;
  pa_t[i] = life; pa_l[i] = life; pa_x[i] = px; pa_y[i] = py; pa_vx[i] = vx; pa_vy[i] = vy;
  pa_c[i] = c; pa_s[i] = sz; pa_g[i] = grav;
  RETURN i;
END

FUNCTION burst(i, c, n);
PRIVATE k;
BEGIN
  FOR k = 1 TO n
    particle(cx_of(i) + rand(-10, 10), cy_of(i) + rand(-10, 10), rand(-170, 170), rand(-260, 40),
             rand(45, 80) * 0.01, c, rand(3, 6), 700);
  END
  RETURN 0;
END

FUNCTION beam(d, p);
PRIVATE i;
BEGIN
  FOR i = 0 TO 7
    IF (bm_t[i] <= 0) bm_t[i] = 0.4; bm_d[i] = d; bm_p[i] = p; RETURN i; END
  END
  RETURN -1;
END

FUNCTION ring(px, py, r);
PRIVATE i;
BEGIN
  FOR i = 0 TO 7
    IF (rg_t[i] <= 0) rg_t[i] = 0.45; rg_x[i] = px; rg_y[i] = py; rg_r[i] = r; RETURN i; END
  END
  RETURN -1;
END

// Floating text: reuses the oldest of ten small graphics
FUNCTION popup(px, py, s, n, r, g, b, sz);
PRIVATE i, k;
BEGIN
  k = 0;
  FOR i = 1 TO 9
    IF (pp_t[i] < pp_t[k]) k = i; END
  END
  gfx_fill_rgba(g_pop[k], 0, 0, 0, 0);
  ctext(g_pop[k], 150, 4, s, n, r, g, b, sz);
  pp_t[k] = 1.1; pp_x[k] = clamp(px, 90, 550); pp_y[k] = py;
  RETURN 0;
END

PROCESS popup_slot(k);
BEGIN
  z = -20;
  LOOP
    graph = 0;
    IF (pp_t[k] > 0)
      pp_t[k] -= get_delta();
      graph = g_pop[k]; x = pp_x[k]; y = pp_y[k] - (1.1 - pp_t[k]) * 40;
      alpha = imin(100, pp_t[k] * 200);
    END
    FRAME;
  END
END

PROCESS fxman();
PRIVATE i, dt, t, h;
BEGIN
  LOOP
    dt = imin(get_delta(), 0.05);
    FOR i = 0 TO 159
      IF (pa_t[i] > 0)
        pa_t[i] -= dt;
        pa_vy[i] += pa_g[i] * dt;
        pa_x[i] += pa_vx[i] * dt; pa_y[i] += pa_vy[i] * dt;
        set_color(css[pa_c[i]]);
        circle(pa_x[i], pa_y[i], 0.5 + pa_s[i] * pa_t[i] / pa_l[i]);
      END
    END
    FOR i = 0 TO 7
      IF (bm_t[i] > 0)                             // striped candy beam
        bm_t[i] -= dt; t = bm_t[i] * 2.5; h = 44 * t;
        IF (bm_d[i] == 0)
          draw_rect(BX, BY + bm_p[i] * CS + 24 - h / 2, 9 * CS, h, 'rgba(255,255,255,0.45)');
          draw_rect(BX, BY + bm_p[i] * CS + 22, 9 * CS, 5, '#ffffff');
        ELSE
          draw_rect(BX + bm_p[i] * CS + 24 - h / 2, BY, h, 9 * CS, 'rgba(255,255,255,0.45)');
          draw_rect(BX + bm_p[i] * CS + 22, BY, 5, 9 * CS, '#ffffff');
        END
      END
      IF (rg_t[i] > 0)                             // wrapped candy blast
        rg_t[i] -= dt; t = rg_t[i] / 0.45;
        set_color("rgba(255,235,180," + (t * 0.55) + ")");
        circle(rg_x[i], rg_y[i], rg_r[i] * (1.15 - t * 0.6));
      END
    END
    FRAME;
  END
END

// =====================================================================
// One process per board cell shows the candy in it
// =====================================================================

PROCESS slot(i);
PRIVATE dt, d, s, k, st, w, t;
BEGIN
  z = 0;
  LOOP
    dt = imin(get_delta(), 0.05);
    IF (mv[i] > 0)                                  // swap / shuffle: straight slide
      d = sqrt(ox[i] * ox[i] + oy[i] * oy[i]);
      st = 420 * dt;
      IF (mv[i] == 2) st = 300 * dt; END
      IF (d <= st)
        ox[i] = 0; oy[i] = 0; mv[i] = 0;
      ELSE
        ox[i] -= ox[i] * st / d; oy[i] -= oy[i] * st / d;
      END
    ELSE
      IF (oy[i] < 0 OR ox[i] != 0)                  // falling, with gravity
        vy[i] = imin(vy[i] + 2600 * dt, 1100);
        s = vy[i] * dt;
        oy[i] += s;
        IF (ox[i] > 0) ox[i] = imax(0, ox[i] - s); END
        IF (ox[i] < 0) ox[i] = imin(0, ox[i] + s); END
        IF (oy[i] >= 0) oy[i] = 0; ox[i] = 0; vy[i] = 0; END
      END
    END
    k = col[i];
    IF (k < 0 OR state < 2)
      graph = 0;
    ELSE
      s = spc[i]; size = 100; alpha = 100; angle = 0; z = 0;
      IF (s == 4)
        graph = g_bomb; angle = (get_time() * 90000) % 360000;
      ELSE
        IF (s == 0) graph = g_cand[k]; END
        IF (s == 1 OR s == 2) graph = g_cand[s * 6 + k]; END
        IF (s == 3 OR s == 5) graph = g_cand[18 + k]; END
      END
      t = get_time();
      IF (s == 5) size = 96 + 10 * sin(t * 900000); END          // armed wrapped
      IF (phase == 3 AND (mk[i] == 1 OR mk[i] == 2)) size = imax(10, 100 - pt * 450); END
      IF (i == sel) size = 112 + 5 * sin(t * 500000); END
      x = cx_of(i) + ox[i]; y = cy_of(i) + oy[i];
      IF (mv[i]) z = -2; END
      IF (phase == 0 AND idle_t > 4 AND (i == hint_a OR i == hint_b))   // hint wobble
        w = 5 * sin(t * 800000);
        IF (i == hint_a) d = hint_b; ELSE d = hint_a; END
        x += w * sign(cx_of(d) - cx_of(i)); y += w * sign(cy_of(d) - cy_of(i));
        size = 108 + 6 * sin(t * 400000);
      END
    END
    FRAME;
  END
END

// =====================================================================
// Matching
// =====================================================================

FUNCTION pass_reset();
PRIVATE i;
BEGIN
  FOR i = 0 TO 80 mk[i] = 0; hit[i] = 0; hl[i] = 0; vl[i] = 0; comp[i] = 0; END
  qh = 0; qt = 0; n_ns = 0;
  RETURN 0;
END

// Marks every run of 3+ (rows and columns); returns how many cells
FUNCTION find_runs();
PRIVATE r, c, i, k, n, j, cnt;
BEGIN
  pass_reset();
  FOR r = 0 TO 8
    c = 0;
    WHILE (c < 9)
      i = r * 9 + c; k = col[i]; n = 1;
      IF (k >= 0 AND k < 6)
        WHILE (c + n < 9 AND col[i + n] == k) n++; END
        IF (n >= 3) FOR j = 0 TO n - 1 hl[i + j] = n; mk[i + j] = 1; END END
      END
      c += n;
    END
  END
  FOR c = 0 TO 8
    r = 0;
    WHILE (r < 9)
      i = r * 9 + c; k = col[i]; n = 1;
      IF (k >= 0 AND k < 6)
        WHILE (r + n < 9 AND col[i + n * 9] == k) n++; END
        IF (n >= 3) FOR j = 0 TO n - 1 vl[i + j * 9] = n; mk[i + j * 9] = 1; END END
      END
      r += n;
    END
  END
  FOR i = 0 TO 80 IF (mk[i]) cnt++; END END
  RETURN cnt;
END

// Blocker in cell i takes one hit (once per pass)
FUNCTION hit_blk(i);
BEGIN
  IF (hit[i] OR blk[i] == 0) RETURN 0; END
  hit[i] = 1; score += 20;
  IF (blk[i] == 3)
    blk[i] = 0; n_choc--; choc_hit = 1; burst(i, 7, 6);
  ELSE
    blk[i]--; burst(i, 8, 5);
  END
  paint_cell(i);
  RETURN 0;
END

// A blast reaches cell i: hit its blocker or queue its candy
FUNCTION mark(i);
BEGIN
  IF (i < 0 OR i > 80) RETURN 0; END
  IF (cell[i] == 0) RETURN 0; END
  IF (blk[i] > 0) hit_blk(i); RETURN 0; END
  IF (col[i] < 0 OR mk[i] != 0) RETURN 0; END
  mk[i] = 2; q[qt] = i; qt++;
  RETURN 0;
END

FUNCTION mark_rc(r, c);
BEGIN
  IF (r >= 0 AND r < 9 AND c >= 0 AND c < 9) mark(r * 9 + c); END
  RETURN 0;
END

FUNCTION blast(i, rad);
PRIVATE r, c;
BEGIN
  FOR r = i / 9 - rad TO i / 9 + rad
    FOR c = i % 9 - rad TO i % 9 + rad mark_rc(r, c); END
  END
  ring(cx_of(i), cy_of(i), CS * (rad + 0.6));
  RETURN 0;
END

FUNCTION common_colour();
PRIVATE i, k, n, bn, bk;
BEGIN
  bk = 0; bn = -1;
  FOR k = 0 TO 5
    n = 0;
    FOR i = 0 TO 80 IF (col[i] == k) n++; END END
    IF (n > bn) bn = n; bk = k; END
  END
  RETURN bk;
END

// Bolts from a colour bomb to every candy of colour k, then marks them
FUNCTION zap_colour(fr, k);
PRIVATE j;
BEGIN
  FOR j = 0 TO 80
    IF (col[j] == k)
      particle(cx_of(fr), cy_of(fr), (cx_of(j) - cx_of(fr)) * 3, (cy_of(j) - cy_of(fr)) * 3,
               0.33, 6, 4, 0);
      mark(j);
    END
  END
  RETURN 0;
END

// The special in cell i goes off
FUNCTION fire(i);
PRIVATE s, k;
BEGIN
  s = spc[i]; spc[i] = 0;
  IF (s == 1 OR s == 2) fired_s++; END
  IF (s == 3) fired_w++; END
  IF (s == 4) fired_b++; END
  SWITCH (s)
    CASE 1 FOR k = 0 TO 8 mark((i / 9) * 9 + k); END beam(0, i / 9);
    CASE 2 FOR k = 0 TO 8 mark(k * 9 + i % 9); END beam(1, i % 9);
    CASE 3 blast(i, 1); mk[i] = 3; spc[i] = 5;     // stays, goes off again later
    CASE 5 blast(i, 1);
    CASE 4 zap_colour(i, common_colour());
  END
  RETURN 0;
END

FUNCTION propagate();
PRIVATE i;
BEGIN
  WHILE (qh < qt)
    i = q[qh]; qh++;
    IF (spc[i] > 0) fire(i); END
  END
  RETURN 0;
END

// Points for the blasted (not matched) cells of this pass
FUNCTION score_blasts();
PRIVATE i, n, sx, sy, p;
BEGIN
  FOR i = 0 TO 80
    IF (mk[i] == 2) n++; sx += cx_of(i); sy += cy_of(i); END
  END
  IF (n > 0)
    p = n * 30 * mult; score += p;
    popup(sx / n, sy / n, "+" + p, ndig(p) + 1, 255, 240, 120, 22);
  END
  n_passes++;
  RETURN n;
END

// Flood fill of a matched group of one colour into lst[]; returns its size
FUNCTION flood(i, idn);
PRIVATE n, h, c, j, d;
BEGIN
  lst[0] = i; comp[i] = idn; n = 1; h = 0;
  WHILE (h < n)
    c = lst[h]; h++;
    FOR d = 0 TO 3
      j = nbr(c, d);
      IF (j >= 0)
        IF (mk[j] == 1 AND comp[j] == 0 AND col[j] == col[i]) comp[j] = idn; lst[n] = j; n++; END
      END
    END
  END
  RETURN n;
END

// Turns the runs found by find_runs() into a clear pass: scores each
// group, decides which special it makes and where (sa/sb: swapped cells)
FUNCTION resolve(sa, sb);
PRIVATE i, j, n, nc, mh, mv2, crs, at, s, k, p, sx, sy, d;
BEGIN
  FOR i = 0 TO 80
    IF (mk[i] == 1 AND comp[i] == 0)
      nc++; n = flood(i, nc);
      mh = 0; mv2 = 0; crs = -1; at = lst[n / 2]; sx = 0; sy = 0;
      FOR j = 0 TO n - 1
        k = lst[j];
        mh = imax(mh, hl[k]); mv2 = imax(mv2, vl[k]);
        IF (hl[k] >= 3 AND vl[k] >= 3) crs = k; END
        IF (k == sa OR k == sb) at = k; END
        sx += cx_of(k); sy += cy_of(k);
      END
      s = 0; p = n * 20 * mult;
      IF (mh >= 5 OR mv2 >= 5)
        s = 4; p += 200;
      ELSE
        IF (crs >= 0)
          s = 3; p += 100;
          IF (at != sa AND at != sb) at = crs; END
        ELSE
          IF (mh == 4) s = 2; p += 60; END
          IF (mv2 == 4) s = 1; p += 60; END
        END
      END
      IF (s > 0)
        ns_at[n_ns] = at; ns_spc[n_ns] = s; ns_col[n_ns] = col[i];
        IF (s == 4) ns_col[n_ns] = 6; END
        n_ns++;
      END
      score += p;
      popup(sx / n, sy / n, "+" + p, ndig(p) + 1, 255, 255, 255, 20);
    END
  END
  FOR i = 0 TO 80                     // matched cells: queue them, crack blockers beside
    IF (mk[i] == 1)
      q[qt] = i; qt++;
      FOR d = 0 TO 3
        j = nbr(i, d);
        IF (j >= 0) IF (blk[j] > 0) hit_blk(j); END END
      END
    END
  END
  propagate();
  score_blasts();
  RETURN 0;
END

// Two specials swapped together (or a colour bomb with anything)
FUNCTION do_combo(a, b);
PRIVATE sa, sb, bo, ot, k, so, j, r, c;
BEGIN
  pass_reset();
  sa = spc[a]; sb = spc[b];
  IF (sa == 5) sa = 3; END
  IF (sb == 5) sb = 3; END
  r = b / 9; c = b % 9;
  IF (sa == 4 AND sb == 4)                        // bomb + bomb: the whole board
    spc[a] = 0; spc[b] = 0;
    FOR j = 0 TO 80 mark(j); END
    ring(cx_of(b), cy_of(b), 300);
    popup(cx_of(b), cy_of(b) - 30, "SUGAR STORM!", 12, 255, 120, 220, 24); last_combo = 1;
  ELSE
    IF (sa == 4 OR sb == 4)                       // bomb + candy: that colour
      IF (sa == 4) bo = a; ot = b; ELSE bo = b; ot = a; END
      k = col[ot]; so = spc[ot];
      IF (so == 5) so = 3; END
      spc[bo] = 0;
      IF (so > 0)                                 // ... all turned into its special
        FOR j = 0 TO 80
          IF (col[j] == k AND spc[j] == 0)
            IF (so == 3) spc[j] = 3; ELSE spc[j] = rand(1, 2); END
          END
        END
        popup(cx_of(b), cy_of(b) - 30, "COLOUR FEVER!", 13, 255, 200, 90, 24);
      END
      zap_colour(bo, k);
      mark(bo); last_combo = 2 + so;
    ELSE
      spc[a] = 0; spc[b] = 0;
      mark(a); mark(b);
      IF (sa == 3 AND sb == 3)                    // wrapped + wrapped: 5x5
        blast(b, 2); last_combo = 6;
        popup(cx_of(b), cy_of(b) - 30, "MEGA BLAST!", 11, 255, 200, 90, 24);
      ELSE
        IF (sa == 3 OR sb == 3)                   // striped + wrapped: 3 rows, 3 columns
          FOR j = -1 TO 1
            FOR k = 0 TO 8 mark_rc(r + j, k); mark_rc(k, c + j); END
            IF (r + j >= 0 AND r + j < 9) beam(0, r + j); END
            IF (c + j >= 0 AND c + j < 9) beam(1, c + j); END
          END
          popup(cx_of(b), cy_of(b) - 30, "GIANT CROSS!", 12, 255, 200, 90, 24); last_combo = 7;
        ELSE                                      // striped + striped: a cross
          FOR k = 0 TO 8 mark_rc(r, k); mark_rc(k, c); END
          beam(0, r); beam(1, c);
          popup(cx_of(b), cy_of(b) - 30, "CROSS!", 6, 255, 200, 90, 24); last_combo = 8;
        END
      END
    END
  END
  propagate();
  score_blasts();
  RETURN 0;
END

// =====================================================================
// Moving candies: gravity, spawning, swaps
// =====================================================================

FUNCTION move_candy(f, t);
BEGIN
  col[t] = col[f]; spc[t] = spc[f];
  ox[t] = ox[f] + cx_of(f) - cx_of(t); oy[t] = oy[f] + cy_of(f) - cy_of(t);
  vy[t] = vy[f]; mv[t] = 0;
  col[f] = -1; spc[f] = 0; ox[f] = 0; oy[f] = 0; vy[f] = 0;
  RETURN 0;
END

// What is above empty cell i: a candy's index, -1 open to the top
// (new candies drop in), -2 a blocker is in the way
FUNCTION above(i);
PRIVATE j;
BEGIN
  j = i - 9;
  WHILE (j >= 0)
    IF (cell[j])
      IF (blk[j] > 0) RETURN -2; END
      IF (col[j] >= 0) RETURN j; END
    END
    j -= 9;
  END
  RETURN -1;
END

FUNCTION empty_cell(i); BEGIN RETURN (cell[i] AND blk[i] == 0 AND col[i] < 0); END

// Everything falls: columns first (through holes), new candies from the
// top, and cells shadowed by a blocker are fed diagonally
FUNCTION gravity();
PRIVATE c, r, i, j, moved, spawn, done;
BEGIN
  REPEAT
    moved = 0;
    FOR c = 0 TO 8
      spawn = 0; r = 8;
      WHILE (r >= 0)
        i = r * 9 + c;
        IF (empty_cell(i))
          j = above(i);
          IF (j >= 0) move_candy(j, i); moved = 1; END
          IF (j == -1)
            spawn++;
            col[i] = rand(0, ncol - 1); spc[i] = 0; mv[i] = 0; ox[i] = 0; vy[i] = 0;
            oy[i] = BY - CS * spawn - cy_of(i);
            moved = 1;
          END
        END
        r--;
      END
    END
    IF (moved == 0)
      done = 0; r = 8;
      WHILE (r >= 1 AND done == 0)
        FOR c = 0 TO 8
          i = r * 9 + c;
          IF (done == 0 AND empty_cell(i))
            IF (above(i) == -2)
              j = i - 10;
              IF (c > 0 AND movable(j)) move_candy(j, i); done = 1; END
              j = i - 8;
              IF (done == 0 AND c < 8 AND movable(j)) move_candy(j, i); done = 1; END
            END
          END
        END
        r--;
      END
      moved = done;
    END
  UNTIL (moved == 0);
  RETURN 0;
END

FUNCTION swap_cells(a, b);
PRIVATE t;
BEGIN
  t = col[a]; col[a] = col[b]; col[b] = t;
  t = spc[a]; spc[a] = spc[b]; spc[b] = t;
  ox[a] = cx_of(b) - cx_of(a); oy[a] = cy_of(b) - cy_of(a);
  ox[b] = -ox[a]; oy[b] = -oy[a];
  mv[a] = 1; mv[b] = 1;
  RETURN 0;
END

FUNCTION at_rest();
PRIVATE i;
BEGIN
  FOR i = 0 TO 80
    IF (ox[i] != 0 OR oy[i] != 0) RETURN 0; END
  END
  RETURN 1;
END

// =====================================================================
// Looking for moves (spread over frames) and reshuffling
// =====================================================================

// Value of the lines through cell i (0 if no match)
FUNCTION line_val(i);
PRIVATE k, c, r, h, v, j, val;
BEGIN
  k = col[i];
  IF (k < 0 OR k > 5) RETURN 0; END
  c = i % 9; r = i / 9; h = 1; v = 1;
  j = c - 1; WHILE (j >= 0 AND col[r * 9 + j] == k) h++; j--; END
  j = c + 1; WHILE (j < 9 AND col[r * 9 + j] == k) h++; j++; END
  j = r - 1; WHILE (j >= 0 AND col[j * 9 + c] == k) v++; j--; END
  j = r + 1; WHILE (j < 9 AND col[j * 9 + c] == k) v++; j++; END
  IF (h >= 3) val += h; END
  IF (v >= 3) val += v; END
  IF (h >= 5 OR v >= 5) val += 12; END
  IF (h >= 3 AND v >= 3) val += 7; END
  IF (h == 4 OR v == 4) val += 4; END
  RETURN val;
END

FUNCTION eval_swap(a, b);
PRIVATE sa, sb, t, v;
BEGIN
  sa = spc[a]; sb = spc[b];
  IF (sa == 4 OR sb == 4) RETURN 30 + (sa > 0) * 10 + (sb > 0) * 10; END
  IF (sa > 0 AND sb > 0) RETURN 28; END
  IF (col[a] == col[b]) RETURN 0; END
  t = col[a]; col[a] = col[b]; col[b] = t;
  v = line_val(a) + line_val(b);
  t = col[a]; col[a] = col[b]; col[b] = t;
  IF (v > 0) v += (sa > 0 OR sb > 0) * 6 + (gtype == 2 AND (col[a] == gcol OR col[b] == gcol)) * 3; END
  RETURN v;
END

FUNCTION start_check();
BEGIN
  fm_row = 0; n_moves = 0; best_v = 0; hint_a = -1; hint_b = -1; phase = 5;
  RETURN 0;
END

// Three rows a frame; the best move found becomes the hint
FUNCTION check_step();
PRIVATE r, c, i, v, d, j;
BEGIN
  FOR r = fm_row TO fm_row + 2
    FOR c = 0 TO 8
      i = r * 9 + c;
      IF (movable(i))
        FOR d = 0 TO 1
          j = nbr(i, d + 1 + d);                  // right, then down
          IF (j >= 0)
            IF (movable(j))
              v = eval_swap(i, j);
              IF (v > 0)
                n_moves++;
                IF (v > best_v OR (v == best_v AND rand(0, 2) == 0)) best_v = v; hint_a = i; hint_b = j; END
              END
            END
          END
        END
      END
    END
  END
  fm_row += 3;
  IF (fm_row < 9) RETURN 0; END
  IF (n_moves > 0)
    shuffling = 0; phase = 0; idle_t = 0;
  ELSE
    IF (shuffling == 0)
      shuffling = 1; shuf_n = 0; n_shuffles++;
      FOR i = 0 TO 80 sv_col[i] = col[i]; sv_spc[i] = spc[i]; END
      popup(232, 230, "NO MOVES - SHUFFLE!", 19, 255, 220, 120, 24);
    END
    phase = 6;
  END
  RETURN 0;
END

// One reshuffle attempt a frame: candies trade places (flying there);
// after many failures new colours are rolled, then blockers melt
FUNCTION shuffle_step();
PRIVATE i, n, k, t;
BEGIN
  shuf_n++;
  IF (shuf_n % 40 == 0)                            // stuck: melt one blocker
    FOR i = 0 TO 80
      IF (blk[i] > 0 AND n == 0)
        IF (blk[i] == 3) n_choc--; END
        blk[i] = 0; sv_col[i] = rand(0, ncol - 1); sv_spc[i] = 0; paint_cell(i); n = 1;
      END
    END
    n = 0;
  END
  FOR i = 0 TO 80
    IF (cell[i] AND blk[i] == 0 AND sv_col[i] >= 0) lst[n] = i; n++; END
  END
  FOR i = 0 TO n - 1 src[lst[i]] = lst[i]; END
  i = n - 1;
  WHILE (i >= 1)                                   // Fisher-Yates on the sources
    k = rand(0, i);
    t = src[lst[i]]; src[lst[i]] = src[lst[k]]; src[lst[k]] = t;
    i--;
  END
  FOR i = 0 TO n - 1
    k = lst[i];
    col[k] = sv_col[src[k]]; spc[k] = sv_spc[src[k]];
    IF (shuf_n > 20 AND spc[k] == 0) col[k] = rand(0, ncol - 1); END
    ox[k] = cx_of(src[k]) - cx_of(k); oy[k] = cy_of(src[k]) - cy_of(k); mv[k] = 2;
  END
  IF (find_runs() == 0) start_check(); END
  RETURN 0;
END

// =====================================================================
// A move: swap, clear passes, cascades, end of move
// =====================================================================

FUNCTION try_swap(a, b);
BEGIN
  sw_a = a; sw_b = b; swap_cells(a, b); phase = 1; idle_t = 0; sel = -1; drag = -1;
  max_pop = 0; last_combo = 0;
  RETURN 0;
END

FUNCTION begin_pop(); BEGIN phase = 3; pt = 0; RETURN 0; END

FUNCTION after_swap();
PRIVATE sa, sb;
BEGIN
  sa = spc[sw_a]; sb = spc[sw_b];
  IF (sa == 4 OR sb == 4 OR (sa > 0 AND sb > 0))
    moves--; mult = 1; choc_hit = 0;
    do_combo(sw_a, sw_b); begin_pop();
    RETURN 0;
  END
  IF (find_runs() > 0)
    moves--; mult = 1; choc_hit = 0;
    resolve(sw_a, sw_b); begin_pop();
    RETURN 0;
  END
  swap_cells(sw_a, sw_b);                          // no match: back it goes
  phase = 2; n_bounce++;
  RETURN 0;
END

// The popped candies go: jelly and goal counters, new specials, gravity
FUNCTION finish_pop();
PRIVATE i, k, n;
BEGIN
  FOR i = 0 TO 80
    IF (mk[i] == 1 OR mk[i] == 2)
      n++;
      k = col[i];
      IF (gtype == 2 AND k == gcol AND gleft > 0) gleft--; END
      IF (jel[i] > 0)
        jel[i]--; score += 40;
        IF (jel[i] == 0) n_jelly--; END
        paint_cell(i);
      END
      IF (k > 5) k = 6; END
      burst(i, k, 4);
      col[i] = -1; spc[i] = 0;
    END
  END
  FOR i = 0 TO n_ns - 1
    k = ns_at[i];
    col[k] = ns_col[i]; spc[k] = ns_spc[i]; ox[k] = 0; oy[k] = 0; mv[k] = 0;
    ring(cx_of(k), cy_of(k), 30);
    IF (ns_spc[i] < 3) made_s++; END
    IF (ns_spc[i] == 3) made_w++; END
    IF (ns_spc[i] == 4) made_b++; END
  END
  max_pop = imax(max_pop, n); max_mult = imax(max_mult, mult);
  IF (gtype == 1) gleft = n_jelly; END
  gravity();
  phase = 4;
  RETURN 0;
END

FUNCTION cheer(m);
BEGIN
  SWITCH (m)
    CASE 2 popup(232, 200, "COMBO x2", 8, 255, 255, 255, 26);
    CASE 3 popup(232, 200, "SWEET! x3", 9, 255, 150, 220, 28);
    CASE 4 popup(232, 200, "TASTY! x4", 9, 255, 200, 90, 30);
    CASE 5 popup(232, 200, "DELICIOUS! x5", 13, 140, 230, 255, 30);
  END
  IF (m > 5) popup(232, 200, "DIVINE! x" + m, 10, 255, 240, 120, 32); END
  RETURN 0;
END

// Chocolate grows onto a neighbouring plain candy (called every second
// move in which no chocolate was eaten)
FUNCTION spread_choc();
PRIVATE i, n, s, t, d, j;
BEGIN
  s = rand(0, 80);
  FOR t = 0 TO 80
    i = (s + t) % 81;
    IF (blk[i] == 3)
      FOR d = 0 TO 3
        j = nbr(i, d);
        IF (j >= 0 AND n == 0)
          IF (movable(j) AND spc[j] == 0 AND col[j] < 6)
            burst(j, 7, 5);
            col[j] = -1; blk[j] = 3; n_choc++; paint_cell(j); n = 1;
          END
        END
      END
    END
  END
  RETURN n;
END

// Sugar crush: leftover moves turn random candies striped and fire them
FUNCTION sugar_round();
PRIVATE k, t, i, tries;
BEGIN
  pass_reset(); mult = 1;
  k = imin(moves, 3); moves -= k;
  FOR t = 1 TO k
    tries = 0;
    REPEAT i = rand(0, 80); tries++; UNTIL ((movable(i) AND spc[i] == 0 AND mk[i] == 0) OR tries > 60);
    IF (tries <= 60) spc[i] = rand(1, 2); mark(i); END
  END
  propagate(); score_blasts();
  RETURN 0;
END

FUNCTION finish(ok);
BEGIN
  won = ok; phase = 7; pt = 0; sel = -1;
  stars = 0;
  IF (won)
    stars = 1;
    IF (score >= s2) stars = 2; END
    IF (score >= s3) stars = 3; END
    best[level] = imax(best[level], stars);
    max_level = imax(max_level, level + 1);
    popup(232, 230, "LEVEL COMPLETE!", 15, 255, 230, 120, 30);
  ELSE
    popup(232, 230, "OUT OF MOVES", 12, 255, 120, 120, 30);
  END
  RETURN 0;
END

FUNCTION after_fall();
PRIVATE i, n;
BEGIN
  IF (find_runs() > 0)                             // cascade
    mult++; cheer(mult);
    resolve(-1, -1); begin_pop();
    RETURN 0;
  END
  pass_reset();                                    // armed wrapped candies blow again
  FOR i = 0 TO 80
    IF (spc[i] == 5 AND col[i] >= 0) mark(i); n++; END
  END
  IF (n > 0) n_wrap2 += n; propagate(); score_blasts(); begin_pop(); RETURN 0; END
  // the move is over
  IF (bonus)
    IF (moves > 0) sugar_round(); begin_pop(); ELSE finish(1); END
    RETURN 0;
  END
  IF (choc_hit == 0 AND n_choc > 0)                // every 2nd move without eating any
    choc_wait++;
    IF (choc_wait >= 2) spread_choc(); choc_wait = 0; END
  END
  IF (gtype == 0 AND score >= target AND moves <= 0) finish(1); RETURN 0; END
  IF (gtype > 0 AND gleft <= 0)
    IF (moves > 0)
      bonus = 1;
      popup(232, 180, "SUGAR CRUSH!", 12, 255, 120, 220, 34);
      sugar_round(); begin_pop();
    ELSE
      finish(1);
    END
    RETURN 0;
  END
  IF (moves <= 0) finish(0); RETURN 0; END
  start_check();
  RETURN 0;
END

// =====================================================================
// Levels: everything is derived from the level number
// =====================================================================

FUNCTION makes_match(i, k);
PRIVATE c, r;
BEGIN
  c = i % 9; r = i / 9;
  IF (c >= 2) IF (col[i - 1] == k AND col[i - 2] == k) RETURN 1; END END
  IF (r >= 2) IF (col[i - 9] == k AND col[i - 18] == k) RETURN 1; END END
  RETURN 0;
END

FUNCTION hole(r, c);                               // a hole and its mirror
BEGIN
  cell[r * 9 + c] = 0; cell[r * 9 + 8 - c] = 0;
  RETURN 0;
END

FUNCTION gen_level();
PRIVATE i, r, c, p, n, k;
BEGIN
  rand_seed(level * 7919 + 31);
  FOR i = 0 TO 80
    cell[i] = 1; col[i] = -1; spc[i] = 0; jel[i] = 0; blk[i] = 0;
    ox[i] = 0; oy[i] = 0; vy[i] = 0; mv[i] = 0; mk[i] = 0;
  END
  // board shape (mirrored left-right)
  p = 0;
  IF (level > 1) p = rand(0, 5); END
  SWITCH (p)
    CASE 1 hole(0, 0); hole(0, 1); hole(1, 0); hole(8, 0); hole(8, 1); hole(7, 0);
    CASE 2 hole(4, 4); hole(3, 4); hole(5, 4); hole(4, 3);
    CASE 3 FOR k = 1 TO rand(2, 2 + imin(level / 4, 4)) hole(rand(1, 8), rand(0, 3)); END
    CASE 4 hole(3, 0); hole(4, 0); hole(5, 0); hole(4, 1);
    CASE 5 hole(8, 0); hole(8, 1); hole(8, 2); hole(7, 0); hole(0, 4);
  END
  gtype = (level - 1) % 3;
  ncol = 5;
  IF (level >= 4) ncol = 6; END
  // jelly (mirrored pairs), double jelly on later levels
  n_jelly = 0;
  IF (gtype == 1)
    FOR k = 1 TO imin(5 + level, 28)
      r = rand(0, 8); c = rand(0, 4);
      n = 1;
      IF (level >= 8 AND rand(0, 99) < level * 3) n = 2; END
      i = r * 9 + c;
      IF (cell[i]) jel[i] = n; jel[r * 9 + 8 - c] = n; END
    END
    FOR i = 0 TO 80 IF (jel[i] > 0) n_jelly++; END END
  END
  // ice from level 3, chocolate on even levels from 6 (never in the top rows)
  IF (level >= 3)
    FOR k = 1 TO imin(1 + level / 3, 7)
      r = rand(2, 8); c = rand(0, 4); i = r * 9 + c;
      n = 1;
      IF (level >= 7 AND rand(0, 1) == 0) n = 2; END
      IF (cell[i] AND jel[i] == 0) blk[i] = n; blk[r * 9 + 8 - c] = n; END
    END
  END
  n_choc = 0; choc_wait = 0;
  IF (level >= 6 AND level % 2 == 0)
    FOR k = 0 TO imin((level - 6) / 4, 2)
      i = rand(5, 8) * 9 + rand(0, 8);
      IF (cell[i] AND blk[i] == 0 AND jel[i] == 0) blk[i] = 3; n_choc++; END
    END
  END
  // goal, moves, stars
  SWITCH (gtype)
    CASE 0
      moves = imax(15, 22 - level / 3);
      target = moves * (400 + level * 40) / 50 * 50;
      s1 = target; s2 = target * 3 / 2; s3 = target * 2;
    CASE 1
      moves = 16 + n_jelly / 3;
      gleft = n_jelly; target = 0;
      s1 = moves * 175; s2 = moves * 350; s3 = moves * 600;
    CASE 2
      gcol = rand(0, ncol - 1);
      gleft = imin(12 + level * 3 / 2, 60);
      moves = 20 + level / 6; target = 0;
      s1 = moves * 175; s2 = moves * 350; s3 = moves * 600;
  END
  // candies: no match at the start
  FOR i = 0 TO 80
    IF (cell[i] AND blk[i] == 0)
      REPEAT k = rand(0, ncol - 1); UNTIL (makes_match(i, k) == 0);
      col[i] = k;
    END
  END
  rand_seed();
  RETURN 0;
END

FUNCTION start_level(n);
PRIVATE s, k;
BEGIN
  level = n;
  gen_level();
  paint_board();
  put_screen(0, g_bg);
  score = 0; mult = 1; bonus = 0; sel = -1; drag = -1; won = 0;
  FOR k = 0 TO 159 pa_t[k] = 0; END                // no leftover effects
  FOR k = 0 TO 9 pp_t[k] = 0; END
  FOR k = 0 TO 7 bm_t[k] = 0; rg_t[k] = 0; END
  state = 2;
  start_check();
  SWITCH (gtype)
    CASE 0 s = "SCORE " + target + " POINTS"; k = ndig(target) + 13;
    CASE 1 s = "CLEAR ALL THE JELLY"; k = 19;
    CASE 2 s = "COLLECT " + gleft + " CANDIES"; k = ndig(gleft) + 16;
  END
  popup(232, 200, "LEVEL " + level, ndig(level) + 6, 255, 240, 140, 34);
  popup(232, 250, s, k, 255, 255, 255, 18);
  RETURN 0;
END

// =====================================================================
// Screens: HUD, level map, result
// =====================================================================

PROCESS hud();
PRIVATE ls, lm, lg, ll, gr, w, i, xx, lit;
BEGIN
  x = 545; y = 240; ls = -1;
  LOOP
    graph = 0;
    IF (state >= 2)
      graph = g_hud;
      IF (ls != score OR lm != moves OR lg != gleft OR ll != level)
        ls = score; lm = moves; lg = gleft; ll = level;
        gr = g_hud;
        gfx_fill_rgba(gr, 0, 0, 0, 0);
        ctext(gr, 85, 10, "LEVEL " + level, ndig(level) + 6, 255, 225, 120, 24);
        gtext(gr, 12, 50, "GOAL", 200, 170, 230, 12);
        SWITCH (gtype)
          CASE 0 gtext(gr, 12, 66, "Reach " + target, 255, 255, 255, 15);
                 gtext(gr, 12, 88, "points", 255, 255, 255, 15);
          CASE 1 gtext(gr, 12, 66, "Clear the jelly", 255, 190, 230, 15);
                 gtext(gr, 12, 88, "" + gleft + " left", 255, 255, 255, 18);
          CASE 2 gtext(gr, 12, 66, "Collect", 255, 255, 255, 15);
                 gtext(gr, 12, 88, "" + gleft + " to go", 255, 255, 255, 18);
        END
        gtext(gr, 12, 128, "MOVES", 200, 170, 230, 12);
        ctext(gr, 85, 144, "" + moves, ndig(moves), 255, 255, 255, 44);
        gtext(gr, 12, 208, "SCORE", 200, 170, 230, 12);
        ctext(gr, 85, 224, "" + score, ndig(score), 255, 240, 150, 28);
        gfx_rect(gr, 12, 272, 150, 14, 30, 15, 40);           // star bar
        w = imin(148, score * 148 / imax(1, s3));
        gfx_rect(gr, 13, 273, w, 12, 255, 110, 190);
        FOR i = 1 TO 3
          IF (i == 1) xx = s1; END
          IF (i == 2) xx = s2; END
          IF (i == 3) xx = s3; END
          lit = (score >= xx);
          IF (i == 1 AND gtype > 0) lit = (gleft <= 0); END
          xx = 12 + xx * 146 / imax(1, s3);
          IF (lit)
            star(gr, xx, 268, 9, 255, 215, 60);
          ELSE
            star(gr, xx, 268, 9, 110, 90, 120);
          END
        END
        gtext(gr, 8, 330, "Swap neighbours:", 210, 200, 230, 12);
        gtext(gr, 8, 346, "click one, then", 210, 200, 230, 12);
        gtext(gr, 8, 362, "the other, or drag.", 210, 200, 230, 12);
        gtext(gr, 8, 386, "4 in line: striped", 180, 170, 200, 11);
        gtext(gr, 8, 400, "L / T: wrapped", 180, 170, 200, 11);
        gtext(gr, 8, 414, "5 in line: bomb", 180, 170, 200, 11);
      END
    END
    FRAME;
  END
END

PROCESS goal_icon();
BEGIN
  x = 575; y = 76; size = 70;
  LOOP
    graph = 0;
    IF (state >= 2 AND gtype == 2) graph = g_cand[gcol]; END
    FRAME;
  END
END

PROCESS overlay();
BEGIN
  x = 320; y = 240; z = -50;
  LOOP
    graph = 0;
    IF (state == 3) graph = g_res; END
    FRAME;
  END
END

FUNCTION node_x(n); PRIVATE c; BEGIN c = n % 5; IF ((n / 5) % 2 == 1) c = 4 - c; END RETURN 120 + c * 100; END
FUNCTION node_y(n); BEGIN RETURN 410 - (n / 5) * 105; END

FUNCTION draw_map();
PRIVATE n, lv, px, py, w, s, r, g, b;
BEGIN
  rand_seed(7);
  backdrop(g_map, 0);
  rand_seed();
  ctext(g_map, 320, 16, "SUGAR SWAP", 10, 255, 235, 130, 48);
  ctext(g_map, 320, 72, "Match 3 candies of a colour. Pick a level!", 42, 255, 255, 255, 14);
  FOR n = 0 TO 13                                     // the candy road (straight pieces)
    px = imin(node_x(n), node_x(n + 1)); py = imin(node_y(n), node_y(n + 1));
    w = abs(node_x(n) - node_x(n + 1)); s = abs(node_y(n) - node_y(n + 1));
    gfx_rect(g_map, px - 6, py - 6, w + 12, s + 12, 150, 70, 130);
    gfx_rect(g_map, px - 4, py - 4, w + 8, s + 8, 255, 225, 240);
  END
  FOR n = 0 TO 14
    lv = map_page * 15 + n + 1; px = node_x(n); py = node_y(n);
    IF (lv <= max_level)
      r = 255; g = 90; b = 170;
      IF (best[lv] == 0) r = 255; g = 190; b = 50; END
      gfx_circle(g_map, px, py + 3, 25, 90, 30, 70);
      gfx_circle(g_map, px, py, 25, r, g, b);
      gfx_circle(g_map, px - 7, py - 8, 7, 255, 255, 255);
      ctext(g_map, px, py - 10, "" + lv, ndig(lv), 255, 255, 255, 20);
      FOR s = 1 TO 3
        IF (best[lv] >= s) star(g_map, px - 24 + s * 12, py + 34, 7, 255, 215, 60);
        ELSE star(g_map, px - 24 + s * 12, py + 34, 7, 120, 90, 120); END
      END
    ELSE
      gfx_circle(g_map, px, py, 22, 120, 110, 140);
      ctext(g_map, px, py - 8, "" + lv, ndig(lv), 190, 180, 200, 16);
    END
  END
  IF (map_page > 0) gfx_circle(g_map, 40, 440, 20, 90, 40, 120); ctext(g_map, 40, 428, "<", 1, 255, 255, 255, 24); END
  IF (max_level > map_page * 15 + 15) gfx_circle(g_map, 600, 440, 20, 90, 40, 120); ctext(g_map, 600, 428, ">", 1, 255, 255, 255, 24); END
  RETURN 0;
END

FUNCTION go_map();
BEGIN
  state = 1; map_page = (level - 1) / 15;         // the page of the last level played
  draw_map(); put_screen(0, g_map);
  RETURN 0;
END

FUNCTION map_frame(click);
PRIVATE n, lv;
BEGIN
  FOR n = 0 TO 14
    lv = map_page * 15 + n + 1;
    IF (lv <= max_level AND fget_distance(mouse.x, mouse.y, node_x(n), node_y(n)) < 26)
      set_color('rgba(255,255,255,0.35)'); circle(node_x(n), node_y(n), 30);
      IF (click) start_level(lv); RETURN 0; END
    END
  END
  IF (click AND fget_distance(mouse.x, mouse.y, 40, 440) < 22 AND map_page > 0)
    map_page--; draw_map();
  END
  IF (click AND fget_distance(mouse.x, mouse.y, 600, 440) < 22 AND max_level > map_page * 15 + 15)
    map_page++; draw_map();
  END
  IF (key_pressed(_enter) OR key_pressed(_space)) start_level(max_level); END
  RETURN 0;
END

FUNCTION show_result();
PRIVATE gr, s;
BEGIN
  gr = g_res;
  gfx_fill_rgba(gr, 0, 0, 0, 50);
  gfx_rect(gr, 146, 86, 348, 308, 90, 30, 90);
  gfx_rect(gr, 150, 90, 340, 300, 250, 170, 215);
  gfx_rect(gr, 156, 96, 328, 288, 120, 50, 130);
  IF (won)
    ctext(gr, 320, 108, "LEVEL " + level + " COMPLETE!", ndig(level) + 16, 255, 235, 130, 24);
  ELSE
    ctext(gr, 320, 108, "LEVEL " + level + " FAILED", ndig(level) + 13, 255, 150, 150, 24);
  END
  FOR s = 1 TO 3
    IF (stars >= s) star(gr, 190 + s * 65, 190 - (s == 2) * 14, 30 + (s == 2) * 6, 255, 215, 60);
    ELSE star(gr, 190 + s * 65, 190 - (s == 2) * 14, 30 + (s == 2) * 6, 80, 40, 90); END
  END
  ctext(gr, 320, 240, "SCORE " + score, ndig(score) + 6, 255, 255, 255, 22);
  IF (won == 0)
    IF (gtype == 0) ctext(gr, 320, 272, "needed " + target, ndig(target) + 7, 255, 200, 220, 15); END
    IF (gtype == 1) ctext(gr, 320, 272, "" + gleft + " jelly left", ndig(gleft) + 11, 255, 200, 220, 15); END
    IF (gtype == 2) ctext(gr, 320, 272, "" + gleft + " candies short", ndig(gleft) + 14, 255, 200, 220, 15); END
  END
  gfx_rect(gr, 170, 320, 100, 40, 255, 120, 190); ctext(gr, 220, 332, "RETRY", 5, 255, 255, 255, 18);
  gfx_rect(gr, 285, 320, 70, 40, 150, 120, 220); ctext(gr, 320, 332, "MAP", 3, 255, 255, 255, 18);
  IF (won) gfx_rect(gr, 370, 320, 100, 40, 90, 200, 110); ctext(gr, 420, 332, "NEXT", 4, 255, 255, 255, 18); END
  state = 3;
  RETURN 0;
END

FUNCTION in_box(bx, by, w, h); BEGIN RETURN (mouse.x >= bx AND mouse.x < bx + w AND mouse.y >= by AND mouse.y < by + h); END

FUNCTION result_frame(click);
BEGIN
  IF (in_box(170, 320, 100, 40)) draw_rect(170, 320, 100, 3, '#ffffff'); END
  IF (in_box(285, 320, 70, 40)) draw_rect(285, 320, 70, 3, '#ffffff'); END
  IF (won AND in_box(370, 320, 100, 40)) draw_rect(370, 320, 100, 3, '#ffffff'); END
  IF ((click AND in_box(170, 320, 100, 40)) OR key_pressed(_r)) start_level(level); RETURN 0; END
  IF ((click AND in_box(285, 320, 70, 40)) OR key_pressed(_esc)) go_map(); RETURN 0; END
  IF (won AND ((click AND in_box(370, 320, 100, 40)) OR key_pressed(_enter))) start_level(level + 1); END
  RETURN 0;
END

// Player input while the board is idle: click-click or drag
FUNCTION idle_input(click);
PRIVATE mx, my, c, ddx, ddy, t;
BEGIN
  IF (at_rest() == 0) RETURN 0; END
  IF (recheck) recheck = 0; start_check(); RETURN 0; END   // board edited from outside
  idle_t += get_delta();
  mx = int(mouse.x); my = int(mouse.y); c = -1;
  IF (mx >= BX AND my >= BY AND mx < BX + 9 * CS AND my < BY + 9 * CS)
    c = ((my - BY) / CS) * 9 + (mx - BX) / CS;
  END
  IF (click)
    IF (c >= 0 AND movable(c))
      IF (sel >= 0 AND adjacent(sel, c)) try_swap(sel, c); RETURN 0; END
      IF (sel == c) sel = -1; drag = -1; ELSE sel = c; drag = c; dx0 = mx; dy0 = my; END
    ELSE
      sel = -1;
    END
  END
  IF (mouse.left AND drag >= 0)
    ddx = mx - dx0; ddy = my - dy0; t = -1;
    IF (abs(ddx) > 20 OR abs(ddy) > 20)
      IF (abs(ddx) > abs(ddy))
        IF (ddx > 0 AND drag % 9 < 8) t = drag + 1; END
        IF (ddx < 0 AND drag % 9 > 0) t = drag - 1; END
      ELSE
        IF (ddy > 0 AND drag < 72) t = drag + 9; END
        IF (ddy < 0 AND drag >= 9) t = drag - 9; END
      END
      IF (t >= 0)
        IF (movable(t)) try_swap(drag, t); RETURN 0; END
      END
      drag = -1;
    END
  END
  IF (mouse.left == 0) drag = -1; END
  IF (sel >= 0)                                    // selection frame
    draw_rect(BX + (sel % 9) * CS, BY + (sel / 9) * CS, CS, 3, '#ffffff');
    draw_rect(BX + (sel % 9) * CS, BY + (sel / 9) * CS + CS - 3, CS, 3, '#ffffff');
    draw_rect(BX + (sel % 9) * CS, BY + (sel / 9) * CS, 3, CS, '#ffffff');
    draw_rect(BX + (sel % 9) * CS + CS - 3, BY + (sel / 9) * CS, 3, CS, '#ffffff');
  END
  RETURN 0;
END

FUNCTION play_frame(click);
BEGIN
  IF (key_pressed(_esc)) go_map(); RETURN 0; END
  SWITCH (phase)
    CASE 0 idle_input(click);
    CASE 1 IF (at_rest()) after_swap(); END
    CASE 2 IF (at_rest()) phase = 0; END
    CASE 3 pt += get_delta(); IF (pt >= 0.2) finish_pop(); END
    CASE 4 IF (at_rest()) after_fall(); END
    CASE 5 check_step();
    CASE 6 shuffle_step();
    CASE 7 pt += get_delta(); IF (pt > 1.2 AND at_rest()) show_result(); END
  END
  RETURN 0;
END

// =====================================================================
// MAIN
// =====================================================================
PRIVATE i, ml, click;
BEGIN
  set_mode(640, 480);
  set_fps(60, 0);
  screen_color('#2a1030');
  // palette: red, orange, yellow, green, blue, purple
  cr[0] = 235; cg[0] = 45;  cb[0] = 60;
  cr[1] = 255; cg[1] = 140; cb[1] = 25;
  cr[2] = 250; cg[2] = 210; cb[2] = 30;
  cr[3] = 60;  cg[3] = 190; cb[3] = 55;
  cr[4] = 45;  cg[4] = 135; cb[4] = 250;
  cr[5] = 165; cg[5] = 70;  cb[5] = 225;
  css[0] = '#ff5060'; css[1] = '#ffa030'; css[2] = '#ffe040'; css[3] = '#70e060';
  css[4] = '#50a8ff'; css[5] = '#c070ff'; css[6] = '#ffffff'; css[7] = '#8a5430'; css[8] = '#d8f0ff';
  g_bg = new_graphic(640, 480); g_map = new_graphic(640, 480);
  g_hud = new_graphic(176, 432); g_res = new_graphic(640, 480);
  FOR i = 0 TO 9 g_pop[i] = new_graphic(300, 44); popup_slot(i); END
  FOR i = 0 TO 80 slot(i); END
  fxman(); hud(); goal_icon(); overlay();
  FOR i = 0 TO 24 baker(i); END
  LOOP
    ml = mouse.left;
    click = (ml AND lprev == 0); lprev = ml;
    SWITCH (state)
      CASE 0                                         // baking the candy sprites
        IF (baked == 25) go_map(); END
        draw_rect(220, 236, 200, 12, '#502040');
        draw_rect(220, 236, baked * 8, 12, '#ff80c0');
        set_color('#ffffff'); text(262, 220, "Baking candies...");
      CASE 1 map_frame(click);
      CASE 2 play_frame(click);
      CASE 3 result_frame(click);
    END
    FRAME;
  END
END
