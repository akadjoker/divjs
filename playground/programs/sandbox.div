PROGRAM sandbox;

// TERRADIV - a small procedural sandbox in the style of Terraria.
// Every new game builds a new 400x120 world of 8-pixel tiles:
//  - the surface is 1D value noise (three octaves of random knots joined
//    with smoothstep), with a grass / dirt / stone layering and a jagged
//    bedrock floor;
//  - dirt and stone blobs, copper / iron / gold veins (deeper = richer),
//    caves dug by random "worms" and a few large caverns;
//  - lakes are flooded into the dips of the surface and of the caves,
//    trees are planted on the grass.
// The tiles live packed four to a number (base 16) in one global array.
// A BUILDER process does the work over many frames and paints the world
// once into a 3200x960 graphic shown through a scroll window; afterwards
// every change repaints just that tile (and one pixel of the minimap).
// Water is a cheap cellular automaton: only cells in a queue of "active"
// water are updated (fall, or step sideways towards the nearest drop).
// Light: a 16-pixel grid over the screen gets sky light (by time of day
// and depth below the ground) plus torch and player glows, and is drawn
// as a few dark rectangles per row.

GLOBAL
  // ---- world: TW x TH tiles of 8x8 pixels, packed 4 per number
  TW = 400; TH = 120; NW = 100;          // NW = numbers per row
  DAYLEN = 10800; DUSK = 6480;         // frames per day, night starts at DUSK
  REACH = 76;                          // mining / building reach (pixels)
  wt[11999];                           // tiles: tile (i, j) is digit i % 4 of wt[j * NW + i / 4]
  p16[3];                              // 1, 16, 256, 4096
  top[399];                            // first solid row of every column
  gsurf[399];                          // generated surface row: sky behind above, cave wall below
  ddep[399]; bedr[399];                // dirt depth and bedrock row of every column
  knot[259];                           // value-noise knots, 65 per octave

  // ---- tiles: 0 air, 1 grass, 2 dirt, 3 stone, 4 copper, 5 iron, 6 gold,
  //      7 wood (trunk), 8 leaves, 9 water, 10 bedrock, 11 planks,
  //      12 torch, 13 furnace, 14 sand
  t_solid[15]; t_hard[15]; t_tier[15]; t_item[15]; t_r[15]; t_g[15]; t_b[15];

  // ---- items: 1 dirt, 2 stone, 3-5 ores, 6 wood, 7 planks, 8 torch,
  //      9 furnace, 10 sand, 11-13 copper/iron/gold bars
  it_name[15]; it_tile[15]; it_kind[15]; it_c1[15]; it_c2[15]; g_item[15];
  inv_it[9]; inv_n[9]; sel = 0;        // 10 hotbar slots

  // ---- crafting: out item (101-103 = pickaxe tier), amount, two ingredients
  rc_out[8]; rc_n[8]; rc_a[8]; rc_an[8]; rc_b[8]; rc_bn[8]; rc_furn[8]; rc_txt[8];
  pick = 0; pk_name[3]; pk_speed[3];

  // ---- active water cells (ring buffer of cell numbers j * TW + i)
  wq[1023]; wq_h = 0; wq_t = 0;
  // ---- torches (tile coordinates), lighting grid, glow table, shades
  tch_i[63]; tch_j[63]; n_tch = 0;
  lt[1418]; lf[120]; dk[8];            // light grid 43x33 cells of 16 pixels
  lg_bx = 0; lg_by = 0;                // world cell of the grid's corner
  ru_x[499]; ru_y[499]; ru_w[499]; ru_l[499]; n_ru = 0;   // shade runs to draw

  // ---- enemies: 8 slots shared with the player's attack code
  en_on[7]; en_x[7]; en_y[7]; en_hp[7]; en_max[7]; en_kind[7]; en_kb[7];

  // ---- graphics
  g_map = 0; g_mini = 0; g_pl[1]; g_slime[1]; g_zomb[1]; g_pick[3];

  // ---- body physics scratch used by move_body()
  b_x = 0.0; b_y = 0.0; b_vx = 0.0; b_vy = 0.0; b_gnd = 0; b_wet = 0; b_hitx = 0;
  cr = 0; cg = 0; cb = 0;              // colour returned by sky_rgb()
  work = 0;                            // generation work since the last FRAME

  // ---- game state: 0 title, 1 playing, 2 paused, 3 dead, 4 building
  state = 0; gen_pct = 0; gen_msg = ""; tod = 0; day = 1; dl = 8; near_furn = 0; hour = 6;
  pl_x = 0.0; pl_y = 0.0; pl_vx = 0.0; pl_vy = 0.0; pl_gnd = 0; pl_wet = 0;
  pl_hp = 100; pl_inv = 0; pl_kb = 0; pl_face = 1; pl_calm = 0;
  spawn_x = 0; spawn_y = 0; dead_t = 0; camx = 0; camy = 0;
  mine_i = -1; mine_j = -1; mine_p = 0.0; mine_h = 1; swing = 0; swing_ph = 0;
  cur_i = 0; cur_j = 0; cur_ok = 0; place_cd = 0; hit_cd = 0; craft_open = 0; over_ui = 0;
  m_l = 0; m_r = 0; m_click = 0; prev_l = 0; msg = ""; msg_t = 0;
  n_en = 0; n_drop = 0; n_pop = 0; spawn_t = 0;
  // statistics (also read by the test page)
  st_mined = 0; st_placed = 0; st_picked = 0; st_crafted = 0; st_kills = 0;
  st_deaths = 0; st_hits = 0; st_hurt = 0; st_flow = 0; st_worlds = 0;

// ---- Small helpers -----------------------------------------------------

FUNCTION mn(a, b);
BEGIN
  IF (a < b) RETURN a; END
  RETURN b;
END

FUNCTION mx(a, b);
BEGIN
  IF (a > b) RETURN a; END
  RETURN b;
END

// Tile at (i, j); the sides and the bottom are bedrock, above is air.
FUNCTION tget(i, j);
BEGIN
  IF (i < 0 OR i >= TW OR j >= TH) RETURN 10; END
  IF (j < 0) RETURN 0; END
  RETURN (wt[j * NW + i / 4] / p16[i % 4]) % 16;
END

// Raw write of one tile (generation only: nothing is repainted).
FUNCTION tset(i, j, t);
PRIVATE n, o;
BEGIN
  IF (i < 0 OR i >= TW OR j < 0 OR j >= TH) RETURN 0; END
  n = j * NW + i / 4; o = (wt[n] / p16[i % 4]) % 16; wt[n] += (t - o) * p16[i % 4];
  RETURN 0;
END

FUNCTION solid_at(i, j);
BEGIN
  RETURN t_solid[tget(i, j)];
END

// One octave of value noise at column i: knots every sp columns.
FUNCTION noise(o, i, sp);
PRIVATE k, t;
BEGIN
  k = i / sp; t = (i % sp) / (sp + 0.001); t = t * t * (3 - 2 * t);
  RETURN lerp(knot[o * 65 + k], knot[o * 65 + k + 1], t);
END

// Sky colour of tile row j (a vertical gradient) into cr, cg, cb.
FUNCTION sky_rgb(j);
BEGIN
  cr = mn(100 + j * 1.3, 180); cg = mn(160 + j * 0.9, 215); cb = mn(235 + j * 0.3, 250);
  RETURN 0;
END

FUNCTION say(t);
BEGIN
  msg = t; msg_t = 150;
  RETURN 0;
END

// ---- Tables and graphics -----------------------------------------------

FUNCTION tdef(t, solid, hard, tier, item, r, g, b);
BEGIN
  t_solid[t] = solid; t_hard[t] = hard; t_tier[t] = tier; t_item[t] = item;
  t_r[t] = r; t_g[t] = g; t_b[t] = b;
  RETURN 0;
END

// Item i: name, tile it places (0 none), icon kind and a 6x6 drop sprite.
// kinds: 0 block, 1 ore, 2 log, 3 torch, 4 bar, 5 furnace
FUNCTION idef(i, name, tile, kind, r, g, b);
PRIVATE gr;
BEGIN
  it_name[i] = name; it_tile[i] = tile; it_kind[i] = kind;
  it_c1[i] = "rgb(" + r + "," + g + "," + b + ")";
  it_c2[i] = "rgb(" + int(r * 0.6) + "," + int(g * 0.6) + "," + int(b * 0.6) + ")";
  gr = new_graphic(6, 6);
  SWITCH (kind)
    CASE 0 gfx_rect(gr, 0, 0, 6, 6, r, g, b); gfx_rect(gr, 1, 1, 2, 2, r * 0.7, g * 0.7, b * 0.7);
    CASE 1
      gfx_rect(gr, 0, 0, 6, 6, 110, 110, 118); gfx_rect(gr, 1, 1, 2, 2, r, g, b);
      gfx_rect(gr, 3, 3, 2, 2, r, g, b);
    CASE 2 gfx_rect(gr, 0, 1, 6, 4, r, g, b); gfx_rect(gr, 4, 1, 2, 4, r * 1.3, g * 1.3, b * 1.2);
    CASE 3 gfx_rect(gr, 2, 2, 2, 4, 120, 80, 45); gfx_rect(gr, 1, 0, 4, 3, 255, 170, 40);
    CASE 4 gfx_rect(gr, 0, 2, 6, 3, r * 0.7, g * 0.7, b * 0.7); gfx_rect(gr, 1, 2, 4, 1, r, g, b);
    CASE 5 gfx_rect(gr, 0, 0, 6, 6, r, g, b); gfx_rect(gr, 2, 3, 2, 2, 255, 130, 30);
  END
  g_item[i] = gr;
  RETURN 0;
END

FUNCTION rdef(k, out, n, a, an, b, bn, furn);
BEGIN
  rc_out[k] = out; rc_n[k] = n; rc_a[k] = a; rc_an[k] = an; rc_b[k] = b; rc_bn[k] = bn;
  rc_furn[k] = furn;
  IF (out > 100) rc_txt[k] = pk_name[out - 100] + " pickaxe";
  ELSE rc_txt[k] = it_name[out] + " x" + n; END
  rc_txt[k] = rc_txt[k] + "  <- " + an + " " + it_name[a];
  IF (bn > 0) rc_txt[k] = rc_txt[k] + " + " + bn + " " + it_name[b]; END
  IF (furn) rc_txt[k] = rc_txt[k] + "  [furnace]"; END
  RETURN 0;
END

FUNCTION init_tables();
PRIVATE i, j, d;
BEGIN
  p16[0] = 1; p16[1] = 16; p16[2] = 256; p16[3] = 4096;
  //   tile  solid hard tier item  minimap colour
  tdef(0,  0, 0,  9, 0,  0, 0, 0);
  tdef(1,  1, 12, 0, 1,  70, 160, 60);      // grass (drops dirt)
  tdef(2,  1, 12, 0, 1,  130, 90, 55);      // dirt
  tdef(3,  1, 40, 0, 2,  120, 120, 126);    // stone
  tdef(4,  1, 50, 0, 3,  205, 120, 70);     // copper ore
  tdef(5,  1, 66, 1, 4,  200, 180, 170);    // iron ore: copper pickaxe
  tdef(6,  1, 80, 2, 5,  240, 205, 60);     // gold ore: iron pickaxe
  tdef(7,  0, 30, 0, 6,  120, 80, 45);      // tree trunk
  tdef(8,  0, 4,  0, 0,  50, 130, 50);      // leaves
  tdef(9,  0, 0,  9, 0,  40, 90, 210);      // water
  tdef(10, 1, 0,  9, 0,  45, 40, 50);       // bedrock
  tdef(11, 1, 25, 0, 7,  185, 140, 85);     // planks
  tdef(12, 0, 1,  0, 8,  255, 200, 80);     // torch
  tdef(13, 0, 35, 0, 9,  110, 105, 105);    // furnace
  tdef(14, 1, 10, 0, 10, 215, 195, 130);    // sand
  tdef(15, 1, 40, 0, 2,  120, 120, 126); idef(1, "Dirt", 2, 0, 130, 90, 55);
  idef(2, "Stone", 3, 0, 120, 120, 126); idef(3, "Copper ore", 4, 1, 215, 125, 70);
  idef(4, "Iron ore", 5, 1, 205, 185, 175); idef(5, "Gold ore", 6, 1, 245, 210, 60);
  idef(6, "Wood", 0, 2, 140, 95, 55); idef(7, "Planks", 11, 0, 185, 140, 85);
  idef(8, "Torch", 12, 3, 255, 200, 80); idef(9, "Furnace", 13, 5, 110, 105, 105);
  idef(10, "Sand", 14, 0, 215, 195, 130); idef(11, "Copper bar", 0, 4, 225, 130, 75);
  idef(12, "Iron bar", 0, 4, 210, 205, 200); idef(13, "Gold bar", 0, 4, 250, 215, 70);
  pk_name[0] = "Wooden"; pk_name[1] = "Copper"; pk_name[2] = "Iron"; pk_name[3] = "Gold";
  pk_speed[0] = 1; pk_speed[1] = 1.6; pk_speed[2] = 2.3; pk_speed[3] = 3.2;
  rdef(0, 7, 4, 6, 1, 0, 0, 0);             // planks
  rdef(1, 8, 3, 6, 1, 0, 0, 0);             // torches
  rdef(2, 9, 1, 2, 12, 6, 2, 0);            // furnace
  rdef(3, 11, 1, 3, 3, 0, 0, 1);            // bars need a furnace
  rdef(4, 12, 1, 4, 3, 0, 0, 1); rdef(5, 13, 1, 5, 3, 0, 0, 1);
  rdef(6, 101, 1, 11, 4, 6, 2, 0);          // pickaxes
  rdef(7, 102, 1, 12, 5, 6, 2, 0); rdef(8, 103, 1, 13, 5, 6, 2, 0);
  // glow of a light at distance d (in 16-pixel cells): 8 at the centre
  FOR j = -5 TO 5
    FOR i = -5 TO 5
      d = sqrt(i * i + j * j); lf[(j + 5) * 11 + i + 5] = int(clamp(9 - d * 1.6, 0, 8));
    END
  END
  // darkness shade of every light level (8 = no shade)
  FOR i = 0 TO 7 dk[i] = "rgba(4,6,20," + (8 - i) * 0.117 + ")"; END
  RETURN 0;
END

// Person 10x20 facing right; zombie = green skin, torn clothes, arms out.
FUNCTION make_person(zombie, step);
PRIVATE g, sr, sg, sb;
BEGIN
  g = new_graphic(10, 20); sr = 240; sg = 190; sb = 150;
  IF (zombie) sr = 110; sg = 170; sb = 100; END
  gfx_rect(g, 2, 2, 6, 6, sr, sg, sb);                       // head
  IF (zombie) gfx_rect(g, 2, 1, 6, 2, 60, 80, 50);
  ELSE gfx_rect(g, 1, 0, 8, 3, 110, 60, 30); gfx_rect(g, 1, 3, 2, 3, 110, 60, 30); END
  gfx_rect(g, 6, 4, 1, 2, 20, 20, 20);                       // eye
  IF (zombie) gfx_rect(g, 1, 8, 8, 6, 70, 80, 130); gfx_rect(g, 5, 9, 5, 2, sr, sg, sb);
  ELSE gfx_rect(g, 1, 8, 8, 6, 60, 110, 210); gfx_rect(g, 4, 9, 2, 5, sr, sg, sb); END
  gfx_rect(g, 2, 14, 6, 3, 70, 50, 40);                      // trousers
  IF (step) gfx_rect(g, 1, 17, 2, 3, 50, 35, 30); gfx_rect(g, 7, 17, 2, 3, 50, 35, 30);
  ELSE gfx_rect(g, 2, 17, 2, 3, 50, 35, 30); gfx_rect(g, 6, 17, 2, 3, 50, 35, 30); END
  RETURN g;
END

FUNCTION make_graphics();
PRIVATE g, k, r, gg, b;
BEGIN
  g_map = new_graphic(3200, 960); g_mini = new_graphic(200, 60);
  g_pl[0] = make_person(0, 0); g_pl[1] = make_person(0, 1);
  g_zomb[0] = make_person(1, 0); g_zomb[1] = make_person(1, 1);
  // slime: squat on the ground, tall in the air
  FOR k = 0 TO 1
    g = new_graphic(12, 9);
    IF (k == 0) gfx_rect(g, 0, 3, 12, 6, 60, 170, 230); gfx_rect(g, 2, 1, 8, 2, 60, 170, 230);
    ELSE gfx_rect(g, 1, 0, 10, 9, 60, 170, 230); END
    gfx_rect(g, 3, 4, 2, 2, 20, 40, 60); gfx_rect(g, 7, 4, 2, 2, 20, 40, 60);
    gfx_rect(g, 2, 3 - k, 2, 1, 200, 240, 255); g_slime[k] = g;
  END
  // pickaxes 12x12 drawn pointing up-right, pivot at the end of the handle
  FOR k = 0 TO 3
    g = new_graphic(12, 12); r = 150; gg = 110; b = 60;
    IF (k == 1) r = 225; gg = 130; b = 75; END
    IF (k == 2) r = 215; gg = 210; b = 205; END
    IF (k == 3) r = 250; gg = 215; b = 70; END
    gfx_line(g, 1, 10, 8, 3, 110, 75, 40); gfx_line(g, 2, 10, 9, 3, 110, 75, 40);
    gfx_line(g, 4, 1, 11, 8, r, gg, b); gfx_line(g, 5, 1, 11, 7, r, gg, b);
    set_point(0, g, 0, 1, 10); g_pick[k] = g;
  END
  RETURN 0;
END

// ---- Painting tiles into the world graphic and the minimap -------------

// Base colour of the plain tiles (cave wall behind air, dirt, stone,
// bedrock, sand) into cr, cg, cb; 0 for tiles with their own drawing.
FUNCTION plain_rgb(t);
BEGIN
  SWITCH (t)
    CASE 3 cr = 118; cg = 118; cb = 124;
    CASE 2 cr = 130; cg = 90; cb = 55;
    CASE 0 cr = 48; cg = 37; cb = 30;
    CASE 10 cr = 42; cg = 38; cb = 48;
    CASE 14 cr = 215; cg = 195; cb = 130;
    DEFAULT RETURN 0;
  END
  RETURN 1;
END

// Texture spot of a plain tile (every third tile has one); h = 0..3.
FUNCTION speckle(i, j, t, h);
PRIVATE x, y;
BEGIN
  x = i * 8 + (h * 5 + i) % 6; y = j * 8 + (h * 3 + j) % 6;
  SWITCH (t)
    CASE 3
      gfx_rect(g_map, x, y, 3, 2, 96, 96, 104);
      IF (h == 1) gfx_rect(g_map, x + 1, y + 2, 1, 1, 150, 150, 158); END
    CASE 2
      gfx_rect(g_map, x, y, 2, 1, 100, 68, 40);
      IF (h == 1) gfx_rect(g_map, x + 1, y + 2, 1, 1, 155, 112, 72); END
    CASE 0 gfx_rect(g_map, x, y, 3, 2, 38, 29, 23);
    CASE 10 gfx_rect(g_map, x, y, 3, 2, 25, 22, 30);
    CASE 14 gfx_rect(g_map, x, y, 1, 1, 180, 160, 100);
  END
  RETURN 0;
END

FUNCTION tile_hash(i, j);
BEGIN
  RETURN (i * 7 + j * 13 + (i * j) % 7) % 9;
END

FUNCTION paint_tile(i, j);
PRIVATE t, x, y, h, sh;
BEGIN
  t = tget(i, j); x = i * 8; y = j * 8; h = tile_hash(i, j);
  IF (t != 0 OR j >= gsurf[i])
    IF (plain_rgb(t))
      gfx_rect(g_map, x, y, 8, 8, cr, cg, cb);
      IF ((i + j) % 3 == 0) speckle(i, j, t, (i * 7 + j * 13) % 4); END
      RETURN 0;
    END
  END
  IF (t_solid[t] == 0)                             // see-through: sky or cave wall behind
    IF (j < gsurf[i])
      sky_rgb(j); gfx_rect(g_map, x, y, 8, 8, cr, cg, cb);
    ELSE
      gfx_rect(g_map, x, y, 8, 8, 48, 37, 30);
      IF ((i + j) % 3 == 0) speckle(i, j, 0, (i * 7 + j * 13) % 4); END
    END
    IF (t == 0) RETURN 0; END
  END
  sh = (h - 4) * 3;
  SWITCH (t)
    CASE 1
      gfx_rect(g_map, x, y, 8, 8, 130 + sh, 90 + sh, 55);
      gfx_rect(g_map, x, y, 8, 3, 70 + sh, 165 + sh, 60);
      gfx_rect(g_map, x + h % 7, y + 3, 1, 1 + h % 2, 60, 140, 50);
    CASE 4, 5, 6
      gfx_rect(g_map, x, y, 8, 8, 112 + sh, 112 + sh, 118 + sh);
      gfx_rect(g_map, x + 1, y + 1 + h % 2, 2, 2, t_r[t], t_g[t], t_b[t]);
      gfx_rect(g_map, x + 4 + h % 3, y + 3, 2, 2, t_r[t], t_g[t], t_b[t]);
      gfx_rect(g_map, x + 2, y + 5 + h % 2, 2, 2, t_r[t] * 0.8, t_g[t] * 0.8, t_b[t] * 0.8);
    CASE 7
      gfx_rect(g_map, x + 1, y, 6, 8, 115 + sh, 75 + sh, 42);
      gfx_rect(g_map, x + 3, y, 1, 8, 85, 55, 30);
      IF (h == 4) gfx_rect(g_map, x + 5, y + 3, 1, 2, 80, 50, 28); END
    CASE 8
      gfx_rect(g_map, x, y, 8, 8, 45 + sh, 128 + sh, 48);
      gfx_rect(g_map, x + h % 6, y + (h * 2) % 6, 2, 2, 30, 95, 35);
      gfx_rect(g_map, x + (h * 3) % 6, y + (h + 4) % 6, 2, 2, 75, 165, 65);
    CASE 9
      IF (j < gsurf[i]) gfx_rect(g_map, x, y, 8, 8, 45, 110, 215);
      ELSE gfx_rect(g_map, x, y, 8, 8, 35, 70, 160); END
      IF (tget(i, j - 1) == 0) gfx_rect(g_map, x, y, 8, 2, 130, 185, 245); END
    CASE 11
      gfx_rect(g_map, x, y, 8, 8, 185 + sh, 140 + sh, 85);
      gfx_rect(g_map, x, y + 3, 8, 1, 140, 100, 60); gfx_rect(g_map, x, y + 7, 8, 1, 140, 100, 60);
      gfx_rect(g_map, x + (j % 2) * 4 + 1, y, 1, 3, 150, 110, 65);
    CASE 12
      gfx_rect(g_map, x + 3, y + 3, 2, 5, 120, 80, 45);
      gfx_rect(g_map, x + 2, y + 1, 4, 3, 255, 150, 40);
      gfx_rect(g_map, x + 3, y + 1, 2, 2, 255, 235, 130);
    CASE 13
      gfx_rect(g_map, x, y + 1, 8, 7, 105, 100, 100);
      gfx_rect(g_map, x + 1, y + 1, 6, 1, 145, 140, 140);
      gfx_rect(g_map, x + 2, y + 4, 4, 3, 255, 120, 30);
      gfx_rect(g_map, x + 3, y + 5, 2, 1, 255, 225, 90);
  END
  RETURN 0;
END

// One minimap pixel (2x2 tiles) from the tile at (i, j).
FUNCTION mini_px(i, j);
PRIVATE t;
BEGIN
  t = tget(i, j);
  IF (t == 0)
    IF (j < gsurf[i]) gfx_rect(g_mini, i / 2, j / 2, 1, 1, 120, 180, 240);
    ELSE gfx_rect(g_mini, i / 2, j / 2, 1, 1, 30, 23, 19); END
  ELSE
    gfx_rect(g_mini, i / 2, j / 2, 1, 1, t_r[t], t_g[t], t_b[t]);
  END
  RETURN 0;
END

// ---- Changing the world while playing ----------------------------------

FUNCTION wake(i, j);
PRIVATE n;
BEGIN
  IF (tget(i, j) != 9) RETURN 0; END
  n = (wq_t + 1) % 1024;
  IF (n == wq_h) RETURN 0; END                     // queue full: forget it
  wq[wq_t] = j * TW + i; wq_t = n;
  RETURN 0;
END

// Every change goes through here: packed map, graphic, minimap, the
// column's top, the torch list and the water queue stay in step.
FUNCTION set_tile(i, j, t);
PRIVATE n, o, k;
BEGIN
  IF (i < 0 OR i >= TW OR j < 0 OR j >= TH) RETURN 0; END
  n = j * NW + i / 4; o = (wt[n] / p16[i % 4]) % 16;
  IF (o == t) RETURN 0; END
  wt[n] += (t - o) * p16[i % 4]; paint_tile(i, j);
  IF (tget(i, j + 1) == 9) paint_tile(i, j + 1); END   // water surface line
  mini_px(i, j);
  IF (t_solid[t] AND j < top[i]) top[i] = j; END
  IF (t_solid[t] == 0 AND j == top[i])
    k = j;
    WHILE (k < TH AND t_solid[tget(i, k)] == 0) k++; END
    top[i] = k;
  END
  IF (o == 12)                                     // a torch went away
    FOR k = 0 TO n_tch - 1
      IF (tch_i[k] == i AND tch_j[k] == j)
        n_tch--; tch_i[k] = tch_i[n_tch]; tch_j[k] = tch_j[n_tch];
        BREAK;
      END
    END
  END
  IF (t == 12 AND n_tch < 64) tch_i[n_tch] = i; tch_j[n_tch] = j; n_tch++; END
  IF (t == 9) wake(i, j); END
  IF (t == 0 OR t == 12)                           // water around may flow in now
    wake(i, j - 1); wake(i - 1, j); wake(i + 1, j); wake(i - 1, j - 1); wake(i + 1, j - 1);
  END
  RETURN 0;
END

// Cellular water: a few queued cells per frame fall into air below or
// step one tile towards the nearest drop within 10 tiles on their row.
FUNCTION water_step();
PRIVATE n, c, i, j, d, s, k, moved;
BEGIN
  FOR n = 1 TO 48
    IF (wq_h == wq_t) BREAK; END
    c = wq[wq_h]; wq_h = (wq_h + 1) % 1024; i = c % TW; j = c / TW;
    IF (tget(i, j) != 9) CONTINUE; END
    IF (tget(i, j + 1) == 0)
      set_tile(i, j, 0); set_tile(i, j + 1, 9); st_flow++;
      CONTINUE;
    END
    d = rand(0, 1) * 2 - 1; moved = 0;
    FOR s = 0 TO 1
      FOR k = 1 TO 10
        IF (tget(i + d * k, j) != 0) BREAK; END
        IF (tget(i + d * k, j + 1) == 0)
          set_tile(i, j, 0); set_tile(i + d, j, 9); st_flow++; moved = 1; BREAK;
        END
      END
      IF (moved) BREAK; END
      d = -d;
    END
  END
  RETURN 0;
END

// ---- Inventory, drops and crafting -------------------------------------

FUNCTION inv_count(it);
PRIVATE s, n;
BEGIN
  n = 0;
  FOR s = 0 TO 9 IF (inv_it[s] == it) n += inv_n[s]; END END
  RETURN n;
END

// Adds n of item it: stacks first, then an empty slot. 0 = no room.
FUNCTION inv_add(it, n);
PRIVATE s;
BEGIN
  FOR s = 0 TO 9
    IF (inv_it[s] == it AND inv_n[s] > 0) inv_n[s] += n; RETURN 1; END
  END
  FOR s = 0 TO 9
    IF (inv_n[s] == 0) inv_it[s] = it; inv_n[s] = n; RETURN 1; END
  END
  RETURN 0;
END

FUNCTION inv_take(it, n);
PRIVATE s, k;
BEGIN
  FOR s = 0 TO 9
    IF (inv_it[s] == it AND n > 0)
      k = mn(n, inv_n[s]); inv_n[s] -= k; n -= k;
      IF (inv_n[s] == 0) inv_it[s] = 0; END
    END
  END
  RETURN 0;
END

FUNCTION craft(r);
PRIVATE o;
BEGIN
  o = rc_out[r];
  IF (o > 100 AND pick >= o - 100) say("You already have a pickaxe that good"); RETURN 0; END
  IF (rc_furn[r] AND near_furn == 0) say("You need to stand near a furnace"); RETURN 0; END
  IF (inv_count(rc_a[r]) < rc_an[r] OR (rc_bn[r] > 0 AND inv_count(rc_b[r]) < rc_bn[r]))
    say("Not enough materials"); RETURN 0;
  END
  inv_take(rc_a[r], rc_an[r]);
  IF (rc_bn[r] > 0) inv_take(rc_b[r], rc_bn[r]); END
  IF (o > 100)
    pick = o - 100; say("Crafted a " + pk_name[pick] + " pickaxe!");
  ELSE
    IF (inv_add(o, rc_n[r]) == 0)                  // no room: give it back
      inv_add(rc_a[r], rc_an[r]);
      IF (rc_bn[r] > 0) inv_add(rc_b[r], rc_bn[r]); END
      say("Inventory full"); RETURN 0;
    END
    say("Crafted " + rc_txt[r]);
  END
  st_crafted++;
  RETURN 0;
END

FUNCTION spawn_drop(it, px, py);
BEGIN
  IF (it <= 0) RETURN 0; END
  IF (n_drop < 40) drop(it, px, py);
  ELSE IF (inv_add(it, 1)) st_picked++; END END
  RETURN 0;
END

// An item lying in the world: falls, and flies to the player nearby.
PROCESS drop(it, px, py);
PRIVATE vy, vx, d, dx, dy, life, j;
BEGIN
  n_drop++; ctype = c_scroll; z = -3; graph = g_item[it];
  vy = -1.5; vx = rand(-10, 10) * 0.1; life = 60 * 180;
  LOOP
    IF (state == 1 OR state == 3)
      dx = pl_x - px; dy = pl_y - 10 - py; d = sqrt(dx * dx + dy * dy);
      IF (state == 1 AND d < 44)
        IF (d < 9)
          IF (inv_add(it, 1)) st_picked++; popup("+1 " + it_name[it], pl_x, pl_y - 24, "#e8ffd0"); BREAK; END
        END
        px += dx * 3.5 / (d + 0.01); py += dy * 3.5 / (d + 0.01);
      ELSE
        vy = mn(vy + 0.25, 5);
        IF (solid_at(floor((px + vx) / 8), floor(py / 8)) == 0) px += vx; END
        vx = vx * 0.95; j = floor((py + 3 + vy) / 8);
        IF (vy > 0 AND solid_at(floor(px / 8), j)) py = j * 8 - 3; vy = 0; vx = vx * 0.6;
        ELSE py += vy; END
        IF (solid_at(floor(px / 8), floor(py / 8))) py -= 8; END  // buried by a block
      END
      life--;
      IF (life <= 0 OR py > TH * 8) BREAK; END
    END
    x = px; y = py - 1 + sin(life * 6000) * 1.5;
    FRAME;
  END
  n_drop--;
END

// Floating text in world coordinates (drawn after the darkness).
PROCESS popup(txt, px, py, col);
PRIVATE t;
BEGIN
  IF (n_pop >= 14) RETURN; END
  n_pop++; priority = -20;
  FOR t = 0 TO 50
    IF (state != 4) set_color(col); text(px - camx - 12, py - camy - t * 0.5, txt); END
    FRAME;
  END
  n_pop--;
END

// =====================================================================
// Bodies (player and enemies): box of half width hw and height bh whose
// feet are at (b_x, b_y); x first, then y, with a one-tile step-up.
// =====================================================================

FUNCTION box_hits(x0, x1, y0, y1);
PRIVATE i, j, i1, j1;
BEGIN
  i1 = floor((x1 - 0.01) / 8); j1 = floor((y1 - 0.01) / 8);
  FOR j = floor(y0 / 8) TO j1
    FOR i = floor(x0 / 8) TO i1
      IF (t_solid[tget(i, j)]) RETURN 1; END
    END
  END
  RETURN 0;
END

FUNCTION move_body(hw, bh);
PRIVATE nx, ny, c, grav, maxf;
BEGIN
  b_wet = (tget(floor(b_x / 8), floor((b_y - bh * 0.5) / 8)) == 9); grav = 0.33; maxf = 7;
  IF (b_wet) grav = 0.1; maxf = 1.8; END
  b_hitx = 0;
  IF (b_vx != 0)
    nx = b_x + b_vx;
    IF (box_hits(nx - hw, nx + hw, b_y - bh, b_y))
      ny = floor((b_y - 0.01) / 8) * 8;            // one tile up
      IF (b_gnd AND b_y - ny <= 8.5 AND box_hits(nx - hw, nx + hw, ny - bh, ny) == 0)
        b_x = nx; b_y = ny;
      ELSE
        b_hitx = 1;
        IF (b_vx > 0) c = floor((nx + hw - 0.01) / 8); b_x = c * 8 - hw;
        ELSE c = floor((nx - hw) / 8); b_x = (c + 1) * 8 + hw; END
        b_vx = 0;
      END
    ELSE
      b_x = nx;
    END
  END
  b_vy = mn(b_vy + grav, maxf); ny = b_y + b_vy;
  IF (b_vy > 0)
    IF (box_hits(b_x - hw, b_x + hw, ny - bh, ny))
      b_y = floor((ny - 0.01) / 8) * 8; b_vy = 0; b_gnd = 1;
    ELSE
      b_y = ny; b_gnd = 0;
    END
  ELSE
    IF (box_hits(b_x - hw, b_x + hw, ny - bh, ny))
      b_y = (floor((ny - bh) / 8) + 1) * 8 + bh; b_vy = 0;
    ELSE
      b_y = ny;
    END
    b_gnd = 0;
  END
  RETURN 0;
END

FUNCTION hurt_player(d, dir);
BEGIN
  IF (pl_inv > 0 OR state != 1) RETURN 0; END
  pl_hp -= d; pl_inv = 45; pl_kb = dir * 4; pl_calm = 0; st_hurt++;
  popup("-" + d, pl_x, pl_y - 26, "#ff6060");
  IF (pl_hp <= 0)
    pl_hp = 0; state = 3; dead_t = 240; st_deaths++; mine_p = 0; craft_open = 0;
    say("You were slain...");
  END
  RETURN 0;
END

// ---- Player: movement, mining, building, fighting ----------------------

FUNCTION break_tile(i, j);
PRIVATE t, k, a, b;
BEGIN
  t = tget(i, j); st_mined++;
  IF (t == 7)                                      // fell the whole tree above
    k = j;
    WHILE (tget(i, k) == 7) set_tile(i, k, 0); spawn_drop(6, i * 8 + 4, k * 8 + 4); k--; END
    FOR b = k - 3 TO k + 2
      FOR a = i - 2 TO i + 2
        IF (tget(a, b) == 8) set_tile(a, b, 0); END
      END
    END
    RETURN 0;
  END
  set_tile(i, j, 0); spawn_drop(t_item[t], i * 8 + 4, j * 8 + 4);
  IF (t == 8 AND rand(0, 3) == 0) spawn_drop(6, i * 8 + 4, j * 8 + 4); END
  RETURN 0;
END

FUNCTION try_place(i, j);
PRIVATE it, t, k, ok, a_tile;
BEGIN
  it = inv_it[sel];
  IF (inv_n[sel] <= 0) RETURN 0; END
  t = it_tile[it];
  IF (t == 0) say(it_name[it] + " can't be placed - craft with it"); RETURN 0; END
  k = tget(i, j);
  IF (k != 0 AND k != 9) RETURN 0; END
  IF (t_solid[t])                                  // not inside a body
    IF (i * 8 < pl_x + 5 AND i * 8 + 8 > pl_x - 5 AND j * 8 < pl_y AND j * 8 + 8 > pl_y - 20) RETURN 0; END
    FOR k = 0 TO 7
      IF (en_on[k] AND abs(i * 8 + 4 - en_x[k]) < 10 AND j * 8 < en_y[k] AND j * 8 + 8 > en_y[k] - 20) RETURN 0; END
    END
  END
  // needs something to hold on to (the cave wall counts)
  ok = (j >= gsurf[i]);
  IF (t == 13) ok = solid_at(i, j + 1);
  ELSE
    IF (t == 12) ok = ok OR solid_at(i, j + 1) OR solid_at(i - 1, j) OR solid_at(i + 1, j);
    ELSE
      FOR k = 0 TO 3
        a_tile = tget(i + (k == 0) - (k == 1), j + (k == 2) - (k == 3));
        IF (a_tile != 0 AND a_tile != 9) ok = 1; END
      END
    END
  END
  IF (ok == 0) RETURN 0; END
  set_tile(i, j, t); inv_n[sel]--;
  IF (inv_n[sel] == 0) inv_it[sel] = 0; END
  st_placed++; place_cd = 9;
  RETURN 1;
END

// Mouse actions of one frame: attack the enemy under the cursor, else
// mine (left) or build (right) the tile under it.
FUNCTION interact();
PRIVATE wx, wy, ti, tj, t, k, tgt, dmg;
BEGIN
  wx = mouse.x + camx; wy = mouse.y + camy; ti = floor(wx / 8); tj = floor(wy / 8);
  cur_i = ti; cur_j = tj; cur_ok = (distance(pl_x, pl_y - 10, ti * 8 + 4, tj * 8 + 4) <= REACH);
  IF (place_cd > 0) place_cd--; END
  IF (hit_cd > 0) hit_cd--; END
  IF (over_ui) mine_p = 0; RETURN 0; END
  IF (m_l)
    IF (wx > pl_x) pl_face = 1; ELSE pl_face = -1; END
    tgt = -1;
    FOR k = 0 TO 7
      IF (en_on[k] AND abs(wx - en_x[k]) < 10 AND wy < en_y[k] + 3 AND wy > en_y[k] - 12 - en_kind[k] * 10)
        tgt = k;
      END
    END
    IF (tgt >= 0 AND distance(pl_x, pl_y - 10, en_x[tgt], en_y[tgt] - 6) < REACH + 16)
      swing = 12; mine_p = 0;
      IF (hit_cd == 0)
        dmg = 10 + pick * 5;
        en_hp[tgt] -= dmg; en_kb[tgt] = pl_face * 3.2; hit_cd = 20; st_hits++;
        popup("-" + dmg, en_x[tgt], en_y[tgt] - 24, "#ffe070");
      END
      RETURN 0;
    END
    t = tget(ti, tj);
    IF (t != 0 AND t != 9 AND cur_ok)
      IF (ti != mine_i OR tj != mine_j) mine_i = ti; mine_j = tj; mine_p = 0; END
      swing = 12;
      IF (t_tier[t] > pick)
        IF (t == 10) say("Bedrock can't be mined");
        ELSE say("You need a better pickaxe for " + it_name[t_item[t]]); END
        RETURN 0;
      END
      IF (t != 7 AND tget(ti, tj - 1) == 7) say("Cut the tree down first"); RETURN 0; END
      mine_h = mx(t_hard[t], 1); mine_p += pk_speed[pick];
      IF (mine_p >= mine_h) break_tile(ti, tj); mine_p = 0; END
    ELSE
      mine_p = 0;
    END
  ELSE
    mine_p = 0;
  END
  IF (m_r AND place_cd == 0 AND cur_ok) try_place(ti, tj); END
  RETURN 0;
END

PROCESS player();
PRIVATE dir, spd, acc, falling, fy0, d, anim;
BEGIN
  ctype = c_scroll; z = -5; graph = g_pl[0]; pl_vx = 0; pl_vy = 0; pl_gnd = 0; tool();
  LOOP
    IF (state == 1)
      dir = 0;
      IF (key(_a) OR key(_left)) dir = -1; END
      IF (key(_d) OR key(_right)) dir = dir + 1; END
      spd = 1.7; acc = 0.2;
      IF (pl_wet) spd = 0.9; END
      IF (pl_gnd) acc = 0.35; END
      pl_vx = pl_vx + clamp(dir * spd - pl_vx, -acc, acc);
      IF (dir != 0 AND m_l == 0) pl_face = dir; END
      IF (key(_space) OR key(_w) OR key(_up))
        IF (pl_gnd) pl_vy = -5.4;
        ELSE IF (pl_wet) pl_vy = mx(pl_vy - 0.6, -2.4); END END
      END
      IF (pl_kb != 0) pl_vx = pl_kb; pl_vy = -3.2; pl_kb = 0; END
      b_x = pl_x; b_y = pl_y; b_vx = pl_vx; b_vy = pl_vy; b_gnd = pl_gnd; move_body(5, 20);
      pl_x = b_x; pl_y = b_y; pl_vx = b_vx; pl_vy = b_vy; pl_gnd = b_gnd; pl_wet = b_wet;
      // fall damage after more than ~12 tiles
      IF (pl_wet) falling = 0; END
      IF (pl_gnd == 0 AND pl_vy > 0 AND falling == 0) falling = 1; fy0 = pl_y; END
      IF (pl_gnd AND falling)
        falling = 0; d = pl_y - fy0;
        IF (d > 100) hurt_player(int((d - 100) / 3), 0); END
      END
      IF (pl_inv > 0) pl_inv--; END
      IF (swing > 0) swing--; swing_ph++; END
      interact();
      // walk animation and blinking while hurt
      IF (pl_gnd AND abs(pl_vx) > 0.3) anim++; END
      graph = g_pl[(anim / 8) % 2];
      IF (pl_inv > 0 AND (pl_inv / 4) % 2) graph = 0; END
      flags = (pl_face < 0);
    END
    IF (state == 3) graph = 0; falling = 0; END
    // the camera follows the player, clamped to the world
    camx = int(clamp(pl_x - 320, 0, TW * 8 - 640));
    camy = int(clamp(pl_y - 250, 0, TH * 8 - 480)); scroll.x0 = camx; scroll.y0 = camy;
    x = pl_x; y = pl_y - 10;
    FRAME;
  END
END

// The pickaxe swinging in the player's hand.
PROCESS tool();
PRIVATE a;
BEGIN
  ctype = c_scroll; z = -6;
  LOOP
    IF (swing > 0 AND state == 1)
      graph = g_pick[pick]; a = (swing_ph * 7000) % 100000; x = pl_x + pl_face * 3; y = pl_y - 11;
      IF (pl_face > 0) angle = 30000 - a; flags = 0;
      ELSE angle = a - 30000; flags = 1; END
    ELSE
      graph = 0;
    END
    FRAME;
  END
END

// ---- Enemies: slimes hop, zombies walk and jump; both hurt on contact. ----

PROCESS enemy(s, kind, bx, by);
PRIVATE vx, vy, gnd, hw, bh, t, dir, anim, hurt_t, hitx, lastx, stuck;
BEGIN
  ctype = c_scroll; z = -4; en_on[s] = 1; en_kind[s] = kind; en_kb[s] = 0; n_en++;
  IF (kind == 0) hw = 6; bh = 9; en_max[s] = 25;
  ELSE hw = 4; bh = 19; en_max[s] = 40 + day * 5; END
  en_hp[s] = en_max[s]; t = rand(20, 60);
  LOOP
    IF (state == 1 OR state == 3)
      dir = sign(pl_x - bx);
      IF (dir == 0) dir = 1; END
      IF (kind == 0)
        IF (gnd)
          vx = vx * 0.7; t--;
          IF (t <= 0) vy = -4.2 - rand(0, 15) * 0.1; vx = dir * (1.5 + rand(0, 8) * 0.1); t = rand(40, 80); END
        END
      ELSE
        vx = vx + (dir * 0.75 - vx) * 0.1;
        IF (gnd AND hitx) vy = -5.2; END
      END
      IF (en_kb[s] != 0) vx = en_kb[s]; vy = -3; en_kb[s] = 0; hurt_t = 12; END
      b_x = bx; b_y = by; b_vx = vx; b_vy = vy; b_gnd = gnd; move_body(hw, bh);
      bx = b_x; by = b_y; vx = b_vx; vy = b_vy; gnd = b_gnd; hitx = b_hitx;
      IF (kind == 1 AND hitx) vx = dir * 0.3; END   // keep pushing to jump again
      IF (b_wet AND pl_y < by) vy = mx(vy - 0.4, -2.2); END   // swim up towards the player
      // an enemy that makes no progress for 4 s far from the player gives up
      stuck++;
      IF (stuck >= 240)
        IF (abs(bx - lastx) < 12 AND abs(bx - pl_x) > 80) BREAK; END
        stuck = 0; lastx = bx;
      END
      en_x[s] = bx; en_y[s] = by;
      IF (state == 1 AND abs(pl_x - bx) < hw + 5 AND pl_y > by - bh AND pl_y - 20 < by)
        hurt_player(8 + kind * 5 + day, sign(pl_x - bx));
      END
      IF (en_hp[s] <= 0)
        st_kills++; popup("defeated", bx, by - 20, "#ffffff");
        IF (rand(0, 2) == 0) spawn_drop(8, bx, by - 6); END   // a torch now and then
        BREAK;
      END
      IF (tod < DUSK - 100 AND tod > 60) popup("poof", bx, by - 10, "#ffe0a0"); BREAK; END
      IF (abs(bx - pl_x) > 900 OR by > TH * 8) BREAK; END
      IF (abs(vx) > 0.2) anim++; END
    END
    IF (kind == 0) graph = g_slime[gnd == 0]; flags = 0;
    ELSE graph = g_zomb[(anim / 10) % 2]; flags = (dir < 0); END
    IF (hurt_t > 0) hurt_t--; IF (hurt_t % 4 < 2) graph = 0; END END
    x = bx; y = by - bh / 2;
    FRAME;
  END
  en_on[s] = 0; n_en--;
END

// At night, now and then, an enemy appears on the surface off screen.
FUNCTION try_spawn();
PRIVATE s, k, side, c, j, cap;
BEGIN
  cap = mn(2 + day, 7);
  IF (n_en >= cap) RETURN 0; END
  s = -1;
  FOR k = 0 TO 7 IF (en_on[k] == 0) s = k; END END
  IF (s < 0) RETURN 0; END
  side = rand(0, 1) * 2 - 1; c = int(pl_x / 8) + side * rand(42, 52);
  IF (c < 3 OR c > TW - 4) c = int(pl_x / 8) - side * rand(42, 52); END
  c = clamp(c, 3, TW - 4); j = top[c];
  IF (tget(c, j - 1) == 9 OR abs(j * 8 - pl_y) > 240) RETURN 0; END
  enemy(s, rand(0, 1), c * 8 + 4, j * 8);
  RETURN 0;
END

// ---- World generation --------------------------------------------------

// Disc of radius r at (ci, cj): set to t where the tile is `only` (-1 =
// anything but bedrock).
FUNCTION blob(ci, cj, r, t, only);
PRIVATE i, j, n, o, w, pw, r2;
BEGIN
  n = int(r); r2 = r * r; work += (2 * n + 1) * (2 * n + 1);
  FOR j = mx(cj - n, 0) TO mn(cj + n, TH - 1)
    FOR i = mx(ci - n, 0) TO mn(ci + n, TW - 1)
      IF ((i - ci) * (i - ci) + (j - cj) * (j - cj) <= r2)
        w = j * NW + i / 4; pw = p16[i % 4];      // inline tget / tset
        o = (wt[w] / pw) % 16;
        IF ((only < 0 AND o != 10) OR o == only) wt[w] += (t - o) * pw; END
      END
    END
  END
  RETURN 0;
END

FUNCTION vein(t, jmin, jmax, len);
PRIVATE i, j, s;
BEGIN
  i = rand(2, TW - 3); j = rand(mx(jmin, gsurf[i] + 5), jmax);
  FOR s = 1 TO len blob(i, j, rand(8, 15) * 0.1, t, 3); i += rand(-1, 1); j += rand(-1, 1); END
  RETURN 0;
END

// Flood the dip whose lowest air cell is (i, j), row by row upwards,
// while every row is closed by walls and stands on solid or water.
FUNCTION pool(i, j, depth, sandy);
PRIVATE d, r, l, rr, k, b, ok, n, a;
BEGIN
  n = 0;
  FOR d = 0 TO depth - 1
    r = j - d;
    IF (tget(i, r) != 0) BREAK; END
    l = i; WHILE (l > 1 AND tget(l - 1, r) == 0 AND i - l < 30) l--; END
    rr = i; WHILE (rr < TW - 2 AND tget(rr + 1, r) == 0 AND rr - i < 30) rr++; END
    IF (solid_at(l - 1, r) == 0 OR solid_at(rr + 1, r) == 0) BREAK; END
    ok = 1;
    FOR k = l TO rr
      b = tget(k, r + 1);
      IF (b != 9 AND t_solid[b] == 0) ok = 0; BREAK; END
    END
    IF (ok == 0) BREAK; END
    FOR k = l TO rr tset(k, r, 9); END
    n++;
    IF (sandy)                                     // sandy banks and bottom
      FOR k = l - 1 TO rr + 1
        FOR a = r TO r + 2
          b = tget(k, a);
          IF (b == 1 OR b == 2) tset(k, a, 14); END
        END
      END
    END
  END
  RETURN n;
END

PROCESS builder();
PRIVATE i, j, k, q, v, t, n, a, r, ci, cj, s, h, base, len, cnt;
  wlo[99]; whi[99]; wbd[99];           // per packed word: top, dirt bottom, bedrock
BEGIN
  state = 4; gen_pct = 0; gen_msg = "Shaping the land";
  FRAME;
  // 1. surface heights, dirt depth and bedrock of every column
  FOR i = 0 TO 259 knot[i] = rand(-100, 100); END
  base = rand(34, 42);
  FOR i = 0 TO TW - 1
    h = base + noise(0, i, 64) * 0.17 + noise(1, i, 24) * 0.07 + noise(2, i, 8) * 0.025;
    gsurf[i] = int(clamp(h, 16, 64)); ddep[i] = 4 + int((noise(3, i, 16) + 100) * 0.03);
    bedr[i] = TH - 1 - rand(0, 2);
    IF (i == TW / 2) FRAME; END
  END
  FRAME;
  // 2. fill the packed rows: air, grass, dirt, stone, bedrock. A word
  // (4 columns) that is all air or all stone on a row is written at once.
  FOR k = 0 TO NW - 1
    wlo[k] = 999; whi[k] = 0; wbd[k] = 999;
    FOR q = 0 TO 3
      i = k * 4 + q;
      wlo[k] = mn(wlo[k], gsurf[i]); whi[k] = mx(whi[k], gsurf[i] + ddep[i]); wbd[k] = mn(wbd[k], bedr[i]);
    END
  END
  FOR j = 0 TO TH - 1
    FOR k = 0 TO NW - 1
      IF (j < wlo[k]) wt[j * NW + k] = 0; CONTINUE; END
      IF (j >= whi[k] AND j < wbd[k]) wt[j * NW + k] = 13107; CONTINUE; END   // 3333 in base 16
      v = 0;
      FOR q = 0 TO 3
        i = k * 4 + q; s = gsurf[i]; t = 3;
        IF (j < s) t = 0;
        ELSE
          IF (j == s) t = 1;
          ELSE
            IF (j < s + ddep[i]) t = 2; END
            IF (j >= bedr[i]) t = 10; END
          END
        END
        v += t * p16[q];
      END
      wt[j * NW + k] = v;
    END
    IF (j % 3 == 2) gen_pct = j * 12 / TH; FRAME; END
  END
  // 3. dirt pockets in the stone, stone lumps in the dirt, ore veins
  gen_msg = "Burying ores";
  FOR n = 1 TO 70
    i = rand(0, TW - 1); blob(i, rand(gsurf[i] + ddep[i] + 2, 105), rand(15, 32) * 0.1, 2, 3);
    IF (work > 900) work = 0; FRAME; END
  END
  FOR n = 1 TO 30 i = rand(0, TW - 1); blob(i, gsurf[i] + rand(2, 4), rand(10, 18) * 0.1, 3, 2); END
  FOR n = 1 TO 80 vein(4, 44, 90, rand(3, 7)); IF (work > 900) work = 0; FRAME; END END
  FOR n = 1 TO 60 vein(5, 58, 112, rand(3, 7)); IF (work > 900) work = 0; FRAME; END END
  FOR n = 1 TO 40 vein(6, 80, 114, rand(3, 6)); IF (work > 900) work = 0; FRAME; END END
  gen_pct = 20;
  // 4. caves: worms that wander and dig; the first ones open to the sky
  gen_msg = "Digging caves";
  FOR n = 1 TO 36
    IF (n <= 5)
      ci = rand(10, TW - 11);
      IF (abs(ci - TW / 2) < 14) ci = ci + 30; END
      cj = gsurf[ci] - 1; a = -90000 + rand(-35000, 35000); len = rand(25, 45);
    ELSE
      ci = rand(5, TW - 6); cj = rand(gsurf[ci] + 10, 108); a = rand(0, 359999); len = rand(30, 90);
    END
    FOR s = 0 TO len
      r = 1.3 + sin(s * 20000 + n * 50000) * 0.6 + rand(0, 10) * 0.08;
      IF (n > 5 AND s % 25 == 12) r = r + rand(1, 2); END
      blob(int(ci), int(cj), r, 0, -1); a = a + rand(-22000, 22000);
      ci = ci + get_distx(a, 1.5); cj = cj + get_disty(a, 1.0);
      IF (ci < 3 OR ci > TW - 4) a = 180000 - a; ci = clamp(ci, 3, TW - 4); END
      IF (cj > 112) a = -a; cj = 112; END
      IF (n > 5 AND cj < gsurf[int(ci)] + 6) a = -a; cj = gsurf[int(ci)] + 6; END
      IF (work > 900) work = 0; FRAME; END
    END
    gen_pct = 20 + n;
  END
  // big caverns: a few overlapping discs deep down
  FOR n = 1 TO 9
    ci = rand(20, TW - 21); cj = rand(70, 104);
    FOR k = 1 TO rand(3, 5) blob(ci + rand(-6, 6), cj + rand(-2, 2), rand(30, 50) * 0.1, 0, -1); END
    FRAME;
  END
  // 5. lakes in the dips of the surface and on cave floors
  gen_msg = "Filling lakes"; cnt = 0;
  FOR i = 6 TO TW - 7
    s = gsurf[i];
    IF (cnt < 7 AND abs(i - TW / 2) > 14 AND s > gsurf[i - 1] AND s >= gsurf[i + 1])
      IF (tget(i, s) == 1 AND tget(i, s - 1) == 0)
        IF (pool(i, s - 1, 6, 1) > 0) cnt++; END
      END
    END
    IF (i % 25 == 0) FRAME; END
  END
  FOR n = 1 TO 40
    i = rand(5, TW - 6); j = rand(55, 110);
    IF (tget(i, j) == 0)
      WHILE (j < TH - 2 AND tget(i, j + 1) == 0) j++; END
      pool(i, j, rand(2, 4), 0);
    END
    IF (n % 4 == 0) FRAME; END
  END
  gen_pct = 60;
  // 6. trees on open grass (never on the spawn point)
  gen_msg = "Planting trees"; i = 4;
  WHILE (i < TW - 5)
    s = gsurf[i];
    IF (abs(i - TW / 2) > 3 AND tget(i, s) == 1 AND tget(i, s - 1) == 0 AND tget(i - 1, s - 1) == 0
        AND tget(i + 1, s - 1) == 0 AND rand(0, 99) < 35)
      h = rand(5, 10);
      FOR k = 1 TO h tset(i, s - k, 7); END
      FOR j = -3 TO 1
        r = 2;
        IF (j == -3 OR j == 1) r = 1; END
        FOR k = -r TO r
          IF (tget(i + k, s - h + j) == 0) tset(i + k, s - h + j, 8); END
        END
      END
      i += rand(5, 11); FRAME;
    ELSE
      i++;
    END
  END
  FOR i = 0 TO TW - 1
    j = 0;
    WHILE (j < TH AND t_solid[tget(i, j)] == 0) j++; END
    top[i] = j;
    IF (i % 20 == 19) FRAME; END
  END
  FRAME;
  // 7. paint the world (two rows a frame) and then the minimap
  gen_msg = "Painting";
  FOR j = 0 TO 70 sky_rgb(j); gfx_rect(g_map, 0, j * 8, TW * 8, 8, cr, cg, cb); END
  FOR i = 0 TO TW - 1
    q = i / 4; v = p16[i % 4];
    FOR j = 0 TO gsurf[i] - 1                      // above ground: trees and lakes
      IF ((wt[j * NW + q] / v) % 16 != 0) paint_tile(i, j); work += 6; END
    END
    // below: runs of equal plain tiles are one rectangle, then their spots
    s = gsurf[i]; n = -1;
    FOR j = gsurf[i] TO TH
      t = -2;
      IF (j < TH) t = (wt[j * NW + q] / v) % 16; END
      IF (t != n)
        IF (n >= 0)
          plain_rgb(n); gfx_rect(g_map, i * 8, s * 8, 8, (j - s) * 8, cr, cg, cb);
          k = s + (3 - (s + i) % 3) % 3;            // spots on every third tile
          WHILE (k < j) speckle(i, k, n, (i * 7 + k * 13) % 4); k += 3; END
        END
        n = -1; s = j;
        IF (t >= 0)
          IF (plain_rgb(t)) n = t; ELSE paint_tile(i, j); work += 6; END
        END
      END
    END
    work += TH - gsurf[i];
    IF (work > 900) work = 0; gen_pct = 62 + i * 30 / TW; FRAME; END
  END
  gen_msg = "Drawing the minimap";
  FOR j = 0 TO 59
    k = (j * 2 + 1) * NW;
    FOR i = 0 TO 199
      t = (wt[k + i / 2] / p16[(i * 2) % 4]) % 16;
      IF (t == 0)
        IF (j * 2 + 1 < gsurf[i * 2]) gfx_rect(g_mini, i, j, 1, 1, 120, 180, 240);
        ELSE gfx_rect(g_mini, i, j, 1, 1, 30, 23, 19); END
      ELSE
        gfx_rect(g_mini, i, j, 1, 1, t_r[t], t_g[t], t_b[t]);
      END
    END
    IF (j % 3 == 2) gen_pct = 92 + j / 8; FRAME; END
  END
  // 8. spawn point: the nearest dry column to the middle
  FOR k = 0 TO 60
    i = TW / 2 + k * (1 - 2 * (k % 2)) / 2;
    IF (tget(i, top[i] - 1) == 0 AND tget(i, top[i] - 2) == 0) BREAK; END
  END
  spawn_x = i * 8 + 4; spawn_y = top[i] * 8;
  pl_x = spawn_x; pl_y = spawn_y; pl_hp = 100; pl_inv = 60;
  FOR k = 0 TO 9 inv_it[k] = 0; inv_n[k] = 0; END
  inv_it[0] = 8; inv_n[0] = 6;                     // start with a few torches
  sel = 0; pick = 0; tod = 900; day = 1; player(); gen_pct = 100; st_worlds++; state = 1;
  say("Welcome! Mine with the left button, build with the right.");
END

// ---- Overlay: darkness, cursor, HUD and panels (runs after everything) ----

// Glow table centred on grid cell (c, r), levels lowered by `sub`.
FUNCTION light_at(c, r, sub);
PRIVATE dx, dy, n, v;
BEGIN
  FOR dy = mx(-5, -r) TO mn(5, 32 - r)
    n = (r + dy) * 43 + c;
    FOR dx = mx(-5, -c) TO mn(5, 42 - c)
      v = lf[(dy + 5) * 11 + dx + 5] - sub;
      IF (v > lt[n + dx]) lt[n + dx] = v; END
    END
  END
  RETURN 0;
END

// Lighting, spread over two frames: first the sky light of every cell
// (full above the ground, fading with depth below it), then the torch
// and player glows and the list of shade runs (world coordinates, so the
// overlay can draw them every frame wherever the camera is).
PROCESS lighter();
PRIVATE ph, c, r, i, d, n, k, st, lv, e;
BEGIN
  LOOP
    IF (state == 1 OR state == 2 OR state == 3)
      IF (ph == 0)
        lg_bx = camx / 16 - 1; lg_by = camy / 16 - 1;
        FOR c = 0 TO 42
          i = clamp((lg_bx + c) * 2, 0, TW - 1); n = c; d = lg_by * 2 - top[i];
          FOR r = 0 TO 32
            IF (d < 2) lt[n] = dl;
            ELSE
              e = dl - (d - 2) * 3 / 5;
              IF (e < 0) e = 0; END
              lt[n] = e;
            END
            n += 43; d += 2;
          END
        END
      ELSE
        FOR k = 0 TO n_tch - 1
          c = tch_i[k] / 2 - lg_bx; r = tch_j[k] / 2 - lg_by;
          IF (c > -6 AND c < 48 AND r > -6 AND r < 38) light_at(c, r, 0); END
        END
        IF (state != 3) light_at(int(pl_x / 16) - lg_bx, int((pl_y - 10) / 16) - lg_by, 2); END
        n_ru = 0;
        FOR r = 0 TO 32
          c = 0; n = r * 43;
          WHILE (c < 43)
            lv = lt[n + c];
            IF (lv >= 8) c++; CONTINUE; END
            st = c;
            WHILE (c < 43 AND lt[n + c] == lv) c++; END
            IF (n_ru < 500)
              ru_x[n_ru] = (lg_bx + st) * 16; ru_y[n_ru] = (lg_by + r) * 16;
              ru_w[n_ru] = (c - st) * 16; ru_l[n_ru] = lv; n_ru++;
            END
          END
        END
      END
      ph = 1 - ph;
    END
    FRAME;
  END
END

// A run of shade, kept off the minimap in the top right corner.
FUNCTION dark_run(x0, y0, w, lv);
PRIVATE xm;
BEGIN
  IF (y0 < 70 AND x0 + w > 430)
    IF (x0 < 430) draw_rect(x0, y0, 430 - x0, 16, dk[lv]); END
    IF (y0 + 16 > 70) xm = mx(x0, 430); draw_rect(xm, 70, x0 + w - xm, y0 + 16 - 70, dk[lv]); END
  ELSE
    draw_rect(x0, y0, w, 16, dk[lv]);
  END
  RETURN 0;
END

FUNCTION shade();
PRIVATE k, y0;
BEGIN
  FOR k = 0 TO n_ru - 1
    y0 = ru_y[k] - camy;
    IF (y0 > -16 AND y0 < 480) dark_run(ru_x[k] - camx, y0, ru_w[k], ru_l[k]); END
  END
  RETURN 0;
END

// Item icon from rectangles (16x16 box at sx, sy).
FUNCTION hud_icon(it, sx, sy);
BEGIN
  SWITCH (it_kind[it])
    CASE 0
      draw_rect(sx + 2, sy + 2, 12, 12, it_c1[it]);
      draw_rect(sx + 4, sy + 5, 2, 2, it_c2[it]); draw_rect(sx + 9, sy + 9, 3, 2, it_c2[it]);
    CASE 1
      draw_rect(sx + 2, sy + 2, 12, 12, "rgb(112,112,120)");
      draw_rect(sx + 4, sy + 4, 3, 3, it_c1[it]); draw_rect(sx + 9, sy + 6, 3, 3, it_c1[it]);
      draw_rect(sx + 5, sy + 10, 3, 2, it_c1[it]);
    CASE 2 draw_rect(sx + 1, sy + 5, 14, 7, it_c1[it]); draw_rect(sx + 12, sy + 5, 3, 7, it_c2[it]);
    CASE 3
      draw_rect(sx + 7, sy + 6, 2, 9, "rgb(120,80,45)");
      draw_rect(sx + 5, sy + 1, 6, 6, "#ff9a20"); draw_rect(sx + 6, sy + 2, 4, 3, "#ffe060");
    CASE 4 draw_rect(sx + 1, sy + 6, 14, 6, it_c2[it]); draw_rect(sx + 2, sy + 6, 12, 3, it_c1[it]);
    CASE 5
      draw_rect(sx + 1, sy + 2, 14, 13, it_c1[it]); draw_rect(sx + 3, sy + 2, 10, 2, it_c2[it]);
      draw_rect(sx + 5, sy + 8, 6, 5, "#ff8a20");
  END
  RETURN 0;
END

FUNCTION panel(x0, y0, w, h);
BEGIN
  draw_rect(x0, y0, w, h, "rgba(10,14,30,0.82)");
  draw_rect(x0, y0, w, 1, "#8090c0"); draw_rect(x0, y0 + h - 1, w, 1, "#8090c0");
  RETURN 0;
END

FUNCTION hud();
PRIVATE s, sx, k, c, ok, mm, sxp, syp;
BEGIN
  // cursor box and cracks on the tile being mined
  IF (state == 1 AND over_ui == 0)
    sx = cur_i * 8 - camx; k = cur_j * 8 - camy;
    IF (cur_ok) c = "rgba(255,255,255,0.8)"; ELSE c = "rgba(255,90,90,0.6)"; END
    draw_rect(sx - 1, k - 1, 10, 1, c); draw_rect(sx - 1, k + 8, 10, 1, c);
    draw_rect(sx - 1, k, 1, 8, c); draw_rect(sx + 8, k, 1, 8, c);
    IF (mine_p > 0)
      s = mine_p * 4 / mine_h; sx = mine_i * 8 - camx; k = mine_j * 8 - camy;
      draw_rect(sx + 1, k + 1, 3, 1, "#000"); draw_rect(sx + 3, k + 2, 1, 2, "#000");
      IF (s >= 1) draw_rect(sx + 4, k + 4, 3, 1, "#000"); draw_rect(sx + 6, k + 5, 1, 2, "#000"); END
      IF (s >= 2) draw_rect(sx + 1, k + 5, 1, 2, "#000"); draw_rect(sx + 2, k + 4, 2, 1, "#000"); END
      IF (s >= 3) draw_rect(sx + 5, k + 1, 2, 1, "#000"); draw_rect(sx + 3, k + 6, 2, 1, "#000"); END
    END
  END
  // enemy health bars
  FOR k = 0 TO 7
    IF (en_on[k] AND en_hp[k] < en_max[k])
      sx = en_x[k] - camx - 8; s = en_y[k] - camy - 14 - en_kind[k] * 10;
      draw_rect(sx, s, 16, 3, "#300");
      draw_rect(sx, s, mx(en_hp[k], 0) * 16 / en_max[k], 3, "#f44");
    END
  END
  // hotbar
  FOR s = 0 TO 9
    sx = 6 + s * 26;
    IF (s == sel) draw_rect(sx, 6, 24, 24, "#ffd860"); ELSE draw_rect(sx, 6, 24, 24, "rgba(20,24,44,0.8)"); END
    draw_rect(sx + 2, 8, 20, 20, "rgba(46,54,86,0.92)");
    IF (inv_n[s] > 0)
      hud_icon(inv_it[s], sx + 4, 9); set_color("#ffffff"); text(sx + 3, 20, "" + inv_n[s]);
    END
  END
  set_color("#ffffff");
  IF (inv_n[sel] > 0) text(8, 34, it_name[inv_it[sel]]); ELSE text(8, 34, "(empty slot)"); END
  // health, pickaxe, clock
  draw_rect(6, 46, 104, 8, "#301018"); draw_rect(8, 48, pl_hp, 4, "#ff4050");
  text(116, 46, "HP " + pl_hp); text(8, 58, pk_name[pick] + " pickaxe");
  text(274, 8, "Day " + day); text(274, 20, "" + hour + ":00");
  IF (tod >= DUSK) set_color("#d0d8ff"); circle(318, 24, 5); set_color("#0a1030"); circle(321, 22, 4);
  ELSE set_color("#ffd040"); circle(318, 24, 5); END
  IF (key(_t)) set_color("#ffe070"); text(274, 34, "time >>"); END
  // minimap frame, view box and player
  mm = 432; draw_rect(mm - 2, 4, 204, 1, "#8090c0"); draw_rect(mm - 2, 67, 204, 1, "#8090c0");
  draw_rect(mm - 2, 4, 1, 64, "#8090c0"); draw_rect(mm + 201, 4, 1, 64, "#8090c0");
  sxp = mm + camx / 16; syp = 6 + camy / 16;
  draw_rect(sxp, syp, 40, 1, "#fff"); draw_rect(sxp, syp + 29, 40, 1, "#fff");
  draw_rect(sxp, syp, 1, 30, "#fff"); draw_rect(sxp + 39, syp, 1, 30, "#fff");
  draw_rect(mm + pl_x / 16 - 1, 6 + pl_y / 16 - 2, 3, 3, "#ff3030");
  FOR k = 0 TO 7
    IF (en_on[k]) draw_rect(mm + en_x[k] / 16 - 1, 6 + en_y[k] / 16 - 1, 2, 2, "#ff60ff"); END
  END
  // crafting panel
  IF (craft_open)
    panel(6, 70, 336, 172);
    set_color("#ffe070"); text(14, 76, "CRAFTING  (click a recipe, C closes)");
    IF (near_furn) set_color("#80ff80"); text(14, 88, "furnace nearby: bars can be smelted");
    ELSE set_color("#a0a0b0"); text(14, 88, "no furnace nearby"); END
    FOR k = 0 TO 8
      ok = (inv_count(rc_a[k]) >= rc_an[k] AND (rc_bn[k] == 0 OR inv_count(rc_b[k]) >= rc_bn[k]));
      IF (rc_furn[k] AND near_furn == 0) ok = 0; END
      IF (rc_out[k] > 100 AND pick >= rc_out[k] - 100) ok = 0; END
      IF (mouse.y >= 102 + k * 15 AND mouse.y < 117 + k * 15 AND mouse.x < 342)
        draw_rect(8, 101 + k * 15, 332, 14, "rgba(120,140,220,0.35)");
      END
      IF (ok) set_color("#ffffff"); ELSE set_color("#707888"); END
      text(14, 105 + k * 15, rc_txt[k]);
    END
  END
  IF (msg_t > 0) set_color("#fff8d0"); text(170, 440, msg); END
  set_color("#b0b8d0");
  text(8, 468, "A/D walk  SPACE jump  LMB mine/hit  RMB place  1-0 Q E slot  C craft  T wait  ESC menu");
  RETURN 0;
END

PROCESS overlay();
BEGIN
  priority = -10;
  LOOP
    IF (state == 1 OR state == 2 OR state == 3) shade(); hud(); END
    SWITCH (state)
      CASE 0
        draw_rect(0, 0, 640, 480, "#101626");
        FOR x = 0 TO 39
          draw_rect(x * 16, 330 + sin(x * 21000) * 14, 16, 170, "#3a2a20");
          draw_rect(x * 16, 330 + sin(x * 21000) * 14, 16, 5, "#4c9a40");
        END
        panel(130, 90, 380, 220); set_color("#ffe070"); text(276, 108, "T E R R A D I V");
        set_color("#ffffff");
        text(150, 136, "A new procedural world every game: dig for copper,");
        text(150, 150, "iron and gold, build, craft better pickaxes and");
        text(150, 164, "survive the night - slimes and zombies come out."); set_color("#c0c8e0");
        text(150, 188, "A/D walk, SPACE jump (swim in water)");
        text(150, 202, "hold LEFT mouse: mine / hit   RIGHT: place block");
        text(150, 216, "1-0, Q/E: hotbar   C: crafting   T: fast time");
        set_color("#80ff80"); text(214, 272, "ENTER / SPACE: generate a new world");
      CASE 2
        panel(180, 170, 280, 90); set_color("#ffe070"); text(290, 186, "PAUSED");
        set_color("#ffffff"); text(200, 210, "ESC / ENTER: back to the game");
        text(200, 226, "N: generate a new world");
      CASE 3
        panel(200, 180, 240, 60); set_color("#ff7070"); text(262, 196, "You were slain");
        set_color("#ffffff"); text(250, 214, "respawning in " + (dead_t / 60 + 1) + "...");
      CASE 4
        draw_rect(0, 0, 640, 480, "#101626"); panel(170, 200, 300, 70);
        set_color("#ffffff"); text(190, 214, "Generating world: " + gen_msg);
        draw_rect(190, 236, 260, 10, "#303850"); draw_rect(190, 236, gen_pct * 2.6, 10, "#70c060");
        text(300, 252, "" + gen_pct + "%");
    END
    FRAME;
  END
END

PROCESS minimap();
BEGIN
  x = 532; y = 36; z = -100;
  LOOP
    IF (state == 1 OR state == 2 OR state == 3) graph = g_mini; ELSE graph = 0; END
    FRAME;
  END
END

// ---- MAIN: input, clock, water, spawning, menus ------------------------

FUNCTION new_game();
PRIVATE k;
BEGIN
  signal(TYPE player, s_kill); signal(TYPE tool, s_kill); signal(TYPE enemy, s_kill);
  signal(TYPE drop, s_kill); signal(TYPE popup, s_kill);
  FOR k = 0 TO 7 en_on[k] = 0; END
  n_en = 0; n_drop = 0; n_pop = 0; n_tch = 0; wq_h = 0; wq_t = 0;
  craft_open = 0; mine_p = 0; swing = 0; msg_t = 0; builder();
  RETURN 0;
END

FUNCTION play_tick();
PRIVATE k;
BEGIN
  // hotbar and menus
  IF (key_pressed(_1)) sel = 0; END IF (key_pressed(_2)) sel = 1; END
  IF (key_pressed(_3)) sel = 2; END IF (key_pressed(_4)) sel = 3; END
  IF (key_pressed(_5)) sel = 4; END IF (key_pressed(_6)) sel = 5; END
  IF (key_pressed(_7)) sel = 6; END IF (key_pressed(_8)) sel = 7; END
  IF (key_pressed(_9)) sel = 8; END
  IF (key_pressed(_0)) sel = 9; END
  IF (key_pressed(_q)) sel = (sel + 9) % 10; END
  IF (key_pressed(_e)) sel = (sel + 1) % 10; END
  IF (key_pressed(_c) AND state == 1) craft_open = 1 - craft_open; END
  IF (key_pressed(_esc) AND state == 1) state = 2; RETURN 0; END
  over_ui = (mouse.y < 32 AND mouse.x < 266) OR (mouse.y < 70 AND mouse.x > 428);
  IF (craft_open AND mouse.x < 342 AND mouse.y > 70 AND mouse.y < 242) over_ui = 1; END
  IF (m_click AND mouse.y < 32 AND mouse.x < 266) sel = mn((mouse.x - 6) / 26, 9); END
  IF (m_click AND craft_open AND mouse.x < 342 AND mouse.y >= 102 AND mouse.y < 237)
    craft((mouse.y - 102) / 15);
  END
  // clock: T fast-forwards
  k = tod; tod++;
  IF (key(_t)) tod += 39; END
  IF (tod >= DAYLEN) tod -= DAYLEN; day++; say("Day " + day); END
  hour = (tod * 24 / DAYLEN + 6) % 24;
  IF (tod < 720) dl = 2 + tod * 6 / 720;
  ELSE
    IF (tod < DUSK - 720) dl = 8;
    ELSE
      IF (tod < DUSK) dl = 8 - (tod - (DUSK - 720)) * 6 / 720; ELSE dl = 2; END
    END
  END
  IF (tod >= DUSK AND k < DUSK) say("Night falls... monsters are coming"); END
  dl = int(dl);
  IF (tod % 15 == 0) near_furn = furnace_near(); END
  water_step();
  // night: spawn enemies now and then
  IF (tod >= DUSK AND state == 1)
    spawn_t--;
    IF (spawn_t <= 0) spawn_t = rand(120, 240); try_spawn(); END
  END
  // slow healing when left alone for 5 seconds
  pl_calm++;
  IF (state == 1 AND pl_calm > 300 AND pl_calm % 40 == 0 AND pl_hp < 100) pl_hp++; END
  IF (state == 3)
    dead_t--;
    IF (dead_t <= 0)
      pl_x = spawn_x; pl_y = spawn_y; pl_vx = 0; pl_vy = 0; pl_kb = 0;
      pl_hp = 100; pl_inv = 120; state = 1; say("You wake up at the spawn point");
    END
  END
  RETURN 0;
END

FUNCTION furnace_near();
PRIVATE i, j, ci, cj;
BEGIN
  ci = floor(pl_x / 8); cj = floor((pl_y - 10) / 8);
  FOR j = cj - 4 TO cj + 4
    FOR i = ci - 6 TO ci + 6
      IF (tget(i, j) == 13) RETURN 1; END
    END
  END
  RETURN 0;
END

BEGIN
  set_mode(640, 480); set_fps(60, 0); screen_color("#101626"); init_tables(); make_graphics();
  start_scroll(0, 0, g_map, 0, 0, 0); lighter(); overlay(); minimap();
  LOOP
    m_l = mouse.left; m_r = mouse.right; m_click = (m_l AND prev_l == 0); prev_l = m_l;
    IF (msg_t > 0) msg_t--; END
    SWITCH (state)
      CASE 0 IF (key_pressed(_enter) OR key_pressed(_space)) new_game(); END
      CASE 1, 3 play_tick();
      CASE 2 IF (key_pressed(_esc) OR key_pressed(_enter)) state = 1; END IF (key_pressed(_n)) new_game(); END
    END
    FRAME;
  END
END
