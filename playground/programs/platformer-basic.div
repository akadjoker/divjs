program platformer;

global speed = 220;
global gravity = 700;
global jump_force = 330;

process player(x, y);
private
  vy = 0;
  on_ground = 0;
begin
  width = 30;
  height = 42;

  loop
    if (key(_left))
      x = x - speed ;
    end

    if (key(_right))
      x = x + speed ;
    end

    vy = vy + gravity * get_delta();

    if (key(_space) and on_ground)
      vy = -jump_force;
      on_ground = 0;
    end

    y = y + vy * get_delta();

    if (y > 540)
      y = 540;
      vy = 0;
      on_ground = 1;
    end

    set_color('#4a9eff');
    draw_rect(x, y, width, height, '#4a9eff');

    frame;
  end
end

begin
  set_mode(800, 600);  // DIV starts in 320x200; this demo is laid out for 800x600
  set_fps(60, 0);  // written for 60 fps (DIV's default is 18)
  player(100, 200);
  loop
    frame;
  end
end
