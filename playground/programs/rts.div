PROGRAM rts;

// RED ORE - a small real-time strategy game in the style of Red Alert.
// Every match is played on a new map: value noise gives the height
// (deep water, sand, grass, rock), a cellular automaton grows the woods
// out of random seeds, ore fields are scattered around, a dirt track is
// carved between the two bases and a flood fill turns every pocket that
// cannot be reached into forest. The map is painted once into a large
// graphic shown through a scroll window; units are processes with
// generated sprites (tanks have a separate rotating turret).
// Units find their way with a breadth-first search over the tile grid,
// done by one PATHFINDER process a few hundred cells per frame. A group
// sent to the same place shares one search.

GLOBAL
  MW = 80; MH = 60; NC = 4800;   // map size in 16-pixel tiles, cell count
  PL = 96;                       // longest stored path, in cells
  UCAP = 16;                     // units per side

  // ---- the map (one cell = row * MW + column)
  tile[4799];      // 0 grass, 1 sand, 2 water, 3 rock, 4 tree, 5 ore
  ore[4799];       // ore left on an ore tile
  pass[4799];      // 1 = ground units can drive here
  orec[799]; n_ore = 0;          // every ore tile of the map
  lat[119]; lat2[399]; latf[119]; hist[99]; sw8[8];
  nb[7]; nbx[7]; nby[7];         // the 8 neighbours of a cell

  // ---- entities: units and buildings share 64 slots
  e_used[63]; e_gen[63]; e_side[63]; e_kind[63]; e_x[63]; e_y[63];
  e_hp[63]; e_max[63]; e_rad[63]; e_sel[63]; e_aim[63];
  o_type[63];      // order: 0 idle, 1 move, 2 attack, 3 attack-move
  o_tgt[63]; o_tgen[63]; o_auto[63]; o_rp[63];
  o_fx[63]; o_fy[63];            // exact spot at the end of the path
  am_on[63]; am_x[63]; am_y[63]; // attack-move destination
  h_st[63];                      // harvester state
  p_state[63];     // path: 0 none, 1 asked, 2 ready, 3 failed, 4 searching
  p_goal[63]; p_start[63]; p_len[63]; p_idx[63];
  pth[6143];                     // 64 paths of up to PL cells

  // ---- tables by kind: 0 harvester, 1 tank, 2 rifleman, 3 HQ,
  //      4 refinery, 5 war factory
  k_hp[5]; k_rad[5]; u_spd[2]; u_rng[2]; u_sight[2]; u_dmg[2]; u_rel[2];
  cost[2]; u_time[2];

  // ---- the two sides: 0 player (blue), 1 enemy (red)
  cred[1]; bq_kind[1]; bq_t[1]; hq[1]; fac[1]; refy[1];
  fac_exit[1]; ref_dock[1]; nunits[1]; cnt[5];
  sc_r[1]; sc_g[1]; sc_b[1];
  base_x[1]; base_y[1];
  al_s[1]; al_g[1]; al_t[1];     // last attacker of each side (alarm)

  // ---- graphics
  g_map = 0; g_mini = 0; g_side = 0; g_title = 0; g_win = 0; g_lose = 0;
  g_unit[5]; g_tur[1]; g_bld[5]; g_shell = 0; g_bullet = 0;

  // ---- game state
  state = 4;       // 0 title, 1 playing, 2 won, 3 lost, 4 building map
  seed = 0; gen_pct = 0; game_t = 0.0;
  cam_x = 0; cam_y = 0;
  wave = 1; wave_t = 0.0; ai_t = 0.0;
  n_shells = 0; n_booms = 0; sel_n = 0;
  sep_x = 0.0; sep_y = 0.0;      // separation push (see separate())
  hud_cred = 0; hud_ecred = 0;
  lprev = 0; rprev = 0; drag = 0; ds_x = 0; ds_y = 0;
  mk_x = 0; mk_y = 0; mk_t = 0.0; mk_c = 0;
  w_lv = 0; s_lv = 0; r_lv = 0;

// =====================================================================
// Small helpers
// =====================================================================

FUNCTION cell_of(px, py);
BEGIN
  RETURN (int(py) / 16) * MW + int(px) / 16;
END

FUNCTION cell_px(c);
BEGIN
  RETURN (c % MW) * 16 + 8;
END

FUNCTION cell_py(c);
BEGIN
  RETURN (c / MW) * 16 + 8;
END

// The passable cell closest to c (searching square rings), -1 if none
FUNCTION near_free(c);
PRIVATE cx, cy, r, i, j, n;
BEGIN
  IF (c >= 0 AND c < NC)
    IF (pass[c]) RETURN c; END
  END
  cx = c % MW; cy = c / MW;
  FOR r = 1 TO 8
    FOR j = cy - r TO cy + r
      FOR i = cx - r TO cx + r
        IF (abs(i - cx) == r OR abs(j - cy) == r)
          IF (i > 0 AND j > 0 AND i < MW - 1 AND j < MH - 1)
            n = j * MW + i;
            IF (pass[n]) RETURN n; END
          END
        END
      END
    END
  END
  RETURN -1;
END

// Asks the pathfinder for a route from where unit s stands to cell g,
// finishing at the exact spot (fx, fy)
FUNCTION set_goal(s, g, fx, fy);
BEGIN
  p_start[s] = near_free(cell_of(e_x[s], e_y[s]));
  IF (g < 0 OR p_start[s] < 0) p_state[s] = 3; RETURN 0; END
  p_goal[s] = g;
  o_fx[s] = fx; o_fy[s] = fy;
  p_state[s] = 1;
  RETURN 0;
END

FUNCTION init_tables();
PRIVATE d;
BEGIN
  sw8[0] = 0;  sw8[1] = 3;  sw8[2] = 10; sw8[3] = 20; sw8[4] = 32;
  sw8[5] = 44; sw8[6] = 54; sw8[7] = 61; sw8[8] = 64;   // smoothstep * 64
  nbx[0] = 1; nby[0] = 0;  nbx[1] = -1; nby[1] = 0;
  nbx[2] = 0; nby[2] = 1;  nbx[3] = 0;  nby[3] = -1;
  nbx[4] = 1; nby[4] = 1;  nbx[5] = 1;  nby[5] = -1;
  nbx[6] = -1; nby[6] = 1; nbx[7] = -1; nby[7] = -1;
  FOR d = 0 TO 7 nb[d] = nbx[d] + nby[d] * MW; END
  k_hp[0] = 600;  k_hp[1] = 300;  k_hp[2] = 60;
  k_hp[3] = 1400; k_hp[4] = 900;  k_hp[5] = 1100;
  k_rad[0] = 9;   k_rad[1] = 8;   k_rad[2] = 5;
  k_rad[3] = 22;  k_rad[4] = 20;  k_rad[5] = 22;
  u_spd[0] = 30;  u_spd[1] = 42;  u_spd[2] = 24;
  u_rng[1] = 96;  u_rng[2] = 64;
  u_sight[1] = 150; u_sight[2] = 130;
  u_dmg[1] = 30;  u_dmg[2] = 8;
  u_rel[1] = 1.6; u_rel[2] = 0.8;
  cost[0] = 1100; cost[1] = 700; cost[2] = 150;
  u_time[0] = 9;  u_time[1] = 7; u_time[2] = 3;
  sc_r[0] = 60;  sc_g[0] = 130; sc_b[0] = 235;
  sc_r[1] = 205; sc_g[1] = 50;  sc_b[1] = 40;
  RETURN 0;
END

// =====================================================================
// Generated graphics. Every sprite faces right (angle 0); the draw
// functions take a target graphic and an offset so the sidebar can
// reuse them for its button icons.
// =====================================================================

FUNCTION draw_tank(g, ox, oy, sd);
PRIVATE i;
BEGIN
  gfx_rect(g, ox + 1, oy + 1, 20, 4, 36, 36, 36);          // tracks
  gfx_rect(g, ox + 1, oy + 11, 20, 4, 36, 36, 36);
  FOR i = 0 TO 6
    gfx_line(g, ox + 2 + i * 3, oy + 1, ox + 2 + i * 3, oy + 4, 80, 80, 80);
    gfx_line(g, ox + 2 + i * 3, oy + 11, ox + 2 + i * 3, oy + 14, 80, 80, 80);
  END
  gfx_rect(g, ox + 3, oy + 4, 16, 8, sc_r[sd] * 3 / 4, sc_g[sd] * 3 / 4, sc_b[sd] * 3 / 4);
  gfx_rect(g, ox + 4, oy + 5, 14, 2, sc_r[sd], sc_g[sd], sc_b[sd]);
  RETURN 0;
END

FUNCTION draw_turret(g, ox, oy, sd);
BEGIN
  gfx_rect(g, ox + 8, oy + 4, 12, 2, 50, 50, 50);          // barrel
  gfx_circle(g, ox + 7, oy + 5, 4, sc_r[sd] * 2 / 3, sc_g[sd] * 2 / 3, sc_b[sd] * 2 / 3);
  gfx_circle(g, ox + 6, oy + 4, 2, sc_r[sd], sc_g[sd], sc_b[sd]);
  RETURN 0;
END

FUNCTION draw_rifle(g, ox, oy, sd);
BEGIN
  gfx_line(g, ox + 7, oy + 7, ox + 13, oy + 7, 30, 30, 30);  // rifle
  gfx_circle(g, ox + 6, oy + 6, 4, sc_r[sd] * 3 / 4, sc_g[sd] * 3 / 4, sc_b[sd] * 3 / 4);
  gfx_circle(g, ox + 6, oy + 6, 2, sc_r[sd], sc_g[sd], sc_b[sd]);  // helmet
  RETURN 0;
END

FUNCTION draw_harv(g, ox, oy, sd);
BEGIN
  gfx_rect(g, ox + 2, oy, 8, 3, 30, 30, 30);                // wheels
  gfx_rect(g, ox + 14, oy, 7, 3, 30, 30, 30);
  gfx_rect(g, ox + 2, oy + 15, 8, 3, 30, 30, 30);
  gfx_rect(g, ox + 14, oy + 15, 7, 3, 30, 30, 30);
  gfx_rect(g, ox + 1, oy + 2, 22, 14, 150, 140, 115);       // chassis
  gfx_rect(g, ox + 3, oy + 4, 12, 10, 95, 85, 65);          // ore bin
  gfx_line(g, ox + 4, oy + 7, ox + 14, oy + 7, 200, 170, 60);
  gfx_line(g, ox + 4, oy + 10, ox + 14, oy + 10, 200, 170, 60);
  gfx_rect(g, ox + 17, oy + 4, 5, 10, sc_r[sd], sc_g[sd], sc_b[sd]);  // cab
  gfx_rect(g, ox + 20, oy + 6, 2, 6, 180, 220, 255);        // windscreen
  RETURN 0;
END

// Buildings: concrete pad, then the structure in the side's colours
FUNCTION draw_building(g, kind, sd);
PRIVATE r, gg, b, i, h;
BEGIN
  r = sc_r[sd]; gg = sc_g[sd]; b = sc_b[sd];
  h = 48;
  IF (kind == 4) h = 32; END
  gfx_rect(g, 0, 0, 48, h, 70, 70, 68);
  gfx_rect(g, 1, 1, 46, h - 2, 118, 118, 112);
  IF (kind == 3)                                     // HQ / construction yard
    gfx_rect(g, 6, 8, 36, 28, 150, 150, 142);
    gfx_rect(g, 6, 8, 36, 6, r, gg, b);
    gfx_rect(g, 10, 18, 10, 10, 60, 70, 80);
    gfx_circle(g, 32, 24, 7, 90, 95, 100);
    gfx_circle(g, 32, 24, 4, r, gg, b);
    gfx_line(g, 4, 44, 42, 4, 230, 190, 40);          // crane jib
    gfx_line(g, 5, 44, 43, 4, 230, 190, 40);
    gfx_rect(g, 2, 40, 8, 6, 80, 80, 80);
  END
  IF (kind == 4)                                     // refinery
    gfx_circle(g, 12, 12, 9, 150, 150, 145);
    gfx_circle(g, 31, 12, 9, 150, 150, 145);
    gfx_circle(g, 12, 12, 4, r, gg, b);
    gfx_circle(g, 31, 12, 4, r, gg, b);
    gfx_rect(g, 40, 3, 6, 18, r * 3 / 4, gg * 3 / 4, b * 3 / 4);
    gfx_rect(g, 14, 23, 20, 8, 50, 50, 50);          // dock
    FOR i = 0 TO 4
      gfx_rect(g, 15 + i * 4, 29, 2, 2, 240, 200, 30);
    END
  END
  IF (kind == 5)                                     // war factory
    gfx_rect(g, 4, 4, 40, 30, r * 3 / 4, gg * 3 / 4, b * 3 / 4);
    FOR i = 0 TO 4
      gfx_line(g, 6, 7 + i * 6, 41, 7 + i * 6, r, gg, b);
    END
    gfx_rect(g, 12, 30, 24, 17, 40, 40, 40);         // door
    FOR i = 0 TO 5
      gfx_rect(g, 12 + i * 4, 44, 2, 3, 240, 200, 30);
    END
  END
  RETURN 0;
END

FUNCTION big_text(w, h, s, r, g, b, sz);
PRIVATE gr;
BEGIN
  gr = new_graphic(w, h);
  gfx_fill_rgba(gr, 0, 0, 0, 0);
  gfx_text(gr, 3, 3, s, 0, 0, 0, sz);                // shadow
  gfx_text(gr, 0, 0, s, r, g, b, sz);
  RETURN gr;
END

FUNCTION make_graphics();
PRIVATE sd, g, i;
BEGIN
  FOR sd = 0 TO 1
    g = new_graphic(24, 18); gfx_fill_rgba(g, 0, 0, 0, 0);
    draw_harv(g, 0, 0, sd); g_unit[sd] = g;
    g = new_graphic(22, 16); gfx_fill_rgba(g, 0, 0, 0, 0);
    draw_tank(g, 0, 0, sd); g_unit[2 + sd] = g;
    g = new_graphic(14, 12); gfx_fill_rgba(g, 0, 0, 0, 0);
    draw_rifle(g, 0, 0, sd); g_unit[4 + sd] = g;
    g = new_graphic(20, 10); gfx_fill_rgba(g, 0, 0, 0, 0);
    draw_turret(g, 0, 0, sd); g_tur[sd] = g;
    set_point(0, g, 0, 7, 5);                        // turns round its ring
    FOR i = 3 TO 5
      IF (i == 4) g = new_graphic(48, 32); ELSE g = new_graphic(48, 48); END
      draw_building(g, i, sd);
      g_bld[(i - 3) * 2 + sd] = g;
    END
  END
  g_shell = new_graphic(6, 3);
  gfx_fill_rgba(g_shell, 0, 0, 0, 0);
  gfx_rect(g_shell, 0, 0, 6, 3, 255, 200, 80);
  gfx_rect(g_shell, 3, 1, 3, 1, 255, 255, 220);
  g_bullet = new_graphic(4, 2);
  gfx_fill(g_bullet, 255, 240, 150);

  g_map = new_graphic(MW * 16, MH * 16);
  g_mini = new_graphic(160, 120);

  // Sidebar: panel with three build buttons and their unit icons
  g_side = new_graphic(160, 360);
  gfx_fill(g_side, 38, 40, 46);
  gfx_rect(g_side, 0, 0, 2, 360, 90, 92, 100);
  gfx_rect(g_side, 0, 0, 160, 2, 90, 92, 100);
  FOR i = 0 TO 2
    gfx_rect(g_side, 6, 40 + i * 44, 148, 38, 70, 72, 82);
    gfx_rect(g_side, 7, 41 + i * 44, 146, 36, 52, 54, 62);
    gfx_rect(g_side, 10, 44 + i * 44, 30, 30, 30, 70, 40);
  END
  draw_tank(g_side, 14, 51, 0);
  draw_rifle(g_side, 18, 53 + 44, 0);
  draw_harv(g_side, 13, 50 + 88, 0);

  g_title = big_text(260, 50, "RED ORE", 230, 50, 40, 44);
  g_win = big_text(260, 50, "VICTORY", 90, 230, 110, 44);
  g_lose = big_text(260, 50, "DEFEAT", 235, 60, 50, 44);
  RETURN 0;
END

// Paints one tile into the map graphic and the minimap
FUNCTION paint_tile(c, h);
PRIVATE px, py, t, v, i, sh;
BEGIN
  px = (c % MW) * 16; py = (c / MW) * 16;
  t = tile[c];
  v = rand(-5, 5) + (h - 50) / 6;               // a little relief
  IF (t == 0 OR t == 4)                              // grass (under trees too)
    gfx_rect(g_map, px, py, 16, 16, 60 + v, 112 + v, 44 + v / 2);
    FOR i = 0 TO 2
      gfx_pixel(g_map, px + rand(0, 15), py + rand(0, 15), 44, 90, 34);
    END
    gfx_rect(g_mini, (c % MW) * 2, (c / MW) * 2, 2, 2, 62, 112, 46);
  END
  IF (t == 1)                                        // sand / dirt
    gfx_rect(g_map, px, py, 16, 16, 180 + v, 156 + v, 102 + v);
    FOR i = 0 TO 3
      gfx_pixel(g_map, px + rand(0, 15), py + rand(0, 15), 150, 128, 84);
    END
    gfx_rect(g_mini, (c % MW) * 2, (c / MW) * 2, 2, 2, 186, 160, 108);
  END
  IF (t == 2)                                        // water: deeper = darker
    sh = (h - w_lv) * 4;
    gfx_rect(g_map, px, py, 16, 16, 26, 70 + sh / 2, 150 + sh);
    IF (rand(0, 2) == 0)
      i = rand(2, 12);
      gfx_line(g_map, px + rand(1, 6), py + i, px + rand(9, 14), py + i, 70, 120, 200);
    END
    gfx_rect(g_mini, (c % MW) * 2, (c / MW) * 2, 2, 2, 30, 70, 150);
  END
  IF (t == 3)                                        // rock
    gfx_rect(g_map, px, py, 16, 16, 100 + v, 94 + v, 88 + v);
    gfx_rect(g_map, px + rand(0, 3), py + rand(0, 3), 9, 6, 136, 128, 120);
    gfx_rect(g_map, px + rand(5, 8), py + rand(8, 10), 8, 5, 72, 66, 62);
    gfx_rect(g_mini, (c % MW) * 2, (c / MW) * 2, 2, 2, 118, 108, 102);
  END
  IF (t == 4)                                        // tree
    gfx_circle(g_map, px + 8, py + 9, 7, 26, 70 + v, 28);
    gfx_circle(g_map, px + 6, py + 7, 4, 46, 104 + v, 40);
    gfx_rect(g_mini, (c % MW) * 2, (c / MW) * 2, 2, 2, 28, 72, 30);
  END
  IF (t == 5)                                        // ore: gems on brown soil
    gfx_rect(g_map, px, py, 16, 16, 112 + v, 100 + v, 56);
    FOR i = 0 TO 4
      gfx_circle(g_map, px + rand(3, 12), py + rand(3, 12), rand(1, 2), 240, 200 - i * 12, 40);
    END
    gfx_rect(g_mini, (c % MW) * 2, (c / MW) * 2, 2, 2, 225, 190, 40);
  END
  RETURN 0;
END

// Bilinear value noise: lattice la (spacing sp, lw points per row)
FUNCTION noise(la, i, j, sp, lw);
PRIVATE a, b, k;
BEGIN
  a = sw8[(i % sp) * 8 / sp];
  b = sw8[(j % sp) * 8 / sp];
  k = (j / sp) * lw + i / sp;
  IF (la == 0)
    RETURN ((lat[k] * (64 - a) + lat[k + 1] * a) * (64 - b)
          + (lat[k + lw] * (64 - a) + lat[k + lw + 1] * a) * b) / 4096;
  END
  RETURN ((lat2[k] * (64 - a) + lat2[k + 1] * a) * (64 - b)
        + (lat2[k + lw] * (64 - a) + lat2[k + lw + 1] * a) * b) / 4096;
END

// Sets a rectangle of cells to grass (base sites)
FUNCTION clear_rect(x0, y0, w, h);
PRIVATE i, j;
BEGIN
  FOR j = y0 TO y0 + h - 1
    FOR i = x0 TO x0 + w - 1
      tile[j * MW + i] = 0;
    END
  END
  RETURN 0;
END

// A roughly round ore field around (cx, cy)
FUNCTION ore_field(cx, cy, r);
PRIVATE i, j, c;
BEGIN
  FOR j = cy - r TO cy + r
    FOR i = cx - r TO cx + r
      IF (i > 1 AND j > 1 AND i < MW - 2 AND j < MH - 2)
        c = j * MW + i;
        IF ((i - cx) * (i - cx) + (j - cy) * (j - cy) <= r * r + 1 AND tile[c] < 2 AND rand(0, 99) < 75)
          IF (abs(i - base_x[0] - 3) + abs(j - base_y[0] - 3) > 7 AND abs(i - base_x[1] - 3) + abs(j - base_y[1] - 3) > 7)
            tile[c] = 5;
            ore[c] = rand(4, 8);
          END
        END
      END
    END
  END
  RETURN 0;
END

// =====================================================================
// Map builder: runs over many frames so no frame does too much work
// =====================================================================
// (its scratch arrays are PRIVATE: the engine clears arrays cell by
// cell when they are created, and this way that happens in the
// builder's own time slice instead of MAIN's first frame)
PROCESS builder(next_state);
PRIVATE i, j, c, n, k, h, acc, cx, cy, tx, ty, sd, head, tail, d;
        hg[4799];        // noise height
        ta[4799];        // tree seeds, then the flood fill's marks
        tb[4799];        // automaton buffer, then the flood fill's queue
BEGIN
  state = 4; gen_pct = 0;
  FRAME;
  rand_seed(seed);
  FOR i = 0 TO 119 lat[i] = rand(0, 99); latf[i] = rand(0, 99); END
  FOR i = 0 TO 399 lat2[i] = rand(0, 99); END
  FOR i = 0 TO 99 hist[i] = 0; END

  // base sites: one corner each, randomly mirrored
  base_x[0] = rand(4, 10);  base_y[0] = rand(3, 8);
  base_x[1] = rand(62, 70); base_y[1] = rand(42, 49);
  IF (rand(0, 1)) FOR sd = 0 TO 1 base_x[sd] = MW - 7 - base_x[sd]; END END
  IF (rand(0, 1)) FOR sd = 0 TO 1 base_y[sd] = MH - 8 - base_y[sd]; END END

  // 1. height = two octaves of value noise
  FOR j = 0 TO MH - 1
    FOR i = 0 TO MW - 1
      h = (noise(0, i, j, 8, 11) * 2 + noise(1, i, j, 4, 21)) / 3;
      hg[j * MW + i] = h;
      hist[h]++;
    END
    IF (j % 2 == 1) gen_pct = j * 20 / MH; FRAME; END
  END

  // 2. thresholds from the histogram: 16% water, 7% sand, 9% rock
  acc = 0; w_lv = 0;
  WHILE (acc < NC * 16 / 100) acc += hist[w_lv]; w_lv++; END
  s_lv = w_lv;
  WHILE (acc < NC * 23 / 100) acc += hist[s_lv]; s_lv++; END
  acc = 0; r_lv = 99;
  WHILE (acc < NC * 9 / 100) acc += hist[r_lv]; r_lv--; END

  // 3. terrain classes; random tree seeds where the forest noise is high
  FOR c = 0 TO NC - 1
    h = hg[c];
    tile[c] = 0;
    IF (h < s_lv) tile[c] = 1; END
    IF (h < w_lv) tile[c] = 2; END
    IF (h > r_lv) tile[c] = 3; END
    ta[c] = 0;
    k = latf[((c / MW) / 8) * 11 + (c % MW) / 8];
    IF (tile[c] == 0 AND rand(0, 99) < k - 30) ta[c] = 1; END
    IF (c % 400 == 399) FRAME; END
  END
  gen_pct = 30;

  // 4. cellular automaton, two passes: a cell is wooded when 5 of its 8
  // neighbours are (4 if it already is) - noise becomes clumps of forest
  FOR k = 0 TO 1
    FOR j = 1 TO MH - 2
      FOR i = 1 TO MW - 2
        c = j * MW + i;
        n = 0;
        FOR d = 0 TO 7 n += ta[c + nb[d]]; END
        tb[c] = (n >= 5 OR (n >= 4 AND ta[c] == 1));
      END
      IF (j % 2 == 0) FRAME; END
    END
    FOR c = 0 TO NC - 1
      ta[c] = tb[c];
      IF (c % 1600 == 1599) FRAME; END
    END
  END
  FOR c = 0 TO NC - 1
    IF (ta[c] AND tile[c] == 0) tile[c] = 4; END
    IF (c % 1600 == 1599) FRAME; END
  END
  gen_pct = 50;

  // 5. flat grass for both bases, a track between them (fords over the
  // water, cuts through rock and wood) and a rock border
  FOR sd = 0 TO 1 clear_rect(base_x[sd] - 2, base_y[sd] - 2, 11, 12); END
  cx = base_x[0] + 1; cy = base_y[0] + 1;
  tx = base_x[1] + 1; ty = base_y[1] + 1;
  WHILE (cx != tx OR cy != ty)
    IF (rand(0, abs(tx - cx) + abs(ty - cy) - 1) < abs(tx - cx))
      cx += sign(tx - cx);
    ELSE
      cy += sign(ty - cy);
    END
    FOR d = 0 TO 3
      c = (cy + d / 2) * MW + cx + d % 2;
      IF (tile[c] >= 2 AND tile[c] <= 4) tile[c] = 1; END
    END
  END
  FRAME;
  FOR i = 0 TO MW - 1 tile[i] = 3; tile[NC - 1 - i] = 3; END
  FOR j = 0 TO MH - 1 tile[j * MW] = 3; tile[j * MW + MW - 1] = 3; END

  // 6. ore: one field in front of each base, four more around the map
  FOR sd = 0 TO 1
    ore_field(base_x[sd] + 3 + sign(MW / 2 - base_x[sd]) * 10, base_y[sd] + 3 + sign(MH / 2 - base_y[sd]) * 7, 3);
  END
  FOR k = 0 TO 3
    ore_field(rand(14, MW - 15), rand(10, MH - 11), rand(2, 3));
    FRAME;
  END
  FOR c = 0 TO NC - 1
    pass[c] = (tile[c] < 2 OR tile[c] == 5);
    ta[c] = 0;
    IF (c % 1200 == 1199) FRAME; END
  END

  // 7. flood fill from the player's base: whatever it cannot reach
  // becomes forest, so no unit or ore is ever stranded
  c = (base_y[0] + 7) * MW + base_x[0] + 1;
  ta[c] = 1; tb[0] = c; head = 0; tail = 1;
  WHILE (head < tail)
    c = tb[head]; head++;
    FOR d = 0 TO 3
      n = c + nb[d];
      IF (pass[n] AND ta[n] == 0) ta[n] = 1; tb[tail] = n; tail++; END
    END
    IF (head % 400 == 0) FRAME; END
  END
  n_ore = 0;
  FOR c = 0 TO NC - 1
    IF (pass[c] AND ta[c] == 0) tile[c] = 4; pass[c] = 0; END
    IF (tile[c] == 5 AND n_ore < 800) orec[n_ore] = c; n_ore++; END
    IF (c % 600 == 599) FRAME; END
  END
  gen_pct = 65;

  // 8. paint the map and the minimap, a few rows per frame
  FOR c = 0 TO NC - 1
    paint_tile(c, hg[c]);
    IF (c % 160 == 159) gen_pct = 65 + c * 35 / NC; FRAME; END
  END

  // 9. bases and starting forces
  FOR sd = 0 TO 1
    building(sd, 3, base_x[sd], base_y[sd]);
    building(sd, 4, base_x[sd] + 4, base_y[sd]);
    building(sd, 5, base_x[sd], base_y[sd] + 4);
    ref_dock[sd] = (base_y[sd] + 2) * MW + base_x[sd] + 5;
    fac_exit[sd] = (base_y[sd] + 7) * MW + base_x[sd] + 1;
    cred[sd] = 1500; bq_kind[sd] = -1;
    c = ref_dock[sd];
    unit(sd, 0, cell_px(c), cell_py(c));
    FOR k = 0 TO 3
      c = near_free(fac_exit[sd] + k * 2 - 2 + MW);
      unit(sd, 1 + k / 2, cell_px(c), cell_py(c));
    END
  END
  cam_x = clamp(base_x[0] * 16 + 56 - 240, 0, MW * 16 - 480);
  cam_y = clamp(base_y[0] * 16 + 64 - 240, 0, MH * 16 - 480);
  gen_pct = 100;
  state = next_state;
END

// =====================================================================
// Entity slots
// =====================================================================
FUNCTION alloc_slot(sd, kind);
PRIVATE i;
BEGIN
  FOR i = 0 TO 63
    IF (e_used[i] == 0)
      e_used[i] = 1; e_gen[i]++;
      e_side[i] = sd; e_kind[i] = kind;
      e_hp[i] = k_hp[kind]; e_max[i] = k_hp[kind]; e_rad[i] = k_rad[kind];
      e_sel[i] = 0; e_aim[i] = 0; o_type[i] = 0; o_auto[i] = 0; o_rp[i] = 0;
      am_on[i] = 0; h_st[i] = 0; p_state[i] = 0;
      IF (kind < 3) nunits[sd]++; cnt[sd * 3 + kind]++; END
      RETURN i;
    END
  END
  RETURN -1;
END

FUNCTION free_slot(s);
BEGIN
  e_used[s] = 0; e_sel[s] = 0;
  IF (e_kind[s] < 3) nunits[e_side[s]]--; cnt[e_side[s] * 3 + e_kind[s]]--; END
  RETURN 0;
END

// Selection corners and health bar, drawn in map coordinates (the
// caller is a C_SCROLL process, so the scroll window places them)
FUNCTION overlay(s, px, py);
PRIVATE r, w;
BEGIN
  r = e_rad[s] + 3;
  IF (e_sel[s])
    set_color('#ffffff');
    draw_rect(px - r, py - r, 4, 1); draw_rect(px - r, py - r, 1, 4);
    draw_rect(px + r - 3, py - r, 4, 1); draw_rect(px + r, py - r, 1, 4);
    draw_rect(px - r, py + r, 4, 1); draw_rect(px - r, py + r - 3, 1, 4);
    draw_rect(px + r - 3, py + r, 4, 1); draw_rect(px + r, py + r - 3, 1, 4);
  END
  IF (e_sel[s] OR e_hp[s] < e_max[s])
    w = r * 2;
    draw_rect(px - r, py - r - 5, w, 3, '#000000');
    IF (e_hp[s] * 3 > e_max[s] * 2)
      set_color('#40e040');
    ELSE
      IF (e_hp[s] * 3 > e_max[s]) set_color('#f0d020'); ELSE set_color('#f03020'); END
    END
    draw_rect(px - r, py - r - 5, w * e_hp[s] / e_max[s], 3);
  END
  RETURN 0;
END

// Nearest living enemy of slot s within distance r (edge to edge)
FUNCTION find_enemy(s, r);
PRIVATE i, best, bd, d;
BEGIN
  best = -1; bd = r;
  FOR i = 0 TO 63
    IF (e_used[i] AND e_side[i] != e_side[s] AND e_hp[i] > 0)
      d = abs(e_x[i] - e_x[s]) + abs(e_y[i] - e_y[s]);
      IF (d < bd * 3 / 2 + e_rad[i])
        d = fget_distance(e_x[s], e_y[s], e_x[i], e_y[i]) - e_rad[i];
        IF (d < bd) bd = d; best = i; END
      END
    END
  END
  RETURN best;
END

// Separation: the push away from every ground unit (either side) that
// overlaps slot s, summed, so a group spreads out instead of piling onto
// one spot. Left in sep_x / sep_y. (d + 0.001 keeps the division a real
// one: two whole numbers divide as integers in this engine.)
FUNCTION separate(s);
PRIVATE i, dx, dy, d, m, f;
BEGIN
  sep_x = 0; sep_y = 0;
  FOR i = 0 TO 63
    IF (e_used[i] AND i != s AND e_kind[i] < 3)
      dx = e_x[s] - e_x[i]; dy = e_y[s] - e_y[i];
      m = e_rad[i] + e_rad[s] + 2;
      IF (abs(dx) < m AND abs(dy) < m)
        d = sqrt(dx * dx + dy * dy);
        IF (d < m)
          IF (d < 0.5)                               // same spot: any way out
            dx = rand(-10, 10) * 0.1; dy = rand(-10, 10) * 0.1; d = 1;
          END
          f = (m - d) / (d + 0.001);
          sep_x = sep_x + dx * f;
          sep_y = sep_y + dy * f;
        END
      END
    END
  END
  RETURN 0;
END

// Nearest ore tile to (px, py), -1 when the map is mined out
FUNCTION find_ore(px, py);
PRIVATE i, c, best, bd, d;
BEGIN
  best = -1; bd = 99999;
  px = int(px) / 16; py = int(py) / 16;
  FOR i = 0 TO n_ore - 1
    c = orec[i];
    IF (ore[c] > 0)
      d = abs(c % MW - px) + abs(c / MW - py);
      IF (d < bd) bd = d; best = c; END
    END
  END
  RETURN best;
END

// =====================================================================
// PATHFINDER: breadth-first search from the goal cell outwards, 120
// cells per frame. Every unit waiting for the same goal is served by
// the same search: once the flood reaches a unit's start cell, its path
// is read back by following the parent links towards the goal.
// =====================================================================
PROCESS pathfinder();
PRIVATE i, g, c, n, d, k, head, tail, work, left, final, stamp;
        pmark[4799];     // search stamp of every cell
        ppar[4799];      // the neighbour a cell was reached from
        pq[4799];        // BFS queue
BEGIN
  LOOP
    g = -1;
    FOR i = 0 TO 63
      IF (e_used[i] AND p_state[i] == 1) g = p_goal[i]; BREAK; END
    END
    IF (g >= 0)
      FOR i = 0 TO 63                        // claim all requests for g
        IF (e_used[i] AND p_state[i] == 1 AND p_goal[i] == g) p_state[i] = 4; END
      END
      stamp++;
      pmark[g] = stamp; ppar[g] = g;
      pq[0] = g; head = 0; tail = 1; final = 0;
      LOOP
        work = 0;
        WHILE (work < 120 AND head < tail)
          c = pq[head]; head++; work++;
          FOR d = 0 TO 7
            n = c + nb[d];
            IF (pmark[n] != stamp AND pass[n])
              // diagonal steps may not cut the corner of an obstacle
              IF (d < 4 OR (pass[c + nbx[d]] AND pass[c + nby[d] * MW]))
                pmark[n] = stamp; ppar[n] = c;
                pq[tail] = n; tail++;
              END
            END
          END
        END
        IF (head >= tail) final = 1; END
        // hand out the paths of every unit the flood has reached
        left = 0;
        FOR i = 0 TO 63
          IF (e_used[i] AND p_state[i] == 4 AND p_goal[i] == g)
            c = p_start[i];
            IF (pmark[c] == stamp)
              k = 0;
              WHILE (c != g AND k < PL)
                c = ppar[c];
                pth[i * PL + k] = c;
                k++;
              END
              p_len[i] = k; p_idx[i] = 0; p_state[i] = 2;
            ELSE
              IF (final) p_state[i] = 3; ELSE left++; END
            END
          END
        END
        IF (left == 0 OR final) BREAK; END
        FRAME;
      END
    END
    FRAME;
  END
END

// =====================================================================
// Units
// =====================================================================

// Explosion: a few expanding, fading rings of fire
PROCESS boom(px, py, big);
PRIVATE t, life;
BEGIN
  IF (n_booms >= 30) RETURN; END
  n_booms++;
  x = px; y = py; ctype = c_scroll; z = -6;
  life = 18 + big * 14;
  FOR t = 0 TO life
    set_color('#ffd040');
    IF (t > life / 3) set_color('#ff7020'); END
    IF (t > life * 2 / 3) set_color('#606060'); END
    circle(x, y, 2 + (big * 5 + 4) * t / life);
    IF (t < life / 2)
      set_color('#fff8c0');
      circle(x + rand(-2, 2), y + rand(-2, 2), 1 + big * 2);
    END
    FRAME;
  END
  n_booms--;
END

// Tank shell (kind 1) or rifle bullet (kind 2) fired by slot src: flies
// to the aimed point and hurts the target if it is still there. A hit
// raises the alarm on the target's side, and an idle target fires back.
PROCESS shell(px, py, tx, ty, t, tg, dmg, kind, src);
PRIVATE spd, d, stp;
BEGIN
  n_shells++;
  x = px; y = py; ctype = c_scroll; z = -5;
  graph = g_shell; spd = 300;
  IF (kind == 2) graph = g_bullet; spd = 480; END
  angle = fget_angle(px, py, tx, ty);
  LOOP
    stp = spd * get_delta();
    d = fget_distance(x, y, tx, ty);
    IF (d <= stp) BREAK; END
    x = x + get_distx(angle, stp);
    y = y + get_disty(angle, stp);
    FRAME;
  END
  IF (e_used[t] AND e_gen[t] == tg)
    IF (fget_distance(e_x[t], e_y[t], tx, ty) < e_rad[t] + 8)
      e_hp[t] -= dmg;
      IF (e_used[src])
        al_s[e_side[t]] = src; al_g[e_side[t]] = e_gen[src]; al_t[e_side[t]] = game_t;
        IF (o_type[t] == 0 AND e_kind[t] >= 1 AND e_kind[t] <= 2)
          o_type[t] = 2; o_tgt[t] = src; o_tgen[t] = e_gen[src]; o_auto[t] = 1; o_rp[t] = 0;
        END
      END
    END
  END
  IF (kind == 1) boom(tx, ty, 0); END
  n_shells--;
END

PROCESS turret(s, sd);
PRIVATE gen;
BEGIN
  gen = e_gen[s]; ctype = c_scroll; z = -1; graph = g_tur[sd];
  x = e_x[s]; y = e_y[s];
  WHILE (e_used[s] AND e_gen[s] == gen)
    x = e_x[s]; y = e_y[s]; angle = e_aim[s];
    FRAME;
  END
END

PROCESS unit(sd, kind, px, py);
PRIVATE s, dt, rl, think, c, wx, wy, d, a, dd, stp, arr, t, ft, opp,
        cargo, ht, hc, dmg, fr, mx;
BEGIN
  s = alloc_slot(sd, kind);
  IF (s < 0) RETURN; END
  x = px; y = py; ctype = c_scroll; z = 0;
  e_x[s] = x; e_y[s] = y;
  graph = g_unit[kind * 2 + sd];
  angle = rand(0, 3) * 90000;
  e_aim[s] = angle;
  IF (kind == 1) turret(s, sd); END
  think = rand(0, 40) * 0.01;
  opp = -1;
  LOOP
    IF (e_hp[s] <= 0) BREAK; END
    IF (state == 1)
      dt = get_delta();
      rl = rl - dt; think = think - dt;
      arr = 0; ft = -1;

      // ---- follow the path: cell centres, then the exact final spot
      IF (p_state[s] == 2)
        IF (p_idx[s] >= p_len[s] AND p_len[s] >= PL)
          IF (pth[s * PL + PL - 1] != p_goal[s])   // path was cut short
            set_goal(s, p_goal[s], o_fx[s], o_fy[s]);
          END
        END
      END
      IF (p_state[s] == 2)
        IF (p_idx[s] < p_len[s])
          c = pth[s * PL + p_idx[s]];
          wx = cell_px(c); wy = cell_py(c);
        ELSE
          wx = o_fx[s]; wy = o_fy[s];
        END
        stp = u_spd[kind] * dt;
        d = fget_distance(x, y, wx, wy);
        IF (d <= stp)
          x = wx; y = wy;
          IF (p_idx[s] < p_len[s]) p_idx[s]++; ELSE p_state[s] = 0; arr = 1; END
        ELSE
          a = fget_angle(x, y, wx, wy);
          x = x + get_distx(a, stp);
          y = y + get_disty(a, stp);
          angle = lerp_angle(angle, a, 0.25);
        END
      END

      // ---- separation: shuffle apart from overlapping units without
      // turning, every other frame. A unit on the move only gives way a
      // little, so it keeps flowing along its path.
      fr = 1 - fr;
      IF (fr)
        separate(s);
        IF (sep_x != 0 OR sep_y != 0)
          d = sqrt(sep_x * sep_x + sep_y * sep_y);
          mx = 1.4;
          IF (p_state[s] == 2) mx = 0.7; END
          IF (d > mx)
            sep_x = sep_x * mx / (d + 0.001); sep_y = sep_y * mx / (d + 0.001);
          END
          wx = clamp(x + sep_x, 1, MW * 16 - 1);    // never off the map
          wy = clamp(y + sep_y, 1, MH * 16 - 1);
          IF (pass[cell_of(wx, wy)]) x = wx; y = wy; END
        END
      END

      IF (kind == 0)
        // ---- harvester: ore -> fill up -> refinery -> unload, forever
        SWITCH (h_st[s])
          CASE 0                                     // look for ore
            IF (think <= 0)
              think = 1.0;
              IF (cargo >= 20)
                h_st[s] = 3;
                IF (e_used[refy[sd]] AND e_kind[refy[sd]] == 4 AND e_side[refy[sd]] == sd)
                  c = ref_dock[sd]; set_goal(s, c, cell_px(c), cell_py(c));
                ELSE
                  h_st[s] = 6;
                END
              ELSE
                hc = find_ore(x, y);
                IF (hc >= 0) set_goal(s, hc, cell_px(hc), cell_py(hc)); h_st[s] = 1; END
              END
            END
          CASE 1                                     // driving to the ore
            IF (arr) h_st[s] = 2; ht = 0.4; hc = cell_of(x, y); END
            IF (p_state[s] == 3) h_st[s] = 0; END
          CASE 2                                     // harvesting
            ht = ht - dt;
            angle = angle + rand(-800, 800);
            IF (ht <= 0)
              ht = 0.35;
              IF (tile[hc] == 5 AND ore[hc] > 0)
                ore[hc]--; cargo++;
                IF (rand(0, 2) == 0) boom(x + get_distx(angle, 12), y + get_disty(angle, 12), 0); END
                IF (ore[hc] == 0) tile[hc] = 1; paint_tile(hc, 50); END
              ELSE
                h_st[s] = 0; think = 0;
              END
              IF (cargo >= 20) h_st[s] = 0; think = 0; END
            END
          CASE 3                                     // driving home
            IF (arr) h_st[s] = 4; ht = 0.5; END
            IF (p_state[s] == 3) h_st[s] = 6; END
          CASE 4                                     // unloading
            ht = ht - dt;
            IF (ht <= 0)
              ht = 0.08;
              IF (cargo > 0) cargo--; cred[sd] += 35; ELSE h_st[s] = 0; END
            END
          CASE 5                                     // moved by the player
            IF (arr OR p_state[s] == 3) h_st[s] = 0; think = 0.5; END
          CASE 6                                     // no refinery: wait
            IF (think <= 0) h_st[s] = 0; END
        END
      ELSE
        // ---- combat unit
        IF (o_type[s] == 2)                          // is the target alive?
          t = o_tgt[s];
          IF (e_used[t] == 0 OR e_gen[t] != o_tgen[s] OR e_hp[t] <= 0)
            o_type[s] = 0;
            IF (p_state[s] == 2) p_state[s] = 0; END
            IF (am_on[s])
              o_type[s] = 3;
              c = near_free(cell_of(am_x[s], am_y[s]));
              wx = cell_px(c) + (s % 3) * 18 - 18; wy = cell_py(c) + (s / 3 % 3) * 18 - 18;
              IF (pass[cell_of(wx, wy)] == 0) wx = cell_px(c); wy = cell_py(c); END
              set_goal(s, c, wx, wy);
            END
          END
        END
        IF (think <= 0)
          think = 0.4;
          IF (o_type[s] == 0 OR o_type[s] == 3)    // guard / attack-move
            t = find_enemy(s, u_sight[kind]);
            IF (t < 0 AND o_type[s] == 0 AND game_t - al_t[sd] < 4)
              t = al_s[sd];                          // help whoever is hit nearby
              IF (e_used[t] == 0 OR e_gen[t] != al_g[sd]) t = -1; END
              IF (t >= 0)
                IF (fget_distance(x, y, e_x[t], e_y[t]) > 320) t = -1; END
              END
            END
            IF (t >= 0)
              o_type[s] = 2; o_tgt[s] = t; o_tgen[s] = e_gen[t];
              o_auto[s] = 1; o_rp[s] = 0;
              IF (p_state[s] == 2) p_state[s] = 0; END
            END
          END
          IF (o_type[s] == 1) opp = find_enemy(s, u_rng[kind]); END
        END
        SWITCH (o_type[s])
          CASE 1                                     // move, firing on the way
            IF (arr OR p_state[s] == 3) o_type[s] = 0; END
            IF (opp >= 0)
              IF (e_used[opp] AND e_hp[opp] > 0 AND e_side[opp] != sd)
                IF (fget_distance(x, y, e_x[opp], e_y[opp]) - e_rad[opp] <= u_rng[kind]) ft = opp; END
              END
            END
          CASE 2                                     // attack
            t = o_tgt[s];
            d = fget_distance(x, y, e_x[t], e_y[t]) - e_rad[t];
            // Already standing and firing: a few pixels of slack before
            // chasing again, so being shoved by a neighbour does not
            // start a drive back and forth.
            IF (d <= u_rng[kind] OR (p_state[s] == 0 AND d <= u_rng[kind] + 10))
              IF (p_state[s] == 2) p_state[s] = 0; END
              ft = t;
            ELSE
              IF (o_auto[s] AND d > u_sight[kind] * 2 + 60)
                o_type[s] = 0;                       // gave up the chase
              ELSE
                IF (arr) o_rp[s] = 0; END
                o_rp[s] = o_rp[s] - dt;
                IF (o_rp[s] <= 0 AND p_state[s] != 1 AND p_state[s] != 4)
                  o_rp[s] = 2.0;
                  // Drive to a spot on a ring round the target, on this
                  // unit's side of it and fanned out by slot, rather
                  // than everyone onto the target's own cell.
                  a = fget_angle(e_x[t], e_y[t], x, y) + (s % 5 - 2) * 15000;
                  dd = e_rad[t] + u_rng[kind] * 0.6;
                  wx = clamp(e_x[t] + get_distx(a, dd), 8, MW * 16 - 8);
                  wy = clamp(e_y[t] + get_disty(a, dd), 8, MH * 16 - 8);
                  c = near_free(cell_of(wx, wy));
                  set_goal(s, c, cell_px(c), cell_py(c));
                END
              END
            END
          CASE 3                                     // attack-move
            IF (arr OR p_state[s] == 3) o_type[s] = 0; am_on[s] = 0; END
        END

        // ---- aim and fire
        IF (ft >= 0)
          a = fget_angle(x, y, e_x[ft], e_y[ft]);
          IF (kind == 1)
            e_aim[s] = lerp_angle(e_aim[s], a, 0.2);
          ELSE
            e_aim[s] = a; angle = a;
          END
          dd = normalize_angle(a - e_aim[s]);
          IF (dd > 180000) dd = 360000 - dd; END
          IF (rl <= 0 AND dd < 12000 AND n_shells < 60)
            rl = u_rel[kind];
            dmg = u_dmg[kind];
            IF (kind == 1 AND e_kind[ft] == 2) dmg = dmg / 2; END
            IF (kind == 2 AND e_kind[ft] != 2) dmg = dmg * 0.4; END
            shell(x + get_distx(e_aim[s], 10), y + get_disty(e_aim[s], 10),
                  e_x[ft] + rand(-2, 2), e_y[ft] + rand(-2, 2), ft, e_gen[ft], dmg, kind, s);
          END
        ELSE
          IF (kind == 1) e_aim[s] = lerp_angle(e_aim[s], angle, 0.08); END
        END
      END
    END
    e_x[s] = x; e_y[s] = y;
    overlay(s, x, y);
    IF (kind == 0 AND e_sel[s])                      // cargo gauge
      draw_rect(x - 12, y + 12, 24 * cargo / 20, 2, '#f0c030');
    END
    FRAME;
  END
  boom(x, y, 1);
  free_slot(s);
END

// A building: blocks its tiles while it stands; the HQ decides the game
PROCESS building(sd, kind, tx, ty);
PRIVATE s, w, h, i, j, burn;
BEGIN
  s = alloc_slot(sd, kind);
  w = 3; h = 3;
  IF (kind == 4) h = 2; END
  x = tx * 16 + w * 8; y = ty * 16 + h * 8;
  ctype = c_scroll; z = 10;
  graph = g_bld[(kind - 3) * 2 + sd];
  e_x[s] = x; e_y[s] = y;
  FOR j = ty TO ty + h - 1
    FOR i = tx TO tx + w - 1 pass[j * MW + i] = 0; END
  END
  IF (kind == 3) hq[sd] = s; END
  IF (kind == 4) refy[sd] = s; END
  IF (kind == 5) fac[sd] = s; END
  LOOP
    IF (e_hp[s] <= 0) BREAK; END
    overlay(s, x, y);
    IF (e_hp[s] * 2 < e_max[s] AND state == 1)       // on fire
      burn = burn - get_delta();
      IF (burn <= 0) burn = 0.5; boom(x + rand(-12, 12), y + rand(-10, 10), 0); END
    END
    FRAME;
  END
  FOR i = 0 TO 4 boom(x + rand(-16, 16), y + rand(-16, 16), 1); END
  FOR j = ty TO ty + h - 1
    FOR i = tx TO tx + w - 1 pass[j * MW + i] = 1; END
  END
  IF (kind == 3 AND state == 1)
    IF (sd == 0) state = 3; ELSE state = 2; END
  END
  free_slot(s);
END

// =====================================================================
// Production and the enemy commander
// =====================================================================
FUNCTION start_build(sd, k);
BEGIN
  IF (bq_kind[sd] >= 0 OR cred[sd] < cost[k] OR nunits[sd] >= UCAP) RETURN 0; END
  IF (e_used[fac[sd]] == 0 OR e_kind[fac[sd]] != 5 OR e_side[fac[sd]] != sd) RETURN 0; END
  cred[sd] -= cost[k];
  bq_kind[sd] = k; bq_t[sd] = 0;
  RETURN 1;
END

FUNCTION produce(sd);
PRIVATE c;
BEGIN
  IF (bq_kind[sd] < 0) RETURN 0; END
  IF (e_used[fac[sd]] == 0 OR e_kind[fac[sd]] != 5)  // factory lost: refund
    cred[sd] += cost[bq_kind[sd]]; bq_kind[sd] = -1;
    RETURN 0;
  END
  bq_t[sd] += get_delta();
  IF (bq_t[sd] >= u_time[bq_kind[sd]] AND nunits[sd] < UCAP)
    c = near_free(fac_exit[sd] + rand(-2, 2) + rand(0, 2) * MW);
    IF (c >= 0) unit(sd, bq_kind[sd], cell_px(c), cell_py(c)); END
    bq_kind[sd] = -1;
  END
  RETURN 0;
END

// Builds a harvester when it has none, otherwise a mix of tanks and
// riflemen; every wave it sends part of its idle army against the
// player's HQ. Its build rate, income bonus and wave size grow each wave.
FUNCTION ai_tick();
PRIVATE i, k, n, c, send, m, fx, fy;
BEGIN
  cred[1] += get_delta() * (1 + wave * 2);
  ai_t = ai_t - get_delta();
  wave_t = wave_t - get_delta();
  IF (ai_t <= 0)
    ai_t = 5.5 - wave * 0.5;
    IF (ai_t < 1.5) ai_t = 1.5; END
    k = 1;
    IF (rand(0, 99) < 40) k = 2; END
    IF (cnt[3] == 0 OR (cnt[3] < 2 AND game_t > 240)) k = 0; END
    start_build(1, k);
  END
  IF (wave_t <= 0 AND e_used[hq[0]] AND e_kind[hq[0]] == 3)
    n = 0;
    FOR i = 0 TO 63
      IF (e_used[i] AND e_side[i] == 1 AND e_kind[i] >= 1 AND e_kind[i] <= 2 AND o_type[i] == 0) n++; END
    END
    IF (n >= 2 + wave / 2 OR wave_t < -40)
      c = near_free(cell_of(e_x[hq[0]], e_y[hq[0]]));
      send = 1 + wave * 2;                           // the rest stays home
      IF (send > n - 1) send = n - 1; END
      m = 0;
      FOR i = 0 TO 63
        IF (e_used[i] AND e_side[i] == 1 AND e_kind[i] >= 1 AND e_kind[i] <= 2 AND o_type[i] == 0)
          IF (send <= 0)
            send = 0;
          ELSE
            send--;
            o_type[i] = 3; am_on[i] = 1; o_auto[i] = 0;
            am_x[i] = e_x[hq[0]]; am_y[i] = e_y[hq[0]];
            // each unit of the wave gets its own spot of a 3-wide block
            fx = cell_px(c) + (m % 3) * 18 - 18; fy = cell_py(c) + (m / 3) * 18 - 9;
            IF (pass[cell_of(fx, fy)] == 0) fx = cell_px(c); fy = cell_py(c); END
            set_goal(i, c, fx, fy);
            m++;
          END
        END
      END
      wave++;
      wave_t = 75 - wave * 4;
      IF (wave_t < 40) wave_t = 40; END
    END
  END
  RETURN 0;
END

// =====================================================================
// Player orders
// =====================================================================
FUNCTION deselect_all();
PRIVATE i;
BEGIN
  FOR i = 0 TO 63 e_sel[i] = 0; END
  RETURN 0;
END

// The entity under a map point (closest centre within its radius)
FUNCTION entity_at(wx, wy);
PRIVATE i, best, bd, d;
BEGIN
  best = -1; bd = 9999;
  FOR i = 0 TO 63
    IF (e_used[i])
      d = fget_distance(wx, wy, e_x[i], e_y[i]);
      IF (d <= e_rad[i] + 4 AND d < bd) bd = d; best = i; END
    END
  END
  RETURN best;
END

// Move every selected unit: one shared goal cell, then a 3-wide
// formation of final spots around it
FUNCTION order_move(wx, wy);
PRIVATE i, n, g, gx, gy, fx, fy;
BEGIN
  g = near_free(cell_of(wx, wy));
  IF (g < 0) RETURN 0; END
  gx = cell_px(g); gy = cell_py(g);
  n = 0;
  FOR i = 0 TO 63
    IF (e_used[i] AND e_sel[i] AND e_side[i] == 0 AND e_kind[i] < 3)
      fx = gx + (n % 3) * 18 - 18; fy = gy + (n / 3) * 18 - 9;
      IF (pass[cell_of(fx, fy)] == 0) fx = gx; fy = gy; END
      o_type[i] = 1; o_auto[i] = 0; am_on[i] = 0;
      IF (e_kind[i] == 0) h_st[i] = 5; END
      set_goal(i, g, fx, fy);
      n++;
    END
  END
  mk_x = wx; mk_y = wy; mk_t = 0.6; mk_c = 0;
  RETURN 0;
END

FUNCTION order_attack(t);
PRIVATE i;
BEGIN
  FOR i = 0 TO 63
    IF (e_used[i] AND e_sel[i] AND e_side[i] == 0 AND e_kind[i] >= 1 AND e_kind[i] <= 2)
      o_type[i] = 2; o_tgt[i] = t; o_tgen[i] = e_gen[t];
      o_auto[i] = 0; am_on[i] = 0; o_rp[i] = 0;
      IF (p_state[i] == 2) p_state[i] = 0; END
    END
  END
  mk_x = e_x[t]; mk_y = e_y[t]; mk_t = 0.6; mk_c = 1;
  RETURN 0;
END

FUNCTION click_at(wx, wy, right);
PRIVATE h;
BEGIN
  h = entity_at(wx, wy);
  IF (h >= 0 AND right == 0)
    IF (e_side[h] == 0 AND e_kind[h] < 3)
      IF (key(_shift) == 0) deselect_all(); END
      e_sel[h] = 1;
      RETURN 0;
    END
  END
  IF (sel_n == 0) RETURN 0; END
  IF (h >= 0)
    IF (e_side[h] == 1) order_attack(h); RETURN 0; END
  END
  order_move(wx, wy);
  RETURN 0;
END

FUNCTION box_select(x0, y0, x1, y1);
PRIVATE i, t;
BEGIN
  IF (x0 > x1) t = x0; x0 = x1; x1 = t; END
  IF (y0 > y1) t = y0; y0 = y1; y1 = t; END
  deselect_all();
  FOR i = 0 TO 63
    IF (e_used[i] AND e_side[i] == 0 AND e_kind[i] < 3)
      IF (e_x[i] >= x0 AND e_x[i] <= x1 AND e_y[i] >= y0 AND e_y[i] <= y1) e_sel[i] = 1; END
    END
  END
  RETURN 0;
END

// Mouse: drag box / click in the view, minimap, sidebar buttons
FUNCTION handle_mouse();
PRIVATE mx, my, wx, wy, lb, rb, b, sx, sy;
BEGIN
  mx = mouse_x(); my = mouse_y();
  wx = mx + cam_x; wy = my + cam_y;
  lb = mouse_button(0); rb = mouse_button(2);
  IF (lb AND drag == 0 AND mx >= 480 AND my < 120)  // minimap: jump there
    cam_x = (mx - 480) * 8 - 240; cam_y = my * 8 - 240;
  END
  IF (lb AND lprev == 0)
    IF (mx < 480) drag = 1; ds_x = wx; ds_y = wy; END
    IF (mx >= 486 AND mx < 634 AND my >= 160 AND my < 292)
      b = (my - 160) / 44;
      IF ((my - 160) % 44 < 38)
        IF (b == 0) start_build(0, 1); END
        IF (b == 1) start_build(0, 2); END
        IF (b == 2) start_build(0, 0); END
      END
    END
  END
  IF (drag)
    IF (lb == 0)
      drag = 0;
      IF (abs(wx - ds_x) + abs(wy - ds_y) > 8)
        box_select(ds_x, ds_y, wx, wy);
      ELSE
        click_at(wx, wy, 0);
      END
    ELSE
      IF (abs(wx - ds_x) + abs(wy - ds_y) > 8)      // rubber band
        sx = min(ds_x, wx) - cam_x; sy = min(ds_y, wy) - cam_y;
        set_color('#80ff80');
        draw_rect(sx, sy, abs(wx - ds_x), 1);
        draw_rect(sx, sy + abs(wy - ds_y), abs(wx - ds_x), 1);
        draw_rect(sx, sy, 1, abs(wy - ds_y));
        draw_rect(sx + abs(wx - ds_x), sy, 1, abs(wy - ds_y) + 1);
      END
    END
  END
  IF (rb AND rprev == 0 AND mx < 480) click_at(wx, wy, 1); END
  lprev = lb; rprev = rb;
  RETURN 0;
END

FUNCTION min(a, b);
BEGIN
  IF (a < b) RETURN a; END
  RETURN b;
END

// =====================================================================
// Screen furniture
// =====================================================================
PROCESS panel(g, px, py, pz);
BEGIN
  graph = g; x = px; y = py; z = pz;
  LOOP FRAME; END
END

// Big title / victory / defeat lettering over the map
PROCESS banner();
BEGIN
  x = 240; y = 130; z = -30;
  LOOP
    graph = 0;
    IF (state == 0) graph = g_title; END
    IF (state == 2) graph = g_win; END
    IF (state == 3) graph = g_lose; END
    FRAME;
  END
END

FUNCTION box_text(y0, n);
BEGIN
  draw_rect(40, y0, 400, n * 16 + 16, 'rgba(0,0,0,0.72)');
  RETURN 0;
END

FUNCTION draw_hud();
PRIVATE i, c, k, by;
BEGIN
  // minimap: unit dots and the camera frame
  sel_n = 0;
  FOR i = 0 TO 63
    IF (e_used[i])
      IF (e_side[i] == 0) c = '#60c0ff'; ELSE c = '#ff5040'; END
      IF (e_sel[i]) c = '#ffffff'; sel_n++; END
      IF (e_kind[i] >= 3)
        draw_rect(478 + e_x[i] / 8, e_y[i] / 8 - 2, 5, 5, c);
      ELSE
        draw_rect(479 + e_x[i] / 8, e_y[i] / 8 - 1, 2, 2, c);
      END
    END
  END
  set_color('#ffffff');
  draw_rect(480 + cam_x / 8, cam_y / 8, 60, 1);
  draw_rect(480 + cam_x / 8, cam_y / 8 + 59, 60, 1);
  draw_rect(480 + cam_x / 8, cam_y / 8, 1, 60);
  draw_rect(539 + cam_x / 8, cam_y / 8, 1, 60);

  // build buttons: progress bar, greyed out when not possible
  FOR i = 0 TO 2
    k = 1;
    IF (i == 1) k = 2; END
    IF (i == 2) k = 0; END
    by = 160 + i * 44;
    IF (bq_kind[0] == k)
      draw_rect(488, by + 33, 144 * bq_t[0] / u_time[k], 3, '#60ff60');
    END
    IF (cred[0] < cost[k] OR (bq_kind[0] >= 0 AND bq_kind[0] != k) OR nunits[0] >= UCAP OR e_used[fac[0]] == 0 OR state != 1)
      draw_rect(487, by + 1, 146, 36, 'rgba(0,0,0,0.5)');
    END
  END
  hud_cred = cred[0]; hud_ecred = cred[1];
  set_color('#c8d0e0');
  text(488, 142, "UNITS " + nunits[0] + " / " + UCAP);
  set_color('#ffb060');
  text(488, 300, "ENEMY WAVE " + wave);
  IF (state == 1) text(488, 312, "arrives in " + int(max(wave_t, 0)) + " s"); END
  set_color('#c8d0e0');
  text(488, 328, "SELECTED " + sel_n);

  // order marker
  IF (mk_t > 0)
    mk_t = mk_t - get_delta();
    IF (mk_x - cam_x < 474)
      IF (mk_c) set_color('#ff4040'); ELSE set_color('#60ff60'); END
      circle(mk_x - cam_x, mk_y - cam_y, 2 + mk_t * 12);
    END
  END
  RETURN 0;
END

FUNCTION max(a, b);
BEGIN
  IF (a > b) RETURN a; END
  RETURN b;
END

// Clears every game process and table and builds a new map
FUNCTION new_game(next_state);
PRIVATE i;
BEGIN
  signal(TYPE unit, s_kill); signal(TYPE turret, s_kill);
  signal(TYPE building, s_kill); signal(TYPE shell, s_kill);
  signal(TYPE boom, s_kill); signal(TYPE builder, s_kill);
  signal(TYPE pathfinder, s_kill);
  FOR i = 0 TO 63 e_used[i] = 0; e_sel[i] = 0; p_state[i] = 0; END
  FOR i = 0 TO 5 cnt[i] = 0; END
  nunits[0] = 0; nunits[1] = 0;
  n_shells = 0; n_booms = 0; drag = 0; mk_t = 0;
  FOR i = 0 TO 1 al_t[i] = -99; END
  wave = 1; wave_t = 80; ai_t = 3; game_t = 0;
  seed = rand(1, 99999);
  pathfinder();
  builder(next_state);
  RETURN 0;
END

// =====================================================================
// MAIN
// =====================================================================
PRIVATE spd;
BEGIN
  set_mode(640, 480);
  set_fps(60, 0);
  screen_color('#000000');
  init_tables();
  make_graphics();
  define_region(1, 0, 0, 480, 480);
  start_scroll(0, 0, g_map, 0, 1, 0);
  panel(g_side, 560, 300, -10);
  panel(g_mini, 560, 60, -12);
  banner();

  // static HUD texts: written once; OFFSET keeps the numbers live
  set_color('#f0d060');
  write(0, 488, 128, 0, "CREDITS");
  write_int(0, 560, 128, 0, OFFSET hud_cred);
  set_color('#c8d0e0');
  write(0, 526, 166, 0, "1 LIGHT TANK");
  write(0, 526, 180, 0, "$700    7 s");
  write(0, 526, 210, 0, "2 RIFLEMAN");
  write(0, 526, 224, 0, "$150    3 s");
  write(0, 526, 254, 0, "3 HARVESTER");
  write(0, 526, 268, 0, "$1100   9 s");
  set_color('#8890a0');
  write(0, 488, 350, 0, "drag: select units");
  write(0, 488, 362, 0, "click unit: select");
  write(0, 488, 374, 0, "click/right: move");
  write(0, 488, 386, 0, "click enemy: attack");
  write(0, 488, 398, 0, "arrows/edge: scroll");
  write(0, 488, 410, 0, "minimap: jump");
  write(0, 488, 440, 0, "MAP #");
  write_int(0, 518, 440, 0, OFFSET seed);
  write(0, 488, 452, 0, "enemy $");
  write_int(0, 530, 452, 0, OFFSET hud_ecred);

  new_game(0);
  LOOP
    // camera: arrow keys or the mouse at the screen edge
    spd = 420 * get_delta();
    IF (key(_left) OR (mouse_x() <= 2 AND mouse_y() > 0)) cam_x -= spd; END
    IF (key(_right) OR mouse_x() >= 637) cam_x += spd; END
    IF (key(_up) OR (mouse_y() <= 2 AND mouse_x() < 480 AND mouse_x() > 0)) cam_y -= spd; END
    IF (key(_down) OR (mouse_y() >= 477 AND mouse_x() < 480)) cam_y += spd; END

    IF (state == 1)
      game_t += get_delta();
      handle_mouse();
      IF (key_pressed(_1)) start_build(0, 1); END
      IF (key_pressed(_2)) start_build(0, 2); END
      IF (key_pressed(_3)) start_build(0, 0); END
      produce(0); produce(1);
      ai_tick();
    ELSE
      IF (state != 4 AND mouse_button(0) AND mouse_x() >= 480 AND mouse_y() < 120)
        cam_x = (mouse_x() - 480) * 8 - 240; cam_y = mouse_y() * 8 - 240;
      END
    END
    cam_x = clamp(int(cam_x), 0, MW * 16 - 480);
    cam_y = clamp(int(cam_y), 0, MH * 16 - 480);
    scroll.x0 = cam_x; scroll.y0 = cam_y;
    draw_hud();

    SWITCH (state)
      CASE 0
        box_text(170, 7);
        set_color('#ffffff');
        text(60, 180, "Destroy the red HQ. Protect your blue one.");
        text(60, 196, "Harvesters mine ore for credits by themselves.");
        text(60, 212, "Drag a box or click to select, then click the");
        text(60, 228, "ground to move or an enemy to attack.");
        text(60, 244, "Build: sidebar buttons or keys 1, 2, 3.");
        set_color('#f0d060');
        text(60, 268, "Waves attack from the enemy base.");
        set_color('#60ff60');
        text(60, 292, "PRESS SPACE OR ENTER TO START");
        IF (key_pressed(_space) OR key_pressed(_enter)) state = 1; END
      CASE 2, 3
        box_text(200, 4);
        set_color('#ffffff');
        IF (state == 2)
          text(60, 212, "The enemy HQ is rubble. The ore is yours.");
        ELSE
          text(60, 212, "Your HQ has fallen.");
        END
        text(60, 232, "Time " + int(game_t) + " s   waves survived " + (wave - 1));
        set_color('#60ff60');
        text(60, 256, "SPACE / ENTER: new map");
        IF (key_pressed(_space) OR key_pressed(_enter)) new_game(1); END
      CASE 4
        box_text(220, 2);
        set_color('#ffffff');
        text(60, 232, "Generating terrain... " + gen_pct + "%");
    END
    FRAME;
  END
END
