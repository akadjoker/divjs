PROGRAM net_tanks;

// Two tanks in an arena, online. The two players connect peer to peer by
// exchanging two codes (option 1 and 2), or play from two tabs of the same
// browser (3 and 4), or share one keyboard (5).
//
// Online, the game runs in lockstep: both computers run this same program
// and only the players' keys travel over the network. That is why the
// gameplay reads net_key(player, key) for BOTH tanks and never key(): each
// side sees exactly the same presses, frame by frame. The arena is made
// with rand() after net_running(), so both sides build the same one from
// the seed the host picked. Anything that differs between the two sides on
// purpose (the menu choice, which tank is "you") lives in PRIVATE
// variables: GLOBALs are part of the state the two sides compare.
//
// Sound (made by the engine: sfx, sfx_tone, song_*): shots, bounces that
// ring higher each time, engines, explosions, a round start beep, a menu
// tune, a battle tune (faster at match point) and a win / lose jingle.
// Sound never changes the game's state, so it is safe in lockstep, but it
// keeps to the same rules: no GLOBAL is used for it (the sound ids are
// asked of sfx() when needed - the same recipe always gives the same id -
// and the songs live in the main program's PRIVATE variables), no extra
// process is created, and variations come from counters, never rand()
// (the seeded generator both sides share). M turns the music on and off.

GLOBAL
  SW = 640; SH = 480;
  TILE = 32; GW = 20; GH = 15;
  WIN_SCORE = 5;
  MAX_SHOTS = 3;
  walls[299];           // GW * GH cells: 1 wall, 0 floor
  tx[1]; ty[1];         // tank positions, read by the bullets
  alive[1];
  shots[1];             // bullets each tank has in the air
  score[1];
  online = 0;           // 1: net_key for both tanks; 0: one keyboard
  round_no = 0;         // bumped for every new round: tanks go home
  round_timer = 0;      // frames left of the pause after a hit
  match_over = 0;       // winner + 1 while the match's result shows
  wipe = 0;             // 1 for a frame: every bullet removes itself
  g_tank[1]; g_wreck; g_bullet; g_arena;

// ---------------------------------------------------------------------
// Input: action 0 left, 1 right, 2 forward, 3 back, 4 fire (the press).
// ---------------------------------------------------------------------

FUNCTION ctl(p, a);
BEGIN
  IF (online)
    IF (a == 0) RETURN (net_key(p, _left) OR net_key(p, _a)); END
    IF (a == 1) RETURN (net_key(p, _right) OR net_key(p, _d)); END
    IF (a == 2) RETURN (net_key(p, _up) OR net_key(p, _w)); END
    IF (a == 3) RETURN (net_key(p, _down) OR net_key(p, _s)); END
    RETURN net_key_pressed(p, _space);
  END
  IF (p == 0)
    IF (a == 0) RETURN key(_a); END
    IF (a == 1) RETURN key(_d); END
    IF (a == 2) RETURN key(_w); END
    IF (a == 3) RETURN key(_s); END
    RETURN key_pressed(_space);
  END
  IF (a == 0) RETURN key(_left); END
  IF (a == 1) RETURN key(_right); END
  IF (a == 2) RETURN key(_up); END
  IF (a == 3) RETURN key(_down); END
  RETURN key_pressed(_enter);
END

// ---------------------------------------------------------------------
// Graphics
// ---------------------------------------------------------------------

FUNCTION draw_tank(r, g, b);
PRIVATE t = 0;
BEGIN
  t = new_graphic(30, 26);
  gfx_fill_rgba(t, 0, 0, 0, 0);
  gfx_rect(t, 2, 1, 24, 6, 40, 44, 48);          // tracks
  gfx_rect(t, 2, 19, 24, 6, 40, 44, 48);
  gfx_rect(t, 4, 6, 20, 14, r, g, b);            // hull
  gfx_rect_outline(t, 4, 6, 20, 14, r / 2, g / 2, b / 2);
  gfx_circle(t, 13, 13, 5, r * 3 / 4, g * 3 / 4, b * 3 / 4);
  gfx_rect(t, 13, 11, 16, 4, 210, 215, 220);     // gun, pointing right
  RETURN t;
END

FUNCTION make_graphics();
BEGIN
  g_tank[0] = draw_tank(70, 140, 255);
  g_tank[1] = draw_tank(255, 90, 70);
  g_wreck = new_graphic(30, 26);
  gfx_fill_rgba(g_wreck, 0, 0, 0, 0);
  gfx_circle(g_wreck, 15, 13, 12, 255, 150, 40);
  gfx_circle(g_wreck, 15, 13, 7, 255, 240, 170);
  g_bullet = new_graphic(6, 6);
  gfx_fill_rgba(g_bullet, 0, 0, 0, 0);
  gfx_circle(g_bullet, 3, 3, 2, 255, 250, 200);
  g_arena = new_graphic(SW, SH);
  RETURN 0;
END

// ---------------------------------------------------------------------
// Sound: effects made from a recipe (the same recipe gives back the same
// sound id, so asking for it every time costs nothing and needs no
// GLOBAL), and the songs.
// ---------------------------------------------------------------------

FUNCTION snd_shot(); BEGIN RETURN sfx_tone(wave_square, 1100, 260, 120, 34); END
FUNCTION snd_bounce(); BEGIN RETURN sfx_tone(wave_triangle, 1500, 1100, 45, 36); END
FUNCTION snd_boom(); BEGIN RETURN sfx(sfx_explosion, 6); END
FUNCTION snd_hit(); BEGIN RETURN sfx(sfx_hit, 3); END
FUNCTION snd_engine(); BEGIN RETURN sfx_tone(wave_noise, 260, 120, 110, 30); END
FUNCTION snd_beep(); BEGIN RETURN sfx_tone(wave_sine, 880, 880, 120, 45); END
FUNCTION snd_menu(); BEGIN RETURN sfx(sfx_coin, 1); END
FUNCTION snd_back(); BEGIN RETURN sfx_tone(wave_square, 600, 380, 70, 28); END

// Makes every effect once at start-up, so none is made mid-match
FUNCTION warm_sounds();
BEGIN
  snd_shot(); snd_bounce(); snd_boom(); snd_hit(); snd_engine(); snd_beep(); snd_menu(); snd_back();
  RETURN 0;
END

// Songs: 0 menu, 1 battle, 2 match point, 3 win, 4 lose. The ids are kept
// by the caller (the main program's PRIVATE variables).
FUNCTION make_song(k);
PRIVATE s = 0;
BEGIN
  IF (k == 0)
    s = song_new(104);
    song_track(s, inst_pad,
      "E4 - - - - - - - - - - - - - - - | C4 - - - - - - - - - - - - - - - |" +
      "D4 - - - - - - - - - - - - - - - | B3 - - - - - - - - - - - - - - - ", 22);
    song_track(s, inst_pluck,
      "E5 . B4 . G4 . B4 . E5 . B4 . G4 . B4 . | E5 . C5 . G4 . C5 . E5 . C5 . G4 . C5 . |" +
      "F#5 . D5 . A4 . D5 . F#5 . D5 . A4 . D5 . | D#5 . B4 . F#4 . B4 . D#5 . B4 . F#4 . B4 . ", 22);
    song_track(s, inst_bass,
      "E3 - - - . . . . E3 - - - . . . . | C3 - - - . . . . C3 - - - . . . . |" +
      "D3 - - - . . . . D3 - - - . . . . | B2 - - - . . . . B2 - - - . . . . ", 50);
    song_track(s, inst_drums, "k . . . h . . . s . . . h . h . ", 22);
  END
  IF (k == 1 OR k == 2)
    IF (k == 1) s = song_new(132); ELSE s = song_new(164); END
    song_track(s, inst_square,
      "E5 . . E5 . . G5 . | . E5 . D5 . C5 B4 . | E5 . . E5 . . G5 . | . A5 . G5 . E5 . . |" +
      "C6 . . B5 . . G5 . | . A5 . G5 . E5 D5 . | E5 . . G5 . . A5 . | B5 - - - . . . . ", 24);
    song_track(s, inst_bass,
      "E3 . E3 E4 . E3 . E3 | E3 . E3 E4 . D3 . D3 | E3 . E3 E4 . E3 . E3 | A3 . A3 A4 . A3 . A3 |" +
      "C3 . C3 C4 . C3 . C3 | D3 . D3 D4 . D3 . D3 | E3 . E3 E4 . E3 . E3 | B2 . B2 B3 . B2 . B2 ", 55);
    IF (k == 1) song_track(s, inst_drums, "k . h . s . h . | k . h k s . h . ", 34); END
    IF (k == 2) song_track(s, inst_drums, "k h s h k h s h | k h s h k k s s ", 40); END
  END
  IF (k == 3)
    s = song_new(144);
    song_track(s, inst_square, "E5 G5 B5 E6 - . B5 E6 - - - - . . . . ", 34);
    song_track(s, inst_bass, "E3 . . . B3 . . . E3 - - - . . . . ", 55);
    song_track(s, inst_drums, "k . h . s . h . k . . . . . . . ", 36);
  END
  IF (k == 4)
    s = song_new(100);
    song_track(s, inst_triangle, "B4 - A4 - G4 - F#4 - | E4 - - - - - - - . . . . . . . . ", 42);
    song_track(s, inst_bass, "E3 - - - - - - - | E2 - - - - - - - . . . . . . . . ", 50);
  END
  RETURN s;
END

// ---------------------------------------------------------------------
// Arena: point-symmetric, so both players get the same map.
// ---------------------------------------------------------------------

FUNCTION solid(px, py);
PRIVATE cx = 0; cy = 0;
BEGIN
  IF (px < 0 OR py < 0) RETURN 1; END
  cx = int(px / TILE);
  cy = int(py / TILE);
  IF (cx >= GW OR cy >= GH) RETURN 1; END
  RETURN walls[cy * GW + cx];
END

FUNCTION set_wall(cx, cy, v);
BEGIN
  // Segments may run past the edge: only the interior changes (the border
  // is always wall).
  IF (cx < 1 OR cy < 1 OR cx > GW - 2 OR cy > GH - 2) RETURN 0; END
  walls[cy * GW + cx] = v;
  walls[(GH - 1 - cy) * GW + (GW - 1 - cx)] = v;
  RETURN 0;
END

FUNCTION make_arena();
PRIVATE cx = 0; cy = 0; n = 0; len = 0; dir = 0; k = 0; shade = 0;
BEGIN
  FOR cy = 0 TO GH - 1
    FOR cx = 0 TO GW - 1
      walls[cy * GW + cx] = 0;
      IF (cx == 0 OR cy == 0 OR cx == GW - 1 OR cy == GH - 1)
        walls[cy * GW + cx] = 1;
      END
    END
  END
  // Short wall segments in the left half, mirrored into the right half.
  FOR n = 1 TO 9
    cx = rand(2, GW / 2 - 1);
    cy = rand(2, GH - 3);
    len = rand(1, 3);
    dir = rand(0, 1);
    FOR k = 0 TO len
      IF (dir == 0)
        set_wall(cx + k, cy, 1);
      ELSE
        set_wall(cx, cy + k, 1);
      END
    END
  END
  // Keep the spawn points and their surroundings open.
  FOR cy = 5 TO 9
    FOR cx = 1 TO 4
      set_wall(cx, cy, 0);
    END
  END

  gfx_fill(g_arena, 26, 30, 24);
  FOR cy = 0 TO GH - 1
    FOR cx = 0 TO GW - 1
      IF (walls[cy * GW + cx])
        gfx_rect(g_arena, cx * TILE, cy * TILE, TILE, TILE, 92, 88, 76);
        gfx_rect(g_arena, cx * TILE + 3, cy * TILE + 3, TILE - 6, TILE - 6, 120, 114, 98);
      ELSE
        shade = 30 + ((cx + cy) MOD 2) * 4;
        gfx_rect(g_arena, cx * TILE, cy * TILE, TILE, TILE, shade, shade + 6, shade - 4);
      END
    END
  END
  put_screen(0, g_arena);
  RETURN 0;
END

// ---------------------------------------------------------------------
// Tanks and bullets
// ---------------------------------------------------------------------

FUNCTION blocked(px, py);
BEGIN
  RETURN (solid(px - 11, py - 11) OR solid(px + 11, py - 11) OR
          solid(px - 11, py + 11) OR solid(px + 11, py + 11));
END

PROCESS tank(p);
PRIVATE my_round = -1; spd = 0.0; nx = 0.0; ny = 0.0; reload = 0;
  snd_shots = 0; snd_move = 0;     // sound only: shot counter (pitch), engine timer
BEGIN
  z = -5;
  LOOP
    IF (my_round != round_no)
      my_round = round_no;
      IF (p == 0) x = 2.5 * TILE; y = 7.5 * TILE; angle = 0;
      ELSE x = (GW - 2.5) * TILE; y = 7.5 * TILE; angle = 180000; END
      graph = g_tank[p];
      alive[p] = 1;
      reload = 0;
    END
    IF (alive[p] AND round_timer == 0 AND match_over == 0)
      IF (ctl(p, 0)) angle = angle + 4000; END
      IF (ctl(p, 1)) angle = angle - 4000; END
      spd = 0.0;
      IF (ctl(p, 2)) spd = 2.2; END
      IF (ctl(p, 3)) spd = -1.4; END
      IF (spd != 0.0)
        nx = x + cos(angle) * spd;
        ny = y - sin(angle) * spd;
        IF (NOT blocked(nx, y)) x = nx; END
        IF (NOT blocked(x, ny)) y = ny; END
        snd_move++;                  // a soft engine rumble while driving
        IF (snd_move % 14 == 1) play_sound(snd_engine(), 18, 80 + p * 12 + (snd_move % 28) / 2, (x - 320) / 3); END
      ELSE
        snd_move = 0;
      END
      IF (reload > 0) reload = reload - 1; END
      IF (ctl(p, 4) AND reload == 0 AND shots[p] < MAX_SHOTS)
        bullet(p, x + cos(angle) * 18, y - sin(angle) * 18, angle);
        reload = 12;
        snd_shots++;
        play_sound(snd_shot(), 55, 92 + (snd_shots % 3) * 6 + p * 8, (x - 320) / 3);
      END
    END
    IF (NOT alive[p])
      graph = g_wreck;
      size = 100 + (round_timer MOD 6) * 8;
    ELSE
      size = 100;
    END
    tx[p] = x; ty[p] = y;
    FRAME;
  END
END

PROCESS bullet(owner, bx, by, dir);
PRIVATE vx = 0.0; vy = 0.0; bounces = 0; life = 240; q = 0; nx = 0.0; ny = 0.0;
  snd_b = 0;                         // sound only: bounces already heard
BEGIN
  x = bx; y = by; graph = g_bullet; z = -6;
  vx = cos(dir) * 5.0;
  vy = -sin(dir) * 5.0;
  shots[owner] = shots[owner] + 1;
  // Fired with the gun inside a wall: gone at once.
  IF (solid(x, y)) life = 0; END
  WHILE (life > 0 AND bounces <= 2 AND wipe == 0)
    nx = x + vx;
    IF (solid(nx, y)) vx = -vx; bounces = bounces + 1; ELSE x = nx; END
    ny = y + vy;
    IF (solid(x, ny)) vy = -vy; bounces = bounces + 1; ELSE y = ny; END
    // sound only: a ping for each bounce this frame, higher every time
    IF (bounces > snd_b AND bounces <= 2)
      play_sound(snd_bounce(), 40, 100 + bounces * 15, (x - 320) / 3);
    END
    snd_b = bounces;
    FOR q = 0 TO 1
      // Its own tank only after the first bounce.
      IF (alive[q] AND round_timer == 0 AND (q != owner OR bounces > 0))
        IF (fget_distance(x, y, tx[q], ty[q]) < 13)
          alive[q] = 0;
          score[1 - q] = score[1 - q] + 1;
          round_timer = 90;
          life = 0;
          play_sound(snd_boom(), 90, 100, (x - 320) / 3);
          play_sound(snd_hit(), 70, 80, (x - 320) / 3);
        END
      END
    END
    life = life - 1;
    FRAME;
  END
  shots[owner] = shots[owner] - 1;
END

// ---------------------------------------------------------------------
// Main: menu, connection, match
// ---------------------------------------------------------------------

FUNCTION new_match();
BEGIN
  score[0] = 0; score[1] = 0;
  match_over = 0;
  round_timer = 0;
  make_arena();
  round_no = round_no + 1;
  RETURN 0;
END

PRIVATE choice = 0; st = 0; msg = ''; wait = 0; me = 0;
  // sound only, local to this side: the songs, the one playing, music on
  m_menu = 0; m_battle = 0; m_point = 0; m_win = 0; m_lose = 0; cur = 0; music = 1;
  want = 0; lp = 1; last_round = 0; k = 0;
BEGIN
  set_mode(SW, SH);
  set_fps(60, 0);
  make_graphics();
  warm_sounds();
  m_menu = make_song(0); m_battle = make_song(1); m_point = make_song(2);
  m_win = make_song(3); m_lose = make_song(4);

  LOOP
    // ── Menu ─────────────────────────────────────────────────────────
    online = 0;
    choice = 0;
    put_screen(0, 0);
    screen_color('#10161c');
    IF (music AND cur != m_menu) cur = m_menu; song_play(m_menu); END
    WHILE (choice == 0)
      IF (key_pressed(_m))
        music = 1 - music; cur = 0;
        IF (music) cur = m_menu; song_play(m_menu); ELSE song_stop(); END
      END
      set_color('#ffe070');
      text(250, 90, 'N E T   T A N K S');
      set_color('#dfe8f0');
      text(190, 150, '1  Host an online game (send a code)');
      text(190, 172, '2  Join an online game (paste a code)');
      text(190, 206, '3  Host in another tab of this browser');
      text(190, 228, '4  Join from another tab');
      text(190, 262, '5  Two players, one keyboard');
      set_color('#8fa4b8');
      text(150, 330, 'Online: arrows or WASD to drive, SPACE to fire');
      text(150, 350, 'One keyboard: blue WASD + SPACE, red arrows + ENTER');
      text(150, 370, 'Bullets bounce twice. First to ' + WIN_SCORE + ' wins.  M music');
      IF (msg != '') set_color('#ff9080'); text(150, 410, msg); END
      IF (key_pressed(_1)) choice = 1; END
      IF (key_pressed(_2)) choice = 2; END
      IF (key_pressed(_3)) choice = 3; END
      IF (key_pressed(_4)) choice = 4; END
      IF (key_pressed(_5)) choice = 5; END
      FRAME;
    END
    play_sound(snd_menu(), 70, 100, 0);
    msg = '';

    // ── Connecting ───────────────────────────────────────────────────
    IF (choice <= 4)
      IF (choice == 1) net_host(); END
      IF (choice == 2) net_join(); END
      IF (choice == 3) net_host_local('net-tanks'); END
      IF (choice == 4) net_join_local('net-tanks'); END
      st = net_status();
      WHILE (st == 1)
        set_color('#dfe8f0');
        IF (choice == 1 OR choice == 3) text(220, 220, 'Waiting for the other player...');
        ELSE text(240, 220, 'Connecting to the host...'); END
        set_color('#8fa4b8');
        text(250, 250, 'ESC to go back');
        IF (key_pressed(_esc)) net_close(); play_sound(snd_back(), 60, 100, 0); END
        FRAME;
        st = net_status();
      END
      IF (st != 2)
        IF (st == 3) msg = 'Could not connect (or the other player left).'; END
        net_close();
        CONTINUE;
      END
      // Both sides call it; only the host's starts the lockstep.
      net_start(3);
      WHILE (NOT net_running() AND net_status() == 2)
        set_color('#dfe8f0');
        text(250, 220, 'Starting...');
        FRAME;
      END
      IF (NOT net_running())
        msg = 'The other player left.';
        net_close();
        CONTINUE;
      END
      online = 1;
    END

    // ── Match ────────────────────────────────────────────────────────
    me = net_me();
    new_match();
    tank(0);
    tank(1);
    last_round = round_no;
    play_sound(snd_beep(), 55, 100, 0);
    LOOP
      IF (online AND net_status() == 3)
        msg = 'The other player left.';
        BREAK;
      END
      IF (key_pressed(_esc))
        play_sound(snd_back(), 60, 100, 0);
        BREAK;
      END
      wipe = 0;
      IF (round_timer > 0)
        round_timer = round_timer - 1;
        IF (round_timer == 0)
          IF (score[0] >= WIN_SCORE OR score[1] >= WIN_SCORE)
            IF (score[0] >= WIN_SCORE) match_over = 1; ELSE match_over = 2; END
            wait = 240;
          ELSE
            round_no = round_no + 1;
          END
          wipe = 1;
        END
      END
      IF (match_over)
        wait = wait - 1;
        IF (wait <= 0)
          new_match();
        END
      END

      // Sound, this side only: a beep for every new round, and the song
      // for the moment (read from the game's state, never written to it)
      IF (round_no != last_round)
        last_round = round_no;
        play_sound(snd_beep(), 55, 100 + (score[0] + score[1]) * 4, 0);
      END
      IF (key_pressed(_m))
        music = 1 - music; cur = 0;
        IF (music == 0) song_stop(); END
      END
      IF (music)
        want = m_battle; lp = 1;
        IF (score[0] == WIN_SCORE - 1 OR score[1] == WIN_SCORE - 1) want = m_point; END
        IF (match_over)
          lp = 0; want = m_win;
          // online: the jingle of whoever this side is; one keyboard: a win
          IF (online AND match_over - 1 != me) want = m_lose; END
        END
        IF (want != cur) cur = want; song_play(want, lp); END
      END

      // HUD (this side only: drawing is not part of the simulation).
      set_color('#78a8ff');
      text(12, 6, 'BLUE ' + score[0]);
      set_color('#ff8870');
      text(SW - 70, 6, 'RED ' + score[1]);
      IF (online)
        set_color('#ffffff');
        text(tx[me] - 12, ty[me] - 30, 'YOU');
        IF (net_status() == 4)
          set_color('#ff5050');
          text(250, 6, 'OUT OF STEP (desync)');
        END
      END
      IF (match_over)
        set_color('#ffe070');
        IF (match_over == 1) text(250, 220, 'BLUE WINS THE MATCH');
        ELSE text(254, 220, 'RED WINS THE MATCH'); END
      END
      FRAME;
    END

    // Back to the menu.
    cur = 0;
    wipe = 1;
    signal(TYPE tank, s_kill);
    FRAME;
    wipe = 0;
    net_close();
  END
END
