// Example of online compiler Div GO: Games Online
// Php + Html5 + Canvas + Javascript
// by J. Manuel Habas

program example_scroll;
global
	ux = 240, uy = 60;

begin
	set_title("Div GO : Example Scroll");
	
	/* display options */
	set_mode(480, 240);
	screen_color(#26b);

	set_fps(60, 0);

	xput(0, 4, 80, 0, 0, 140, 0, 0);
	xput(0, 4, 160, 20, 0, 160, 0, 0);
	xput(0, 4, 300, 0, 0, 140, 0, 0);
	xput(0, 4, 400, 20, 0, 160, 0, 0);

	xput(0, 4, 400, 240, 180000, 140, 0, 0);
	xput(0, 4, 300, 220, 180000, 160, 0, 0);
	xput(0, 4, 160, 240, 180000, 140, 0, 0);
	xput(0, 4, 80, 220, 180000, 160, 0, 0);

	// defines the regions where to display the graphics
	define_region(1, 0, 0, 480, 120);
    define_region(2, 0, 120, 480, 120);
    define_region(3, 0, 0, 480, 240);

	// initialize scroll
	start_scroll(0, 0, 1, 5, 1, 0);
	start_scroll(1, 0, 1, 5, 2, 0);
		
    text_color	  = rgb(0, 0, 0);
    text_size	  = 45;
    
    write(0, 40, 26, 4, "1 Player");
    write(0, 40, 146, 4, "2 Player");

    text_color	  = rgb(0, 0, 0);
    text_size	  = 60;
    write(0, 240, 110, 4, "[cursors] to move");
    write(0, 240, 230, 4, "[o, p, q, a] to move");
    
    text_color	  = rgb(255, 255, 255);
    write(0, 241, 109, 4, "[cursors] to move");
    write(0, 241, 229, 4, "[o, p, q, a] to move");

   	speech_bubble(7, 40, 30, 50);
    speech_bubble(7, 40, 150, 50);
    
    star(2, 90, uy, 50);
	arrow(3, ux, uy, 0);	
    
	loop		
		if (key(_1) and scroll.front.alpha > 0) scroll.front.alpha -= 2; end
		if (key(_2) and scroll.front.alpha < 100) scroll.front.alpha += 2; end
		if (key(_4) and scroll.back.alpha > 0) scroll.back.alpha -= 2; end
		if (key(_5) and scroll.back.alpha < 100) scroll.back.alpha += 2; end
		
		if (key(_enter)) start_scroll(0, 0, 1, 2, 1, 0); end
		if (key(_esc)) stop_scroll(0); end
		
		frame;
	end
end

process arrow(graph, x, y, angle);
begin
	size  = 50;
	ctype = c_scroll;
	
	scroll[0].camera = id;
    
	loop
		if (key(_up))
			y-=3;
			angle = 90000;
		end
		
		if (key(_down))
			y+=3;
			angle = -90000;
		end
		
		if (key(_left))
			x-=3;
			angle = 180000;
		end
		
		if (key(_right))
			x+=3;
			angle = 0;
		end
	
		frame;
	end
end

process star(graph, x, y, size)
begin
	ctype = c_scroll;
	
	scroll[1].camera = id;

    loop

		if (key(_q)) y-=3; end		
		if (key(_a)) y+=3; end		
		if (key(_o)) x-=3; end
		if (key(_p)) x+=3; end

    	frame;
    end
end

process speech_bubble(graph, x, y, size)
begin
    region = 3;
    
    loop

    	frame;
    end
end
